# Triangle vertex stage (e7s).
#
# `@vertex` makes vs_main a Slang vertex entry point. Vertex attributes arrive
# in the `Vertex` struct; the returned `Varying` struct is the interpolated
# interface handed to the fragment stage.
#
# Every file is transpiled as its own Slang translation unit, so the vertex and
# fragment stages declare matching interface structs independently.

# Per-object constants (set 0, binding 0). A plain user struct resource lowers
# to ConstantBuffer<Scene>.
Scene <- struct
    mvp: [f32; 4, 4]
    tint: [f32; 4]

# Vertex attributes: @location(n) becomes [[vk::location(n)]].
Vertex <- struct
    @location(0) position: [f32; 3]
    @location(1) colour: [f32; 4]

# Varyings: @builtin(position) names SV_Position; @location(n) carries payload.
Varying <- struct
    @builtin(position) clip_position: [f32; 4]
    @location(0) colour: [f32; 4]

@binding(0, 0)
scene: Scene

@vertex
vs_main <- (vertex: Vertex) -> Varying:
    # `mul(m, v)` treats v as a column vector. Matrix fields default to
    # column-major storage, matching the column-major host matrix upload.
    clip := mul(scene.mvp, [vertex.position.x, vertex.position.y, vertex.position.z, 1.0] as [f32; 4])
    ret Varying{clip_position: clip, colour: vertex.colour * scene.tint}
