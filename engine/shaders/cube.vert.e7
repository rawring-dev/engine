# Vertex shader for the engine7 scene renderer: spinning cube with a point
# light.  This is e7s source; engine/shaders/build.sh transpiles it to Slang
# and compiles the result to cube.vert.spv.
#
# Uniform layout (std140-compatible, 256 bytes, matching renderer.Uniforms):
#   model, view, proj (each [f32; 4, 4]), then camera_pos, light_pos,
#   light_color, params (each [f32; 4]).
#
# e7s matrices are stored column-major: a [f32; 4, 4] field becomes
# `column_major float4x4`, and `*` on a matrix operand becomes `mul(...)`.
# The host uploads a column-major Mat4, so no explicit column vectors are
# needed in the shader.

SceneUniform <- struct
    model: [f32; 4, 4]
    view: [f32; 4, 4]
    proj: [f32; 4, 4]
    camera_pos: [f32; 4]
    light_pos: [f32; 4]
    light_color: [f32; 4]
    params: [f32; 4]

@binding(0, 0)
scene: SceneUniform

VSInput <- struct
    @location(0) position: [f32; 3]
    @location(1) normal: [f32; 3]
    @location(2) color: [f32; 3]

VSOutput <- struct
    @builtin(position) position: [f32; 4]
    @location(0) world_pos: [f32; 3]
    @location(1) normal: [f32; 3]
    @location(2) color: [f32; 3]

@vertex
main <- (input: VSInput) -> VSOutput:
    position := [input.position.x, input.position.y, input.position.z, 1.0] as [f32; 4]
    world := scene.model * position
    view := scene.view * world
    clip := scene.proj * view

    # The model matrix is rotation-only; a w=0 vector applies its upper 3x3.
    normal4 := scene.model * ([input.normal.x, input.normal.y, input.normal.z, 0.0] as [f32; 4])
    normal := normal4.xyz

    ret VSOutput{
        position: clip,
        world_pos: world.xyz,
        normal: normal,
        color: input.color,
    }
