SceneUniform <- struct
    model: [f32; 4, 4]
    view: [f32; 4, 4]
    proj: [f32; 4, 4]
    camera_pos: [f32; 4]
    light_pos: [f32; 4]
    light_color: [f32; 4]
    params: [f32; 4]
    tint: [f32; 4]

@binding(0, 0)
scene: SceneUniform

# Set 1 holds the per-object material texture/sampler.  Texture id 0 is a
# white 1x1 texture, so untextured draws behave exactly like tint * vertex
# colour.
@binding(1, 1)
albedo: Texture2D<[f32; 4]>

@binding(2, 1)
albedo_sampler: SamplerState

VSOutput <- struct
    @builtin(position) position: [f32; 4]
    @location(0) world_pos: [f32; 3]
    @location(1) normal: [f32; 3]
    @location(2) color: [f32; 3]
    @location(3) uv: [f32; 2]

@fragment
main <- (input: VSOutput) -> [f32; 4]:
    n := normalize(input.normal)
    to_light := scene.light_pos.xyz - input.world_pos
    distance_to_light := length(to_light)
    light_dir := to_light / max(distance_to_light, 1.0e-4)
    diffuse := max(dot(n, light_dir), 0.0)

    # Inverse-square-ish falloff with a linear term to keep near faces bright.
    attenuation := 1.0 / (1.0 + 0.15 * distance_to_light +
                         0.02 * distance_to_light * distance_to_light)
    # light_color.w carries the light intensity.
    light := scene.light_color.rgb * (scene.light_color.w * attenuation)
    # params.rgb * params.w is the ambient colour.
    ambient := scene.params.rgb * scene.params.w

    base := albedo.Sample(albedo_sampler, input.uv)

    # Per-object tint and material texture multiply the mesh vertex colour.
    lit := input.color * scene.tint.rgb * base.rgb * (ambient + light * diffuse)
    ret [lit.x, lit.y, lit.z, 1.0]
