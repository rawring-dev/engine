# Textured fullscreen-triangle vertex stage: the three clip-space corners are
# selected by the vertex index builtin, and the UV is derived from the clip
# position (p * 0.5 + 0.5), matching the original GLSL shader.
#
# `@builtin(vertex_index)` lowers through Slang's SV_VertexID, which rebases the
# index with BaseVertex and therefore declares the SPIR-V DrawParameters
# capability (see README: shaderDrawParameters feature requirement).

In <- struct
    @builtin(vertex_index) index: u32

Out <- struct
    @builtin(position) position: [f32; 4]
    @location(0) uv: [f32; 2]

@vertex
main <- (input: In) -> Out:
    p: [f32; 2]
    if input.index == 0:
        p = [-1.0, -1.0] as [f32; 2]
    elif input.index == 1:
        p = [3.0, -1.0] as [f32; 2]
    else:
        p = [-1.0, 3.0] as [f32; 2]
    uv := [p.x * 0.5 + 0.5, p.y * 0.5 + 0.5] as [f32; 2]
    ret Out{position: [p.x, p.y, 0.0, 1.0] as [f32; 4], uv: uv}
