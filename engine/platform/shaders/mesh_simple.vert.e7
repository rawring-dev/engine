# Mesh vertex stage without uniforms; vertex positions are already clip space.

In <- struct
    @location(0) position: [f32; 3]
    @location(1) color: [f32; 3]

Out <- struct
    @builtin(position) position: [f32; 4]
    @location(0) vcolor: [f32; 3]

@vertex
main <- (input: In) -> Out:
    clip := [input.position.x, input.position.y, input.position.z, 1.0] as [f32; 4]
    ret Out{position: clip, vcolor: input.color}
