# Vulkan platform bootstrap implemented in e7 through the generic C FFI.
#
# The instance is created with the platform extensions reported by SDL, and the
# surface is created by SDL for the window owned by the e7 SDL state block.
# Struct layouts are the Vulkan 1.1/1.4 core layouts for x86_64:
#   VkApplicationInfo:     48 bytes (sType 0, pNext 8, pAppName 16,
#                          appVersion 24, pEngineName 32, engineVersion 40,
#                          apiVersion 44)
#   VkInstanceCreateInfo:  64 bytes (sType 0, pNext 8, flags 16, pAppInfo 24,
#                          layerCount 32, ppLayers 40, extCount 48, ppExts 56)
#   VkSurfaceKHR / VkInstance are 64-bit handles.

bind_vk <- (name: str) -> u64:
    ret e7_cffi_bind("vulkan", name)

vulkan_instance_create <- (extensions: u64, extension_count: i64, out_instance: u64) -> i64:
    app_name := e7_cstr("engine7-e7")
    engine_name := e7_cstr("engine7")
    app := e7_alloc_bytes(48)
    e7_store_u32(app, 0)
    e7_store_u64(app + 16, app_name)
    e7_store_u32(app + 24, 1)
    e7_store_u64(app + 32, engine_name)
    e7_store_u32(app + 40, 1)
    e7_store_u32(app + 44, 4198400)
    info := e7_alloc_bytes(64)
    e7_store_u32(info, 1)
    e7_store_u64(info + 24, app)
    e7_store_u32(info + 48, extension_count)
    e7_store_u64(info + 56, extensions)
    create := bind_vk("vkCreateInstance")
    result := e7_ffi_call3(create, info, 0, out_instance)
    e7_free_ptr(app_name)
    e7_free_ptr(engine_name)
    e7_free_ptr(app)
    e7_free_ptr(info)
    ret result as i64

vulkan_instance_destroy <- (instance: i64) -> nil:
    destroy := bind_vk("vkDestroyInstance")
    e7_ffi_call2(destroy, instance, 0)

vulkan_surface_create <- (window_state: u64, instance: i64, out_surface: u64) -> i64:
    window := e7_load_u64(window_state)
    create := e7_cffi_bind("SDL3", "SDL_Vulkan_CreateSurface")
    ret e7_ffi_call4(create, window, instance, 0, out_surface) as i64

vulkan_surface_destroy <- (instance: i64, surface: i64) -> nil:
    destroy := bind_vk("vkDestroySurfaceKHR")
    e7_ffi_call3(destroy, instance, surface, 0)

# True when a queue family supports graphics and the surface.  The unrolled
# family/device probes below avoid loops: LLVM's instcombine currently fails to
# reach a fixpoint on the e7-generated loop CFG for this shape.
queue_family_supported <- (physical: i64, surface: i64, props: u64, index: i64) -> i64:
    offset := (index * 24) as u64
    flags := e7_load_u32(props + offset)
    if flags % 2 == 0:
        ret 0
    support := e7_alloc_bytes(4)
    e7_store_u32(support, 0)
    check := bind_vk("vkGetPhysicalDeviceSurfaceSupportKHR")
    e7_ffi_call4(check, physical, index, surface, support)
    supported := e7_load_u32(support)
    e7_free_ptr(support)
    ret supported

find_queue_family <- (physical: i64, surface: i64) -> i64:
    get_families := bind_vk("vkGetPhysicalDeviceQueueFamilyProperties")
    count_out := e7_alloc_bytes(4)
    e7_ffi_call3(get_families, physical, count_out, 0)
    count := e7_load_u32(count_out)
    if count <= 0:
        e7_free_ptr(count_out)
        ret -1
    props := e7_alloc_bytes(count * 24)
    e7_ffi_call3(get_families, physical, count_out, props)
    if count > 0:
        if queue_family_supported(physical, surface, props, 0) != 0:
            e7_free_ptr(count_out)
            e7_free_ptr(props)
            ret 0
    if count > 1:
        if queue_family_supported(physical, surface, props, 1) != 0:
            e7_free_ptr(count_out)
            e7_free_ptr(props)
            ret 1
    if count > 2:
        if queue_family_supported(physical, surface, props, 2) != 0:
            e7_free_ptr(count_out)
            e7_free_ptr(props)
            ret 2
    if count > 3:
        if queue_family_supported(physical, surface, props, 3) != 0:
            e7_free_ptr(count_out)
            e7_free_ptr(props)
            ret 3
    if count > 4:
        if queue_family_supported(physical, surface, props, 4) != 0:
            e7_free_ptr(count_out)
            e7_free_ptr(props)
            ret 4
    if count > 5:
        if queue_family_supported(physical, surface, props, 5) != 0:
            e7_free_ptr(count_out)
            e7_free_ptr(props)
            ret 5
    if count > 6:
        if queue_family_supported(physical, surface, props, 6) != 0:
            e7_free_ptr(count_out)
            e7_free_ptr(props)
            ret 6
    if count > 7:
        if queue_family_supported(physical, surface, props, 7) != 0:
            e7_free_ptr(count_out)
            e7_free_ptr(props)
            ret 7
    e7_free_ptr(count_out)
    e7_free_ptr(props)
    ret -1

create_logical_device <- (
    physical: i64,
    family: i64,
    out_device: u64,
    out_queue: u64,
    out_family: u64,
    out_physical: u64,
) -> i64:
    priority := e7_alloc_bytes(4)
    e7_store_u32(priority, 1065353216)
    queue_info := e7_alloc_bytes(40)
    e7_store_u32(queue_info, 2)
    e7_store_u32(queue_info + 20, family)
    e7_store_u32(queue_info + 24, 1)
    e7_store_u64(queue_info + 32, priority)
    extension_name := e7_cstr("VK_KHR_swapchain")
    extension_array := e7_alloc_bytes(8)
    e7_store_u64(extension_array, extension_name)
    device_info := e7_alloc_bytes(72)
    e7_store_u32(device_info, 3)
    e7_store_u32(device_info + 20, 1)
    e7_store_u64(device_info + 24, queue_info)
    e7_store_u32(device_info + 48, 1)
    e7_store_u64(device_info + 56, extension_array)
    create := bind_vk("vkCreateDevice")
    create_result := e7_ffi_call4(create, physical, device_info, 0, out_device)
    e7_free_ptr(priority)
    e7_free_ptr(queue_info)
    e7_free_ptr(extension_name)
    e7_free_ptr(extension_array)
    e7_free_ptr(device_info)
    if create_result != 0:
        ret 0
    device := e7_load_u64(out_device)
    get_queue := bind_vk("vkGetDeviceQueue")
    e7_ffi_call4(get_queue, device, family, 0, out_queue)
    e7_store_u32(out_family, family)
    e7_store_u64(out_physical, physical)
    ret 1

# Create a logical device and graphics/present queue.  Returns 1 on success and
# 0 when the instance has no device that can present to `surface`.
vulkan_device_create <- (
    instance: i64,
    surface: i64,
    out_device: u64,
    out_queue: u64,
    out_family: u64,
    out_physical: u64,
) -> i64:
    enumerate := bind_vk("vkEnumeratePhysicalDevices")
    count_out := e7_alloc_bytes(4)
    e7_store_u32(count_out, 0)
    enum_result := e7_ffi_call3(enumerate, instance, count_out, 0)
    count := e7_load_u32(count_out)
    if enum_result != 0 or count <= 0:
        e7_free_ptr(count_out)
        ret 0
    devices := e7_alloc_bytes(count * 8)
    enum2 := e7_ffi_call3(enumerate, instance, count_out, devices)
    if enum2 != 0:
        e7_free_ptr(count_out)
        e7_free_ptr(devices)
        ret -5
    if count > 0:
        physical := e7_load_u64(devices)
        family := find_queue_family(physical, surface)
        if family >= 0:
            result := create_logical_device(physical, family, out_device, out_queue, out_family, out_physical)
            if result != 0:
                e7_free_ptr(count_out)
                e7_free_ptr(devices)
                ret result
    if count > 1:
        physical := e7_load_u64(devices + 8)
        family := find_queue_family(physical, surface)
        if family >= 0:
            result := create_logical_device(physical, family, out_device, out_queue, out_family, out_physical)
            if result != 0:
                e7_free_ptr(count_out)
                e7_free_ptr(devices)
                ret result
    if count > 2:
        physical := e7_load_u64(devices + 16)
        family := find_queue_family(physical, surface)
        if family >= 0:
            result := create_logical_device(physical, family, out_device, out_queue, out_family, out_physical)
            if result != 0:
                e7_free_ptr(count_out)
                e7_free_ptr(devices)
                ret result
    if count > 3:
        physical := e7_load_u64(devices + 24)
        family := find_queue_family(physical, surface)
        if family >= 0:
            result := create_logical_device(physical, family, out_device, out_queue, out_family, out_physical)
            if result != 0:
                e7_free_ptr(count_out)
                e7_free_ptr(devices)
                ret result
    e7_free_ptr(count_out)
    e7_free_ptr(devices)
    ret 0

vulkan_device_destroy <- (device: i64) -> nil:
    destroy := bind_vk("vkDestroyDevice")
    e7_ffi_call2(destroy, device, 0)

# Create a swapchain for the window surface.  The first reported surface format
# is used (or BGRA8/SRGB when the surface reports VK_FORMAT_UNDEFINED), FIFO
# presentation is requested, and the swapchain images are returned as an array
# of VkImage handles.  `window_state` supplies the pixel extent when the surface
# reports the special 0xFFFFFFFF currentExtent.
vulkan_swapchain_create <- (
    device: i64,
    physical: i64,
    surface: i64,
    window_state: u64,
    out_swapchain: u64,
    out_format: u64,
    out_width: u64,
    out_height: u64,
    out_images: u64,
    out_image_count: u64,
) -> i64:
    capabilities := e7_alloc_bytes(64)
    get_caps := bind_vk("vkGetPhysicalDeviceSurfaceCapabilitiesKHR")
    caps_result := e7_ffi_call3(get_caps, physical, surface, capabilities)
    if caps_result != 0:
        e7_free_ptr(capabilities)
        ret 0
    min_images := e7_load_u32(capabilities)
    max_images := e7_load_u32(capabilities + 4)
    image_count := min_images + 1
    if max_images > 0:
        if image_count > max_images:
            image_count = max_images
    if image_count < 1:
        image_count = 1

    format_count := e7_alloc_bytes(4)
    get_formats := bind_vk("vkGetPhysicalDeviceSurfaceFormatsKHR")
    e7_ffi_call4(get_formats, physical, surface, format_count, 0)
    formats_len := e7_load_u32(format_count)
    if formats_len <= 0:
        e7_free_ptr(capabilities)
        e7_free_ptr(format_count)
        ret 0
    formats := e7_alloc_bytes(formats_len * 8)
    e7_ffi_call4(get_formats, physical, surface, format_count, formats)
    image_format := e7_load_u32(formats)
    color_space := e7_load_u32(formats + 4)
    if image_format == 0:
        image_format = 44
        color_space = 0

    width := e7_load_u32(capabilities + 8)
    height := e7_load_u32(capabilities + 12)
    window_width := e7_alloc_bytes(4)
    window_height := e7_alloc_bytes(4)
    if width == 4294967295:
        window_size(window_state, window_width, window_height)
        width = e7_load_u32(window_width)
        height = e7_load_u32(window_height)
    if width == 0:
        width = 64
    if height == 0:
        height = 48

    pre_transform := e7_load_u32(capabilities + 40)
    if pre_transform == 0:
        pre_transform = 1
    info := e7_alloc_bytes(104)
    e7_store_u32(info, 1000001000)
    e7_store_u64(info + 24, surface)
    e7_store_u32(info + 32, image_count)
    e7_store_u32(info + 36, image_format)
    e7_store_u32(info + 40, color_space)
    e7_store_u32(info + 44, width)
    e7_store_u32(info + 48, height)
    e7_store_u32(info + 52, 1)
    e7_store_u32(info + 56, 16)
    e7_store_u32(info + 60, 0)
    e7_store_u32(info + 64, 0)
    e7_store_u32(info + 80, pre_transform)
    e7_store_u32(info + 84, 1)
    e7_store_u32(info + 88, 2)
    e7_store_u32(info + 92, 1)
    e7_store_u64(info + 96, 0)
    create := bind_vk("vkCreateSwapchainKHR")
    create_result := e7_ffi_call4(create, device, info, 0, out_swapchain)
    e7_free_ptr(capabilities)
    e7_free_ptr(format_count)
    e7_free_ptr(formats)
    e7_free_ptr(window_width)
    e7_free_ptr(window_height)
    e7_free_ptr(info)
    if create_result != 0:
        ret 0

    swapchain := e7_load_u64(out_swapchain)
    image_count_out := e7_alloc_bytes(4)
    get_images := bind_vk("vkGetSwapchainImagesKHR")
    e7_ffi_call4(get_images, device, swapchain, image_count_out, 0)
    images_len := e7_load_u32(image_count_out)
    if images_len <= 0:
        e7_free_ptr(image_count_out)
        ret 0
    images := e7_alloc_bytes(images_len * 8)
    e7_ffi_call4(get_images, device, swapchain, image_count_out, images)
    e7_store_u32(out_format, image_format)
    e7_store_u32(out_width, width)
    e7_store_u32(out_height, height)
    e7_store_u64(out_images, images)
    e7_store_u32(out_image_count, images_len)
    e7_free_ptr(image_count_out)
    ret 1

vulkan_swapchain_destroy <- (device: i64, swapchain: i64) -> nil:
    destroy := bind_vk("vkDestroySwapchainKHR")
    e7_ffi_call3(destroy, device, swapchain, 0)

# Minimal submission used to validate command-pool/queue family agreement.
vulkan_submit_empty <- (device: i64, queue: i64, queue_family: i64) -> i64:
    pool_info := e7_alloc_bytes(24)
    e7_store_u32(pool_info, 39)
    e7_store_u32(pool_info + 20, queue_family)
    pool_out := e7_alloc_bytes(8)
    create_pool := bind_vk("vkCreateCommandPool")
    e7_ffi_call4(create_pool, device, pool_info, 0, pool_out)
    pool := e7_load_u64(pool_out)
    allocate_info := e7_alloc_bytes(32)
    e7_store_u32(allocate_info, 40)
    e7_store_u64(allocate_info + 16, pool)
    e7_store_u32(allocate_info + 24, 0)
    e7_store_u32(allocate_info + 28, 1)
    command_out := e7_alloc_bytes(8)
    allocate_command := bind_vk("vkAllocateCommandBuffers")
    e7_ffi_call3(allocate_command, device, allocate_info, command_out)
    command := e7_load_u64(command_out)
    begin_info := e7_alloc_bytes(32)
    e7_store_u32(begin_info, 42)
    begin_command := bind_vk("vkBeginCommandBuffer")
    e7_ffi_call2(begin_command, command, begin_info)
    end_command := bind_vk("vkEndCommandBuffer")
    e7_ffi_call1(end_command, command)
    command_buffers := e7_alloc_bytes(8)
    e7_store_u64(command_buffers, command)
    submit_info := e7_alloc_bytes(72)
    e7_store_u32(submit_info, 4)
    e7_store_u32(submit_info + 40, 1)
    e7_store_u64(submit_info + 48, command_buffers)
    queue_submit := bind_vk("vkQueueSubmit")
    submit_result := e7_ffi_call4(queue_submit, queue, 1, submit_info, 0)
    queue_wait := bind_vk("vkQueueWaitIdle")
    e7_ffi_call1(queue_wait, queue)
    destroy_pool := bind_vk("vkDestroyCommandPool")
    e7_ffi_call3(destroy_pool, device, pool, 0)
    e7_free_ptr(pool_info)
    e7_free_ptr(pool_out)
    e7_free_ptr(allocate_info)
    e7_free_ptr(command_out)
    e7_free_ptr(begin_info)
    e7_free_ptr(command_buffers)
    e7_free_ptr(submit_info)
    if submit_result != 0:
        ret 0
    ret 1

transition_image <- (command_buffer: i64, image: i64, old_layout: i64, new_layout: i64, src_access: i64, dst_access: i64, src_stage: i64, dst_stage: i64) -> nil:
    barrier := e7_alloc_bytes(128)
    e7_store_u32(barrier, 45)
    e7_store_u32(barrier + 16, src_access)
    e7_store_u32(barrier + 20, dst_access)
    e7_store_u32(barrier + 24, old_layout)
    e7_store_u32(barrier + 28, new_layout)
    e7_store_u32(barrier + 32, 4294967295)
    e7_store_u32(barrier + 36, 4294967295)
    e7_store_u64(barrier + 40, image)
    e7_store_u32(barrier + 48, 1)
    e7_store_u32(barrier + 52, 0)
    e7_store_u32(barrier + 56, 1)
    e7_store_u32(barrier + 60, 0)
    e7_store_u32(barrier + 64, 1)
    pipeline_barrier := bind_vk("vkCmdPipelineBarrier")
    e7_ffi_call10(pipeline_barrier, command_buffer, src_stage, dst_stage, 0, 0, 0, 0, 0, 1, barrier)
    e7_free_ptr(barrier)

vulkan_present_clear <- (device: i64, queue: i64, queue_family: i64, swapchain: i64, out_image_index: u64) -> i64:
    semaphore_info := e7_alloc_bytes(24)
    e7_store_u32(semaphore_info, 9)
    image_semaphore_out := e7_alloc_bytes(8)
    render_semaphore_out := e7_alloc_bytes(8)
    create_semaphore := bind_vk("vkCreateSemaphore")
    e7_ffi_call4(create_semaphore, device, semaphore_info, 0, image_semaphore_out)
    e7_ffi_call4(create_semaphore, device, semaphore_info, 0, render_semaphore_out)
    image_semaphore := e7_load_u64(image_semaphore_out)
    render_semaphore := e7_load_u64(render_semaphore_out)
    fence_info := e7_alloc_bytes(24)
    e7_store_u32(fence_info, 8)
    fence_out := e7_alloc_bytes(8)
    create_fence := bind_vk("vkCreateFence")
    e7_ffi_call4(create_fence, device, fence_info, 0, fence_out)
    fence := e7_load_u64(fence_out)

    image_index_out := e7_alloc_bytes(4)
    e7_store_u32(image_index_out, 0)
    acquire := bind_vk("vkAcquireNextImageKHR")
    acquire_result := e7_ffi_call6(acquire, device, swapchain, -1, image_semaphore, 0, image_index_out)
    image_index := e7_load_u32(image_index_out)

    pool_info := e7_alloc_bytes(24)
    e7_store_u32(pool_info, 39)
    e7_store_u32(pool_info + 20, queue_family)
    pool_out := e7_alloc_bytes(8)
    create_pool := bind_vk("vkCreateCommandPool")
    e7_ffi_call4(create_pool, device, pool_info, 0, pool_out)
    pool := e7_load_u64(pool_out)
    allocate_info := e7_alloc_bytes(32)
    e7_store_u32(allocate_info, 40)
    e7_store_u64(allocate_info + 16, pool)
    e7_store_u32(allocate_info + 24, 0)
    e7_store_u32(allocate_info + 28, 1)
    command_out := e7_alloc_bytes(8)
    allocate_command := bind_vk("vkAllocateCommandBuffers")
    e7_ffi_call3(allocate_command, device, allocate_info, command_out)
    command := e7_load_u64(command_out)

    begin_info := e7_alloc_bytes(32)
    e7_store_u32(begin_info, 42)
    begin_command := bind_vk("vkBeginCommandBuffer")
    e7_ffi_call2(begin_command, command, begin_info)
    image_count_out := e7_alloc_bytes(4)
    get_images := bind_vk("vkGetSwapchainImagesKHR")
    e7_ffi_call4(get_images, device, swapchain, image_count_out, 0)
    image_count := e7_load_u32(image_count_out)
    images := e7_alloc_bytes(image_count * 8)
    e7_ffi_call4(get_images, device, swapchain, image_count_out, images)
    image := e7_load_u64(images + ((image_index * 8) as u64))
    transition_image(command, image, 0, 7, 0, 4096, 1, 4096)
    clear_color := e7_alloc_bytes(16)
    e7_store_u32(clear_color, 1065353216)
    e7_store_u32(clear_color + 4, 0)
    e7_store_u32(clear_color + 8, 0)
    e7_store_u32(clear_color + 12, 1065353216)
    clear_range := e7_alloc_bytes(20)
    e7_store_u32(clear_range, 1)
    e7_store_u32(clear_range + 4, 0)
    e7_store_u32(clear_range + 8, 1)
    e7_store_u32(clear_range + 12, 0)
    e7_store_u32(clear_range + 16, 1)
    clear_image := bind_vk("vkCmdClearColorImage")
    e7_ffi_call6(clear_image, command, image, 7, clear_color, 1, clear_range)
    transition_image(command, image, 7, 1000001002, 4096, 0, 4096, 8192)
    end_command := bind_vk("vkEndCommandBuffer")
    e7_ffi_call1(end_command, command)

    wait_stage_out := e7_alloc_bytes(4)
    e7_store_u32(wait_stage_out, 4096)
    wait_semaphores := e7_alloc_bytes(8)
    e7_store_u64(wait_semaphores, image_semaphore)
    command_buffers := e7_alloc_bytes(8)
    e7_store_u64(command_buffers, command)
    signal_semaphores := e7_alloc_bytes(8)
    e7_store_u64(signal_semaphores, render_semaphore)
    submit_info := e7_alloc_bytes(72)
    e7_store_u32(submit_info, 4)
    e7_store_u32(submit_info + 16, 1)
    e7_store_u64(submit_info + 24, wait_semaphores)
    e7_store_u64(submit_info + 32, wait_stage_out)
    e7_store_u32(submit_info + 40, 1)
    e7_store_u64(submit_info + 48, command_buffers)
    e7_store_u32(submit_info + 56, 1)
    e7_store_u64(submit_info + 64, signal_semaphores)
    queue_submit := bind_vk("vkQueueSubmit")
    submit_result := e7_ffi_call4(queue_submit, queue, 1, submit_info, fence)
    fence_array := e7_alloc_bytes(8)
    e7_store_u64(fence_array, fence)
    wait_fences := bind_vk("vkWaitForFences")
    e7_ffi_call5(wait_fences, device, 1, fence_array, 1, -1)

    swapchains := e7_alloc_bytes(8)
    e7_store_u64(swapchains, swapchain)
    present_wait := e7_alloc_bytes(8)
    e7_store_u64(present_wait, render_semaphore)
    present_info := e7_alloc_bytes(64)
    e7_store_u32(present_info, 1000001001)
    e7_store_u32(present_info + 16, 1)
    e7_store_u64(present_info + 24, present_wait)
    e7_store_u32(present_info + 32, 1)
    e7_store_u64(present_info + 40, swapchains)
    e7_store_u64(present_info + 48, image_index_out)
    present := bind_vk("vkQueuePresentKHR")
    present_result := e7_ffi_call2(present, queue, present_info)

    destroy_pool := bind_vk("vkDestroyCommandPool")
    e7_ffi_call3(destroy_pool, device, pool, 0)
    destroy_fence := bind_vk("vkDestroyFence")
    e7_ffi_call3(destroy_fence, device, fence, 0)
    destroy_semaphore := bind_vk("vkDestroySemaphore")
    e7_ffi_call3(destroy_semaphore, device, image_semaphore, 0)
    e7_ffi_call3(destroy_semaphore, device, render_semaphore, 0)
    e7_store_u32(out_image_index, image_index)
    e7_free_ptr(semaphore_info)
    e7_free_ptr(image_semaphore_out)
    e7_free_ptr(render_semaphore_out)
    e7_free_ptr(fence_info)
    e7_free_ptr(fence_out)
    e7_free_ptr(image_index_out)
    e7_free_ptr(pool_info)
    e7_free_ptr(pool_out)
    e7_free_ptr(allocate_info)
    e7_free_ptr(command_out)
    e7_free_ptr(begin_info)
    e7_free_ptr(image_count_out)
    e7_free_ptr(images)
    e7_free_ptr(clear_color)
    e7_free_ptr(clear_range)
    e7_free_ptr(wait_stage_out)
    e7_free_ptr(wait_semaphores)
    e7_free_ptr(command_buffers)
    e7_free_ptr(signal_semaphores)
    e7_free_ptr(submit_info)
    e7_free_ptr(fence_array)
    e7_free_ptr(swapchains)
    e7_free_ptr(present_wait)
    e7_free_ptr(present_info)
    if acquire_result != 0 and acquire_result != 1000001003:
        ret 0
    if submit_result != 0:
        ret 0
    if present_result != 0:
        ret 0
    ret 1

# Choose a host-visible coherent memory type allowed by `type_bits`.
find_memory_type <- (physical: i64, type_bits: i64) -> i64:
    props := e7_alloc_bytes(520)
    get_props := bind_vk("vkGetPhysicalDeviceMemoryProperties")
    e7_ffi_call2(get_props, physical, props)
    count := e7_load_u32(props)
    if count > 0:
        flags := e7_load_u32(props + 4)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if type_bits % 2 == 1:
                    e7_free_ptr(props)
                    ret 0
    if count > 1:
        flags := e7_load_u32(props + 12)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 2) % 2 == 1:
                    e7_free_ptr(props)
                    ret 1
    if count > 2:
        flags := e7_load_u32(props + 20)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 4) % 2 == 1:
                    e7_free_ptr(props)
                    ret 2
    if count > 3:
        flags := e7_load_u32(props + 28)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 8) % 2 == 1:
                    e7_free_ptr(props)
                    ret 3
    if count > 4:
        flags := e7_load_u32(props + 36)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 16) % 2 == 1:
                    e7_free_ptr(props)
                    ret 4
    if count > 5:
        flags := e7_load_u32(props + 44)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 32) % 2 == 1:
                    e7_free_ptr(props)
                    ret 5
    if count > 6:
        flags := e7_load_u32(props + 52)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 64) % 2 == 1:
                    e7_free_ptr(props)
                    ret 6
    if count > 7:
        flags := e7_load_u32(props + 60)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 128) % 2 == 1:
                    e7_free_ptr(props)
                    ret 7
    e7_free_ptr(props)
    ret -1

# Clear a swapchain image and read it back into an e7-owned BGRA/RGBA buffer.
vulkan_capture_clear <- (
    device: i64,
    queue: i64,
    queue_family: i64,
    physical: i64,
    swapchain: i64,
    width: i64,
    height: i64,
    out_pixels: u64,
    out_size: u64,
) -> i64:
    pixel_size := width * height * 4
    buffer_info := e7_alloc_bytes(56)
    e7_store_u32(buffer_info, 12)
    e7_store_u64(buffer_info + 16, pixel_size)
    e7_store_u32(buffer_info + 24, 2)
    buffer_out := e7_alloc_bytes(8)
    create_buffer := bind_vk("vkCreateBuffer")
    e7_ffi_call4(create_buffer, device, buffer_info, 0, buffer_out)
    buffer := e7_load_u64(buffer_out)
    requirements := e7_alloc_bytes(24)
    get_requirements := bind_vk("vkGetBufferMemoryRequirements")
    e7_ffi_call3(get_requirements, device, buffer, requirements)
    memory_size := e7_load_u64(requirements)
    type_bits := e7_load_u32(requirements + 8)
    memory_type := find_memory_type(physical, type_bits)
    alloc_info := e7_alloc_bytes(32)
    e7_store_u32(alloc_info, 5)
    e7_store_u64(alloc_info + 16, memory_size)
    e7_store_u32(alloc_info + 24, memory_type)
    memory_out := e7_alloc_bytes(8)
    allocate_memory := bind_vk("vkAllocateMemory")
    e7_ffi_call4(allocate_memory, device, alloc_info, 0, memory_out)
    memory := e7_load_u64(memory_out)
    bind_buffer := bind_vk("vkBindBufferMemory")
    e7_ffi_call4(bind_buffer, device, buffer, memory, 0)
    mapped_out := e7_alloc_bytes(8)
    map_memory := bind_vk("vkMapMemory")
    e7_ffi_call6(map_memory, device, memory, 0, memory_size, 0, mapped_out)
    mapped := e7_load_u64(mapped_out)

    semaphore_info := e7_alloc_bytes(24)
    e7_store_u32(semaphore_info, 9)
    image_sem_out := e7_alloc_bytes(8)
    create_sem := bind_vk("vkCreateSemaphore")
    e7_ffi_call4(create_sem, device, semaphore_info, 0, image_sem_out)
    image_sem := e7_load_u64(image_sem_out)
    image_index_out := e7_alloc_bytes(4)
    acquire := bind_vk("vkAcquireNextImageKHR")
    acquire_result := e7_ffi_call6(acquire, device, swapchain, -1, image_sem, 0, image_index_out)
    image_index := e7_load_u32(image_index_out)

    pool_info := e7_alloc_bytes(24)
    e7_store_u32(pool_info, 39)
    e7_store_u32(pool_info + 20, queue_family)
    pool_out := e7_alloc_bytes(8)
    create_pool := bind_vk("vkCreateCommandPool")
    e7_ffi_call4(create_pool, device, pool_info, 0, pool_out)
    pool := e7_load_u64(pool_out)
    allocate_info := e7_alloc_bytes(32)
    e7_store_u32(allocate_info, 40)
    e7_store_u64(allocate_info + 16, pool)
    e7_store_u32(allocate_info + 24, 0)
    e7_store_u32(allocate_info + 28, 1)
    command_out := e7_alloc_bytes(8)
    allocate_command := bind_vk("vkAllocateCommandBuffers")
    e7_ffi_call3(allocate_command, device, allocate_info, command_out)
    command := e7_load_u64(command_out)
    begin_info := e7_alloc_bytes(32)
    e7_store_u32(begin_info, 42)
    begin_command := bind_vk("vkBeginCommandBuffer")
    e7_ffi_call2(begin_command, command, begin_info)
    image_count_out := e7_alloc_bytes(4)
    get_images := bind_vk("vkGetSwapchainImagesKHR")
    e7_ffi_call4(get_images, device, swapchain, image_count_out, 0)
    image_count := e7_load_u32(image_count_out)
    images := e7_alloc_bytes(image_count * 8)
    e7_ffi_call4(get_images, device, swapchain, image_count_out, images)
    image := e7_load_u64(images + ((image_index * 8) as u64))
    transition_image(command, image, 0, 7, 0, 4096, 1, 4096)
    clear_color := e7_alloc_bytes(16)
    e7_store_u32(clear_color, 1065353216)
    e7_store_u32(clear_color + 12, 1065353216)
    clear_range := e7_alloc_bytes(20)
    e7_store_u32(clear_range, 1)
    e7_store_u32(clear_range + 8, 1)
    e7_store_u32(clear_range + 16, 1)
    clear_image := bind_vk("vkCmdClearColorImage")
    e7_ffi_call6(clear_image, command, image, 7, clear_color, 1, clear_range)
    transition_image(command, image, 7, 6, 4096, 2048, 4096, 4096)
    region := e7_alloc_bytes(56)
    e7_store_u32(region + 16, 1)
    e7_store_u32(region + 24, 1)
    e7_store_u32(region + 44, width)
    e7_store_u32(region + 48, height)
    e7_store_u32(region + 52, 1)
    copy_image := bind_vk("vkCmdCopyImageToBuffer")
    e7_ffi_call6(copy_image, command, image, 6, buffer, 1, region)
    transition_image(command, image, 6, 1000001002, 2048, 0, 4096, 8192)
    end_command := bind_vk("vkEndCommandBuffer")
    e7_ffi_call1(end_command, command)

    wait_stage := e7_alloc_bytes(4)
    e7_store_u32(wait_stage, 4096)
    wait_sem := e7_alloc_bytes(8)
    e7_store_u64(wait_sem, image_sem)
    command_buffers := e7_alloc_bytes(8)
    e7_store_u64(command_buffers, command)
    submit_info := e7_alloc_bytes(72)
    e7_store_u32(submit_info, 4)
    e7_store_u32(submit_info + 16, 1)
    e7_store_u64(submit_info + 24, wait_sem)
    e7_store_u64(submit_info + 32, wait_stage)
    e7_store_u32(submit_info + 40, 1)
    e7_store_u64(submit_info + 48, command_buffers)
    fence_info := e7_alloc_bytes(24)
    e7_store_u32(fence_info, 8)
    fence_out := e7_alloc_bytes(8)
    create_fence := bind_vk("vkCreateFence")
    e7_ffi_call4(create_fence, device, fence_info, 0, fence_out)
    fence := e7_load_u64(fence_out)
    queue_submit := bind_vk("vkQueueSubmit")
    submit_result := e7_ffi_call4(queue_submit, queue, 1, submit_info, fence)
    fence_array := e7_alloc_bytes(8)
    e7_store_u64(fence_array, fence)
    wait_fences := bind_vk("vkWaitForFences")
    e7_ffi_call5(wait_fences, device, 1, fence_array, 1, -1)

    pixels := e7_alloc_bytes(pixel_size)
    e7_memcpy(pixels, mapped, pixel_size)
    unmap := bind_vk("vkUnmapMemory")
    e7_ffi_call2(unmap, device, memory)
    e7_store_u64(out_pixels, pixels)
    e7_store_u64(out_size, pixel_size)

    destroy_buffer := bind_vk("vkDestroyBuffer")
    e7_ffi_call3(destroy_buffer, device, buffer, 0)
    free_memory := bind_vk("vkFreeMemory")
    e7_ffi_call3(free_memory, device, memory, 0)
    destroy_pool := bind_vk("vkDestroyCommandPool")
    e7_ffi_call3(destroy_pool, device, pool, 0)
    destroy_fence := bind_vk("vkDestroyFence")
    e7_ffi_call3(destroy_fence, device, fence, 0)
    destroy_sem := bind_vk("vkDestroySemaphore")
    e7_ffi_call3(destroy_sem, device, image_sem, 0)
    e7_free_ptr(buffer_info)
    e7_free_ptr(buffer_out)
    e7_free_ptr(requirements)
    e7_free_ptr(alloc_info)
    e7_free_ptr(memory_out)
    e7_free_ptr(mapped_out)
    e7_free_ptr(semaphore_info)
    e7_free_ptr(image_sem_out)
    e7_free_ptr(image_index_out)
    e7_free_ptr(pool_info)
    e7_free_ptr(pool_out)
    e7_free_ptr(allocate_info)
    e7_free_ptr(command_out)
    e7_free_ptr(begin_info)
    e7_free_ptr(image_count_out)
    e7_free_ptr(images)
    e7_free_ptr(clear_color)
    e7_free_ptr(clear_range)
    e7_free_ptr(region)
    e7_free_ptr(wait_stage)
    e7_free_ptr(wait_sem)
    e7_free_ptr(command_buffers)
    e7_free_ptr(submit_info)
    e7_free_ptr(fence_info)
    e7_free_ptr(fence_out)
    e7_free_ptr(fence_array)
    if acquire_result != 0 and acquire_result != 1000001003:
        ret 0
    if submit_result != 0:
        ret 0
    if memory_type < 0:
        ret 0
    ret 1
