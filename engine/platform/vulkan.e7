# Vulkan platform bootstrap implemented in e7 through the generic C FFI.
#
# The instance is created with the platform extensions reported by SDL, and the
# surface is created by SDL for the window owned by the e7 SDL state block.
# Struct layouts are the Vulkan 1.1/1.4 core layouts for x86_64:
#   VkApplicationInfo:     48 bytes (sType 0, pNext 8, pAppName 16,
#                          appVersion 24, pEngineName 32, engineVersion 40,
#                          apiVersion 44)
#   VkInstanceCreateInfo:  64 bytes (sType 0, pNext 8, flags 16, pAppInfo 24,
#                          layerCount 32, ppLayers 40, extCount 48, ppExts 56)
#   VkSurfaceKHR / VkInstance are 64-bit handles.

bind_vk <- (name: str) -> u64:
    ret ffi::bind("vulkan", name)

vulkan_instance_create <- (extensions: u64, extension_count: i64, out_instance: u64) -> i64:
    app_name := str::cstr("engine7-e7")
    engine_name := str::cstr("engine7")
    app := ptr::alloc(48) as u64
    ptr::store_u32(app, 0)
    ptr::store_u64(app + 16, app_name)
    ptr::store_u32(app + 24, 1)
    ptr::store_u64(app + 32, engine_name)
    ptr::store_u32(app + 40, 1)
    ptr::store_u32(app + 44, 4198400)
    info := ptr::alloc(64) as u64
    ptr::store_u32(info, 1)
    ptr::store_u64(info + 24, app)
    ptr::store_u32(info + 48, extension_count)
    ptr::store_u64(info + 56, extensions)
    create := bind_vk("vkCreateInstance")
    result := ffi::call3(create, info, 0, out_instance)
    ptr::free(app_name)
    ptr::free(engine_name)
    ptr::free(app)
    ptr::free(info)
    ret result as i64

vulkan_instance_destroy <- (instance: i64) -> nil:
    destroy := bind_vk("vkDestroyInstance")
    ffi::call2(destroy, instance, 0)

vulkan_surface_create <- (window_state: u64, instance: i64, out_surface: u64) -> i64:
    window := ptr::load_u64(window_state)
    create := ffi::bind("SDL3", "SDL_Vulkan_CreateSurface")
    ret ffi::call4(create, window, instance, 0, out_surface) as i64

vulkan_surface_destroy <- (instance: i64, surface: i64) -> nil:
    destroy := bind_vk("vkDestroySurfaceKHR")
    ffi::call3(destroy, instance, surface, 0)

# True when a queue family supports graphics and the surface.  The unrolled
# family/device probes below avoid loops: LLVM's instcombine currently fails to
# reach a fixpoint on the e7-generated loop CFG for this shape.
queue_family_supported <- (physical: i64, surface: i64, props: u64, index: i64) -> i64:
    offset := (index * 24) as u64
    flags := ptr::load_u32(props + offset)
    if flags % 2 == 0:
        ret 0
    support := ptr::alloc(4) as u64
    ptr::store_u32(support, 0)
    check := bind_vk("vkGetPhysicalDeviceSurfaceSupportKHR")
    ffi::call4(check, physical, index, surface, support)
    supported := ptr::load_u32(support)
    ptr::free(support)
    ret supported

find_queue_family <- (physical: i64, surface: i64) -> i64:
    get_families := bind_vk("vkGetPhysicalDeviceQueueFamilyProperties")
    count_out := ptr::alloc(4) as u64
    ffi::call3(get_families, physical, count_out, 0)
    count := ptr::load_u32(count_out)
    if count <= 0:
        ptr::free(count_out)
        ret -1
    props := ptr::alloc(count * 24) as u64
    ffi::call3(get_families, physical, count_out, props)
    if count > 0:
        if queue_family_supported(physical, surface, props, 0) != 0:
            ptr::free(count_out)
            ptr::free(props)
            ret 0
    if count > 1:
        if queue_family_supported(physical, surface, props, 1) != 0:
            ptr::free(count_out)
            ptr::free(props)
            ret 1
    if count > 2:
        if queue_family_supported(physical, surface, props, 2) != 0:
            ptr::free(count_out)
            ptr::free(props)
            ret 2
    if count > 3:
        if queue_family_supported(physical, surface, props, 3) != 0:
            ptr::free(count_out)
            ptr::free(props)
            ret 3
    if count > 4:
        if queue_family_supported(physical, surface, props, 4) != 0:
            ptr::free(count_out)
            ptr::free(props)
            ret 4
    if count > 5:
        if queue_family_supported(physical, surface, props, 5) != 0:
            ptr::free(count_out)
            ptr::free(props)
            ret 5
    if count > 6:
        if queue_family_supported(physical, surface, props, 6) != 0:
            ptr::free(count_out)
            ptr::free(props)
            ret 6
    if count > 7:
        if queue_family_supported(physical, surface, props, 7) != 0:
            ptr::free(count_out)
            ptr::free(props)
            ret 7
    ptr::free(count_out)
    ptr::free(props)
    ret -1

create_logical_device <- (
    physical: i64,
    family: i64,
    out_device: u64,
    out_queue: u64,
    out_family: u64,
    out_physical: u64,
) -> i64:
    priority := ptr::alloc(4) as u64
    ptr::store_u32(priority, 1065353216)
    queue_info := ptr::alloc(40) as u64
    ptr::store_u32(queue_info, 2)
    ptr::store_u32(queue_info + 20, family)
    ptr::store_u32(queue_info + 24, 1)
    ptr::store_u64(queue_info + 32, priority)
    extension_name := str::cstr("VK_KHR_swapchain")
    extension_array := ptr::alloc(8) as u64
    ptr::store_u64(extension_array, extension_name)
    device_info := ptr::alloc(72) as u64
    ptr::store_u32(device_info, 3)
    ptr::store_u32(device_info + 20, 1)
    ptr::store_u64(device_info + 24, queue_info)
    ptr::store_u32(device_info + 48, 1)
    ptr::store_u64(device_info + 56, extension_array)
    create := bind_vk("vkCreateDevice")
    create_result := ffi::call4(create, physical, device_info, 0, out_device)
    ptr::free(priority)
    ptr::free(queue_info)
    ptr::free(extension_name)
    ptr::free(extension_array)
    ptr::free(device_info)
    if create_result != 0:
        ret 0
    device := ptr::load_u64(out_device)
    get_queue := bind_vk("vkGetDeviceQueue")
    ffi::call4(get_queue, device, family, 0, out_queue)
    ptr::store_u32(out_family, family)
    ptr::store_u64(out_physical, physical)
    ret 1

# Create a logical device and graphics/present queue.  Returns 1 on success and
# 0 when the instance has no device that can present to `surface`.
vulkan_device_create <- (
    instance: i64,
    surface: i64,
    out_device: u64,
    out_queue: u64,
    out_family: u64,
    out_physical: u64,
) -> i64:
    enumerate := bind_vk("vkEnumeratePhysicalDevices")
    count_out := ptr::alloc(4) as u64
    ptr::store_u32(count_out, 0)
    enum_result := ffi::call3(enumerate, instance, count_out, 0)
    count := ptr::load_u32(count_out)
    if enum_result != 0 or count <= 0:
        ptr::free(count_out)
        ret 0
    devices := ptr::alloc(count * 8) as u64
    enum2 := ffi::call3(enumerate, instance, count_out, devices)
    if enum2 != 0:
        ptr::free(count_out)
        ptr::free(devices)
        ret -5
    if count > 0:
        physical := ptr::load_u64(devices)
        family := find_queue_family(physical, surface)
        if family >= 0:
            result := create_logical_device(physical, family, out_device, out_queue, out_family, out_physical)
            if result != 0:
                ptr::free(count_out)
                ptr::free(devices)
                ret result
    if count > 1:
        physical := ptr::load_u64(devices + 8)
        family := find_queue_family(physical, surface)
        if family >= 0:
            result := create_logical_device(physical, family, out_device, out_queue, out_family, out_physical)
            if result != 0:
                ptr::free(count_out)
                ptr::free(devices)
                ret result
    if count > 2:
        physical := ptr::load_u64(devices + 16)
        family := find_queue_family(physical, surface)
        if family >= 0:
            result := create_logical_device(physical, family, out_device, out_queue, out_family, out_physical)
            if result != 0:
                ptr::free(count_out)
                ptr::free(devices)
                ret result
    if count > 3:
        physical := ptr::load_u64(devices + 24)
        family := find_queue_family(physical, surface)
        if family >= 0:
            result := create_logical_device(physical, family, out_device, out_queue, out_family, out_physical)
            if result != 0:
                ptr::free(count_out)
                ptr::free(devices)
                ret result
    ptr::free(count_out)
    ptr::free(devices)
    ret 0

vulkan_device_destroy <- (device: i64) -> nil:
    destroy := bind_vk("vkDestroyDevice")
    ffi::call2(destroy, device, 0)

# Pure selection over VkSurfaceFormatKHR pairs. Return -1 rather than making
# readback interpret an HDR pixel as two unrelated BGRA8 pixels.
vulkan_capture_format_index <- (formats: u64, count: i64) -> i64:
    fallback := -1
    index := 0
    while index < count:
        format := ptr::load_u32(formats + ((index * 8) as u64))
        space := ptr::load_u32(formats + ((index * 8) as u64) + 4)
        if space == 0:
            if format == 44 or format == 0:
                ret index
            if format == 50:
                fallback = index
        index = index + 1
    ret fallback

# Create a swapchain using BGRA8, matching the four-byte capture/PPM ABI.
# Prefer UNORM to SRGB; never silently use HDR/16-bit surface formats. FIFO
# presentation is requested, and the swapchain images are returned as an array
# of VkImage handles.  `window_state` supplies the pixel extent when the surface
# reports the special 0xFFFFFFFF currentExtent.
vulkan_swapchain_create <- (
    device: i64,
    physical: i64,
    surface: i64,
    window_state: u64,
    out_swapchain: u64,
    out_format: u64,
    out_width: u64,
    out_height: u64,
    out_images: u64,
    out_image_count: u64,
) -> i64:
    capabilities := ptr::alloc(64) as u64
    get_caps := bind_vk("vkGetPhysicalDeviceSurfaceCapabilitiesKHR")
    caps_result := ffi::call3(get_caps, physical, surface, capabilities)
    if caps_result != 0:
        ptr::free(capabilities)
        ret 0
    min_images := ptr::load_u32(capabilities)
    max_images := ptr::load_u32(capabilities + 4)
    image_count := min_images + 1
    if max_images > 0:
        if image_count > max_images:
            image_count = max_images
    if image_count < 1:
        image_count = 1

    format_count := ptr::alloc(4) as u64
    get_formats := bind_vk("vkGetPhysicalDeviceSurfaceFormatsKHR")
    ffi::call4(get_formats, physical, surface, format_count, 0)
    formats_len := ptr::load_u32(format_count)
    if formats_len <= 0:
        ptr::free(capabilities)
        ptr::free(format_count)
        ret 0
    formats := ptr::alloc(formats_len * 8) as u64
    ffi::call4(get_formats, physical, surface, format_count, formats)
    selected_format := vulkan_capture_format_index(formats, formats_len)
    if selected_format < 0:
        ptr::free(capabilities)
        ptr::free(format_count)
        ptr::free(formats)
        ret 0
    image_format := ptr::load_u32(formats + ((selected_format * 8) as u64))
    color_space := ptr::load_u32(formats + ((selected_format * 8) as u64) + 4)
    if image_format == 0:
        image_format = 44
        color_space = 0

    width := ptr::load_u32(capabilities + 8)
    height := ptr::load_u32(capabilities + 12)
    window_width := ptr::alloc(4) as u64
    window_height := ptr::alloc(4) as u64
    if width == 4294967295:
        window_size(window_state, window_width, window_height)
        width = ptr::load_u32(window_width)
        height = ptr::load_u32(window_height)
    if width == 0:
        width = 64
    if height == 0:
        height = 48

    pre_transform := ptr::load_u32(capabilities + 40)
    if pre_transform == 0:
        pre_transform = 1
    info := ptr::alloc(104) as u64
    ptr::store_u32(info, 1000001000)
    ptr::store_u64(info + 24, surface)
    ptr::store_u32(info + 32, image_count)
    ptr::store_u32(info + 36, image_format)
    ptr::store_u32(info + 40, color_space)
    ptr::store_u32(info + 44, width)
    ptr::store_u32(info + 48, height)
    ptr::store_u32(info + 52, 1)
    ptr::store_u32(info + 56, 16)
    ptr::store_u32(info + 60, 0)
    ptr::store_u32(info + 64, 0)
    ptr::store_u32(info + 80, pre_transform)
    ptr::store_u32(info + 84, 1)
    ptr::store_u32(info + 88, 2)
    ptr::store_u32(info + 92, 1)
    ptr::store_u64(info + 96, 0)
    create := bind_vk("vkCreateSwapchainKHR")
    create_result := ffi::call4(create, device, info, 0, out_swapchain)
    ptr::free(capabilities)
    ptr::free(format_count)
    ptr::free(formats)
    ptr::free(window_width)
    ptr::free(window_height)
    ptr::free(info)
    if create_result != 0:
        ret 0

    swapchain := ptr::load_u64(out_swapchain)
    image_count_out := ptr::alloc(4) as u64
    get_images := bind_vk("vkGetSwapchainImagesKHR")
    ffi::call4(get_images, device, swapchain, image_count_out, 0)
    images_len := ptr::load_u32(image_count_out)
    if images_len <= 0:
        ptr::free(image_count_out)
        ret 0
    images := ptr::alloc(images_len * 8) as u64
    ffi::call4(get_images, device, swapchain, image_count_out, images)
    ptr::store_u32(out_format, image_format)
    ptr::store_u32(out_width, width)
    ptr::store_u32(out_height, height)
    ptr::store_u64(out_images, images)
    ptr::store_u32(out_image_count, images_len)
    ptr::free(image_count_out)
    ret 1

vulkan_swapchain_destroy <- (device: i64, swapchain: i64) -> nil:
    destroy := bind_vk("vkDestroySwapchainKHR")
    ffi::call3(destroy, device, swapchain, 0)

# Minimal submission used to validate command-pool/queue family agreement.
vulkan_submit_empty <- (device: i64, queue: i64, queue_family: i64) -> i64:
    pool_info := ptr::alloc(24) as u64
    ptr::store_u32(pool_info, 39)
    ptr::store_u32(pool_info + 20, queue_family)
    pool_out := ptr::alloc(8) as u64
    create_pool := bind_vk("vkCreateCommandPool")
    ffi::call4(create_pool, device, pool_info, 0, pool_out)
    pool := ptr::load_u64(pool_out)
    allocate_info := ptr::alloc(32) as u64
    ptr::store_u32(allocate_info, 40)
    ptr::store_u64(allocate_info + 16, pool)
    ptr::store_u32(allocate_info + 24, 0)
    ptr::store_u32(allocate_info + 28, 1)
    command_out := ptr::alloc(8) as u64
    allocate_command := bind_vk("vkAllocateCommandBuffers")
    ffi::call3(allocate_command, device, allocate_info, command_out)
    command := ptr::load_u64(command_out)
    begin_info := ptr::alloc(32) as u64
    ptr::store_u32(begin_info, 42)
    begin_command := bind_vk("vkBeginCommandBuffer")
    ffi::call2(begin_command, command, begin_info)
    end_command := bind_vk("vkEndCommandBuffer")
    ffi::call1(end_command, command)
    command_buffers := ptr::alloc(8) as u64
    ptr::store_u64(command_buffers, command)
    submit_info := ptr::alloc(72) as u64
    ptr::store_u32(submit_info, 4)
    ptr::store_u32(submit_info + 40, 1)
    ptr::store_u64(submit_info + 48, command_buffers)
    queue_submit := bind_vk("vkQueueSubmit")
    submit_result := ffi::call4(queue_submit, queue, 1, submit_info, 0)
    queue_wait := bind_vk("vkQueueWaitIdle")
    ffi::call1(queue_wait, queue)
    destroy_pool := bind_vk("vkDestroyCommandPool")
    ffi::call3(destroy_pool, device, pool, 0)
    ptr::free(pool_info)
    ptr::free(pool_out)
    ptr::free(allocate_info)
    ptr::free(command_out)
    ptr::free(begin_info)
    ptr::free(command_buffers)
    ptr::free(submit_info)
    if submit_result != 0:
        ret 0
    ret 1

transition_image <- (command_buffer: i64, image: i64, old_layout: i64, new_layout: i64, src_access: i64, dst_access: i64, src_stage: i64, dst_stage: i64) -> nil:
    barrier := ptr::alloc(128) as u64
    ptr::store_u32(barrier, 45)
    ptr::store_u32(barrier + 16, src_access)
    ptr::store_u32(barrier + 20, dst_access)
    ptr::store_u32(barrier + 24, old_layout)
    ptr::store_u32(barrier + 28, new_layout)
    ptr::store_u32(barrier + 32, 4294967295)
    ptr::store_u32(barrier + 36, 4294967295)
    ptr::store_u64(barrier + 40, image)
    ptr::store_u32(barrier + 48, 1)
    ptr::store_u32(barrier + 52, 0)
    ptr::store_u32(barrier + 56, 1)
    ptr::store_u32(barrier + 60, 0)
    ptr::store_u32(barrier + 64, 1)
    pipeline_barrier := bind_vk("vkCmdPipelineBarrier")
    ffi::call10(pipeline_barrier, command_buffer, src_stage, dst_stage, 0, 0, 0, 0, 0, 1, barrier)
    ptr::free(barrier)

# Present the swapchain image acquired by a captured frame.  The render submit
# already waited on its fence, so the image is in PRESENT_SRC_OPTIMAL and needs
# no wait semaphore.  Returns 1 on success and 0 when presentation failed.
vulkan_present_image <- (queue: i64, swapchain: i64, image_index: i64) -> i64:
    swapchains := ptr::alloc(8) as u64
    ptr::store_u64(swapchains, swapchain)
    image_indices := ptr::alloc(4) as u64
    ptr::store_u32(image_indices, image_index)
    present_info := ptr::alloc(64) as u64
    ptr::store_u32(present_info, 1000001001)
    ptr::store_u32(present_info + 32, 1)
    ptr::store_u64(present_info + 40, swapchains)
    ptr::store_u64(present_info + 48, image_indices)
    present := bind_vk("vkQueuePresentKHR")
    present_result := ffi::call2(present, queue, present_info)
    ptr::free(swapchains)
    ptr::free(image_indices)
    ptr::free(present_info)
    if present_result != 0:
        ret 0
    ret 1

vulkan_present_clear <- (device: i64, queue: i64, queue_family: i64, swapchain: i64, out_image_index: u64) -> i64:
    semaphore_info := ptr::alloc(24) as u64
    ptr::store_u32(semaphore_info, 9)
    image_semaphore_out := ptr::alloc(8) as u64
    render_semaphore_out := ptr::alloc(8) as u64
    create_semaphore := bind_vk("vkCreateSemaphore")
    ffi::call4(create_semaphore, device, semaphore_info, 0, image_semaphore_out)
    ffi::call4(create_semaphore, device, semaphore_info, 0, render_semaphore_out)
    image_semaphore := ptr::load_u64(image_semaphore_out)
    render_semaphore := ptr::load_u64(render_semaphore_out)
    fence_info := ptr::alloc(24) as u64
    ptr::store_u32(fence_info, 8)
    fence_out := ptr::alloc(8) as u64
    create_fence := bind_vk("vkCreateFence")
    ffi::call4(create_fence, device, fence_info, 0, fence_out)
    fence := ptr::load_u64(fence_out)

    image_index_out := ptr::alloc(4) as u64
    ptr::store_u32(image_index_out, 0)
    acquire := bind_vk("vkAcquireNextImageKHR")
    acquire_result := ffi::call6(acquire, device, swapchain, -1, image_semaphore, 0, image_index_out)
    image_index := ptr::load_u32(image_index_out)

    pool_info := ptr::alloc(24) as u64
    ptr::store_u32(pool_info, 39)
    ptr::store_u32(pool_info + 20, queue_family)
    pool_out := ptr::alloc(8) as u64
    create_pool := bind_vk("vkCreateCommandPool")
    ffi::call4(create_pool, device, pool_info, 0, pool_out)
    pool := ptr::load_u64(pool_out)
    allocate_info := ptr::alloc(32) as u64
    ptr::store_u32(allocate_info, 40)
    ptr::store_u64(allocate_info + 16, pool)
    ptr::store_u32(allocate_info + 24, 0)
    ptr::store_u32(allocate_info + 28, 1)
    command_out := ptr::alloc(8) as u64
    allocate_command := bind_vk("vkAllocateCommandBuffers")
    ffi::call3(allocate_command, device, allocate_info, command_out)
    command := ptr::load_u64(command_out)

    begin_info := ptr::alloc(32) as u64
    ptr::store_u32(begin_info, 42)
    begin_command := bind_vk("vkBeginCommandBuffer")
    ffi::call2(begin_command, command, begin_info)
    image_count_out := ptr::alloc(4) as u64
    get_images := bind_vk("vkGetSwapchainImagesKHR")
    ffi::call4(get_images, device, swapchain, image_count_out, 0)
    image_count := ptr::load_u32(image_count_out)
    images := ptr::alloc(image_count * 8) as u64
    ffi::call4(get_images, device, swapchain, image_count_out, images)
    image := ptr::load_u64(images + ((image_index * 8) as u64))
    transition_image(command, image, 0, 7, 0, 4096, 1, 4096)
    clear_color := ptr::alloc(16) as u64
    ptr::store_u32(clear_color, 1065353216)
    ptr::store_u32(clear_color + 4, 0)
    ptr::store_u32(clear_color + 8, 0)
    ptr::store_u32(clear_color + 12, 1065353216)
    clear_range := ptr::alloc(20) as u64
    ptr::store_u32(clear_range, 1)
    ptr::store_u32(clear_range + 4, 0)
    ptr::store_u32(clear_range + 8, 1)
    ptr::store_u32(clear_range + 12, 0)
    ptr::store_u32(clear_range + 16, 1)
    clear_image := bind_vk("vkCmdClearColorImage")
    ffi::call6(clear_image, command, image, 7, clear_color, 1, clear_range)
    transition_image(command, image, 7, 1000001002, 4096, 0, 4096, 8192)
    end_command := bind_vk("vkEndCommandBuffer")
    ffi::call1(end_command, command)

    wait_stage_out := ptr::alloc(4) as u64
    ptr::store_u32(wait_stage_out, 4096)
    wait_semaphores := ptr::alloc(8) as u64
    ptr::store_u64(wait_semaphores, image_semaphore)
    command_buffers := ptr::alloc(8) as u64
    ptr::store_u64(command_buffers, command)
    signal_semaphores := ptr::alloc(8) as u64
    ptr::store_u64(signal_semaphores, render_semaphore)
    submit_info := ptr::alloc(72) as u64
    ptr::store_u32(submit_info, 4)
    ptr::store_u32(submit_info + 16, 1)
    ptr::store_u64(submit_info + 24, wait_semaphores)
    ptr::store_u64(submit_info + 32, wait_stage_out)
    ptr::store_u32(submit_info + 40, 1)
    ptr::store_u64(submit_info + 48, command_buffers)
    ptr::store_u32(submit_info + 56, 1)
    ptr::store_u64(submit_info + 64, signal_semaphores)
    queue_submit := bind_vk("vkQueueSubmit")
    submit_result := ffi::call4(queue_submit, queue, 1, submit_info, fence)
    fence_array := ptr::alloc(8) as u64
    ptr::store_u64(fence_array, fence)
    wait_fences := bind_vk("vkWaitForFences")
    wait_result := ffi::call5(wait_fences, device, 1, fence_array, 1, 1000000000)
    if wait_result != 0:
        ret -30

    swapchains := ptr::alloc(8) as u64
    ptr::store_u64(swapchains, swapchain)
    present_wait := ptr::alloc(8) as u64
    ptr::store_u64(present_wait, render_semaphore)
    present_info := ptr::alloc(64) as u64
    ptr::store_u32(present_info, 1000001001)
    ptr::store_u32(present_info + 16, 1)
    ptr::store_u64(present_info + 24, present_wait)
    ptr::store_u32(present_info + 32, 1)
    ptr::store_u64(present_info + 40, swapchains)
    ptr::store_u64(present_info + 48, image_index_out)
    present := bind_vk("vkQueuePresentKHR")
    present_result := ffi::call2(present, queue, present_info)

    destroy_pool := bind_vk("vkDestroyCommandPool")
    ffi::call3(destroy_pool, device, pool, 0)
    destroy_fence := bind_vk("vkDestroyFence")
    ffi::call3(destroy_fence, device, fence, 0)
    destroy_semaphore := bind_vk("vkDestroySemaphore")
    ffi::call3(destroy_semaphore, device, image_semaphore, 0)
    ffi::call3(destroy_semaphore, device, render_semaphore, 0)
    ptr::store_u32(out_image_index, image_index)
    ptr::free(semaphore_info)
    ptr::free(image_semaphore_out)
    ptr::free(render_semaphore_out)
    ptr::free(fence_info)
    ptr::free(fence_out)
    ptr::free(image_index_out)
    ptr::free(pool_info)
    ptr::free(pool_out)
    ptr::free(allocate_info)
    ptr::free(command_out)
    ptr::free(begin_info)
    ptr::free(image_count_out)
    ptr::free(images)
    ptr::free(clear_color)
    ptr::free(clear_range)
    ptr::free(wait_stage_out)
    ptr::free(wait_semaphores)
    ptr::free(command_buffers)
    ptr::free(signal_semaphores)
    ptr::free(submit_info)
    ptr::free(fence_array)
    ptr::free(swapchains)
    ptr::free(present_wait)
    ptr::free(present_info)
    if acquire_result != 0 and acquire_result != 1000001003:
        ret 0
    if submit_result != 0:
        ret 0
    if present_result != 0:
        ret 0
    ret 1

# Choose a host-visible coherent memory type allowed by `type_bits`.
find_memory_type <- (physical: i64, type_bits: i64) -> i64:
    props := ptr::alloc(520) as u64
    get_props := bind_vk("vkGetPhysicalDeviceMemoryProperties")
    ffi::call2(get_props, physical, props)
    count := ptr::load_u32(props)
    if count > 0:
        flags := ptr::load_u32(props + 4)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if type_bits % 2 == 1:
                    ptr::free(props)
                    ret 0
    if count > 1:
        flags := ptr::load_u32(props + 12)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 2) % 2 == 1:
                    ptr::free(props)
                    ret 1
    if count > 2:
        flags := ptr::load_u32(props + 20)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 4) % 2 == 1:
                    ptr::free(props)
                    ret 2
    if count > 3:
        flags := ptr::load_u32(props + 28)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 8) % 2 == 1:
                    ptr::free(props)
                    ret 3
    if count > 4:
        flags := ptr::load_u32(props + 36)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 16) % 2 == 1:
                    ptr::free(props)
                    ret 4
    if count > 5:
        flags := ptr::load_u32(props + 44)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 32) % 2 == 1:
                    ptr::free(props)
                    ret 5
    if count > 6:
        flags := ptr::load_u32(props + 52)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 64) % 2 == 1:
                    ptr::free(props)
                    ret 6
    if count > 7:
        flags := ptr::load_u32(props + 60)
        if (flags / 2) % 2 == 1:
            if (flags / 4) % 2 == 1:
                if (type_bits / 128) % 2 == 1:
                    ptr::free(props)
                    ret 7
    ptr::free(props)
    ret -1

# Clear a swapchain image and read it back into an e7-owned BGRA/RGBA buffer.
vulkan_capture_clear <- (
    device: i64,
    queue: i64,
    queue_family: i64,
    physical: i64,
    swapchain: i64,
    width: i64,
    height: i64,
    out_pixels: u64,
    out_size: u64,
) -> i64:
    pixel_size := width * height * 4
    buffer_info := ptr::alloc(56) as u64
    ptr::store_u32(buffer_info, 12)
    ptr::store_u64(buffer_info + 24, pixel_size)
    ptr::store_u32(buffer_info + 32, 2)
    buffer_out := ptr::alloc(8) as u64
    create_buffer := bind_vk("vkCreateBuffer")
    ffi::call4(create_buffer, device, buffer_info, 0, buffer_out)
    buffer := ptr::load_u64(buffer_out)
    requirements := ptr::alloc(24) as u64
    get_requirements := bind_vk("vkGetBufferMemoryRequirements")
    ffi::call3(get_requirements, device, buffer, requirements)
    memory_size := ptr::load_u64(requirements)
    type_bits := ptr::load_u32(requirements + 16)
    memory_type := find_memory_type(physical, type_bits)
    alloc_info := ptr::alloc(32) as u64
    ptr::store_u32(alloc_info, 5)
    ptr::store_u64(alloc_info + 16, memory_size)
    ptr::store_u32(alloc_info + 24, memory_type)
    memory_out := ptr::alloc(8) as u64
    allocate_memory := bind_vk("vkAllocateMemory")
    ffi::call4(allocate_memory, device, alloc_info, 0, memory_out)
    memory := ptr::load_u64(memory_out)
    bind_buffer := bind_vk("vkBindBufferMemory")
    ffi::call4(bind_buffer, device, buffer, memory, 0)
    mapped_out := ptr::alloc(8) as u64
    map_memory := bind_vk("vkMapMemory")
    ffi::call6(map_memory, device, memory, 0, memory_size, 0, mapped_out)
    mapped := ptr::load_u64(mapped_out)

    semaphore_info := ptr::alloc(24) as u64
    ptr::store_u32(semaphore_info, 9)
    image_sem_out := ptr::alloc(8) as u64
    create_sem := bind_vk("vkCreateSemaphore")
    ffi::call4(create_sem, device, semaphore_info, 0, image_sem_out)
    image_sem := ptr::load_u64(image_sem_out)
    image_index_out := ptr::alloc(4) as u64
    acquire := bind_vk("vkAcquireNextImageKHR")
    acquire_result := ffi::call6(acquire, device, swapchain, -1, image_sem, 0, image_index_out)
    image_index := ptr::load_u32(image_index_out)

    pool_info := ptr::alloc(24) as u64
    ptr::store_u32(pool_info, 39)
    ptr::store_u32(pool_info + 20, queue_family)
    pool_out := ptr::alloc(8) as u64
    create_pool := bind_vk("vkCreateCommandPool")
    ffi::call4(create_pool, device, pool_info, 0, pool_out)
    pool := ptr::load_u64(pool_out)
    allocate_info := ptr::alloc(32) as u64
    ptr::store_u32(allocate_info, 40)
    ptr::store_u64(allocate_info + 16, pool)
    ptr::store_u32(allocate_info + 24, 0)
    ptr::store_u32(allocate_info + 28, 1)
    command_out := ptr::alloc(8) as u64
    allocate_command := bind_vk("vkAllocateCommandBuffers")
    ffi::call3(allocate_command, device, allocate_info, command_out)
    command := ptr::load_u64(command_out)
    begin_info := ptr::alloc(32) as u64
    ptr::store_u32(begin_info, 42)
    begin_command := bind_vk("vkBeginCommandBuffer")
    ffi::call2(begin_command, command, begin_info)
    image_count_out := ptr::alloc(4) as u64
    get_images := bind_vk("vkGetSwapchainImagesKHR")
    ffi::call4(get_images, device, swapchain, image_count_out, 0)
    image_count := ptr::load_u32(image_count_out)
    images := ptr::alloc(image_count * 8) as u64
    ffi::call4(get_images, device, swapchain, image_count_out, images)
    image := ptr::load_u64(images + ((image_index * 8) as u64))
    transition_image(command, image, 0, 7, 0, 4096, 1, 4096)
    clear_color := ptr::alloc(16) as u64
    ptr::store_u32(clear_color, 1065353216)
    ptr::store_u32(clear_color + 12, 1065353216)
    clear_range := ptr::alloc(20) as u64
    ptr::store_u32(clear_range, 1)
    ptr::store_u32(clear_range + 8, 1)
    ptr::store_u32(clear_range + 16, 1)
    clear_image := bind_vk("vkCmdClearColorImage")
    ffi::call6(clear_image, command, image, 7, clear_color, 1, clear_range)
    transition_image(command, image, 7, 6, 4096, 2048, 4096, 4096)
    # VkBufferImageCopy: aspectMask@16, mipLevel@20, baseArrayLayer@24,
    # layerCount@28.  layerCount must be 1 (the earlier offset selected
    # baseArrayLayer=1/layerCount=0, which made the copy a no-op).
    region := ptr::alloc(56) as u64
    ptr::store_u32(region + 16, 1)
    ptr::store_u32(region + 28, 1)
    ptr::store_u32(region + 44, width)
    ptr::store_u32(region + 48, height)
    ptr::store_u32(region + 52, 1)
    copy_image := bind_vk("vkCmdCopyImageToBuffer")
    ffi::call6(copy_image, command, image, 6, buffer, 1, region)
    transition_image(command, image, 6, 1000001002, 2048, 0, 4096, 8192)
    end_command := bind_vk("vkEndCommandBuffer")
    ffi::call1(end_command, command)

    wait_stage := ptr::alloc(4) as u64
    ptr::store_u32(wait_stage, 4096)
    wait_sem := ptr::alloc(8) as u64
    ptr::store_u64(wait_sem, image_sem)
    command_buffers := ptr::alloc(8) as u64
    ptr::store_u64(command_buffers, command)
    submit_info := ptr::alloc(72) as u64
    ptr::store_u32(submit_info, 4)
    ptr::store_u32(submit_info + 16, 1)
    ptr::store_u64(submit_info + 24, wait_sem)
    ptr::store_u64(submit_info + 32, wait_stage)
    ptr::store_u32(submit_info + 40, 1)
    ptr::store_u64(submit_info + 48, command_buffers)
    fence_info := ptr::alloc(24) as u64
    ptr::store_u32(fence_info, 8)
    fence_out := ptr::alloc(8) as u64
    create_fence := bind_vk("vkCreateFence")
    ffi::call4(create_fence, device, fence_info, 0, fence_out)
    fence := ptr::load_u64(fence_out)
    queue_submit := bind_vk("vkQueueSubmit")
    submit_result := ffi::call4(queue_submit, queue, 1, submit_info, fence)
    fence_array := ptr::alloc(8) as u64
    ptr::store_u64(fence_array, fence)
    wait_fences := bind_vk("vkWaitForFences")
    wait_result := ffi::call5(wait_fences, device, 1, fence_array, 1, 1000000000)
    if wait_result != 0:
        ret -30

    pixels := ptr::alloc(pixel_size) as u64
    ptr::copy(pixels, mapped, pixel_size)
    unmap := bind_vk("vkUnmapMemory")
    ffi::call2(unmap, device, memory)
    ptr::store_u64(out_pixels, pixels)
    ptr::store_u64(out_size, pixel_size)

    destroy_buffer := bind_vk("vkDestroyBuffer")
    ffi::call3(destroy_buffer, device, buffer, 0)
    free_memory := bind_vk("vkFreeMemory")
    ffi::call3(free_memory, device, memory, 0)
    destroy_pool := bind_vk("vkDestroyCommandPool")
    ffi::call3(destroy_pool, device, pool, 0)
    destroy_fence := bind_vk("vkDestroyFence")
    ffi::call3(destroy_fence, device, fence, 0)
    destroy_sem := bind_vk("vkDestroySemaphore")
    ffi::call3(destroy_sem, device, image_sem, 0)
    ptr::free(buffer_info)
    ptr::free(buffer_out)
    ptr::free(requirements)
    ptr::free(alloc_info)
    ptr::free(memory_out)
    ptr::free(mapped_out)
    ptr::free(semaphore_info)
    ptr::free(image_sem_out)
    ptr::free(image_index_out)
    ptr::free(pool_info)
    ptr::free(pool_out)
    ptr::free(allocate_info)
    ptr::free(command_out)
    ptr::free(begin_info)
    ptr::free(image_count_out)
    ptr::free(images)
    ptr::free(clear_color)
    ptr::free(clear_range)
    ptr::free(region)
    ptr::free(wait_stage)
    ptr::free(wait_sem)
    ptr::free(command_buffers)
    ptr::free(submit_info)
    ptr::free(fence_info)
    ptr::free(fence_out)
    ptr::free(fence_array)
    if acquire_result != 0 and acquire_result != 1000001003:
        ret -20
    if submit_result != 0:
        ret -21
    if memory_type < 0:
        ret -22
    ret 1

create_image_view <- (device: i64, image: i64, format: i64, out_view: u64) -> nil:
    info := ptr::alloc(80) as u64
    ptr::store_u32(info, 15)
    ptr::store_u64(info + 24, image)
    ptr::store_u32(info + 32, 1)
    ptr::store_u32(info + 36, format)
    ptr::store_u32(info + 56, 1)
    ptr::store_u32(info + 60, 0)
    ptr::store_u32(info + 64, 1)
    ptr::store_u32(info + 68, 0)
    ptr::store_u32(info + 72, 1)
    create := bind_vk("vkCreateImageView")
    ffi::call4(create, device, info, 0, out_view)
    ptr::free(info)

create_framebuffer <- (device: i64, render_pass: i64, view: i64, width: i64, height: i64, out_framebuffer: u64) -> nil:
    attachments := ptr::alloc(8) as u64
    ptr::store_u64(attachments, view)
    info := ptr::alloc(64) as u64
    ptr::store_u32(info, 37)
    ptr::store_u64(info + 24, render_pass)
    ptr::store_u32(info + 32, 1)
    ptr::store_u64(info + 40, attachments)
    ptr::store_u32(info + 48, width)
    ptr::store_u32(info + 52, height)
    ptr::store_u32(info + 56, 1)
    create := bind_vk("vkCreateFramebuffer")
    ffi::call4(create, device, info, 0, out_framebuffer)
    ptr::free(attachments)
    ptr::free(info)

# Create a single-attachment render pass plus an image view and framebuffer for
# each swapchain image.  Returns 1 on success.
create_framebuffer_depth <- (device: i64, render_pass: i64, color_view: i64, depth_view: i64, width: i64, height: i64, out_framebuffer: u64) -> nil:
    if depth_view == 0:
        create_framebuffer(device, render_pass, color_view, width, height, out_framebuffer)
        ret
    attachments := ptr::alloc(16) as u64
    ptr::store_u64(attachments, color_view)
    ptr::store_u64(attachments + 8, depth_view)
    info := ptr::alloc(64) as u64
    ptr::store_u32(info, 37)
    ptr::store_u64(info + 24, render_pass)
    ptr::store_u32(info + 32, 2)
    ptr::store_u64(info + 40, attachments)
    ptr::store_u32(info + 48, width)
    ptr::store_u32(info + 52, height)
    ptr::store_u32(info + 56, 1)
    create := bind_vk("vkCreateFramebuffer")
    ffi::call4(create, device, info, 0, out_framebuffer)
    ptr::free(attachments)
    ptr::free(info)

vulkan_render_targets <- (
    device: i64,
    swapchain_images: i64,
    image_count: i64,
    format: i64,
    width: i64,
    height: i64,
    depth_view: i64,
    out_render_pass: u64,
    out_views: u64,
    out_framebuffers: u64,
) -> i64:
    attachment_count := 1
    if depth_view != 0:
        attachment_count = 2
    attachments := ptr::alloc(attachment_count * 36) as u64
    ptr::store_u32(attachments + 4, format)
    ptr::store_u32(attachments + 8, 1)
    ptr::store_u32(attachments + 12, 1)
    ptr::store_u32(attachments + 16, 0)
    ptr::store_u32(attachments + 28, 0)
    ptr::store_u32(attachments + 32, 1000001002)
    if depth_view != 0:
        ptr::store_u32(attachments + 40, 126)
        ptr::store_u32(attachments + 44, 1)
        ptr::store_u32(attachments + 48, 1)
        ptr::store_u32(attachments + 52, 1)
        ptr::store_u32(attachments + 64, 0)
        ptr::store_u32(attachments + 68, 3)
    reference := ptr::alloc(8) as u64
    ptr::store_u32(reference, 0)
    ptr::store_u32(reference + 4, 2)
    subpass := ptr::alloc(72) as u64
    ptr::store_u32(subpass + 4, 0)
    ptr::store_u32(subpass + 24, 1)
    ptr::store_u64(subpass + 32, reference)
    if depth_view != 0:
        depth_reference := ptr::alloc(8) as u64
        ptr::store_u32(depth_reference, 1)
        ptr::store_u32(depth_reference + 4, 3)
        ptr::store_u64(subpass + 48, depth_reference)
    render_pass_info := ptr::alloc(64) as u64
    ptr::store_u32(render_pass_info, 38)
    ptr::store_u32(render_pass_info + 20, attachment_count)
    ptr::store_u64(render_pass_info + 24, attachments)
    ptr::store_u32(render_pass_info + 32, 1)
    ptr::store_u64(render_pass_info + 40, subpass)
    create_render_pass := bind_vk("vkCreateRenderPass")
    ffi::call4(create_render_pass, device, render_pass_info, 0, out_render_pass)
    render_pass := ptr::load_u64(out_render_pass)

    views := ptr::alloc(image_count * 8) as u64
    framebuffers := ptr::alloc(image_count * 8) as u64
    if image_count > 0:
        image := ptr::load_u64(swapchain_images)
        view_out := ptr::alloc(8) as u64
        create_image_view(device, image, format, view_out)
        view := ptr::load_u64(view_out)
        ptr::store_u64(views, view)
        create_framebuffer_depth(device, render_pass, view, depth_view, width, height, framebuffers)
        ptr::free(view_out)
    if image_count > 1:
        image := ptr::load_u64(swapchain_images + 8)
        view_out := ptr::alloc(8) as u64
        create_image_view(device, image, format, view_out)
        view := ptr::load_u64(view_out)
        ptr::store_u64(views + 8, view)
        create_framebuffer_depth(device, render_pass, view, depth_view, width, height, framebuffers + 8)
        ptr::free(view_out)
    if image_count > 2:
        image := ptr::load_u64(swapchain_images + 16)
        view_out := ptr::alloc(8) as u64
        create_image_view(device, image, format, view_out)
        view := ptr::load_u64(view_out)
        ptr::store_u64(views + 16, view)
        create_framebuffer_depth(device, render_pass, view, depth_view, width, height, framebuffers + 16)
        ptr::free(view_out)
    if image_count > 3:
        image := ptr::load_u64(swapchain_images + 24)
        view_out := ptr::alloc(8) as u64
        create_image_view(device, image, format, view_out)
        view := ptr::load_u64(view_out)
        ptr::store_u64(views + 24, view)
        create_framebuffer_depth(device, render_pass, view, depth_view, width, height, framebuffers + 24)
        ptr::free(view_out)
    ptr::store_u64(out_views, views)
    ptr::store_u64(out_framebuffers, framebuffers)
    ptr::free(attachments)
    ptr::free(reference)
    ptr::free(subpass)
    ptr::free(render_pass_info)
    ret 1

# Create swapchain image views and framebuffers for an existing render pass.
# Used when recreating a swapchain on resize: the render pass and pipelines stay
# valid, so only views/framebuffers (and the depth attachment) are rebuilt.
vulkan_render_targets_views <- (
    device: i64,
    swapchain_images: i64,
    image_count: i64,
    format: i64,
    width: i64,
    height: i64,
    depth_view: i64,
    render_pass: i64,
    out_views: u64,
    out_framebuffers: u64,
) -> nil:
    views := ptr::alloc(image_count * 8) as u64
    framebuffers := ptr::alloc(image_count * 8) as u64
    if image_count > 0:
        image := ptr::load_u64(swapchain_images)
        view_out := ptr::alloc(8) as u64
        create_image_view(device, image, format, view_out)
        view := ptr::load_u64(view_out)
        ptr::store_u64(views, view)
        create_framebuffer_depth(device, render_pass, view, depth_view, width, height, framebuffers)
        ptr::free(view_out)
    if image_count > 1:
        image := ptr::load_u64(swapchain_images + 8)
        view_out := ptr::alloc(8) as u64
        create_image_view(device, image, format, view_out)
        view := ptr::load_u64(view_out)
        ptr::store_u64(views + 8, view)
        create_framebuffer_depth(device, render_pass, view, depth_view, width, height, framebuffers + 8)
        ptr::free(view_out)
    if image_count > 2:
        image := ptr::load_u64(swapchain_images + 16)
        view_out := ptr::alloc(8) as u64
        create_image_view(device, image, format, view_out)
        view := ptr::load_u64(view_out)
        ptr::store_u64(views + 16, view)
        create_framebuffer_depth(device, render_pass, view, depth_view, width, height, framebuffers + 16)
        ptr::free(view_out)
    if image_count > 3:
        image := ptr::load_u64(swapchain_images + 24)
        view_out := ptr::alloc(8) as u64
        create_image_view(device, image, format, view_out)
        view := ptr::load_u64(view_out)
        ptr::store_u64(views + 24, view)
        create_framebuffer_depth(device, render_pass, view, depth_view, width, height, framebuffers + 24)
        ptr::free(view_out)
    ptr::store_u64(out_views, views)
    ptr::store_u64(out_framebuffers, framebuffers)

# Destroy only the per-image views/framebuffers, keeping the render pass.
vulkan_render_targets_views_destroy <- (device: i64, views: i64, framebuffers: i64, image_count: i64) -> nil:
    destroy_framebuffer := bind_vk("vkDestroyFramebuffer")
    destroy_view := bind_vk("vkDestroyImageView")
    if image_count > 0:
        ffi::call3(destroy_framebuffer, device, ptr::load_u64(framebuffers), 0)
        ffi::call3(destroy_view, device, ptr::load_u64(views), 0)
    if image_count > 1:
        ffi::call3(destroy_framebuffer, device, ptr::load_u64(framebuffers + 8), 0)
        ffi::call3(destroy_view, device, ptr::load_u64(views + 8), 0)
    if image_count > 2:
        ffi::call3(destroy_framebuffer, device, ptr::load_u64(framebuffers + 16), 0)
        ffi::call3(destroy_view, device, ptr::load_u64(views + 16), 0)
    if image_count > 3:
        ffi::call3(destroy_framebuffer, device, ptr::load_u64(framebuffers + 24), 0)
        ffi::call3(destroy_view, device, ptr::load_u64(views + 24), 0)
    ptr::free(views)
    ptr::free(framebuffers)

vulkan_device_wait_idle <- (device: i64) -> nil:
    wait_idle := bind_vk("vkDeviceWaitIdle")
    ffi::call1(wait_idle, device)
    ret

vulkan_render_targets_destroy <- (device: i64, render_pass: i64, views: i64, framebuffers: i64, image_count: i64) -> nil:
    destroy_framebuffer := bind_vk("vkDestroyFramebuffer")
    destroy_view := bind_vk("vkDestroyImageView")
    if image_count > 0:
        ffi::call3(destroy_framebuffer, device, ptr::load_u64(framebuffers), 0)
        ffi::call3(destroy_view, device, ptr::load_u64(views), 0)
    if image_count > 1:
        ffi::call3(destroy_framebuffer, device, ptr::load_u64(framebuffers + 8), 0)
        ffi::call3(destroy_view, device, ptr::load_u64(views + 8), 0)
    if image_count > 2:
        ffi::call3(destroy_framebuffer, device, ptr::load_u64(framebuffers + 16), 0)
        ffi::call3(destroy_view, device, ptr::load_u64(views + 16), 0)
    if image_count > 3:
        ffi::call3(destroy_framebuffer, device, ptr::load_u64(framebuffers + 24), 0)
        ffi::call3(destroy_view, device, ptr::load_u64(views + 24), 0)
    destroy_render_pass := bind_vk("vkDestroyRenderPass")
    ffi::call3(destroy_render_pass, device, render_pass, 0)
    ptr::free(views)
    ptr::free(framebuffers)

vulkan_graphics_pipeline <- (
    device: i64,
    render_pass: i64,
    vert_spv: str,
    frag_spv: str,
    out_pipeline: u64,
    out_layout: u64,
) -> i64:
    vert_info := ptr::alloc(40) as u64
    ptr::store_u32(vert_info, 16)
    vert_bytes := str::data(vert_spv)
    ptr::store_u64(vert_info + 24, str::len(vert_spv))
    ptr::store_u64(vert_info + 32, vert_bytes)
    vert_module_out := ptr::alloc(8) as u64
    create_module := bind_vk("vkCreateShaderModule")
    ffi::call4(create_module, device, vert_info, 0, vert_module_out)
    vert_module := ptr::load_u64(vert_module_out)

    frag_info := ptr::alloc(40) as u64
    ptr::store_u32(frag_info, 16)
    ptr::store_u64(frag_info + 24, str::len(frag_spv))
    ptr::store_u64(frag_info + 32, str::data(frag_spv))
    frag_module_out := ptr::alloc(8) as u64
    ffi::call4(create_module, device, frag_info, 0, frag_module_out)
    frag_module := ptr::load_u64(frag_module_out)

    layout_info := ptr::alloc(48) as u64
    ptr::store_u32(layout_info, 30)
    create_layout := bind_vk("vkCreatePipelineLayout")
    ffi::call4(create_layout, device, layout_info, 0, out_layout)
    pipeline_layout := ptr::load_u64(out_layout)

    entry_name := str::cstr("main")
    stages := ptr::alloc(96) as u64
    ptr::store_u32(stages, 18)
    ptr::store_u32(stages + 20, 1)
    ptr::store_u64(stages + 24, vert_module)
    ptr::store_u64(stages + 32, entry_name)
    ptr::store_u32(stages + 48, 18)
    ptr::store_u32(stages + 48 + 20, 16)
    ptr::store_u64(stages + 48 + 24, frag_module)
    ptr::store_u64(stages + 48 + 32, entry_name)

    vertex_input := ptr::alloc(48) as u64
    ptr::store_u32(vertex_input, 19)
    input_assembly := ptr::alloc(32) as u64
    ptr::store_u32(input_assembly, 20)
    ptr::store_u32(input_assembly + 20, 3)
    viewport_state := ptr::alloc(48) as u64
    ptr::store_u32(viewport_state, 21)
    ptr::store_u32(viewport_state + 20, 1)
    ptr::store_u32(viewport_state + 32, 1)
    raster := ptr::alloc(64) as u64
    ptr::store_u32(raster, 23)
    ptr::store_u32(raster + 28, 0)
    ptr::store_u32(raster + 32, 0)
    ptr::store_u32(raster + 36, 0)
    ptr::store_u32(raster + 56, 1065353216)
    multisample := ptr::alloc(48) as u64
    ptr::store_u32(multisample, 24)
    ptr::store_u32(multisample + 20, 1)
    blend_attachment := ptr::alloc(32) as u64
    ptr::store_u32(blend_attachment + 28, 15)
    blend_state := ptr::alloc(56) as u64
    ptr::store_u32(blend_state, 26)
    ptr::store_u32(blend_state + 28, 1)
    ptr::store_u64(blend_state + 32, blend_attachment)
    dynamic_states := ptr::alloc(8) as u64
    ptr::store_u32(dynamic_states, 0)
    ptr::store_u32(dynamic_states + 4, 1)
    dynamic_state := ptr::alloc(32) as u64
    ptr::store_u32(dynamic_state, 27)
    ptr::store_u32(dynamic_state + 20, 2)
    ptr::store_u64(dynamic_state + 24, dynamic_states)

    pipeline_info := ptr::alloc(144) as u64
    ptr::store_u32(pipeline_info, 28)
    ptr::store_u32(pipeline_info + 20, 2)
    ptr::store_u64(pipeline_info + 24, stages)
    ptr::store_u64(pipeline_info + 32, vertex_input)
    ptr::store_u64(pipeline_info + 40, input_assembly)
    ptr::store_u64(pipeline_info + 56, viewport_state)
    ptr::store_u64(pipeline_info + 64, raster)
    ptr::store_u64(pipeline_info + 72, multisample)
    ptr::store_u64(pipeline_info + 88, blend_state)
    ptr::store_u64(pipeline_info + 96, dynamic_state)
    ptr::store_u64(pipeline_info + 104, pipeline_layout)
    ptr::store_u64(pipeline_info + 112, render_pass)
    create_pipeline := bind_vk("vkCreateGraphicsPipelines")
    result := ffi::call6(create_pipeline, device, 0, 1, pipeline_info, 0, out_pipeline)

    destroy_module := bind_vk("vkDestroyShaderModule")
    ffi::call3(destroy_module, device, vert_module, 0)
    ffi::call3(destroy_module, device, frag_module, 0)
    ptr::free(vert_info)
    ptr::free(vert_module_out)
    ptr::free(frag_info)
    ptr::free(frag_module_out)
    ptr::free(layout_info)
    ptr::free(entry_name)
    ptr::free(stages)
    ptr::free(vertex_input)
    ptr::free(input_assembly)
    ptr::free(viewport_state)
    ptr::free(raster)
    ptr::free(multisample)
    ptr::free(blend_attachment)
    ptr::free(blend_state)
    ptr::free(dynamic_states)
    ptr::free(dynamic_state)
    ptr::free(pipeline_info)
    if result != 0:
        ret 0
    ret 1

vulkan_graphics_pipeline_destroy <- (device: i64, pipeline: i64, layout: i64) -> nil:
    destroy_pipeline := bind_vk("vkDestroyPipeline")
    ffi::call3(destroy_pipeline, device, pipeline, 0)
    destroy_layout := bind_vk("vkDestroyPipelineLayout")
    ffi::call3(destroy_layout, device, layout, 0)

record_indexed_draw <- (command: i64, index_buffer: i64, index_count: i64, descriptor_set: i64, pipeline_layout: i64, dynamic_offset: i64, extra_objects: i64, descriptor_sets: u64, bind_descriptor: u64) -> nil:
    bind_index := bind_vk("vkCmdBindIndexBuffer")
    ffi::call4(bind_index, command, index_buffer, 0, 0)
    draw_indexed := bind_vk("vkCmdDrawIndexed")
    ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
    if extra_objects > 0:
        if descriptor_set != 0:
            offsets2 := ptr::alloc(4) as u64
            ptr::store_u32(offsets2, dynamic_offset + 320)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets2)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets2)
    if extra_objects > 1:
        if descriptor_set != 0:
            offsets3 := ptr::alloc(4) as u64
            ptr::store_u32(offsets3, dynamic_offset + 640)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets3)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets3)
    if extra_objects > 2:
        if descriptor_set != 0:
            offsets4 := ptr::alloc(4) as u64
            ptr::store_u32(offsets4, dynamic_offset + 960)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets4)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets4)
    if extra_objects > 3:
        if descriptor_set != 0:
            offsets5 := ptr::alloc(4) as u64
            ptr::store_u32(offsets5, dynamic_offset + 1280)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets5)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets5)
    if extra_objects > 4:
        if descriptor_set != 0:
            offsets6 := ptr::alloc(4) as u64
            ptr::store_u32(offsets6, dynamic_offset + 1600)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets6)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets6)
    if extra_objects > 5:
        if descriptor_set != 0:
            offsets7 := ptr::alloc(4) as u64
            ptr::store_u32(offsets7, dynamic_offset + 1920)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets7)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets7)
    if extra_objects > 6:
        if descriptor_set != 0:
            offsets8 := ptr::alloc(4) as u64
            ptr::store_u32(offsets8, dynamic_offset + 2240)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets8)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets8)
    if extra_objects > 6:
        if descriptor_set != 0:
            offsets8 := ptr::alloc(4) as u64
            ptr::store_u32(offsets8, dynamic_offset + 2560)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets8)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets8)
    if extra_objects > 7:
        if descriptor_set != 0:
            offsets9 := ptr::alloc(4) as u64
            ptr::store_u32(offsets9, dynamic_offset + 2880)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets9)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets9)
    if extra_objects > 8:
        if descriptor_set != 0:
            offsets10 := ptr::alloc(4) as u64
            ptr::store_u32(offsets10, dynamic_offset + 3200)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets10)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets10)
    if extra_objects > 9:
        if descriptor_set != 0:
            offsets11 := ptr::alloc(4) as u64
            ptr::store_u32(offsets11, dynamic_offset + 3520)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets11)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets11)
    if extra_objects > 10:
        if descriptor_set != 0:
            offsets12 := ptr::alloc(4) as u64
            ptr::store_u32(offsets12, dynamic_offset + 3840)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets12)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets12)
    if extra_objects > 11:
        if descriptor_set != 0:
            offsets13 := ptr::alloc(4) as u64
            ptr::store_u32(offsets13, dynamic_offset + 4160)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets13)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets13)
    if extra_objects > 12:
        if descriptor_set != 0:
            offsets14 := ptr::alloc(4) as u64
            ptr::store_u32(offsets14, dynamic_offset + 4480)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets14)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets14)
    if extra_objects > 13:
        if descriptor_set != 0:
            offsets15 := ptr::alloc(4) as u64
            ptr::store_u32(offsets15, dynamic_offset + 4800)
            ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, 1, offsets15)
            ffi::call6(draw_indexed, command, index_count, 1, 0, 0, 0)
            ptr::free(offsets15)
    ret

record_plain_draw <- (command: i64) -> nil:
    draw := bind_vk("vkCmdDraw")
    ffi::call5(draw, command, 3, 1, 0, 0)
    ret

# Record one captured frame.  The main draw (pipeline + shared vertex/index
# buffers + dynamic UBO descriptor set + texture set) is followed by an
# optional draw list of 80-byte entries; engine scene code uses the list for
# per-object materials and the screen-space UI quads.  The list entry layout is
# documented in scene.e7 next to `append_draw`.
vulkan_capture_frame <- (
    device: i64,
    queue: i64,
    queue_family: i64,
    physical: i64,
    swapchain: i64,
    render_pass: i64,
    pipeline: i64,
    framebuffers: i64,
    image_count: i64,
    width: i64,
    height: i64,
    vertex_buffer: i64,
    index_buffer: i64,
    index_count: i64,
    descriptor_set: i64,
    pipeline_layout: i64,
    dynamic_offset: i64,
    descriptor_dynamic: i64,
    texture_set: i64,
    has_depth: i64,
    extra_objects: i64,
    out_pixels: u64,
    out_size: u64,
    extra_draws: u64,
    extra_count: i64,
    present: i64,
) -> i64:
    pixel_size := width * height * 4
    buffer_info := ptr::alloc(56) as u64
    ptr::store_u32(buffer_info, 12)
    ptr::store_u64(buffer_info + 24, pixel_size)
    ptr::store_u32(buffer_info + 32, 2)
    buffer_out := ptr::alloc(8) as u64
    create_buffer := bind_vk("vkCreateBuffer")
    ffi::call4(create_buffer, device, buffer_info, 0, buffer_out)
    buffer := ptr::load_u64(buffer_out)
    requirements := ptr::alloc(24) as u64
    get_requirements := bind_vk("vkGetBufferMemoryRequirements")
    ffi::call3(get_requirements, device, buffer, requirements)
    memory_size := ptr::load_u64(requirements)
    memory_type := find_memory_type(physical, ptr::load_u32(requirements + 16))
    alloc_info := ptr::alloc(32) as u64
    ptr::store_u32(alloc_info, 5)
    ptr::store_u64(alloc_info + 16, memory_size)
    ptr::store_u32(alloc_info + 24, memory_type)
    memory_out := ptr::alloc(8) as u64
    allocate_memory := bind_vk("vkAllocateMemory")
    ffi::call4(allocate_memory, device, alloc_info, 0, memory_out)
    memory := ptr::load_u64(memory_out)
    bind_buffer := bind_vk("vkBindBufferMemory")
    ffi::call4(bind_buffer, device, buffer, memory, 0)
    mapped_out := ptr::alloc(8) as u64
    map_memory := bind_vk("vkMapMemory")
    ffi::call6(map_memory, device, memory, 0, memory_size, 0, mapped_out)
    mapped := ptr::load_u64(mapped_out)

    semaphore_info := ptr::alloc(24) as u64
    ptr::store_u32(semaphore_info, 9)
    sem_out := ptr::alloc(8) as u64
    create_sem := bind_vk("vkCreateSemaphore")
    ffi::call4(create_sem, device, semaphore_info, 0, sem_out)
    sem := ptr::load_u64(sem_out)
    index_out := ptr::alloc(4) as u64
    acquire := bind_vk("vkAcquireNextImageKHR")
    acquire_result := ffi::call6(acquire, device, swapchain, -1, sem, 0, index_out)
    image_index := ptr::load_u32(index_out)

    pool_info := ptr::alloc(24) as u64
    ptr::store_u32(pool_info, 39)
    ptr::store_u32(pool_info + 20, queue_family)
    pool_out := ptr::alloc(8) as u64
    create_pool := bind_vk("vkCreateCommandPool")
    ffi::call4(create_pool, device, pool_info, 0, pool_out)
    pool := ptr::load_u64(pool_out)
    allocate_info := ptr::alloc(32) as u64
    ptr::store_u32(allocate_info, 40)
    ptr::store_u64(allocate_info + 16, pool)
    ptr::store_u32(allocate_info + 24, 0)
    ptr::store_u32(allocate_info + 28, 1)
    command_out := ptr::alloc(8) as u64
    allocate_command := bind_vk("vkAllocateCommandBuffers")
    ffi::call3(allocate_command, device, allocate_info, command_out)
    command := ptr::load_u64(command_out)
    begin_info := ptr::alloc(32) as u64
    ptr::store_u32(begin_info, 42)
    begin_command := bind_vk("vkBeginCommandBuffer")
    ffi::call2(begin_command, command, begin_info)

    image_count_out := ptr::alloc(4) as u64
    get_images := bind_vk("vkGetSwapchainImagesKHR")
    ffi::call4(get_images, device, swapchain, image_count_out, 0)
    images := ptr::alloc(image_count * 8) as u64
    ffi::call4(get_images, device, swapchain, image_count_out, images)
    image := ptr::load_u64(images + ((image_index * 8) as u64))
    framebuffer := ptr::load_u64((framebuffers as u64) + ((image_index * 8) as u64))

    clear_values := ptr::alloc(32) as u64
    ptr::store_u32(clear_values + 12, 1065353216)
    if has_depth != 0:
        ptr::store_u32(clear_values + 16, 1065353216)
    render_area := ptr::alloc(16) as u64
    ptr::store_u32(render_area + 8, width)
    ptr::store_u32(render_area + 12, height)
    render_pass_begin := ptr::alloc(64) as u64
    ptr::store_u32(render_pass_begin, 43)
    ptr::store_u64(render_pass_begin + 16, render_pass)
    ptr::store_u64(render_pass_begin + 24, framebuffer)
    ptr::store_u32(render_pass_begin + 32, 0)
    ptr::store_u32(render_pass_begin + 36, 0)
    ptr::store_u32(render_pass_begin + 40, width)
    ptr::store_u32(render_pass_begin + 44, height)
    clear_count := 1
    if has_depth != 0:
        clear_count = 2
    ptr::store_u32(render_pass_begin + 48, clear_count)
    ptr::store_u64(render_pass_begin + 56, clear_values)
    begin_render_pass := bind_vk("vkCmdBeginRenderPass")
    ffi::call3(begin_render_pass, command, render_pass_begin, 0)
    bind_pipeline := bind_vk("vkCmdBindPipeline")
    ffi::call3(bind_pipeline, command, 0, pipeline)
    viewport := ptr::alloc(24) as u64
    ptr::store_f32(viewport, 0.0)
    ptr::store_f32(viewport + 4, 0.0)
    ptr::store_f32(viewport + 8, (width) as f32)
    ptr::store_f32(viewport + 12, (height) as f32)
    ptr::store_f32(viewport + 16, 0.0)
    ptr::store_f32(viewport + 20, 1.0)
    set_viewport := bind_vk("vkCmdSetViewport")
    ffi::call4(set_viewport, command, 0, 1, viewport)
    scissor := ptr::alloc(16) as u64
    ptr::store_u32(scissor + 8, width)
    ptr::store_u32(scissor + 12, height)
    set_scissor := bind_vk("vkCmdSetScissor")
    ffi::call4(set_scissor, command, 0, 1, scissor)
    vertex_buffers := ptr::alloc(8) as u64
    vertex_offsets := ptr::alloc(8) as u64
    if vertex_buffer != 0:
        ptr::store_u64(vertex_buffers, vertex_buffer)
        bind_vertex := bind_vk("vkCmdBindVertexBuffers")
        ffi::call5(bind_vertex, command, 0, 1, vertex_buffers, vertex_offsets)
    descriptor_sets := ptr::alloc(8) as u64
    bind_descriptor := bind_vk("vkCmdBindDescriptorSets")
    if descriptor_set != 0:
        ptr::store_u64(descriptor_sets, descriptor_set)
        dynamic_offsets := ptr::alloc(4) as u64
        ptr::store_u32(dynamic_offsets, dynamic_offset)
        dynamic_count := 0
        if descriptor_dynamic != 0:
            dynamic_count = 1
        ffi::call8(bind_descriptor, command, 0, pipeline_layout, 0, 1, descriptor_sets, dynamic_count, dynamic_offsets)
        ptr::free(dynamic_offsets)
    texture_sets := ptr::alloc(8) as u64
    if texture_set != 0:
        ptr::store_u64(texture_sets, texture_set)
        ffi::call8(bind_descriptor, command, 0, pipeline_layout, 1, 1, texture_sets, 0, 0)
    ptr::free(texture_sets)
    if index_buffer != 0:
        record_indexed_draw(command, index_buffer, index_count, descriptor_set, pipeline_layout, dynamic_offset, extra_objects, descriptor_sets, bind_descriptor)
    else:
        record_plain_draw(command)
    # Additional per-object UI/material draws recorded by scene.e7.  Each entry
    # carries its own pipeline, buffers, descriptor sets and dynamic UBO offset,
    # so one captured frame can mix the 3D pipelines with the blended UI pass.
    if extra_count > 0:
        extra_sets := ptr::alloc(8) as u64
        extra_offsets := ptr::alloc(4) as u64
        draw_plain := bind_vk("vkCmdDraw")
        bind_vertex := bind_vk("vkCmdBindVertexBuffers")
        extra := 0
        while extra < extra_count:
            entry := extra_draws + ((extra * 80) as u64)
            entry_pipeline := ptr::load_u64(entry)
            entry_layout := ptr::load_u64(entry + 8)
            entry_vertex_buffer := ptr::load_u64(entry + 16)
            entry_index_buffer := ptr::load_u64(entry + 24)
            entry_index_count := ptr::load_u32(entry + 32)
            entry_index_type := ptr::load_u32(entry + 36)
            entry_first := ptr::load_u32(entry + 40)
            entry_kind := ptr::load_u32(entry + 44)
            entry_set0 := ptr::load_u64(entry + 48)
            entry_set0_dynamic := ptr::load_u32(entry + 56)
            entry_dynamic_offset := ptr::load_u32(entry + 60)
            entry_set1 := ptr::load_u64(entry + 64)
            ffi::call3(bind_pipeline, command, 0, entry_pipeline)
            if entry_vertex_buffer != 0:
                ptr::store_u64(vertex_buffers, entry_vertex_buffer)
                ptr::store_u64(vertex_offsets, 0)
                ffi::call5(bind_vertex, command, 0, 1, vertex_buffers, vertex_offsets)
            if entry_kind == 0:
                bind_index := bind_vk("vkCmdBindIndexBuffer")
                ffi::call4(bind_index, command, entry_index_buffer, 0, entry_index_type)
            if entry_set0 != 0:
                ptr::store_u64(extra_sets, entry_set0)
                if entry_set0_dynamic != 0:
                    ptr::store_u32(extra_offsets, entry_dynamic_offset)
                    ffi::call8(bind_descriptor, command, 0, entry_layout, 0, 1, extra_sets, 1, extra_offsets)
                else:
                    ffi::call8(bind_descriptor, command, 0, entry_layout, 0, 1, extra_sets, 0, 0)
            if entry_set1 != 0:
                ptr::store_u64(extra_sets, entry_set1)
                ffi::call8(bind_descriptor, command, 0, entry_layout, 1, 1, extra_sets, 0, 0)
            if entry_kind == 0:
                draw_indexed := bind_vk("vkCmdDrawIndexed")
                ffi::call6(draw_indexed, command, entry_index_count, 1, entry_first, 0, 0)
            else:
                ffi::call5(draw_plain, command, entry_index_count, 1, entry_first, 0)
            extra = extra + 1
        ptr::free(extra_sets)
        ptr::free(extra_offsets)
    end_render_pass := bind_vk("vkCmdEndRenderPass")
    ffi::call1(end_render_pass, command)
    transition_image(command, image, 1000001002, 6, 0, 2048, 8192, 4096)
    # VkBufferImageCopy: aspectMask@16, mipLevel@20, baseArrayLayer@24,
    # layerCount@28.  layerCount must be 1 (the earlier offset selected
    # baseArrayLayer=1/layerCount=0, which made the copy a no-op).
    region := ptr::alloc(56) as u64
    ptr::store_u32(region + 16, 1)
    ptr::store_u32(region + 28, 1)
    ptr::store_u32(region + 44, width)
    ptr::store_u32(region + 48, height)
    ptr::store_u32(region + 52, 1)
    copy_image := bind_vk("vkCmdCopyImageToBuffer")
    ffi::call6(copy_image, command, image, 6, buffer, 1, region)
    transition_image(command, image, 6, 1000001002, 2048, 0, 4096, 8192)
    end_command := bind_vk("vkEndCommandBuffer")
    ffi::call1(end_command, command)

    wait_stage := ptr::alloc(4) as u64
    ptr::store_u32(wait_stage, 1024)
    wait_sem := ptr::alloc(8) as u64
    ptr::store_u64(wait_sem, sem)
    command_buffers := ptr::alloc(8) as u64
    ptr::store_u64(command_buffers, command)
    submit_info := ptr::alloc(72) as u64
    ptr::store_u32(submit_info, 4)
    ptr::store_u32(submit_info + 16, 1)
    ptr::store_u64(submit_info + 24, wait_sem)
    ptr::store_u64(submit_info + 32, wait_stage)
    ptr::store_u32(submit_info + 40, 1)
    ptr::store_u64(submit_info + 48, command_buffers)
    fence_info := ptr::alloc(24) as u64
    ptr::store_u32(fence_info, 8)
    fence_out := ptr::alloc(8) as u64
    create_fence := bind_vk("vkCreateFence")
    ffi::call4(create_fence, device, fence_info, 0, fence_out)
    fence := ptr::load_u64(fence_out)
    queue_submit := bind_vk("vkQueueSubmit")
    submit_result := ffi::call4(queue_submit, queue, 1, submit_info, fence)
    fence_array := ptr::alloc(8) as u64
    ptr::store_u64(fence_array, fence)
    wait_fences := bind_vk("vkWaitForFences")
    wait_result := ffi::call5(wait_fences, device, 1, fence_array, 1, 1000000000)
    if wait_result != 0:
        ret -30

    mapped_range := ptr::alloc(40) as u64
    ptr::store_u32(mapped_range, 6)
    ptr::store_u64(mapped_range + 16, memory)
    ptr::store_u64(mapped_range + 24, 0)
    ptr::store_u64(mapped_range + 32, -1)
    ffi::call3(bind_vk("vkInvalidateMappedMemoryRanges"), device, 1, mapped_range)
    ptr::free(mapped_range)
    pixels := ptr::alloc(pixel_size) as u64
    ptr::copy(pixels, mapped, pixel_size)
    unmap := bind_vk("vkUnmapMemory")
    ffi::call2(unmap, device, memory)
    ptr::store_u64(out_pixels, pixels)
    ptr::store_u64(out_size, pixel_size)
    presented := 1
    if present != 0:
        presented = vulkan_present_image(queue, swapchain, image_index)

    destroy_buffer := bind_vk("vkDestroyBuffer")
    ffi::call3(destroy_buffer, device, buffer, 0)
    free_memory := bind_vk("vkFreeMemory")
    ffi::call3(free_memory, device, memory, 0)
    destroy_pool := bind_vk("vkDestroyCommandPool")
    ffi::call3(destroy_pool, device, pool, 0)
    destroy_fence := bind_vk("vkDestroyFence")
    ffi::call3(destroy_fence, device, fence, 0)
    destroy_sem := bind_vk("vkDestroySemaphore")
    ffi::call3(destroy_sem, device, sem, 0)
    ptr::free(buffer_info)
    ptr::free(buffer_out)
    ptr::free(requirements)
    ptr::free(alloc_info)
    ptr::free(memory_out)
    ptr::free(mapped_out)
    ptr::free(semaphore_info)
    ptr::free(sem_out)
    ptr::free(index_out)
    ptr::free(pool_info)
    ptr::free(pool_out)
    ptr::free(allocate_info)
    ptr::free(command_out)
    ptr::free(begin_info)
    ptr::free(image_count_out)
    ptr::free(images)
    ptr::free(clear_values)
    ptr::free(render_area)
    ptr::free(render_pass_begin)
    ptr::free(viewport)
    ptr::free(scissor)
    ptr::free(region)
    ptr::free(vertex_buffers)
    ptr::free(vertex_offsets)
    ptr::free(descriptor_sets)
    ptr::free(wait_stage)
    ptr::free(wait_sem)
    ptr::free(command_buffers)
    ptr::free(submit_info)
    ptr::free(fence_info)
    ptr::free(fence_out)
    ptr::free(fence_array)
    if acquire_result != 0 and acquire_result != 1000001003:
        ret -20
    if submit_result != 0:
        ret -21
    if memory_type < 0:
        ret -22
    if present != 0:
        if presented == 0:
            # Report the failure to the engine, which will skip capture for the
            # frame; release the readback buffer so the desktop path does not
            # leak when presentation fails (e.g. an out-of-date swapchain).
            ptr::free(ptr::load_u64(out_pixels))
            ptr::store_u64(out_pixels, 0)
            ptr::store_u64(out_size, 0)
            ret -40
    ret 1

# Legacy single-pipeline capture entry point kept for the runtime e7 tests and
# the older scene draw variants: no additional draw list.
vulkan_draw_triangle_capture <- (
    device: i64,
    queue: i64,
    queue_family: i64,
    physical: i64,
    swapchain: i64,
    render_pass: i64,
    pipeline: i64,
    framebuffers: i64,
    image_count: i64,
    width: i64,
    height: i64,
    vertex_buffer: i64,
    index_buffer: i64,
    index_count: i64,
    descriptor_set: i64,
    pipeline_layout: i64,
    dynamic_offset: i64,
    descriptor_dynamic: i64,
    texture_set: i64,
    has_depth: i64,
    extra_objects: i64,
    out_pixels: u64,
    out_size: u64,
) -> i64:
    ret vulkan_capture_frame(
        device,
        queue,
        queue_family,
        physical,
        swapchain,
        render_pass,
        pipeline,
        framebuffers,
        image_count,
        width,
        height,
        vertex_buffer,
        index_buffer,
        index_count,
        descriptor_set,
        pipeline_layout,
        dynamic_offset,
        descriptor_dynamic,
        texture_set,
        has_depth,
        extra_objects,
        out_pixels,
        out_size,
        0,
        0,
        0,
    )

# Create a host-visible uniform buffer and a one-binding descriptor set.  The
# engine shaders use this for the per-frame SceneUniform block.
vulkan_uniform_resources <- (
    device: i64,
    physical: i64,
    slot_count: i64,
    out_set_layout: u64,
    out_pool: u64,
    out_set: u64,
    out_buffer: u64,
    out_memory: u64,
    out_mapped: u64,
    out_size: u64,
) -> i64:
    uniform_size := slot_count * 320
    buffer_info := ptr::alloc(56) as u64
    ptr::store_u32(buffer_info, 12)
    ptr::store_u64(buffer_info + 24, uniform_size)
    ptr::store_u32(buffer_info + 32, 64)
    buffer_out := ptr::alloc(8) as u64
    create_buffer := bind_vk("vkCreateBuffer")
    ffi::call4(create_buffer, device, buffer_info, 0, buffer_out)
    buffer := ptr::load_u64(buffer_out)
    requirements := ptr::alloc(24) as u64
    get_requirements := bind_vk("vkGetBufferMemoryRequirements")
    ffi::call3(get_requirements, device, buffer, requirements)
    memory_size := ptr::load_u64(requirements)
    memory_type := find_memory_type(physical, ptr::load_u32(requirements + 16))
    if memory_type < 0:
        ptr::free(buffer_info)
        ptr::free(buffer_out)
        ptr::free(requirements)
        ret 0
    alloc_info := ptr::alloc(32) as u64
    ptr::store_u32(alloc_info, 5)
    ptr::store_u64(alloc_info + 16, memory_size)
    ptr::store_u32(alloc_info + 24, memory_type)
    memory_out := ptr::alloc(8) as u64
    allocate_memory := bind_vk("vkAllocateMemory")
    ffi::call4(allocate_memory, device, alloc_info, 0, memory_out)
    memory := ptr::load_u64(memory_out)
    bind_buffer := bind_vk("vkBindBufferMemory")
    ffi::call4(bind_buffer, device, buffer, memory, 0)
    mapped_out := ptr::alloc(8) as u64
    map_memory := bind_vk("vkMapMemory")
    ffi::call6(map_memory, device, memory, 0, memory_size, 0, mapped_out)
    mapped := ptr::load_u64(mapped_out)

    binding := ptr::alloc(24) as u64
    ptr::store_u32(binding, 0)
    ptr::store_u32(binding + 4, 8)
    ptr::store_u32(binding + 8, 1)
    # VERTEX | FRAGMENT: the lit fragment stage also reads the Scene block.
    ptr::store_u32(binding + 12, 17)
    layout_info := ptr::alloc(32) as u64
    ptr::store_u32(layout_info, 32)
    ptr::store_u32(layout_info + 20, 1)
    ptr::store_u64(layout_info + 24, binding)
    create_layout := bind_vk("vkCreateDescriptorSetLayout")
    ffi::call4(create_layout, device, layout_info, 0, out_set_layout)
    set_layout := ptr::load_u64(out_set_layout)

    pool_size := ptr::alloc(8) as u64
    ptr::store_u32(pool_size, 8)
    ptr::store_u32(pool_size + 4, 1)
    pool_info := ptr::alloc(40) as u64
    ptr::store_u32(pool_info, 33)
    ptr::store_u32(pool_info + 20, 1)
    ptr::store_u32(pool_info + 24, 1)
    ptr::store_u64(pool_info + 32, pool_size)
    create_pool := bind_vk("vkCreateDescriptorPool")
    ffi::call4(create_pool, device, pool_info, 0, out_pool)
    pool := ptr::load_u64(out_pool)

    layouts := ptr::alloc(8) as u64
    ptr::store_u64(layouts, set_layout)
    allocate_info := ptr::alloc(40) as u64
    ptr::store_u32(allocate_info, 34)
    ptr::store_u64(allocate_info + 16, pool)
    ptr::store_u32(allocate_info + 24, 1)
    ptr::store_u64(allocate_info + 32, layouts)
    allocate_set := bind_vk("vkAllocateDescriptorSets")
    ffi::call3(allocate_set, device, allocate_info, out_set)
    descriptor_set := ptr::load_u64(out_set)

    descriptor_buffer := ptr::alloc(24) as u64
    ptr::store_u64(descriptor_buffer, buffer)
    ptr::store_u64(descriptor_buffer + 8, 0)
    ptr::store_u64(descriptor_buffer + 16, 320)
    write := ptr::alloc(64) as u64
    ptr::store_u32(write, 35)
    ptr::store_u64(write + 16, descriptor_set)
    ptr::store_u32(write + 24, 0)
    ptr::store_u32(write + 32, 1)
    ptr::store_u32(write + 36, 8)
    ptr::store_u64(write + 48, descriptor_buffer)
    update_sets := bind_vk("vkUpdateDescriptorSets")
    ffi::call5(update_sets, device, 1, write, 0, 0)
    ptr::store_u64(out_buffer, buffer)
    ptr::store_u64(out_memory, memory)
    ptr::store_u64(out_mapped, mapped)
    ptr::store_u64(out_size, uniform_size)

    ptr::free(buffer_info)
    ptr::free(buffer_out)
    ptr::free(requirements)
    ptr::free(alloc_info)
    ptr::free(memory_out)
    ptr::free(mapped_out)
    ptr::free(binding)
    ptr::free(layout_info)
    ptr::free(pool_size)
    ptr::free(pool_info)
    ptr::free(layouts)
    ptr::free(allocate_info)
    ptr::free(descriptor_buffer)
    ptr::free(write)
    ret 1

vulkan_uniform_resources_destroy <- (device: i64, set_layout: i64, pool: i64, buffer: i64, memory: i64) -> nil:
    destroy_layout := bind_vk("vkDestroyDescriptorSetLayout")
    ffi::call3(destroy_layout, device, set_layout, 0)
    destroy_pool := bind_vk("vkDestroyDescriptorPool")
    ffi::call3(destroy_pool, device, pool, 0)
    destroy_buffer := bind_vk("vkDestroyBuffer")
    ffi::call3(destroy_buffer, device, buffer, 0)
    free_memory := bind_vk("vkFreeMemory")
    ffi::call3(free_memory, device, memory, 0)

vulkan_vertex_buffer <- (device: i64, physical: i64, out_buffer: u64, out_memory: u64, out_mapped: u64) -> i64:
    size := 72
    info := ptr::alloc(56) as u64
    ptr::store_u32(info, 12)
    ptr::store_u64(info + 24, size)
    ptr::store_u32(info + 32, 128)
    buffer_out := ptr::alloc(8) as u64
    create := bind_vk("vkCreateBuffer")
    ffi::call4(create, device, info, 0, buffer_out)
    buffer := ptr::load_u64(buffer_out)
    requirements := ptr::alloc(24) as u64
    get_requirements := bind_vk("vkGetBufferMemoryRequirements")
    ffi::call3(get_requirements, device, buffer, requirements)
    memory_size := ptr::load_u64(requirements)
    memory_type := find_memory_type(physical, ptr::load_u32(requirements + 16))
    alloc_info := ptr::alloc(32) as u64
    ptr::store_u32(alloc_info, 5)
    ptr::store_u64(alloc_info + 16, memory_size)
    ptr::store_u32(alloc_info + 24, memory_type)
    memory_out := ptr::alloc(8) as u64
    allocate_memory := bind_vk("vkAllocateMemory")
    ffi::call4(allocate_memory, device, alloc_info, 0, memory_out)
    memory := ptr::load_u64(memory_out)
    bind_buffer := bind_vk("vkBindBufferMemory")
    ffi::call4(bind_buffer, device, buffer, memory, 0)
    mapped_out := ptr::alloc(8) as u64
    map_memory := bind_vk("vkMapMemory")
    ffi::call6(map_memory, device, memory, 0, memory_size, 0, mapped_out)
    mapped := ptr::load_u64(mapped_out)
    ptr::store_f32(mapped, 0.0)
    ptr::store_f32(mapped + 4, -0.6)
    ptr::store_f32(mapped + 12, 0.0)
    ptr::store_f32(mapped + 16, 1.0)
    ptr::store_f32(mapped + 24, 0.6)
    ptr::store_f32(mapped + 28, 0.6)
    ptr::store_f32(mapped + 36, 0.0)
    ptr::store_f32(mapped + 40, 1.0)
    ptr::store_f32(mapped + 48, -0.6)
    ptr::store_f32(mapped + 52, 0.6)
    ptr::store_f32(mapped + 60, 0.0)
    ptr::store_f32(mapped + 64, 1.0)
    ptr::store_u64(out_buffer, buffer)
    ptr::store_u64(out_memory, memory)
    ptr::store_u64(out_mapped, mapped)
    ptr::free(info)
    ptr::free(buffer_out)
    ptr::free(requirements)
    ptr::free(alloc_info)
    ptr::free(memory_out)
    ptr::free(mapped_out)
    if memory_type < 0:
        ret 0
    ret 1

vulkan_vertex_buffer_destroy <- (device: i64, buffer: i64, memory: i64) -> nil:
    destroy_buffer := bind_vk("vkDestroyBuffer")
    ffi::call3(destroy_buffer, device, buffer, 0)
    free_memory := bind_vk("vkFreeMemory")
    ffi::call3(free_memory, device, memory, 0)

# Create a host-visible, host-coherent mapped buffer.  `usage` is the Vulkan
# VkBufferUsageFlagBits value (128 vertex, 64 index).
vulkan_dynamic_buffer <- (device: i64, physical: i64, byte_size: i64, usage: i64, out_buffer: u64, out_memory: u64, out_mapped: u64) -> i64:
    info := ptr::alloc(56) as u64
    ptr::store_u32(info, 12)
    ptr::store_u64(info + 24, byte_size)
    ptr::store_u32(info + 32, usage)
    buffer_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkCreateBuffer"), device, info, 0, buffer_out)
    buffer := ptr::load_u64(buffer_out)
    requirements := ptr::alloc(24) as u64
    ffi::call3(bind_vk("vkGetBufferMemoryRequirements"), device, buffer, requirements)
    memory_size := ptr::load_u64(requirements)
    memory_type := find_memory_type(physical, ptr::load_u32(requirements + 16))
    if memory_type < 0:
        ffi::call3(bind_vk("vkDestroyBuffer"), device, buffer, 0)
        ptr::free(info)
        ptr::free(buffer_out)
        ptr::free(requirements)
        ret 0
    alloc_info := ptr::alloc(32) as u64
    ptr::store_u32(alloc_info, 5)
    ptr::store_u64(alloc_info + 16, memory_size)
    ptr::store_u32(alloc_info + 24, memory_type)
    memory_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkAllocateMemory"), device, alloc_info, 0, memory_out)
    memory := ptr::load_u64(memory_out)
    ffi::call4(bind_vk("vkBindBufferMemory"), device, buffer, memory, 0)
    mapped_out := ptr::alloc(8) as u64
    ffi::call6(bind_vk("vkMapMemory"), device, memory, 0, memory_size, 0, mapped_out)
    ptr::store_u64(out_buffer, buffer)
    ptr::store_u64(out_memory, memory)
    ptr::store_u64(out_mapped, ptr::load_u64(mapped_out))
    ptr::free(info)
    ptr::free(buffer_out)
    ptr::free(requirements)
    ptr::free(alloc_info)
    ptr::free(memory_out)
    ptr::free(mapped_out)
    ret 1

vulkan_ubo_set_layout <- (device: i64, out_set_layout: u64) -> i64:
    binding := ptr::alloc(24) as u64
    ptr::store_u32(binding, 0)
    ptr::store_u32(binding + 4, 8)
    ptr::store_u32(binding + 8, 1)
    ptr::store_u32(binding + 12, 1)
    info := ptr::alloc(32) as u64
    ptr::store_u32(info, 32)
    ptr::store_u32(info + 20, 1)
    ptr::store_u64(info + 24, binding)
    create := bind_vk("vkCreateDescriptorSetLayout")
    ffi::call4(create, device, info, 0, out_set_layout)
    ptr::free(binding)
    ptr::free(info)
    if ptr::load_u64(out_set_layout) == 0:
        ret 0
    ret 1

vulkan_descriptor_set_layout_destroy <- (device: i64, layout: i64) -> nil:
    destroy := bind_vk("vkDestroyDescriptorSetLayout")
    ffi::call3(destroy, device, layout, 0)

vulkan_mesh_pipeline_simple <- (device: i64, render_pass: i64, vertex_shader: str, fragment_shader: str, set_layout: i64, out_pipeline: u64, out_layout: u64) -> i64:
    vert_info := ptr::alloc(40) as u64
    ptr::store_u32(vert_info, 16)
    ptr::store_u64(vert_info + 24, str::len(vertex_shader))
    ptr::store_u64(vert_info + 32, str::data(vertex_shader))
    vert_out := ptr::alloc(8) as u64
    create_module := bind_vk("vkCreateShaderModule")
    ffi::call4(create_module, device, vert_info, 0, vert_out)
    vert_module := ptr::load_u64(vert_out)
    frag_info := ptr::alloc(40) as u64
    ptr::store_u32(frag_info, 16)
    ptr::store_u64(frag_info + 24, str::len(fragment_shader))
    ptr::store_u64(frag_info + 32, str::data(fragment_shader))
    frag_out := ptr::alloc(8) as u64
    ffi::call4(create_module, device, frag_info, 0, frag_out)
    frag_module := ptr::load_u64(frag_out)
    if vert_module == 0 or frag_module == 0:
        ret 0
    layouts := ptr::alloc(8) as u64
    if set_layout != 0:
        ptr::store_u64(layouts, set_layout)
    layout_info := ptr::alloc(48) as u64
    ptr::store_u32(layout_info, 30)
    if set_layout != 0:
        ptr::store_u32(layout_info + 20, 1)
        ptr::store_u64(layout_info + 24, layouts)
    create_layout := bind_vk("vkCreatePipelineLayout")
    ffi::call4(create_layout, device, layout_info, 0, out_layout)
    pipeline_layout := ptr::load_u64(out_layout)
    if pipeline_layout == 0:
        ret 0
    entry := str::cstr("main")
    stages := ptr::alloc(96) as u64
    ptr::store_u32(stages, 18)
    ptr::store_u32(stages + 20, 1)
    ptr::store_u64(stages + 24, vert_module)
    ptr::store_u64(stages + 32, entry)
    ptr::store_u32(stages + 48, 18)
    ptr::store_u32(stages + 68, 16)
    ptr::store_u64(stages + 72, frag_module)
    ptr::store_u64(stages + 80, entry)
    binding := ptr::alloc(12) as u64
    ptr::store_u32(binding, 0)
    ptr::store_u32(binding + 4, 24)
    ptr::store_u32(binding + 8, 0)
    attributes := ptr::alloc(32) as u64
    ptr::store_u32(attributes, 0)
    ptr::store_u32(attributes + 4, 0)
    ptr::store_u32(attributes + 8, 106)
    ptr::store_u32(attributes + 12, 0)
    ptr::store_u32(attributes + 16, 1)
    ptr::store_u32(attributes + 20, 0)
    ptr::store_u32(attributes + 24, 106)
    ptr::store_u32(attributes + 28, 12)
    vertex_input := ptr::alloc(48) as u64
    ptr::store_u32(vertex_input, 19)
    ptr::store_u32(vertex_input + 20, 1)
    ptr::store_u64(vertex_input + 24, binding)
    ptr::store_u32(vertex_input + 32, 2)
    ptr::store_u64(vertex_input + 40, attributes)
    input_assembly := ptr::alloc(32) as u64
    ptr::store_u32(input_assembly, 20)
    ptr::store_u32(input_assembly + 20, 3)
    viewport_state := ptr::alloc(48) as u64
    ptr::store_u32(viewport_state, 21)
    ptr::store_u32(viewport_state + 20, 1)
    ptr::store_u32(viewport_state + 32, 1)
    raster := ptr::alloc(64) as u64
    ptr::store_u32(raster, 23)
    ptr::store_u32(raster + 56, 1065353216)
    multisample := ptr::alloc(48) as u64
    ptr::store_u32(multisample, 24)
    ptr::store_u32(multisample + 20, 1)
    blend_attachment := ptr::alloc(32) as u64
    ptr::store_u32(blend_attachment + 28, 15)
    blend_state := ptr::alloc(56) as u64
    ptr::store_u32(blend_state, 26)
    ptr::store_u32(blend_state + 28, 1)
    ptr::store_u64(blend_state + 32, blend_attachment)
    dynamic_states := ptr::alloc(8) as u64
    ptr::store_u32(dynamic_states, 0)
    ptr::store_u32(dynamic_states + 4, 1)
    dynamic_state := ptr::alloc(32) as u64
    ptr::store_u32(dynamic_state, 27)
    ptr::store_u32(dynamic_state + 20, 2)
    ptr::store_u64(dynamic_state + 24, dynamic_states)
    depth_state := ptr::alloc(104) as u64
    ptr::store_u32(depth_state, 25)
    ptr::store_u32(depth_state + 20, 1)
    ptr::store_u32(depth_state + 24, 1)
    ptr::store_u32(depth_state + 28, 3)
    pipeline_info := ptr::alloc(144) as u64
    ptr::store_u32(pipeline_info, 28)
    ptr::store_u32(pipeline_info + 20, 2)
    ptr::store_u64(pipeline_info + 24, stages)
    ptr::store_u64(pipeline_info + 32, vertex_input)
    ptr::store_u64(pipeline_info + 40, input_assembly)
    ptr::store_u64(pipeline_info + 56, viewport_state)
    ptr::store_u64(pipeline_info + 64, raster)
    ptr::store_u64(pipeline_info + 72, multisample)
    ptr::store_u64(pipeline_info + 80, depth_state)
    ptr::store_u64(pipeline_info + 88, blend_state)
    ptr::store_u64(pipeline_info + 96, dynamic_state)
    ptr::store_u64(pipeline_info + 104, pipeline_layout)
    ptr::store_u64(pipeline_info + 112, render_pass)
    create_pipeline := bind_vk("vkCreateGraphicsPipelines")
    result := ffi::call6(create_pipeline, device, 0, 1, pipeline_info, 0, out_pipeline)
    destroy_module := bind_vk("vkDestroyShaderModule")
    ffi::call3(destroy_module, device, vert_module, 0)
    ffi::call3(destroy_module, device, frag_module, 0)
    ptr::free(vert_info)
    ptr::free(vert_out)
    ptr::free(frag_info)
    ptr::free(frag_out)
    ptr::free(layouts)
    ptr::free(layout_info)
    ptr::free(entry)
    ptr::free(stages)
    ptr::free(binding)
    ptr::free(attributes)
    ptr::free(vertex_input)
    ptr::free(input_assembly)
    ptr::free(viewport_state)
    ptr::free(raster)
    ptr::free(multisample)
    ptr::free(blend_attachment)
    ptr::free(blend_state)
    ptr::free(dynamic_states)
    ptr::free(dynamic_state)
    ptr::free(depth_state)
    ptr::free(pipeline_info)
    if result != 0:
        ret 0
    ret 1

# Cube vertex buffer (8 * 24 bytes) and 16-bit index buffer (36 indices).
vulkan_cube_buffers <- (
    device: i64,
    physical: i64,
    out_vertex_buffer: u64,
    out_vertex_memory: u64,
    out_index_buffer: u64,
    out_index_memory: u64,
) -> i64:
    vertex_bytes := 192
    vertex_info := ptr::alloc(56) as u64
    ptr::store_u32(vertex_info, 12)
    ptr::store_u64(vertex_info + 24, vertex_bytes)
    ptr::store_u32(vertex_info + 32, 128)
    vertex_out := ptr::alloc(8) as u64
    create_buffer := bind_vk("vkCreateBuffer")
    ffi::call4(create_buffer, device, vertex_info, 0, vertex_out)
    vertex_buffer := ptr::load_u64(vertex_out)
    vertex_requirements := ptr::alloc(24) as u64
    get_requirements := bind_vk("vkGetBufferMemoryRequirements")
    ffi::call3(get_requirements, device, vertex_buffer, vertex_requirements)
    vertex_size := ptr::load_u64(vertex_requirements)
    vertex_type := find_memory_type(physical, ptr::load_u32(vertex_requirements + 16))
    vertex_alloc := ptr::alloc(32) as u64
    ptr::store_u32(vertex_alloc, 5)
    ptr::store_u64(vertex_alloc + 16, vertex_size)
    ptr::store_u32(vertex_alloc + 24, vertex_type)
    vertex_memory_out := ptr::alloc(8) as u64
    allocate_memory := bind_vk("vkAllocateMemory")
    ffi::call4(allocate_memory, device, vertex_alloc, 0, vertex_memory_out)
    vertex_memory := ptr::load_u64(vertex_memory_out)
    bind_memory := bind_vk("vkBindBufferMemory")
    ffi::call4(bind_memory, device, vertex_buffer, vertex_memory, 0)
    vertex_mapped_out := ptr::alloc(8) as u64
    map_memory := bind_vk("vkMapMemory")
    ffi::call6(map_memory, device, vertex_memory, 0, vertex_size, 0, vertex_mapped_out)
    mapped := ptr::load_u64(vertex_mapped_out)
    # Unit cube matching the removed Zig renderer: positions span [-1, 1], so
    # engine scales are half extents (a 1x1x1 cube uses scale 1,1,1).  Vertex
    # order is the existing index buffer's bit order (x = bit0, y = bit1,
    # z = bit2).  Vertex colours are white; the per-object material tint
    # comes from the lit UBO.
    ptr::store_f32(mapped + 0, -1.0)
    ptr::store_f32(mapped + 4, -1.0)
    ptr::store_f32(mapped + 8, -1.0)
    ptr::store_f32(mapped + 12, 1.0)
    ptr::store_f32(mapped + 16, 1.0)
    ptr::store_f32(mapped + 20, 1.0)
    ptr::store_f32(mapped + 24, 1.0)
    ptr::store_f32(mapped + 28, -1.0)
    ptr::store_f32(mapped + 32, -1.0)
    ptr::store_f32(mapped + 36, 1.0)
    ptr::store_f32(mapped + 40, 1.0)
    ptr::store_f32(mapped + 44, 1.0)
    ptr::store_f32(mapped + 48, -1.0)
    ptr::store_f32(mapped + 52, 1.0)
    ptr::store_f32(mapped + 56, -1.0)
    ptr::store_f32(mapped + 60, 1.0)
    ptr::store_f32(mapped + 64, 1.0)
    ptr::store_f32(mapped + 68, 1.0)
    ptr::store_f32(mapped + 72, 1.0)
    ptr::store_f32(mapped + 76, 1.0)
    ptr::store_f32(mapped + 80, -1.0)
    ptr::store_f32(mapped + 84, 1.0)
    ptr::store_f32(mapped + 88, 1.0)
    ptr::store_f32(mapped + 92, 1.0)
    ptr::store_f32(mapped + 96, -1.0)
    ptr::store_f32(mapped + 100, -1.0)
    ptr::store_f32(mapped + 104, 1.0)
    ptr::store_f32(mapped + 108, 1.0)
    ptr::store_f32(mapped + 112, 1.0)
    ptr::store_f32(mapped + 116, 1.0)
    ptr::store_f32(mapped + 120, 1.0)
    ptr::store_f32(mapped + 124, -1.0)
    ptr::store_f32(mapped + 128, 1.0)
    ptr::store_f32(mapped + 132, 1.0)
    ptr::store_f32(mapped + 136, 1.0)
    ptr::store_f32(mapped + 140, 1.0)
    ptr::store_f32(mapped + 144, -1.0)
    ptr::store_f32(mapped + 148, 1.0)
    ptr::store_f32(mapped + 152, 1.0)
    ptr::store_f32(mapped + 156, 1.0)
    ptr::store_f32(mapped + 160, 1.0)
    ptr::store_f32(mapped + 164, 1.0)
    ptr::store_f32(mapped + 168, 1.0)
    ptr::store_f32(mapped + 172, 1.0)
    ptr::store_f32(mapped + 176, 1.0)
    ptr::store_f32(mapped + 180, 1.0)
    ptr::store_f32(mapped + 184, 1.0)
    ptr::store_f32(mapped + 188, 1.0)

    index_bytes := 72
    index_info := ptr::alloc(56) as u64
    ptr::store_u32(index_info, 12)
    ptr::store_u64(index_info + 24, index_bytes)
    ptr::store_u32(index_info + 32, 64)
    index_out := ptr::alloc(8) as u64
    ffi::call4(create_buffer, device, index_info, 0, index_out)
    index_buffer := ptr::load_u64(index_out)
    index_requirements := ptr::alloc(24) as u64
    ffi::call3(get_requirements, device, index_buffer, index_requirements)
    index_size := ptr::load_u64(index_requirements)
    index_type := find_memory_type(physical, ptr::load_u32(index_requirements + 16))
    index_alloc := ptr::alloc(32) as u64
    ptr::store_u32(index_alloc, 5)
    ptr::store_u64(index_alloc + 16, index_size)
    ptr::store_u32(index_alloc + 24, index_type)
    index_memory_out := ptr::alloc(8) as u64
    ffi::call4(allocate_memory, device, index_alloc, 0, index_memory_out)
    index_memory := ptr::load_u64(index_memory_out)
    ffi::call4(bind_memory, device, index_buffer, index_memory, 0)
    index_mapped_out := ptr::alloc(8) as u64
    ffi::call6(map_memory, device, index_memory, 0, index_size, 0, index_mapped_out)
    index_mapped := ptr::load_u64(index_mapped_out)
    ptr::store_u16(index_mapped, 0)
    ptr::store_u16(index_mapped + 2, 1)
    ptr::store_u16(index_mapped + 4, 2)
    ptr::store_u16(index_mapped + 6, 2)
    ptr::store_u16(index_mapped + 8, 1)
    ptr::store_u16(index_mapped + 10, 3)
    ptr::store_u16(index_mapped + 12, 4)
    ptr::store_u16(index_mapped + 14, 5)
    ptr::store_u16(index_mapped + 16, 6)
    ptr::store_u16(index_mapped + 18, 6)
    ptr::store_u16(index_mapped + 20, 5)
    ptr::store_u16(index_mapped + 22, 7)
    ptr::store_u16(index_mapped + 24, 0)
    ptr::store_u16(index_mapped + 26, 1)
    ptr::store_u16(index_mapped + 28, 4)
    ptr::store_u16(index_mapped + 30, 4)
    ptr::store_u16(index_mapped + 32, 1)
    ptr::store_u16(index_mapped + 34, 5)
    ptr::store_u16(index_mapped + 36, 2)
    ptr::store_u16(index_mapped + 38, 3)
    ptr::store_u16(index_mapped + 40, 6)
    ptr::store_u16(index_mapped + 42, 6)
    ptr::store_u16(index_mapped + 44, 3)
    ptr::store_u16(index_mapped + 46, 7)
    ptr::store_u16(index_mapped + 48, 0)
    ptr::store_u16(index_mapped + 50, 2)
    ptr::store_u16(index_mapped + 52, 4)
    ptr::store_u16(index_mapped + 54, 4)
    ptr::store_u16(index_mapped + 56, 2)
    ptr::store_u16(index_mapped + 58, 6)
    ptr::store_u16(index_mapped + 60, 1)
    ptr::store_u16(index_mapped + 62, 3)
    ptr::store_u16(index_mapped + 64, 5)
    ptr::store_u16(index_mapped + 66, 5)
    ptr::store_u16(index_mapped + 68, 3)
    ptr::store_u16(index_mapped + 70, 7)

    ptr::store_u64(out_vertex_buffer, vertex_buffer)
    ptr::store_u64(out_vertex_memory, vertex_memory)
    ptr::store_u64(out_index_buffer, index_buffer)
    ptr::store_u64(out_index_memory, index_memory)
    ptr::free(vertex_info)
    ptr::free(vertex_out)
    ptr::free(vertex_requirements)
    ptr::free(vertex_alloc)
    ptr::free(vertex_memory_out)
    ptr::free(vertex_mapped_out)
    ptr::free(index_info)
    ptr::free(index_out)
    ptr::free(index_requirements)
    ptr::free(index_alloc)
    ptr::free(index_memory_out)
    ptr::free(index_mapped_out)
    if vertex_type < 0:
        ret 0
    if index_type < 0:
        ret 0
    ret 1

vulkan_depth_target <- (device: i64, physical: i64, width: i64, height: i64, out_image: u64, out_memory: u64, out_view: u64) -> i64:
    info := ptr::alloc(88) as u64
    ptr::store_u32(info, 14)
    ptr::store_u32(info + 20, 1)
    ptr::store_u32(info + 24, 126)
    ptr::store_u32(info + 28, width)
    ptr::store_u32(info + 32, height)
    ptr::store_u32(info + 36, 1)
    ptr::store_u32(info + 40, 1)
    ptr::store_u32(info + 44, 1)
    ptr::store_u32(info + 48, 1)
    ptr::store_u32(info + 52, 0)
    ptr::store_u32(info + 56, 32)
    ptr::store_u32(info + 60, 0)
    image_out := ptr::alloc(8) as u64
    create_image := bind_vk("vkCreateImage")
    ffi::call4(create_image, device, info, 0, image_out)
    image := ptr::load_u64(image_out)
    requirements := ptr::alloc(24) as u64
    get_requirements := bind_vk("vkGetImageMemoryRequirements")
    ffi::call3(get_requirements, device, image, requirements)
    memory_size := ptr::load_u64(requirements)
    memory_type := find_memory_type(physical, ptr::load_u32(requirements + 16))
    if memory_type < 0:
        ptr::free(info)
        ptr::free(image_out)
        ptr::free(requirements)
        ret 0
    alloc_info := ptr::alloc(32) as u64
    ptr::store_u32(alloc_info, 5)
    ptr::store_u64(alloc_info + 16, memory_size)
    ptr::store_u32(alloc_info + 24, memory_type)
    memory_out := ptr::alloc(8) as u64
    allocate_memory := bind_vk("vkAllocateMemory")
    ffi::call4(allocate_memory, device, alloc_info, 0, memory_out)
    memory := ptr::load_u64(memory_out)
    bind_image := bind_vk("vkBindImageMemory")
    ffi::call4(bind_image, device, image, memory, 0)
    view_info := ptr::alloc(80) as u64
    ptr::store_u32(view_info, 15)
    ptr::store_u64(view_info + 24, image)
    ptr::store_u32(view_info + 32, 1)
    ptr::store_u32(view_info + 36, 126)
    ptr::store_u32(view_info + 56, 2)
    ptr::store_u32(view_info + 60, 0)
    ptr::store_u32(view_info + 64, 1)
    ptr::store_u32(view_info + 68, 0)
    ptr::store_u32(view_info + 72, 1)
    view_out := ptr::alloc(8) as u64
    create_view := bind_vk("vkCreateImageView")
    ffi::call4(create_view, device, view_info, 0, view_out)
    ptr::store_u64(out_image, image)
    ptr::store_u64(out_memory, memory)
    ptr::store_u64(out_view, ptr::load_u64(view_out))
    ptr::free(info)
    ptr::free(image_out)
    ptr::free(requirements)
    ptr::free(alloc_info)
    ptr::free(memory_out)
    ptr::free(view_info)
    ptr::free(view_out)
    ret 1

vulkan_depth_target_destroy <- (device: i64, image: i64, memory: i64, view: i64) -> nil:
    destroy_view := bind_vk("vkDestroyImageView")
    ffi::call3(destroy_view, device, view, 0)
    destroy_image := bind_vk("vkDestroyImage")
    ffi::call3(destroy_image, device, image, 0)
    free_memory := bind_vk("vkFreeMemory")
    ffi::call3(free_memory, device, memory, 0)

vulkan_texture_empty <- (device: i64, physical: i64, width: i64, height: i64, out_image: u64, out_memory: u64, out_view: u64, out_sampler: u64) -> i64:
    info := ptr::alloc(88) as u64
    ptr::store_u32(info, 14)
    ptr::store_u32(info + 20, 1)
    ptr::store_u32(info + 24, 37)
    ptr::store_u32(info + 28, width)
    ptr::store_u32(info + 32, height)
    ptr::store_u32(info + 36, 1)
    ptr::store_u32(info + 40, 1)
    ptr::store_u32(info + 44, 1)
    ptr::store_u32(info + 48, 1)
    ptr::store_u32(info + 52, 0)
    ptr::store_u32(info + 56, 6)
    ptr::store_u32(info + 60, 0)
    image_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkCreateImage"), device, info, 0, image_out)
    image := ptr::load_u64(image_out)
    req := ptr::alloc(24) as u64
    ffi::call3(bind_vk("vkGetImageMemoryRequirements"), device, image, req)
    memory_type := find_memory_type(physical, ptr::load_u32(req + 16))
    alloc_info := ptr::alloc(32) as u64
    ptr::store_u32(alloc_info, 5)
    ptr::store_u64(alloc_info + 16, ptr::load_u64(req))
    ptr::store_u32(alloc_info + 24, memory_type)
    memory_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkAllocateMemory"), device, alloc_info, 0, memory_out)
    memory := ptr::load_u64(memory_out)
    ffi::call4(bind_vk("vkBindImageMemory"), device, image, memory, 0)
    view_info := ptr::alloc(80) as u64
    ptr::store_u32(view_info, 15)
    ptr::store_u64(view_info + 24, image)
    ptr::store_u32(view_info + 32, 1)
    ptr::store_u32(view_info + 36, 37)
    ptr::store_u32(view_info + 56, 1)
    ptr::store_u32(view_info + 60, 0)
    ptr::store_u32(view_info + 64, 1)
    ptr::store_u32(view_info + 68, 0)
    ptr::store_u32(view_info + 72, 1)
    view_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkCreateImageView"), device, view_info, 0, view_out)
    sampler_info := ptr::alloc(80) as u64
    ptr::store_u32(sampler_info, 31)
    ptr::store_u32(sampler_info + 20, 1)
    ptr::store_u32(sampler_info + 24, 1)
    ptr::store_u32(sampler_info + 28, 0)
    ptr::store_u32(sampler_info + 32, 0)
    ptr::store_u32(sampler_info + 36, 0)
    ptr::store_u32(sampler_info + 40, 0)
    ptr::store_f32(sampler_info + 64, 1.0)
    sampler_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkCreateSampler"), device, sampler_info, 0, sampler_out)
    ptr::store_u64(out_image, image)
    ptr::store_u64(out_memory, memory)
    ptr::store_u64(out_view, ptr::load_u64(view_out))
    ptr::store_u64(out_sampler, ptr::load_u64(sampler_out))
    ptr::free(info)
    ptr::free(image_out)
    ptr::free(req)
    ptr::free(alloc_info)
    ptr::free(memory_out)
    ptr::free(view_info)
    ptr::free(view_out)
    ptr::free(sampler_info)
    ptr::free(sampler_out)
    if memory_type < 0:
        ret 0
    ret 1

vulkan_texture_empty_destroy <- (device: i64, image: i64, memory: i64, view: i64, sampler: i64) -> nil:
    ffi::call3(bind_vk("vkDestroySampler"), device, sampler, 0)
    ffi::call3(bind_vk("vkDestroyImageView"), device, view, 0)
    ffi::call3(bind_vk("vkDestroyImage"), device, image, 0)
    ffi::call3(bind_vk("vkFreeMemory"), device, memory, 0)

vulkan_texture_upload <- (device: i64, queue: i64, queue_family: i64, physical: i64, image: i64, pixels: u64, width: i64, height: i64) -> i64:
    byte_count := width * height * 4
    info := ptr::alloc(56) as u64
    ptr::store_u32(info, 12)
    ptr::store_u64(info + 24, byte_count)
    ptr::store_u32(info + 32, 1)
    staging_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkCreateBuffer"), device, info, 0, staging_out)
    staging := ptr::load_u64(staging_out)
    req := ptr::alloc(24) as u64
    ffi::call3(bind_vk("vkGetBufferMemoryRequirements"), device, staging, req)
    memory_size := ptr::load_u64(req)
    memory_type := find_memory_type(physical, ptr::load_u32(req + 16))
    alloc_info := ptr::alloc(32) as u64
    ptr::store_u32(alloc_info, 5)
    ptr::store_u64(alloc_info + 16, memory_size)
    ptr::store_u32(alloc_info + 24, memory_type)
    memory_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkAllocateMemory"), device, alloc_info, 0, memory_out)
    memory := ptr::load_u64(memory_out)
    ffi::call4(bind_vk("vkBindBufferMemory"), device, staging, memory, 0)
    mapped_out := ptr::alloc(8) as u64
    ffi::call6(bind_vk("vkMapMemory"), device, memory, 0, memory_size, 0, mapped_out)
    ptr::copy(ptr::load_u64(mapped_out), pixels, byte_count)
    ffi::call2(bind_vk("vkUnmapMemory"), device, memory)

    pool_info := ptr::alloc(24) as u64
    ptr::store_u32(pool_info, 39)
    ptr::store_u32(pool_info + 20, queue_family)
    pool_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkCreateCommandPool"), device, pool_info, 0, pool_out)
    pool := ptr::load_u64(pool_out)
    command_alloc := ptr::alloc(32) as u64
    ptr::store_u32(command_alloc, 40)
    ptr::store_u64(command_alloc + 16, pool)
    ptr::store_u32(command_alloc + 24, 0)
    ptr::store_u32(command_alloc + 28, 1)
    command_out := ptr::alloc(8) as u64
    ffi::call3(bind_vk("vkAllocateCommandBuffers"), device, command_alloc, command_out)
    command := ptr::load_u64(command_out)
    begin_info := ptr::alloc(32) as u64
    ptr::store_u32(begin_info, 42)
    ffi::call2(bind_vk("vkBeginCommandBuffer"), command, begin_info)
    transition_image(command, image, 0, 7, 0, 4096, 1, 4096)
    # VkBufferImageCopy: aspectMask@16, mipLevel@20, baseArrayLayer@24,
    # layerCount@28.  layerCount must be 1 (the earlier offset selected
    # baseArrayLayer=1/layerCount=0, which made the copy a no-op).
    region := ptr::alloc(56) as u64
    ptr::store_u32(region + 16, 1)
    ptr::store_u32(region + 28, 1)
    ptr::store_u32(region + 44, width)
    ptr::store_u32(region + 48, height)
    ptr::store_u32(region + 52, 1)
    ffi::call6(bind_vk("vkCmdCopyBufferToImage"), command, staging, image, 7, 1, region)
    transition_image(command, image, 7, 5, 4096, 32, 4096, 128)
    ffi::call1(bind_vk("vkEndCommandBuffer"), command)
    commands := ptr::alloc(8) as u64
    ptr::store_u64(commands, command)
    submit_info := ptr::alloc(72) as u64
    ptr::store_u32(submit_info, 4)
    ptr::store_u32(submit_info + 40, 1)
    ptr::store_u64(submit_info + 48, commands)
    fence_info := ptr::alloc(24) as u64
    ptr::store_u32(fence_info, 8)
    fence_out := ptr::alloc(8) as u64
    ffi::call4(bind_vk("vkCreateFence"), device, fence_info, 0, fence_out)
    fence := ptr::load_u64(fence_out)
    ffi::call4(bind_vk("vkQueueSubmit"), queue, 1, submit_info, fence)
    fences := ptr::alloc(8) as u64
    ptr::store_u64(fences, fence)
    wait_result := ffi::call5(bind_vk("vkWaitForFences"), device, 1, fences, 1, 1000000000)
    ffi::call3(bind_vk("vkDestroyFence"), device, fence, 0)
    ffi::call3(bind_vk("vkDestroyCommandPool"), device, pool, 0)
    ffi::call3(bind_vk("vkDestroyBuffer"), device, staging, 0)
    ffi::call3(bind_vk("vkFreeMemory"), device, memory, 0)
    ptr::free(info)
    ptr::free(staging_out)
    ptr::free(req)
    ptr::free(alloc_info)
    ptr::free(memory_out)
    ptr::free(mapped_out)
    ptr::free(pool_info)
    ptr::free(pool_out)
    ptr::free(command_alloc)
    ptr::free(command_out)
    ptr::free(begin_info)
    ptr::free(region)
    ptr::free(commands)
    ptr::free(submit_info)
    ptr::free(fence_info)
    ptr::free(fence_out)
    ptr::free(fences)
    if wait_result != 0:
        ret 0
    if memory_type < 0:
        ret 0
    ret 1

# Single combined-image-sampler descriptor set (set 1, binding 1).
vulkan_texture_descriptor_one <- (device: i64, view: i64, sampler: i64, out_layout: u64, out_pool: u64, out_set: u64) -> i64:
    binding := ptr::alloc(24) as u64
    ptr::store_u32(binding, 1)
    ptr::store_u32(binding + 4, 1)
    ptr::store_u32(binding + 8, 1)
    ptr::store_u32(binding + 12, 16)
    layout_info := ptr::alloc(32) as u64
    ptr::store_u32(layout_info, 32)
    ptr::store_u32(layout_info + 20, 1)
    ptr::store_u64(layout_info + 24, binding)
    ffi::call4(bind_vk("vkCreateDescriptorSetLayout"), device, layout_info, 0, out_layout)
    set_layout := ptr::load_u64(out_layout)
    pool_size := ptr::alloc(8) as u64
    ptr::store_u32(pool_size, 1)
    ptr::store_u32(pool_size + 4, 1)
    pool_info := ptr::alloc(40) as u64
    ptr::store_u32(pool_info, 33)
    ptr::store_u32(pool_info + 20, 1)
    ptr::store_u32(pool_info + 24, 1)
    ptr::store_u64(pool_info + 32, pool_size)
    ffi::call4(bind_vk("vkCreateDescriptorPool"), device, pool_info, 0, out_pool)
    pool := ptr::load_u64(out_pool)
    layouts := ptr::alloc(8) as u64
    ptr::store_u64(layouts, set_layout)
    alloc_info := ptr::alloc(40) as u64
    ptr::store_u32(alloc_info, 34)
    ptr::store_u64(alloc_info + 16, pool)
    ptr::store_u32(alloc_info + 24, 1)
    ptr::store_u64(alloc_info + 32, layouts)
    ffi::call3(bind_vk("vkAllocateDescriptorSets"), device, alloc_info, out_set)
    descriptor_set := ptr::load_u64(out_set)
    image_info := ptr::alloc(24) as u64
    ptr::store_u64(image_info, sampler)
    ptr::store_u64(image_info + 8, view)
    ptr::store_u32(image_info + 16, 5)
    write := ptr::alloc(64) as u64
    ptr::store_u32(write, 35)
    ptr::store_u64(write + 16, descriptor_set)
    ptr::store_u32(write + 24, 1)
    ptr::store_u32(write + 32, 1)
    ptr::store_u32(write + 36, 1)
    ptr::store_u64(write + 40, image_info)
