# Engine window layer implemented entirely in e7 through SDL3 and the generic
# C FFI.  The window state is the raw 256-byte e7 SDL state; engine resources
# hold that handle and pass it explicitly to these functions.

# SDL_WINDOW_VULKAN | SDL_WINDOW_RESIZABLE = 0x10000020; headless runs add
# SDL_WINDOW_HIDDEN (0x8) so the dummy video driver never maps a window.
e7_engine_window_flags <- (headless: i64) -> i64:
    if headless != 0:
        ret 268435496
    ret 268435488

e7_engine_window_create <- (title: str, width: i64, height: i64) -> u64:
    headless := e7_host_headless()
    initialized := 0
    if headless != 0:
        initialized = video_init("dummy")
        if initialized == 0:
            video_quit()
            initialized = video_init("dummy")
    else:
        initialized = video_start()
    if initialized == 0:
        ret 0
    flags := e7_engine_window_flags(headless)
    created := window_create(title, width, height, flags)
    if created != 0:
        # SDL3 creates windows hidden by default; desktop runs must show it.
        if headless == 0:
            window_show(created)
            wait_ms(100)
        window_pump(created)
        window_pump(created)
        window_pump(created)
        window_pump(created)
        window_pump(created)
        window_pump(created)
        window_pump(created)
        window_pump(created)
        if headless == 0:
            # First-person look owns the pointer on desktop runs; text input is
            # re-enabled automatically when capture is released.
            set_relative_mouse(created, 1)
            start_text_input(created)
    ret created

e7_engine_window_pump <- (handle: u64) -> i64:
    if handle == 0:
        ret 1
    e7_store_u32(handle + 8, 0)
    text_input_reset(handle)
    mouse_reset_delta(handle)
    window_pump(handle)
    window_pump(handle)
    window_pump(handle)
    window_pump(handle)
    window_pump(handle)
    window_pump(handle)
    window_pump(handle)
    window_pump(handle)
    window_sync_size(handle)
    ret window_should_close(handle)

e7_engine_window_take_resize <- (handle: u64, out_width: u64, out_height: u64) -> i64:
    if handle == 0:
        ret 0
    ret window_take_resize(handle, out_width, out_height)

e7_engine_window_should_close <- (handle: u64) -> i64:
    if handle == 0:
        ret 1
    ret window_should_close(handle)

e7_engine_window_destroy <- (handle: u64) -> nil:
    if handle == 0:
        ret
    window_destroy(handle)
    video_quit()

e7_engine_key_down <- (handle: u64, code: i64) -> i64:
    if handle == 0:
        ret 0
    scancode := 0
    if code == 0:
        scancode = 26
    elif code == 1:
        scancode = 22
    elif code == 2:
        scancode = 4
    elif code == 3:
        scancode = 7
    elif code == 4:
        scancode = 8
    elif code == 5:
        scancode = 20
    elif code == 6:
        scancode = 225
    elif code == 7:
        scancode = 80
    elif code == 8:
        scancode = 79
    elif code == 9:
        scancode = 82
    elif code == 10:
        scancode = 81
    elif code == 11:
        scancode = 44
    else:
        ret 0
    ret key_down(handle, scancode)

e7_engine_mouse_dx <- (handle: u64) -> i64:
    if handle == 0:
        ret 0
    ret mouse_dx(handle)

e7_engine_mouse_dy <- (handle: u64) -> i64:
    if handle == 0:
        ret 0
    ret mouse_dy(handle)

e7_engine_mouse_x <- (handle: u64) -> i64:
    if handle == 0:
        ret 0
    ret mouse_x(handle)

e7_engine_mouse_y <- (handle: u64) -> i64:
    if handle == 0:
        ret 0
    ret mouse_y(handle)

e7_engine_text_input <- (handle: u64) -> str:
    if handle == 0:
        ret e7_str_new(0, 0)
    ret text_input_pending(handle)

e7_engine_capture_mouse <- (handle: u64, enabled: i64) -> nil:
    if handle == 0:
        ret
    set_relative_mouse(handle, enabled)
    ret

e7_engine_mouse_down <- (handle: u64, button: i64) -> i64:
    if handle == 0:
        ret 0
    ret mouse_button_mask_down(mouse_buttons(handle), button)

e7_engine_mouse_captured <- (handle: u64) -> i64:
    if handle == 0:
        ret 0
    ret mouse_captured(handle)
