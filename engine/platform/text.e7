# SDL_ttf text/font implementation in e7 through the C FFI.
# Rasterized surfaces are registered as RGBA images through the runtime's
# e7_image_from_argb helper (image storage is not SDL/Vulkan).

bind_ttf <- (name: str) -> u64:
    ret e7_cffi_bind("SDL3_ttf", name)

e7_font_load <- (path: str, size: i64) -> u64:
    init := bind_ttf("TTF_Init")
    e7_ffi_call0(init)
    open_font := bind_ttf("TTF_OpenFont")
    path_c := e7_cstr(path)
    font := e7_ffi_call_f32_2(open_font, path_c, e7_f32_from_i64(size))
    e7_free_ptr(path_c)
    ret font

e7_font_free <- (font: u64) -> i64:
    if font == 0:
        ret 0
    close_font := bind_ttf("TTF_CloseFont")
    e7_ffi_call1(close_font, font)
    ret 0

e7_text_measure <- (font: u64, text: str) -> i64:
    if font == 0:
        ret 0
    text_c := e7_cstr(text)
    width_out := e7_alloc_bytes(4)
    height_out := e7_alloc_bytes(4)
    measure := bind_ttf("TTF_GetStringSize")
    ok := e7_ffi_call5(measure, font, text_c, 0, width_out, height_out)
    width := e7_load_u32(width_out)
    height := e7_load_u32(height_out)
    e7_free_ptr(text_c)
    e7_free_ptr(width_out)
    e7_free_ptr(height_out)
    if ok == 0:
        ret 0
    ret width * 4294967296 + height

e7_text_image <- (font: u64, text: str, r: i64, g: i64, b: i64) -> u64:
    if font == 0:
        ret 0
    text_c := e7_cstr(text)
    color := r + g * 256 + b * 65536 + 255 * 16777216
    render := bind_ttf("TTF_RenderText_Blended")
    surface := e7_ffi_call4(render, font, text_c, 0, color)
    e7_free_ptr(text_c)
    if surface == 0:
        ret 0
    width := e7_load_u32(surface + 8)
    height := e7_load_u32(surface + 12)
    pitch := e7_load_u32(surface + 16)
    pixels := e7_load_u64(surface + 24)
    handle := e7_image_from_argb(pixels as u64, width, height, pitch)
    destroy := e7_cffi_bind("SDL3", "SDL_DestroySurface")
    e7_ffi_call1(destroy, surface)
    ret handle
