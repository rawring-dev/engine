# Reusable e7 scene state.  Layout (128 bytes):
#   0 window, 8 instance, 16 surface, 24 physical, 32 device, 40 queue,
#   48 family (u32), 52 image_count (u32), 56 swapchain, 64 render_pass,
#   72 pipeline, 80 framebuffers, 88 width (u32), 92 height (u32),
#   96 views, 104 layout.
# The scene owns everything except the SDL window.

scene_create <- (window_state: u64, requested_width: i64, requested_height: i64) -> u64:
    scene := e7_alloc_bytes(2048)
    e7_store_u64(scene, window_state)
    e7_store_u32(scene + 232, 0)

    ext_count := e7_alloc_bytes(4)
    get_ext := e7_cffi_bind("SDL3", "SDL_Vulkan_GetInstanceExtensions")
    exts := e7_ffi_call1(get_ext, ext_count)
    if exts == 0:
        e7_free_ptr(scene)
        e7_free_ptr(ext_count)
        ret 0
    count := e7_load_u32(ext_count)
    ext_array := e7_alloc_bytes(count * 8)
    if count > 0:
        e7_store_u64(ext_array, e7_load_u64(exts))
    if count > 1:
        e7_store_u64(ext_array + 8, e7_load_u64(exts + 8))
    if count > 2:
        e7_store_u64(ext_array + 16, e7_load_u64(exts + 16))
    if count > 3:
        e7_store_u64(ext_array + 24, e7_load_u64(exts + 24))

    instance_out := e7_alloc_bytes(8)
    if vulkan_instance_create(ext_array, count, instance_out) != 0:
        e7_free_ptr(scene)
        e7_free_ptr(ext_count)
        e7_free_ptr(ext_array)
        e7_free_ptr(instance_out)
        ret 0
    instance := e7_load_u64(instance_out)
    e7_store_u64(scene + 8, instance)

    surface_out := e7_alloc_bytes(8)
    if vulkan_surface_create(window_state, instance, surface_out) == 0:
        vulkan_instance_destroy(instance)
        e7_free_ptr(scene)
        e7_free_ptr(ext_count)
        e7_free_ptr(ext_array)
        e7_free_ptr(instance_out)
        e7_free_ptr(surface_out)
        ret 0
    surface := e7_load_u64(surface_out)
    e7_store_u64(scene + 16, surface)

    device_out := e7_alloc_bytes(8)
    queue_out := e7_alloc_bytes(8)
    family_out := e7_alloc_bytes(4)
    physical_out := e7_alloc_bytes(8)
    if vulkan_device_create(instance, surface, device_out, queue_out, family_out, physical_out) == 0:
        vulkan_surface_destroy(instance, surface)
        vulkan_instance_destroy(instance)
        e7_free_ptr(scene)
        e7_free_ptr(ext_count)
        e7_free_ptr(ext_array)
        e7_free_ptr(instance_out)
        e7_free_ptr(surface_out)
        e7_free_ptr(device_out)
        e7_free_ptr(queue_out)
        e7_free_ptr(family_out)
        e7_free_ptr(physical_out)
        ret 0
    device := e7_load_u64(device_out)
    queue := e7_load_u64(queue_out)
    family := e7_load_u32(family_out)
    physical := e7_load_u64(physical_out)
    e7_store_u64(scene + 24, physical)
    e7_store_u64(scene + 32, device)
    e7_store_u64(scene + 40, queue)
    e7_store_u32(scene + 48, family)

    swapchain_out := e7_alloc_bytes(8)
    format_out := e7_alloc_bytes(4)
    width_out := e7_alloc_bytes(4)
    height_out := e7_alloc_bytes(4)
    images_out := e7_alloc_bytes(8)
    image_count_out := e7_alloc_bytes(4)
    if vulkan_swapchain_create(device, physical, surface, window_state, swapchain_out, format_out, width_out, height_out, images_out, image_count_out) == 0:
        ret 0
    swapchain := e7_load_u64(swapchain_out)
    format := e7_load_u32(format_out)
    width := e7_load_u32(width_out)
    height := e7_load_u32(height_out)
    images := e7_load_u64(images_out)
    image_count := e7_load_u32(image_count_out)
    e7_store_u64(scene + 56, swapchain)
    e7_store_u32(scene + 52, image_count)
    e7_store_u32(scene + 88, width)
    e7_store_u32(scene + 92, height)

    depth_image_out := e7_alloc_bytes(8)
    depth_memory_out := e7_alloc_bytes(8)
    depth_view_out := e7_alloc_bytes(8)
    if vulkan_depth_target(device, physical, width, height, depth_image_out, depth_memory_out, depth_view_out) == 0:
        ret 0
    e7_store_u64(scene + 208, e7_load_u64(depth_image_out))
    e7_store_u64(scene + 216, e7_load_u64(depth_memory_out))
    e7_store_u64(scene + 224, e7_load_u64(depth_view_out))
    depth_view := e7_load_u64(depth_view_out)
    e7_free_ptr(depth_image_out)
    e7_free_ptr(depth_memory_out)
    e7_free_ptr(depth_view_out)
    texture_image_out := e7_alloc_bytes(8)
    texture_memory_out := e7_alloc_bytes(8)
    texture_view_out := e7_alloc_bytes(8)
    texture_sampler_out := e7_alloc_bytes(8)
    if vulkan_texture_empty(device, physical, 4, 4, texture_image_out, texture_memory_out, texture_view_out, texture_sampler_out) == 0:
        ret 0
    texture_pixels := e7_alloc_bytes(64)
    e7_store_u32(texture_pixels, 4294967295)
    e7_store_u32(texture_pixels + 4, 4294967295)
    e7_store_u32(texture_pixels + 8, 4294967295)
    e7_store_u32(texture_pixels + 12, 4294967295)
    e7_store_u32(texture_pixels + 16, 4294967295)
    e7_store_u32(texture_pixels + 20, 4294967295)
    e7_store_u32(texture_pixels + 24, 4294967295)
    e7_store_u32(texture_pixels + 28, 4294967295)
    e7_store_u32(texture_pixels + 32, 4294967295)
    e7_store_u32(texture_pixels + 36, 4294967295)
    e7_store_u32(texture_pixels + 40, 4294967295)
    e7_store_u32(texture_pixels + 44, 4294967295)
    e7_store_u32(texture_pixels + 48, 4294967295)
    e7_store_u32(texture_pixels + 52, 4294967295)
    e7_store_u32(texture_pixels + 56, 4294967295)
    e7_store_u32(texture_pixels + 60, 4294967295)
    if vulkan_texture_upload(device, queue, family, physical, e7_load_u64(texture_image_out), texture_pixels as u64, 4, 4) == 0:
        ret 0
    e7_free_ptr(texture_pixels)
    texture_layout_out := e7_alloc_bytes(8)
    texture_pool_out := e7_alloc_bytes(8)
    texture_set_out := e7_alloc_bytes(8)
    if vulkan_texture_descriptor_one(device, e7_load_u64(texture_view_out), e7_load_u64(texture_sampler_out), texture_layout_out, texture_pool_out, texture_set_out) == 0:
        ret 0
    e7_store_u64(scene + 1056, e7_load_u64(texture_layout_out))
    e7_store_u64(scene + 1064, e7_load_u64(texture_pool_out))
    e7_store_u64(scene + 1072, e7_load_u64(texture_set_out))
    e7_free_ptr(texture_layout_out)
    e7_free_ptr(texture_pool_out)
    e7_free_ptr(texture_set_out)
    static_layout_out := e7_alloc_bytes(8)
    static_pool_out := e7_alloc_bytes(8)
    static_set_out := e7_alloc_bytes(8)
    if vulkan_texture_descriptor_static(device, e7_load_u64(texture_view_out), e7_load_u64(texture_sampler_out), static_layout_out, static_pool_out, static_set_out) == 0:
        ret 0
    e7_store_u64(scene + 1136, e7_load_u64(static_layout_out))
    e7_store_u64(scene + 1144, e7_load_u64(static_pool_out))
    e7_store_u64(scene + 1152, e7_load_u64(static_set_out))
    e7_free_ptr(static_layout_out)
    e7_free_ptr(static_pool_out)
    e7_free_ptr(static_set_out)
    e7_store_u64(scene + 1024, e7_load_u64(texture_image_out))
    e7_store_u64(scene + 1032, e7_load_u64(texture_memory_out))
    e7_store_u64(scene + 1040, e7_load_u64(texture_view_out))
    e7_store_u64(scene + 1048, e7_load_u64(texture_sampler_out))
    e7_free_ptr(texture_image_out)
    e7_free_ptr(texture_memory_out)
    e7_free_ptr(texture_view_out)
    e7_free_ptr(texture_sampler_out)
    render_pass_out := e7_alloc_bytes(8)
    views_out := e7_alloc_bytes(8)
    framebuffers_out := e7_alloc_bytes(8)
    if vulkan_render_targets(device, images, image_count, format, width, height, depth_view, render_pass_out, views_out, framebuffers_out) == 0:
        ret 0
    render_pass := e7_load_u64(render_pass_out)
    views := e7_load_u64(views_out)
    framebuffers := e7_load_u64(framebuffers_out)
    e7_store_u64(scene + 64, render_pass)
    e7_store_u64(scene + 80, framebuffers)
    e7_store_u64(scene + 96, views)

    vert := e7_engine_read_shader("engine/platform/shaders/triangle.vert.spv")
    frag := e7_engine_read_shader("engine/platform/shaders/triangle.frag.spv")
    vert_handle := e7_handle(vert)
    frag_handle := e7_handle(frag)
    pipeline_out := e7_alloc_bytes(8)
    layout_out := e7_alloc_bytes(8)
    if vert_handle == 0 or frag_handle == 0:
        ret 0
    if vulkan_graphics_pipeline(device, render_pass, vert_handle, frag_handle, pipeline_out, layout_out) == 0:
        ret 0
    e7_store_u64(scene + 72, e7_load_u64(pipeline_out))
    e7_store_u64(scene + 104, e7_load_u64(layout_out))
    e7_free_ptr(vert_handle)
    e7_free_ptr(frag_handle)

    ubo_layout_out := e7_alloc_bytes(8)
    ubo_pool_out := e7_alloc_bytes(8)
    ubo_set_out := e7_alloc_bytes(8)
    ubo_buffer_out := e7_alloc_bytes(8)
    ubo_memory_out := e7_alloc_bytes(8)
    ubo_mapped_out := e7_alloc_bytes(8)
    ubo_size_out := e7_alloc_bytes(8)
    if vulkan_uniform_resources(device, physical, 24, ubo_layout_out, ubo_pool_out, ubo_set_out, ubo_buffer_out, ubo_memory_out, ubo_mapped_out, ubo_size_out) == 0:
        ret 0
    ubo_layout := e7_load_u64(ubo_layout_out)
    ubo_mapped := e7_load_u64(ubo_mapped_out)
    e7_store_u64(scene + 112, ubo_layout)
    e7_store_u64(scene + 120, e7_load_u64(ubo_pool_out))
    e7_store_u64(scene + 128, e7_load_u64(ubo_set_out))
    e7_store_u64(scene + 136, e7_load_u64(ubo_buffer_out))
    e7_store_u64(scene + 144, e7_load_u64(ubo_memory_out))
    e7_store_u64(scene + 152, ubo_mapped)
    if ubo_mapped != 0:
        e7_store_f32(ubo_mapped, 1.0)
        e7_store_f32(ubo_mapped + 20, 1.0)
        e7_store_f32(ubo_mapped + 40, 1.0)
        e7_store_f32(ubo_mapped + 60, 1.0)
        e7_store_f32(ubo_mapped + 64, 1.0)
        e7_store_f32(ubo_mapped + 84, 1.0)
        e7_store_f32(ubo_mapped + 104, 1.0)
        e7_store_f32(ubo_mapped + 124, 1.0)
        e7_store_f32(ubo_mapped + 128, 1.0)
        e7_store_f32(ubo_mapped + 148, 1.0)
        e7_store_f32(ubo_mapped + 168, 1.0)
        e7_store_f32(ubo_mapped + 188, 1.0)
    vertex_buffer_out := e7_alloc_bytes(8)
    vertex_memory_out := e7_alloc_bytes(8)
    index_buffer_out := e7_alloc_bytes(8)
    index_memory_out := e7_alloc_bytes(8)
    if vulkan_cube_buffers(device, physical, vertex_buffer_out, vertex_memory_out, index_buffer_out, index_memory_out) == 0:
        ret 0
    e7_store_u64(scene + 176, e7_load_u64(vertex_buffer_out))
    e7_store_u64(scene + 184, e7_load_u64(vertex_memory_out))
    e7_store_u64(scene + 192, e7_load_u64(index_buffer_out))
    e7_store_u64(scene + 200, e7_load_u64(index_memory_out))
    mesh_vert := e7_engine_read_shader("engine/platform/shaders/mesh.vert.spv")
    mesh_frag := e7_engine_read_shader("engine/platform/shaders/mesh.frag.spv")
    mesh_vert_handle := e7_handle(mesh_vert)
    mesh_frag_handle := e7_handle(mesh_frag)
    mesh_pipeline_out := e7_alloc_bytes(8)
    mesh_layout_out := e7_alloc_bytes(8)
    if mesh_vert_handle == 0 or mesh_frag_handle == 0:
        ret 0
    if vulkan_mesh_pipeline_simple(device, render_pass, mesh_vert_handle, mesh_frag_handle, ubo_layout, mesh_pipeline_out, mesh_layout_out) == 0:
        ret 0
    e7_store_u64(scene + 160, e7_load_u64(mesh_pipeline_out))
    e7_store_u64(scene + 168, e7_load_u64(mesh_layout_out))
    static_vert := e7_engine_read_shader("engine/platform/shaders/mesh_simple.vert.spv")
    static_frag := e7_engine_read_shader("engine/platform/shaders/mesh_simple.frag.spv")
    static_vert_handle := e7_handle(static_vert)
    static_frag_handle := e7_handle(static_frag)
    static_pipeline_out := e7_alloc_bytes(8)
    static_pipeline_layout_out := e7_alloc_bytes(8)
    if static_vert_handle != 0:
        if static_frag_handle != 0:
            if vulkan_mesh_pipeline_simple(device, render_pass, static_vert_handle, static_frag_handle, e7_load_u64(scene + 1136), static_pipeline_out, static_pipeline_layout_out) != 0:
                e7_store_u64(scene + 1160, e7_load_u64(static_pipeline_out))
                e7_store_u64(scene + 1168, e7_load_u64(static_pipeline_layout_out))
    e7_free_ptr(static_vert_handle)
    e7_free_ptr(static_frag_handle)
    e7_free_ptr(static_pipeline_out)
    e7_free_ptr(static_pipeline_layout_out)
    e7_free_ptr(mesh_vert_handle)
    e7_free_ptr(mesh_frag_handle)

    # Engine extension state (offsets relative to the scene block):
    #   1192/1200 UI pipeline + layout, 1208/1216/1224 UI vertex buffer,
    #   memory and mapped pointer, 1232 UI quad count,
    #   1256/1264 lit pipeline + layout (3D tint/texture), 1272 borrowed flag,
    #   1280 extension block pointer,
    #   1288 texture count, 1292 texture free count,
    #   1296 mesh count, 1300 extra draw count,
    #   1304/1312 wide (32-byte vertex stride) lit pipeline + layout.
    # Extension block: draw list 88 x 80 bytes at 0, texture table 24 x 96 at
    # 7040, texture free list 24 x 4 at 9344, mesh table 8 x 48 at 9440.
    extra := e7_alloc_bytes(9856)
    e7_store_u64(scene + 1280, extra)
    ui_vertex_bytes := 64 * 6 * 32
    ui_buffer_out := e7_alloc_bytes(8)
    ui_memory_out := e7_alloc_bytes(8)
    ui_mapped_out := e7_alloc_bytes(8)
    if vulkan_dynamic_buffer(device, physical, ui_vertex_bytes, 128, ui_buffer_out, ui_memory_out, ui_mapped_out) != 0:
        e7_store_u64(scene + 1208, e7_load_u64(ui_buffer_out))
        e7_store_u64(scene + 1216, e7_load_u64(ui_memory_out))
        e7_store_u64(scene + 1224, e7_load_u64(ui_mapped_out))
    e7_free_ptr(ui_buffer_out)
    e7_free_ptr(ui_memory_out)
    e7_free_ptr(ui_mapped_out)
    static_texture_layout := e7_load_u64(scene + 1136)
    lit_texture_layout := e7_load_u64(scene + 1056)
    ui_vert := e7_engine_read_shader("engine/platform/shaders/ui.vert.spv")
    ui_frag := e7_engine_read_shader("engine/platform/shaders/ui.frag.spv")
    ui_vert_handle := e7_handle(ui_vert)
    ui_frag_handle := e7_handle(ui_frag)
    ui_pipeline_out := e7_alloc_bytes(8)
    ui_layout_out := e7_alloc_bytes(8)
    if ui_vert_handle != 0 and ui_frag_handle != 0:
        if vulkan_ui_pipeline(device, render_pass, ui_vert_handle, ui_frag_handle, static_texture_layout, ui_pipeline_out, ui_layout_out) != 0:
            e7_store_u64(scene + 1192, e7_load_u64(ui_pipeline_out))
            e7_store_u64(scene + 1200, e7_load_u64(ui_layout_out))
    e7_free_ptr(ui_vert_handle)
    e7_free_ptr(ui_frag_handle)
    e7_free_ptr(ui_pipeline_out)
    e7_free_ptr(ui_layout_out)
    lit_vert := e7_engine_read_shader("engine/platform/shaders/lit.vert.spv")
    lit_frag := e7_engine_read_shader("engine/platform/shaders/lit.frag.spv")
    lit_vert_handle := e7_handle(lit_vert)
    lit_frag_handle := e7_handle(lit_frag)
    lit_pipeline_out := e7_alloc_bytes(8)
    lit_layout_out := e7_alloc_bytes(8)
    if lit_vert_handle != 0 and lit_frag_handle != 0:
        if vulkan_mesh_pipeline_two(device, render_pass, lit_vert_handle, lit_frag_handle, ubo_layout, lit_texture_layout, 24, lit_pipeline_out, lit_layout_out) != 0:
            e7_store_u64(scene + 1256, e7_load_u64(lit_pipeline_out))
            e7_store_u64(scene + 1264, e7_load_u64(lit_layout_out))
        if vulkan_mesh_pipeline_two(device, render_pass, lit_vert_handle, lit_frag_handle, ubo_layout, lit_texture_layout, 32, lit_pipeline_out, lit_layout_out) != 0:
            e7_store_u64(scene + 1304, e7_load_u64(lit_pipeline_out))
            e7_store_u64(scene + 1312, e7_load_u64(lit_layout_out))
    e7_free_ptr(lit_vert_handle)
    e7_free_ptr(lit_frag_handle)
    e7_free_ptr(lit_pipeline_out)
    e7_free_ptr(lit_layout_out)
    shape_geometry_create(scene)
    e7_free_ptr(ubo_layout_out)
    e7_free_ptr(ubo_pool_out)
    e7_free_ptr(ubo_set_out)
    e7_free_ptr(ubo_buffer_out)
    e7_free_ptr(ubo_memory_out)
    e7_free_ptr(ubo_mapped_out)
    e7_free_ptr(ubo_size_out)
    e7_free_ptr(vertex_buffer_out)
    e7_free_ptr(vertex_memory_out)
    e7_free_ptr(index_buffer_out)
    e7_free_ptr(index_memory_out)
    e7_free_ptr(mesh_pipeline_out)
    e7_free_ptr(mesh_layout_out)

    e7_free_ptr(ext_count)
    e7_free_ptr(ext_array)
    e7_free_ptr(instance_out)
    e7_free_ptr(surface_out)
    e7_free_ptr(device_out)
    e7_free_ptr(queue_out)
    e7_free_ptr(family_out)
    e7_free_ptr(physical_out)
    e7_free_ptr(swapchain_out)
    e7_free_ptr(format_out)
    e7_free_ptr(width_out)
    e7_free_ptr(height_out)
    e7_free_ptr(images_out)
    e7_free_ptr(image_count_out)
    e7_free_ptr(render_pass_out)
    e7_free_ptr(views_out)
    e7_free_ptr(framebuffers_out)
    e7_free_ptr(pipeline_out)
    e7_free_ptr(layout_out)
    ret scene

scene_width <- (scene: u64) -> i64:
    ret e7_load_u32(scene + 88)

scene_height <- (scene: u64) -> i64:
    ret e7_load_u32(scene + 92)

scene_begin_frame <- (scene: u64) -> nil:
    e7_store_u32(scene + 232, 0)
    e7_store_u32(scene + 1232, 0)
    e7_store_u32(scene + 1300, 0)

# ---------------------------------------------------------------------------
# Draw recording
#
# Scene draws are recorded as 80-byte entries in the scene's extension block.
# Each entry carries its own pipeline, vertex/index buffers, dynamic UBO slot,
# and combined-sampler descriptor sets, so one captured frame can mix the lit
# 3D pipeline with the blended screen-space UI pipeline:
#   0 pipeline, 8 pipeline layout, 16 vertex buffer, 24 index buffer,
#   32 index count (u32), 36 index type (u32), 40 first index/vertex (u32),
#   44 draw kind (0 indexed, 1 plain), 48 set 0, 56 set 0 dynamic flag (u32),
#   60 dynamic offset (u32), 64 set 1, 72 reserved.
# ---------------------------------------------------------------------------

milli_to_f32 <- (value: i64) -> f32:
    signed := value
    if value > 2147483647:
        signed = value - 4294967296
    ret e7_f32_div(e7_f32_from_i64(signed), 1000.0)

append_draw <- (scene: u64, pipeline: i64, layout: i64, vertex_buffer: i64, index_buffer: i64, index_count: i64, index_type: i64, first: i64, kind: i64, set0: i64, set0_dynamic: i64, dynamic_offset: i64, set1: i64) -> nil:
    extra := e7_load_u64(scene + 1280)
    if extra == 0:
        ret
    count := e7_load_u32(scene + 1300)
    if count >= 88:
        ret
    entry := extra + count * 80
    e7_store_u64(entry, pipeline)
    e7_store_u64(entry + 8, layout)
    e7_store_u64(entry + 16, vertex_buffer)
    e7_store_u64(entry + 24, index_buffer)
    e7_store_u32(entry + 32, index_count)
    e7_store_u32(entry + 36, index_type)
    e7_store_u32(entry + 40, first)
    e7_store_u32(entry + 44, kind)
    e7_store_u64(entry + 48, set0)
    e7_store_u32(entry + 56, set0_dynamic)
    e7_store_u32(entry + 60, dynamic_offset)
    e7_store_u64(entry + 64, set1)
    e7_store_u64(entry + 72, 0)
    e7_store_u32(scene + 1300, count + 1)

# Descriptor set for an engine texture id; 0 and unknown ids use the built-in
# white texture so untextured materials stay tint-only.  `texture_set` is the
# UI set-0 view (static layout, binding 0); `texture_set_lit` is the lit set-1
# view (binding 1) used by the 3D material path.
texture_set <- (scene: u64, texture: i64) -> i64:
    white := e7_load_u64(scene + 1152)
    if texture == 0:
        ret white
    extra := e7_load_u64(scene + 1280)
    if extra == 0:
        ret white
    count := e7_load_u32(scene + 1288)
    if texture > count:
        ret white
    entry := extra + 7040 + (texture as i64 - 1) * 96
    set := e7_load_u64(entry + 32)
    if set == 0:
        ret white
    ret set

texture_set_lit <- (scene: u64, texture: i64) -> i64:
    white := e7_load_u64(scene + 1072)
    if texture == 0:
        ret white
    extra := e7_load_u64(scene + 1280)
    if extra == 0:
        ret white
    count := e7_load_u32(scene + 1288)
    if texture > count:
        ret white
    entry := extra + 7040 + (texture as i64 - 1) * 96
    set := e7_load_u64(entry + 56)
    if set == 0:
        ret white
    ret set

# Write the 320-byte per-object UBO slot (model = T * R * S with R = Ry*Rx*Rz,
# then the material tint).  Slot 0's frame block (view/proj/camera/light) is
# copied from the previous slot; scene_set_camera/scene_set_light write it
# before the frame is recorded.
write_object_slot <- (scene: u64, slot_index: i64, x_milli: i64, y_milli: i64, z_milli: i64, sx_milli: i64, sy_milli: i64, sz_milli: i64, rx_milli: i64, ry_milli: i64, rz_milli: i64, r_milli: i64, g_milli: i64, b_milli: i64) -> nil:
    ubo := e7_load_u64(scene + 152)
    if ubo == 0:
        ret
    slot := ubo + slot_index * 320
    if slot_index > 0:
        e7_memcpy(slot, ubo, 320)
    px := milli_to_f32(x_milli)
    py := milli_to_f32(y_milli)
    pz := milli_to_f32(z_milli)
    sx := milli_to_f32(sx_milli)
    sy := milli_to_f32(sy_milli)
    sz := milli_to_f32(sz_milli)
    rx := e7_f32_div(e7_f32_from_i64(rx_milli), 1000.0)
    ry := e7_f32_div(e7_f32_from_i64(ry_milli), 1000.0)
    rz := e7_f32_div(e7_f32_from_i64(rz_milli), 1000.0)
    cx := e7_f32_cos(rx)
    sxr := e7_f32_sin(rx)
    cy := e7_f32_cos(ry)
    syr := e7_f32_sin(ry)
    cz := e7_f32_cos(rz)
    szr := e7_f32_sin(rz)
    m00 := e7_f32_add(e7_f32_mul(cy, cz), e7_f32_mul(e7_f32_mul(syr, sxr), szr))
    m01 := e7_f32_sub(e7_f32_mul(e7_f32_mul(syr, sxr), cz), e7_f32_mul(cy, szr))
    m02 := e7_f32_mul(syr, cx)
    m10 := e7_f32_mul(cx, szr)
    m11 := e7_f32_mul(cx, cz)
    m12 := e7_f32_neg(sxr)
    m20 := e7_f32_sub(e7_f32_mul(e7_f32_mul(cy, sxr), szr), e7_f32_mul(syr, cz))
    m21 := e7_f32_add(e7_f32_mul(syr, szr), e7_f32_mul(e7_f32_mul(cy, sxr), cz))
    m22 := e7_f32_mul(cy, cx)
    e7_store_f32(slot, e7_f32_mul(m00, sx))
    e7_store_f32(slot + 4, e7_f32_mul(m10, sx))
    e7_store_f32(slot + 8, e7_f32_mul(m20, sx))
    e7_store_f32(slot + 12, 0.0)
    e7_store_f32(slot + 16, e7_f32_mul(m01, sy))
    e7_store_f32(slot + 20, e7_f32_mul(m11, sy))
    e7_store_f32(slot + 24, e7_f32_mul(m21, sy))
    e7_store_f32(slot + 28, 0.0)
    e7_store_f32(slot + 32, e7_f32_mul(m02, sz))
    e7_store_f32(slot + 36, e7_f32_mul(m12, sz))
    e7_store_f32(slot + 40, e7_f32_mul(m22, sz))
    e7_store_f32(slot + 44, 0.0)
    e7_store_f32(slot + 48, px)
    e7_store_f32(slot + 52, py)
    e7_store_f32(slot + 56, pz)
    e7_store_f32(slot + 60, 1.0)
    e7_store_f32(slot + 256, e7_f32_div(e7_f32_from_i64(r_milli), 1000.0))
    e7_store_f32(slot + 260, e7_f32_div(e7_f32_from_i64(g_milli), 1000.0))
    e7_store_f32(slot + 264, e7_f32_div(e7_f32_from_i64(b_milli), 1000.0))
    e7_store_f32(slot + 268, 1.0)

# ---------------------------------------------------------------------------
# Procedural shape geometry (sphere / capsule / plane)
#
# Box draws keep the shared 8-vertex cube buffer.  Sphere, capsule and plane
# meshes are generated once per scene on the CPU and uploaded into host-visible
# mapped buffers; their draws use the existing 32-byte-stride lit pipeline
# (position xyz at 0, neutral vertex colour at 12, 8 bytes padding).  The
# meshes are unit-sized like the shared cube (half extent 0.5):
#   * sphere radius 0.5 (16 stacks x 24 slices),
#   * capsule radius 0.5, cap rings at y=+/-0.5 and poles at y=+/-1
#     (24 slices, 8 cap stacks, closed cylinder band),
#   * plane spanning [-0.5, 0.5] on XZ at y=0 (the Y scale is ignored).
# Vertex totals: sphere 425, capsule 450, plane 4 -> 879 * 32 = 28128 bytes.
# Index totals:  sphere 2304, capsule 2448, plane 6 -> 4758 * 2 = 9516 bytes.
# Scene state: 1320/1328 vertex buffer/memory, 1336/1344 index buffer/memory,
# 1360 + kind * 8 first index (u32) + index count.
# ---------------------------------------------------------------------------

shape_write_vertex <- (vertices: u64, index: i64, x: f32, y: f32, z: f32) -> nil:
    offset := vertices + (index * 32) as u64
    e7_store_f32(offset, x)
    e7_store_f32(offset + 4, y)
    e7_store_f32(offset + 8, z)
    e7_store_f32(offset + 12, 1.0)
    e7_store_f32(offset + 16, 1.0)
    e7_store_f32(offset + 20, 1.0)
    e7_store_f32(offset + 24, 0.0)
    e7_store_f32(offset + 28, 0.0)

shape_write_index <- (indices: u64, at: i64, vertex: i64) -> nil:
    e7_store_u16(indices + (at * 2) as u64, vertex)

# UV sphere, radius 0.5, neutral white vertex colour (the per-object tint and
# texture come from the lit UBO/descriptors).  The float helper calls in the
# loop bodies also put this function under the LLVM instcombine fixed-point
# attribute that loop-heavy stack-machine IR needs on LLVM 23.
shape_generate_sphere <- (vertices: u64, indices: u64) -> nil:
    stacks := 16
    slices := 24
    radius: f32 := 0.5
    row_stride := slices + 1
    stack := 0
    slice := 0
    at := 0
    while stack <= stacks:
        theta := e7_f32_mul(e7_f32_div(e7_f32_from_i64(stack), e7_f32_from_i64(stacks)), 3.141592653589793)
        sin_theta := e7_f32_sin(theta)
        cos_theta := e7_f32_cos(theta)
        slice = 0
        while slice <= slices:
            phi := e7_f32_mul(e7_f32_div(e7_f32_from_i64(slice), e7_f32_from_i64(slices)), 6.283185307179586)
            x := e7_f32_mul(e7_f32_mul(sin_theta, e7_f32_cos(phi)), radius)
            y := e7_f32_mul(cos_theta, radius)
            z := e7_f32_mul(e7_f32_mul(sin_theta, e7_f32_sin(phi)), radius)
            shape_write_vertex(vertices, stack * row_stride + slice, x, y, z)
            slice = slice + 1
        stack = stack + 1
    stack = 0
    while stack < stacks:
        slice = 0
        while slice < slices:
            a := stack * row_stride + slice
            b := a + 1
            below := a + row_stride
            below_right := below + 1
            shape_write_index(indices, at, a)
            shape_write_index(indices, at + 1, below)
            shape_write_index(indices, at + 2, b)
            shape_write_index(indices, at + 3, b)
            shape_write_index(indices, at + 4, below)
            shape_write_index(indices, at + 5, below_right)
            at = at + 6
            slice = slice + 1
        stack = stack + 1

# Capsule along Y: radius 0.5, hemispherical caps centred at y=+/-0.5 (rings at
# y=+/-0.5, poles at y=+/-1) and a closed cylinder band between the two rings.
shape_generate_capsule <- (vertices: u64, indices: u64, base_vertex: i64, base_index: i64) -> nil:
    slices := 24
    cap_stacks := 8
    rows := cap_stacks + 1
    row_stride := slices + 1
    radius: f32 := 0.5
    cap_center: f32 := 0.5
    bottom_base := rows * row_stride
    stack := 0
    slice := 0
    at := base_index
    cap_base := base_vertex
    cap := 0
    while stack <= cap_stacks:
        theta := e7_f32_mul(e7_f32_div(e7_f32_from_i64(stack), e7_f32_from_i64(cap_stacks)), 1.5707963267948966)
        sin_theta := e7_f32_sin(theta)
        cos_theta := e7_f32_cos(theta)
        cap_y := e7_f32_mul(cos_theta, radius)
        slice = 0
        while slice <= slices:
            phi := e7_f32_mul(e7_f32_div(e7_f32_from_i64(slice), e7_f32_from_i64(slices)), 6.283185307179586)
            x := e7_f32_mul(e7_f32_mul(sin_theta, e7_f32_cos(phi)), radius)
            z := e7_f32_mul(e7_f32_mul(sin_theta, e7_f32_sin(phi)), radius)
            shape_write_vertex(vertices, base_vertex + stack * row_stride + slice, x, e7_f32_add(cap_center, cap_y), z)
            shape_write_vertex(vertices, base_vertex + bottom_base + stack * row_stride + slice, x, e7_f32_sub(0.0 - cap_center, cap_y), z)
            slice = slice + 1
        stack = stack + 1
    while cap < 2:
        stack = 0
        while stack < cap_stacks:
            slice = 0
            while slice < slices:
                a := cap_base + stack * row_stride + slice
                b := a + 1
                below := a + row_stride
                below_right := below + 1
                shape_write_index(indices, at, a)
                shape_write_index(indices, at + 1, below)
                shape_write_index(indices, at + 2, b)
                shape_write_index(indices, at + 3, b)
                shape_write_index(indices, at + 4, below)
                shape_write_index(indices, at + 5, below_right)
                at = at + 6
                slice = slice + 1
            stack = stack + 1
        cap_base = cap_base + bottom_base
        cap = cap + 1
    top_ring := base_vertex + (rows - 1) * row_stride
    bottom_ring := base_vertex + bottom_base + (rows - 1) * row_stride
    slice = 0
    while slice < slices:
        a := top_ring + slice
        b := a + 1
        below := bottom_ring + slice
        below_right := below + 1
        shape_write_index(indices, at, a)
        shape_write_index(indices, at + 1, below)
        shape_write_index(indices, at + 2, b)
        shape_write_index(indices, at + 3, b)
        shape_write_index(indices, at + 4, below)
        shape_write_index(indices, at + 5, below_right)
        at = at + 6
        slice = slice + 1

# Flat XZ plane spanning [-0.5, 0.5] with a +Y facing quad at y=0.
shape_generate_plane <- (vertices: u64, indices: u64, base_vertex: i64, base_index: i64) -> nil:
    shape_write_vertex(vertices, base_vertex, 0.0 - 0.5, 0.0, 0.0 - 0.5)
    shape_write_vertex(vertices, base_vertex + 1, 0.5, 0.0, 0.0 - 0.5)
    shape_write_vertex(vertices, base_vertex + 2, 0.5, 0.0, 0.5)
    shape_write_vertex(vertices, base_vertex + 3, 0.0 - 0.5, 0.0, 0.5)
    shape_write_index(indices, base_index, base_vertex)
    shape_write_index(indices, base_index + 1, base_vertex + 1)
    shape_write_index(indices, base_index + 2, base_vertex + 2)
    shape_write_index(indices, base_index + 3, base_vertex)
    shape_write_index(indices, base_index + 4, base_vertex + 2)
    shape_write_index(indices, base_index + 5, base_vertex + 3)

# Allocate and fill the procedural shape meshes.  Returns 0 when the mapped
# buffers cannot be created; draws then keep the former cube fallback.
shape_geometry_create <- (scene: u64) -> i64:
    device := e7_load_u64(scene + 32)
    physical := e7_load_u64(scene + 24)
    vertex_buffer_out := e7_alloc_bytes(8)
    vertex_memory_out := e7_alloc_bytes(8)
    vertex_mapped_out := e7_alloc_bytes(8)
    index_buffer_out := e7_alloc_bytes(8)
    index_memory_out := e7_alloc_bytes(8)
    index_mapped_out := e7_alloc_bytes(8)
    if vulkan_dynamic_buffer(device, physical, 28128, 128, vertex_buffer_out, vertex_memory_out, vertex_mapped_out) == 0:
        e7_free_ptr(vertex_buffer_out)
        e7_free_ptr(vertex_memory_out)
        e7_free_ptr(vertex_mapped_out)
        e7_free_ptr(index_buffer_out)
        e7_free_ptr(index_memory_out)
        e7_free_ptr(index_mapped_out)
        ret 0
    if vulkan_dynamic_buffer(device, physical, 9516, 64, index_buffer_out, index_memory_out, index_mapped_out) == 0:
        vulkan_vertex_buffer_destroy(device, e7_load_u64(vertex_buffer_out), e7_load_u64(vertex_memory_out))
        e7_free_ptr(vertex_buffer_out)
        e7_free_ptr(vertex_memory_out)
        e7_free_ptr(vertex_mapped_out)
        e7_free_ptr(index_buffer_out)
        e7_free_ptr(index_memory_out)
        e7_free_ptr(index_mapped_out)
        ret 0
    vertices := e7_load_u64(vertex_mapped_out) as u64
    indices := e7_load_u64(index_mapped_out) as u64
    shape_generate_sphere(vertices, indices)
    shape_generate_capsule(vertices, indices, 425, 2304)
    shape_generate_plane(vertices, indices, 875, 4752)
    e7_store_u64(scene + 1320, e7_load_u64(vertex_buffer_out))
    e7_store_u64(scene + 1328, e7_load_u64(vertex_memory_out))
    e7_store_u64(scene + 1336, e7_load_u64(index_buffer_out))
    e7_store_u64(scene + 1344, e7_load_u64(index_memory_out))
    # Per-kind index ranges, looked up as scene + 1360 + kind * 8.
    e7_store_u32(scene + 1368, 0)
    e7_store_u32(scene + 1372, 2304)
    e7_store_u32(scene + 1376, 2304)
    e7_store_u32(scene + 1380, 2448)
    e7_store_u32(scene + 1384, 4752)
    e7_store_u32(scene + 1388, 6)
    e7_free_ptr(vertex_buffer_out)
    e7_free_ptr(vertex_memory_out)
    e7_free_ptr(vertex_mapped_out)
    e7_free_ptr(index_buffer_out)
    e7_free_ptr(index_memory_out)
    e7_free_ptr(index_mapped_out)
    ret 1

# Record one procedural draw.  Kind 0 (box) uses the shared cube buffer; kinds
# 1..3 (sphere, capsule, plane) use the per-kind geometry generated at scene
# creation.  The transform, full XYZ Euler rotation, tint and texture id are
# honored for every kind; an unknown kind or unavailable procedural buffers
# fall back to the cube.
scene_draw_shape_rot <- (scene: u64, shape: i32, x: i64, y: i64, z: i64, sx: i64, sy: i64, sz: i64, rx: i64, ry: i64, rz: i64, r: i64, g: i64, b: i64, texture: u64) -> nil:
    if scene == 0:
        ret
    count := e7_load_u32(scene + 1300)
    if count >= 24:
        ret
    kind := shape as i64
    if kind >= 1 and kind <= 3:
        shape_vertices := e7_load_u64(scene + 1320)
        shape_indices := e7_load_u64(scene + 1336)
        wide_pipeline := e7_load_u64(scene + 1304)
        if shape_vertices != 0 and shape_indices != 0 and wide_pipeline != 0:
            write_object_slot(scene, count, x, y, z, sx, sy, sz, rx, ry, rz, r, g, b)
            append_draw(
                scene,
                wide_pipeline,
                e7_load_u64(scene + 1312),
                shape_vertices,
                shape_indices,
                e7_load_u32(scene + (1364 + kind * 8) as u64),
                0,
                e7_load_u32(scene + (1360 + kind * 8) as u64),
                0,
                e7_load_u64(scene + 128),
                1,
                count * 320,
                texture_set_lit(scene, texture as i64),
            )
            ret
    write_object_slot(scene, count, x, y, z, sx, sy, sz, rx, ry, rz, r, g, b)
    pipeline := e7_load_u64(scene + 1256)
    layout := e7_load_u64(scene + 1264)
    set1 := texture_set_lit(scene, texture as i64)
    if pipeline == 0:
        # Lit pipeline unavailable: vertex-colour mesh pipeline has no texture.
        pipeline = e7_load_u64(scene + 160)
        layout = e7_load_u64(scene + 168)
        set1 = 0
    append_draw(scene, pipeline, layout, e7_load_u64(scene + 176), e7_load_u64(scene + 192), 36, 0, 0, 0, e7_load_u64(scene + 128), 1, count * 320, set1)

scene_draw_box <- (scene: u64, x_milli: i64, y_milli: i64, z_milli: i64, sx_milli: i64, sy_milli: i64, sz_milli: i64, r_milli: i64, g_milli: i64, b_milli: i64, angle_milli: i64) -> nil:
    scene_draw_shape_rot(scene, 0, x_milli, y_milli, z_milli, sx_milli, sy_milli, sz_milli, 0, angle_milli, 0, r_milli, g_milli, b_milli, 0 as u64)

# Record a draw of an uploaded OBJ mesh.  Mesh layout 0 is the engine OBJ
# interleaved format (position xyz, normal xyz, uv xy -> 32-byte stride) with
# 32-bit indices, consumed by the wide lit pipeline.
scene_draw_custom <- (scene: u64, mesh: u64, x: i64, y: i64, z: i64, sx: i64, sy: i64, sz: i64, rx: i64, ry: i64, rz: i64, r: i64, g: i64, b: i64, texture: u64) -> nil:
    if scene == 0:
        ret
    mesh_count := e7_load_u32(scene + 1296)
    pipeline := e7_load_u64(scene + 1304)
    if mesh == 0 or (mesh as i64) > mesh_count or pipeline == 0:
        # Unknown mesh or missing pipeline: documented box approximation.
        scene_draw_shape_rot(scene, 0, x, y, z, sx, sy, sz, rx, ry, rz, r, g, b, texture)
        ret
    count := e7_load_u32(scene + 1300)
    if count >= 24:
        ret
    write_object_slot(scene, count, x, y, z, sx, sy, sz, rx, ry, rz, r, g, b)
    extra := e7_load_u64(scene + 1280)
    entry := extra + 9440 + (mesh as i64 - 1) * 48
    append_draw(scene, pipeline, e7_load_u64(scene + 1312), e7_load_u64(entry), e7_load_u64(entry + 16), e7_load_u32(entry + 32), 1, 0, 0, e7_load_u64(scene + 128), 1, count * 320, texture_set_lit(scene, texture as i64))

# Capture the recorded frame.  The main draw is degenerate (zero indices); all
# object and UI draws live in the extension list so each keeps its own pipeline,
# material texture and dynamic UBO slot.  A non-zero `present` additionally
# presents the acquired swapchain image for desktop windows.
scene_draw_with_present <- (scene: u64, out_pixels: u64, out_size: u64, present: i64) -> i64:
    extra := e7_load_u64(scene + 1280)
    count := e7_load_u32(scene + 1300)
    pipeline := e7_load_u64(scene + 1256)
    layout := e7_load_u64(scene + 1264)
    texture := e7_load_u64(scene + 1072)
    if pipeline == 0:
        pipeline = e7_load_u64(scene + 160)
        layout = e7_load_u64(scene + 168)
        texture = 0
    ret vulkan_capture_frame(
        e7_load_u64(scene + 32),
        e7_load_u64(scene + 40),
        e7_load_u32(scene + 48),
        e7_load_u64(scene + 24),
        e7_load_u64(scene + 56),
        e7_load_u64(scene + 64),
        pipeline,
        e7_load_u64(scene + 80),
        e7_load_u32(scene + 52),
        e7_load_u32(scene + 88),
        e7_load_u32(scene + 92),
        e7_load_u64(scene + 176),
        e7_load_u64(scene + 192),
        0,
        e7_load_u64(scene + 128),
        layout,
        0,
        1,
        texture,
        1,
        0,
        out_pixels,
        out_size,
        extra as u64,
        count,
        present,
    )

scene_draw <- (scene: u64, out_pixels: u64, out_size: u64) -> i64:
    ret scene_draw_with_present(scene, out_pixels, out_size, 0)

# Capture a frame and present it to the window (visible desktop engine path).
scene_draw_present <- (scene: u64, out_pixels: u64, out_size: u64) -> i64:
    ret scene_draw_with_present(scene, out_pixels, out_size, 1)

scene_draw_static <- (scene: u64, out_pixels: u64, out_size: u64) -> i64:
    ret vulkan_draw_triangle_capture(
        e7_load_u64(scene + 32),
        e7_load_u64(scene + 40),
        e7_load_u32(scene + 48),
        e7_load_u64(scene + 24),
        e7_load_u64(scene + 56),
        e7_load_u64(scene + 64),
        e7_load_u64(scene + 1160),
        e7_load_u64(scene + 80),
        e7_load_u32(scene + 52),
        e7_load_u32(scene + 88),
        e7_load_u32(scene + 92),
        e7_load_u64(scene + 176),
        e7_load_u64(scene + 192),
        36,
        e7_load_u64(scene + 1152),
        e7_load_u64(scene + 1168),
        0,
        0,
        0,
        1,
        0,
        out_pixels,
        out_size,
    )

scene_draw_textured <- (scene: u64, out_pixels: u64, out_size: u64) -> i64:
    ret vulkan_draw_triangle_capture(
        e7_load_u64(scene + 32),
        e7_load_u64(scene + 40),
        e7_load_u32(scene + 48),
        e7_load_u64(scene + 24),
        e7_load_u64(scene + 56),
        e7_load_u64(scene + 64),
        e7_load_u64(scene + 1176),
        e7_load_u64(scene + 80),
        e7_load_u32(scene + 52),
        e7_load_u32(scene + 88),
        e7_load_u32(scene + 92),
        0,
        0,
        0,
        e7_load_u64(scene + 1152),
        e7_load_u64(scene + 1184),
        0,
        0,
        0,
        1,
        0,
        out_pixels,
        out_size,
    )

scene_draw_two <- (scene: u64, out_pixels: u64, out_size: u64) -> i64:
    ret vulkan_draw_triangle_capture(
        e7_load_u64(scene + 32),
        e7_load_u64(scene + 40),
        e7_load_u32(scene + 48),
        e7_load_u64(scene + 24),
        e7_load_u64(scene + 56),
        e7_load_u64(scene + 64),
        e7_load_u64(scene + 1240),
        e7_load_u64(scene + 80),
        e7_load_u32(scene + 52),
        e7_load_u32(scene + 88),
        e7_load_u32(scene + 92),
        e7_load_u64(scene + 176),
        e7_load_u64(scene + 192),
        36,
        e7_load_u64(scene + 128),
        e7_load_u64(scene + 1248),
        0,
        1,
        e7_load_u64(scene + 1072),
        1,
        0,
        out_pixels,
        out_size,
    )

scene_draw_lit <- (scene: u64, out_pixels: u64, out_size: u64) -> i64:
    ret vulkan_draw_triangle_capture(
        e7_load_u64(scene + 32),
        e7_load_u64(scene + 40),
        e7_load_u32(scene + 48),
        e7_load_u64(scene + 24),
        e7_load_u64(scene + 56),
        e7_load_u64(scene + 64),
        e7_load_u64(scene + 1256),
        e7_load_u64(scene + 80),
        e7_load_u32(scene + 52),
        e7_load_u32(scene + 88),
        e7_load_u32(scene + 92),
        e7_load_u64(scene + 176),
        e7_load_u64(scene + 192),
        36,
        e7_load_u64(scene + 128),
        e7_load_u64(scene + 1264),
        0,
        1,
        e7_load_u64(scene + 1072),
        1,
        0,
        out_pixels,
        out_size,
    )

# Replace the UI quad texture with tightly packed RGBA8 pixels (text/image
# raster output) and repoint the static UI descriptor set.
scene_set_ui_texture <- (scene: u64, pixels: u64, width: i64, height: i64) -> i64:
    device := e7_load_u64(scene + 32)
    physical := e7_load_u64(scene + 24)
    image_out := e7_alloc_bytes(8)
    memory_out := e7_alloc_bytes(8)
    view_out := e7_alloc_bytes(8)
    sampler_out := e7_alloc_bytes(8)
    if vulkan_texture_empty(device, physical, width, height, image_out, memory_out, view_out, sampler_out) == 0:
        e7_free_ptr(image_out)
        e7_free_ptr(memory_out)
        e7_free_ptr(view_out)
        e7_free_ptr(sampler_out)
        ret 0
    image := e7_load_u64(image_out)
    memory := e7_load_u64(memory_out)
    view := e7_load_u64(view_out)
    sampler := e7_load_u64(sampler_out)
    if vulkan_texture_upload(device, e7_load_u64(scene + 40), e7_load_u32(scene + 48), physical, image, pixels, width, height) == 0:
        vulkan_texture_empty_destroy(device, image, memory, view, sampler)
        e7_free_ptr(image_out)
        e7_free_ptr(memory_out)
        e7_free_ptr(view_out)
        e7_free_ptr(sampler_out)
        ret 0
    vulkan_texture_descriptor_write(device, e7_load_u64(scene + 1152), view, sampler)
    vulkan_texture_empty_destroy(device, e7_load_u64(scene + 1024), e7_load_u64(scene + 1032), e7_load_u64(scene + 1040), e7_load_u64(scene + 1048))
    e7_store_u64(scene + 1024, image)
    e7_store_u64(scene + 1032, memory)
    e7_store_u64(scene + 1040, view)
    e7_store_u64(scene + 1048, sampler)
    e7_free_ptr(image_out)
    e7_free_ptr(memory_out)
    e7_free_ptr(view_out)
    e7_free_ptr(sampler_out)
    ret 1

# ---------------------------------------------------------------------------
# Engine textures, meshes, and screen-space UI quads
# ---------------------------------------------------------------------------

push_texture_free <- (scene: u64, index: i64) -> nil:
    extra := e7_load_u64(scene + 1280)
    if extra == 0:
        ret
    free_count := e7_load_u32(scene + 1292)
    if free_count >= 24:
        ret
    e7_store_u32(extra + 9344 + free_count * 4, index)
    e7_store_u32(scene + 1292, free_count + 1)

# Upload an e7 image (text glyph or material image) as a sampled texture with
# its own combined-image-sampler descriptor set.  Returns a stable non-zero
# texture id (1..24); id 0 is the built-in white texture.
scene_texture_create <- (scene: u64, image: u64) -> i64:
    if scene == 0 or image == 0:
        ret 0
    width := e7_image_width(image)
    height := e7_image_height(image)
    if width <= 0 or height <= 0:
        ret 0
    pixels := e7_image_pixels(image)
    pixels_ptr := e7_str_data(pixels)
    if pixels_ptr == 0:
        ret 0
    extra := e7_load_u64(scene + 1280)
    if extra == 0:
        ret 0
    free_count := e7_load_u32(scene + 1292)
    index := -1
    if free_count > 0:
        free_count = free_count - 1
        index = e7_load_u32(extra + 9344 + free_count * 4)
        e7_store_u32(scene + 1292, free_count)
    else:
        count := e7_load_u32(scene + 1288)
        if count >= 24:
            ret 0
        index = count
        e7_store_u32(scene + 1288, count + 1)
    device := e7_load_u64(scene + 32)
    physical := e7_load_u64(scene + 24)
    image_out := e7_alloc_bytes(8)
    memory_out := e7_alloc_bytes(8)
    view_out := e7_alloc_bytes(8)
    sampler_out := e7_alloc_bytes(8)
    if vulkan_texture_empty(device, physical, width, height, image_out, memory_out, view_out, sampler_out) == 0:
        push_texture_free(scene, index)
        e7_free_ptr(image_out)
        e7_free_ptr(memory_out)
        e7_free_ptr(view_out)
        e7_free_ptr(sampler_out)
        ret 0
    texture_image := e7_load_u64(image_out)
    texture_memory := e7_load_u64(memory_out)
    texture_view := e7_load_u64(view_out)
    texture_sampler := e7_load_u64(sampler_out)
    if vulkan_texture_upload(device, e7_load_u64(scene + 40), e7_load_u32(scene + 48), physical, texture_image, pixels_ptr, width, height) == 0:
        vulkan_texture_empty_destroy(device, texture_image, texture_memory, texture_view, texture_sampler)
        push_texture_free(scene, index)
        e7_free_ptr(image_out)
        e7_free_ptr(memory_out)
        e7_free_ptr(view_out)
        e7_free_ptr(sampler_out)
        ret 0
    layout_out := e7_alloc_bytes(8)
    pool_out := e7_alloc_bytes(8)
    set_out := e7_alloc_bytes(8)
    if vulkan_texture_descriptor_static(device, texture_view, texture_sampler, layout_out, pool_out, set_out) == 0:
        vulkan_texture_empty_destroy(device, texture_image, texture_memory, texture_view, texture_sampler)
        push_texture_free(scene, index)
        e7_free_ptr(image_out)
        e7_free_ptr(memory_out)
        e7_free_ptr(view_out)
        e7_free_ptr(sampler_out)
        e7_free_ptr(layout_out)
        e7_free_ptr(pool_out)
        e7_free_ptr(set_out)
        ret 0
    lit_layout_out := e7_alloc_bytes(8)
    lit_pool_out := e7_alloc_bytes(8)
    lit_set_out := e7_alloc_bytes(8)
    if vulkan_texture_descriptor_one(device, texture_view, texture_sampler, lit_layout_out, lit_pool_out, lit_set_out) == 0:
        vulkan_texture_empty_destroy(device, texture_image, texture_memory, texture_view, texture_sampler)
        vulkan_texture_descriptor_one_destroy(device, e7_load_u64(layout_out), e7_load_u64(pool_out))
        push_texture_free(scene, index)
        e7_free_ptr(image_out)
        e7_free_ptr(memory_out)
        e7_free_ptr(view_out)
        e7_free_ptr(sampler_out)
        e7_free_ptr(layout_out)
        e7_free_ptr(pool_out)
        e7_free_ptr(set_out)
        e7_free_ptr(lit_layout_out)
        e7_free_ptr(lit_pool_out)
        e7_free_ptr(lit_set_out)
        ret 0
    entry := extra + 7040 + index * 96
    e7_store_u64(entry, texture_image)
    e7_store_u64(entry + 8, texture_memory)
    e7_store_u64(entry + 16, texture_view)
    e7_store_u64(entry + 24, texture_sampler)
    e7_store_u64(entry + 32, e7_load_u64(set_out))
    e7_store_u64(entry + 40, e7_load_u64(layout_out))
    e7_store_u64(entry + 48, e7_load_u64(pool_out))
    e7_store_u64(entry + 56, e7_load_u64(lit_set_out))
    e7_store_u64(entry + 64, e7_load_u64(lit_layout_out))
    e7_store_u64(entry + 72, e7_load_u64(lit_pool_out))
    e7_store_u32(entry + 80, width)
    e7_store_u32(entry + 84, height)
    e7_free_ptr(image_out)
    e7_free_ptr(memory_out)
    e7_free_ptr(view_out)
    e7_free_ptr(sampler_out)
    e7_free_ptr(layout_out)
    e7_free_ptr(pool_out)
    e7_free_ptr(set_out)
    e7_free_ptr(lit_layout_out)
    e7_free_ptr(lit_pool_out)
    e7_free_ptr(lit_set_out)
    ret index + 1

release_texture <- (scene: u64, index: i64) -> nil:
    extra := e7_load_u64(scene + 1280)
    if extra == 0:
        ret
    entry := extra + 7040 + index * 96
    image := e7_load_u64(entry)
    if image == 0:
        ret
    device := e7_load_u64(scene + 32)
    vulkan_texture_empty_destroy(device, image, e7_load_u64(entry + 8), e7_load_u64(entry + 16), e7_load_u64(entry + 24))
    if e7_load_u64(entry + 40) != 0:
        vulkan_texture_descriptor_one_destroy(device, e7_load_u64(entry + 40), e7_load_u64(entry + 48))
    if e7_load_u64(entry + 64) != 0:
        vulkan_texture_descriptor_one_destroy(device, e7_load_u64(entry + 64), e7_load_u64(entry + 72))
    e7_store_u64(entry, 0)
    e7_store_u64(entry + 8, 0)
    e7_store_u64(entry + 16, 0)
    e7_store_u64(entry + 24, 0)
    e7_store_u64(entry + 32, 0)
    e7_store_u64(entry + 40, 0)
    e7_store_u64(entry + 48, 0)
    e7_store_u64(entry + 56, 0)
    e7_store_u64(entry + 64, 0)
    e7_store_u64(entry + 72, 0)
    e7_store_u32(entry + 80, 0)
    e7_store_u32(entry + 84, 0)

scene_texture_destroy <- (scene: u64, texture: u64) -> nil:
    if scene == 0 or texture == 0:
        ret
    count := e7_load_u32(scene + 1288)
    if (texture as i64) > count:
        ret
    index := (texture as i64) - 1
    extra := e7_load_u64(scene + 1280)
    if extra == 0:
        ret
    entry := extra + 7040 + index * 96
    if e7_load_u64(entry) == 0:
        ret
    release_texture(scene, index)
    push_texture_free(scene, index)

# Upload OBJ vertex/index data.  Layout 0 is the engine OBJ interleaved 8-float
# vertex format (32-byte stride) plus 32-bit indices; the wide lit pipeline
# consumes it directly.  Returns a stable non-zero mesh id.
scene_mesh_upload <- (scene: u64, vertices: [f32], indices: [i32], layout: i32) -> i64:
    if scene == 0:
        ret 0
    vertex_floats := vertices.len() as i64
    index_count := indices.len() as i64
    if vertex_floats <= 0 or index_count <= 0:
        ret 0
    count := e7_load_u32(scene + 1296)
    if count >= 8:
        ret 0
    extra := e7_load_u64(scene + 1280)
    if extra == 0:
        ret 0
    vertex_bytes := vertex_floats * 4
    index_bytes := index_count * 4
    device := e7_load_u64(scene + 32)
    physical := e7_load_u64(scene + 24)
    vertex_buffer_out := e7_alloc_bytes(8)
    vertex_memory_out := e7_alloc_bytes(8)
    vertex_mapped_out := e7_alloc_bytes(8)
    if vulkan_dynamic_buffer(device, physical, vertex_bytes, 128, vertex_buffer_out, vertex_memory_out, vertex_mapped_out) == 0:
        e7_free_ptr(vertex_buffer_out)
        e7_free_ptr(vertex_memory_out)
        e7_free_ptr(vertex_mapped_out)
        ret 0
    index_buffer_out := e7_alloc_bytes(8)
    index_memory_out := e7_alloc_bytes(8)
    index_mapped_out := e7_alloc_bytes(8)
    if vulkan_dynamic_buffer(device, physical, index_bytes, 64, index_buffer_out, index_memory_out, index_mapped_out) == 0:
        vulkan_vertex_buffer_destroy(device, e7_load_u64(vertex_buffer_out), e7_load_u64(vertex_memory_out))
        e7_free_ptr(vertex_buffer_out)
        e7_free_ptr(vertex_memory_out)
        e7_free_ptr(vertex_mapped_out)
        e7_free_ptr(index_buffer_out)
        e7_free_ptr(index_memory_out)
        e7_free_ptr(index_mapped_out)
        ret 0
    # e7 [f32]/[i32] aggregates store each element in an 8-byte slot, so the
    # GPU buffers are filled element by element into tightly packed 32-bit
    # values (indexing also gives this loop the JIT fixpoint attribute).  The
    # OBJ 8-float vertex (position, normal, uv) is uploaded as the lit
    # pipeline's 32-byte layout: position xyz, white vertex colour, uv.  The
    # lit vertex stage derives its uv from position.xy, so the normal slot is
    # repurposed as neutral colour and the material tint/texture drive shading.
    vertex_mapped := e7_load_u64(vertex_mapped_out)
    vertex_records := vertex_floats / 8
    vertex_index := 0
    while vertex_index < vertex_records:
        source := vertex_index * 8
        destination := vertex_mapped + vertex_index * 32
        e7_store_f32(destination, vertices[source as usize])
        e7_store_f32(destination + 4, vertices[(source + 1) as usize])
        e7_store_f32(destination + 8, vertices[(source + 2) as usize])
        e7_store_f32(destination + 12, 1.0)
        e7_store_f32(destination + 16, 1.0)
        e7_store_f32(destination + 20, 1.0)
        e7_store_f32(destination + 24, vertices[(source + 6) as usize])
        e7_store_f32(destination + 28, vertices[(source + 7) as usize])
        vertex_index = vertex_index + 1
    index_mapped := e7_load_u64(index_mapped_out)
    index_position := 0
    while index_position < index_count:
        e7_store_u32(index_mapped + index_position * 4, indices[index_position as usize])
        index_position = index_position + 1
    entry := extra + 9440 + count * 48
    e7_store_u64(entry, e7_load_u64(vertex_buffer_out))
    e7_store_u64(entry + 8, e7_load_u64(vertex_memory_out))
    e7_store_u64(entry + 16, e7_load_u64(index_buffer_out))
    e7_store_u64(entry + 24, e7_load_u64(index_memory_out))
    e7_store_u32(entry + 32, index_count)
    e7_store_u32(entry + 36, 0)
    e7_store_u64(entry + 40, 0)
    e7_store_u32(scene + 1296, count + 1)
    e7_free_ptr(vertex_buffer_out)
    e7_free_ptr(vertex_memory_out)
    e7_free_ptr(vertex_mapped_out)
    e7_free_ptr(index_buffer_out)
    e7_free_ptr(index_memory_out)
    e7_free_ptr(index_mapped_out)
    ret count + 1

release_mesh <- (scene: u64, index: i64) -> nil:
    device := e7_load_u64(scene + 32)
    extra := e7_load_u64(scene + 1280)
    if extra == 0:
        ret
    entry := extra + 9440 + index * 48
    if e7_load_u64(entry) != 0:
        vulkan_vertex_buffer_destroy(device, e7_load_u64(entry), e7_load_u64(entry + 8))
    if e7_load_u64(entry + 16) != 0:
        vulkan_vertex_buffer_destroy(device, e7_load_u64(entry + 16), e7_load_u64(entry + 24))
    e7_store_u64(entry, 0)
    e7_store_u64(entry + 8, 0)
    e7_store_u64(entry + 16, 0)
    e7_store_u64(entry + 24, 0)
    e7_store_u32(entry + 32, 0)

# One UI vertex: position/uv in clip/texture space plus straight-alpha RGBA.
ui_vertex <- (mapped: i64, index: i64, px: f32, py: f32, u: f32, v: f32, cr: f32, cg: f32, cb: f32, ca: f32) -> nil:
    base := mapped + index * 32
    e7_store_f32(base, px)
    e7_store_f32(base + 4, py)
    e7_store_f32(base + 8, u)
    e7_store_f32(base + 12, v)
    e7_store_f32(base + 16, cr)
    e7_store_f32(base + 20, cg)
    e7_store_f32(base + 24, cb)
    e7_store_f32(base + 28, ca)

# Record one screen-space UI quad.  Pixel coordinates are top-left origin; the
# vertices are converted to Vulkan clip space here.  The quad samples its own
# texture descriptor (0 = built-in white) through the blended UI pipeline and
# is drawn after the 3D draws in record order.
scene_ui_quad <- (scene: u64, texture: u64, x: i64, y: i64, w: i64, h: i64, r: i64, g: i64, b: i64, a: i64) -> nil:
    if scene == 0:
        ret
    mapped := e7_load_u64(scene + 1224)
    pipeline := e7_load_u64(scene + 1192)
    if mapped == 0 or pipeline == 0:
        ret
    quad := e7_load_u32(scene + 1232)
    count := e7_load_u32(scene + 1300)
    if quad >= 64 or count >= 88:
        ret
    width := e7_f32_from_i64(e7_load_u32(scene + 88))
    height := e7_f32_from_i64(e7_load_u32(scene + 92))
    if e7_f32_le(width, 0.0):
        ret
    if e7_f32_le(height, 0.0):
        ret
    x0 := e7_f32_from_i64(x)
    x1 := e7_f32_add(x0, e7_f32_from_i64(w))
    y0 := e7_f32_from_i64(y)
    y1 := e7_f32_add(y0, e7_f32_from_i64(h))
    inv_w := e7_f32_div(2.0, width)
    inv_h := e7_f32_div(2.0, height)
    cx0 := e7_f32_sub(e7_f32_mul(x0, inv_w), 1.0)
    cx1 := e7_f32_sub(e7_f32_mul(x1, inv_w), 1.0)
    # Vulkan NDC y = -1 is the top of the framebuffer, so top-left pixel
    # coordinates map directly (y * 2 / height - 1).
    cy0 := e7_f32_sub(e7_f32_mul(y0, inv_h), 1.0)
    cy1 := e7_f32_sub(e7_f32_mul(y1, inv_h), 1.0)
    cr := e7_f32_abs(e7_f32_div(e7_f32_from_i64(r), 255.0))
    cg := e7_f32_abs(e7_f32_div(e7_f32_from_i64(g), 255.0))
    cb := e7_f32_abs(e7_f32_div(e7_f32_from_i64(b), 255.0))
    ca := e7_f32_abs(e7_f32_div(e7_f32_from_i64(a), 255.0))
    base := quad * 6
    ui_vertex(mapped, base, cx0, cy0, 0.0, 0.0, cr, cg, cb, ca)
    ui_vertex(mapped, base + 1, cx1, cy0, 1.0, 0.0, cr, cg, cb, ca)
    ui_vertex(mapped, base + 2, cx1, cy1, 1.0, 1.0, cr, cg, cb, ca)
    ui_vertex(mapped, base + 3, cx0, cy0, 0.0, 0.0, cr, cg, cb, ca)
    ui_vertex(mapped, base + 4, cx1, cy1, 1.0, 1.0, cr, cg, cb, ca)
    ui_vertex(mapped, base + 5, cx0, cy1, 0.0, 1.0, cr, cg, cb, ca)
    append_draw(scene, pipeline, e7_load_u64(scene + 1200), e7_load_u64(scene + 1208), 0, 6, 0, base, 1, texture_set(scene, texture as i64), 0, 0, 0)
    e7_store_u32(scene + 1232, quad + 1)

scene_destroy <- (scene: u64) -> nil:
    device := e7_load_u64(scene + 32)
    instance := e7_load_u64(scene + 8)
    surface := e7_load_u64(scene + 16)
    vulkan_graphics_pipeline_destroy(device, e7_load_u64(scene + 72), e7_load_u64(scene + 104))
    vulkan_depth_target_destroy(device, e7_load_u64(scene + 208), e7_load_u64(scene + 216), e7_load_u64(scene + 224))
    vulkan_texture_descriptor_one_destroy(device, e7_load_u64(scene + 1056), e7_load_u64(scene + 1064))
    vulkan_texture_empty_destroy(device, e7_load_u64(scene + 1024), e7_load_u64(scene + 1032), e7_load_u64(scene + 1040), e7_load_u64(scene + 1048))
    vulkan_texture_descriptor_one_destroy(device, e7_load_u64(scene + 1136), e7_load_u64(scene + 1144))
    vulkan_graphics_pipeline_destroy(device, e7_load_u64(scene + 160), e7_load_u64(scene + 168))
    if e7_load_u64(scene + 1192) != 0:
        vulkan_graphics_pipeline_destroy(device, e7_load_u64(scene + 1192), e7_load_u64(scene + 1200))
    if e7_load_u64(scene + 1256) != 0:
        vulkan_graphics_pipeline_destroy(device, e7_load_u64(scene + 1256), e7_load_u64(scene + 1264))
    if e7_load_u64(scene + 1304) != 0:
        vulkan_graphics_pipeline_destroy(device, e7_load_u64(scene + 1304), e7_load_u64(scene + 1312))
    if e7_load_u64(scene + 1208) != 0:
        vulkan_vertex_buffer_destroy(device, e7_load_u64(scene + 1208), e7_load_u64(scene + 1216))
    if e7_load_u64(scene + 1280) != 0:
        release_texture(scene, 0)
        release_texture(scene, 1)
        release_texture(scene, 2)
        release_texture(scene, 3)
        release_texture(scene, 4)
        release_texture(scene, 5)
        release_texture(scene, 6)
        release_texture(scene, 7)
        release_texture(scene, 8)
        release_texture(scene, 9)
        release_texture(scene, 10)
        release_texture(scene, 11)
        release_texture(scene, 12)
        release_texture(scene, 13)
        release_texture(scene, 14)
        release_texture(scene, 15)
        release_texture(scene, 16)
        release_texture(scene, 17)
        release_texture(scene, 18)
        release_texture(scene, 19)
        release_texture(scene, 20)
        release_texture(scene, 21)
        release_texture(scene, 22)
        release_texture(scene, 23)
        release_mesh(scene, 0)
        release_mesh(scene, 1)
        release_mesh(scene, 2)
        release_mesh(scene, 3)
        release_mesh(scene, 4)
        release_mesh(scene, 5)
        release_mesh(scene, 6)
        release_mesh(scene, 7)
        e7_free_ptr(e7_load_u64(scene + 1280))
    vulkan_uniform_resources_destroy(device, e7_load_u64(scene + 112), e7_load_u64(scene + 120), e7_load_u64(scene + 136), e7_load_u64(scene + 144))
    vulkan_vertex_buffer_destroy(device, e7_load_u64(scene + 176), e7_load_u64(scene + 184))
    vulkan_vertex_buffer_destroy(device, e7_load_u64(scene + 192), e7_load_u64(scene + 200))
    if e7_load_u64(scene + 1320) != 0:
        vulkan_vertex_buffer_destroy(device, e7_load_u64(scene + 1320), e7_load_u64(scene + 1328))
    if e7_load_u64(scene + 1336) != 0:
        vulkan_vertex_buffer_destroy(device, e7_load_u64(scene + 1336), e7_load_u64(scene + 1344))
    vulkan_render_targets_destroy(device, e7_load_u64(scene + 64), e7_load_u64(scene + 96), e7_load_u64(scene + 80), e7_load_u32(scene + 52))
    vulkan_swapchain_destroy(device, e7_load_u64(scene + 56))
    vulkan_device_destroy(device)
    vulkan_surface_destroy(instance, surface)
    vulkan_instance_destroy(instance)
    e7_free_ptr(scene)

# Convert milli-unit eye/yaw/pitch into view/projection matrices and write the
# engine SceneUniform block.  Matches the host renderer's FPS conventions:
# yaw 0 looks down -Z, +X right, Vulkan Y-flipped projection.
# Create a scene on a native `SDL_Window*` owned by the caller.  The scene
# creates its own Vulkan surface/swapchain but leaves window destruction to the
# owner.
scene_create_borrowed <- (native_window: u64, requested_width: i64, requested_height: i64) -> u64:
    state := e7_alloc_bytes(256)
    e7_store_u64(state, native_window)
    scene := scene_create(state, requested_width, requested_height)
    if scene == 0:
        e7_free_ptr(state)
        ret 0
    e7_store_u32(scene + 1272, 1)
    ret scene

scene_set_camera <- (scene: u64, eye_x_milli: i64, eye_y_milli: i64, eye_z_milli: i64, yaw_milli: i64, pitch_milli: i64) -> nil:
    ubo := e7_load_u64(scene + 152)
    if ubo == 0:
        ret
    degree := 0.000017453292519943295
    yaw := e7_f32_mul(e7_f32_from_i64(yaw_milli), degree)
    pitch := e7_f32_mul(e7_f32_from_i64(pitch_milli), degree)
    cos_p := e7_f32_cos(pitch)
    sin_p := e7_f32_sin(pitch)
    sin_y := e7_f32_sin(yaw)
    cos_y := e7_f32_cos(yaw)
    fx := e7_f32_mul(sin_y, cos_p)
    fy := sin_p
    fz := e7_f32_neg(e7_f32_mul(cos_y, cos_p))
    rx := e7_f32_neg(fz)
    rz := fx
    rlen := e7_f32_sqrt(e7_f32_add(e7_f32_mul(rx, rx), e7_f32_mul(rz, rz)))
    if e7_f32_gt(rlen, 0.0):
        rx = e7_f32_div(rx, rlen)
        rz = e7_f32_div(rz, rlen)
    ux := e7_f32_sub(e7_f32_mul(0.0, fz), e7_f32_mul(rz, fy))
    uy := e7_f32_sub(e7_f32_mul(rz, fx), e7_f32_mul(rx, fz))
    uz := e7_f32_sub(e7_f32_mul(rx, fy), e7_f32_mul(0.0, fx))
    bx := e7_f32_neg(fx)
    by := e7_f32_neg(fy)
    bz := e7_f32_neg(fz)
    ex := e7_f32_div(e7_f32_from_i64(eye_x_milli), 1000.0)
    ey := e7_f32_div(e7_f32_from_i64(eye_y_milli), 1000.0)
    ez := e7_f32_div(e7_f32_from_i64(eye_z_milli), 1000.0)
    dr := e7_f32_add(e7_f32_mul(rx, ex), e7_f32_add(e7_f32_mul(0.0, ey), e7_f32_mul(rz, ez)))
    du := e7_f32_add(e7_f32_mul(ux, ex), e7_f32_add(e7_f32_mul(uy, ey), e7_f32_mul(uz, ez)))
    db := e7_f32_add(e7_f32_mul(bx, ex), e7_f32_add(e7_f32_mul(by, ey), e7_f32_mul(bz, ez)))
    view := ubo + 64
    e7_store_f32(view, rx)
    e7_store_f32(view + 4, ux)
    e7_store_f32(view + 8, bx)
    e7_store_f32(view + 12, 0.0)
    e7_store_f32(view + 16, 0.0)
    e7_store_f32(view + 20, uy)
    e7_store_f32(view + 24, by)
    e7_store_f32(view + 28, 0.0)
    e7_store_f32(view + 32, rz)
    e7_store_f32(view + 36, uz)
    e7_store_f32(view + 40, bz)
    e7_store_f32(view + 44, 0.0)
    e7_store_f32(view + 48, e7_f32_neg(dr))
    e7_store_f32(view + 52, e7_f32_neg(du))
    e7_store_f32(view + 56, e7_f32_neg(db))
    e7_store_f32(view + 60, 1.0)
    half_fov := 0.5235987755982988
    tan_half := e7_f32_div(e7_f32_sin(half_fov), e7_f32_cos(half_fov))
    f := e7_f32_div(1.0, tan_half)
    width := e7_f32_from_i64(e7_load_u32(scene + 88))
    height := e7_f32_from_i64(e7_load_u32(scene + 92))
    aspect := 1.0
    if e7_f32_gt(height, 0.0):
        aspect = e7_f32_div(width, height)
    near := 0.1
    far := 100.0
    proj := ubo + 128
    e7_store_f32(proj, e7_f32_div(f, aspect))
    e7_store_f32(proj + 4, 0.0)
    e7_store_f32(proj + 8, 0.0)
    e7_store_f32(proj + 12, 0.0)
    e7_store_f32(proj + 16, 0.0)
    e7_store_f32(proj + 20, e7_f32_neg(f))
    e7_store_f32(proj + 24, 0.0)
    e7_store_f32(proj + 28, 0.0)
    e7_store_f32(proj + 32, 0.0)
    e7_store_f32(proj + 36, 0.0)
    e7_store_f32(proj + 40, e7_f32_div(far, e7_f32_sub(near, far)))
    e7_store_f32(proj + 44, -1.0)
    e7_store_f32(proj + 48, 0.0)
    e7_store_f32(proj + 52, 0.0)
    e7_store_f32(proj + 56, e7_f32_div(e7_f32_mul(near, far), e7_f32_sub(near, far)))
    e7_store_f32(proj + 60, 0.0)
    e7_store_f32(ubo + 192, ex)
    e7_store_f32(ubo + 196, ey)
    e7_store_f32(ubo + 200, ez)
    e7_store_f32(ubo + 204, 1.0)

# Write the engine point-light parameters and white tint into the SceneUniform.
scene_set_light <- (scene: u64, x_milli: i64, y_milli: i64, z_milli: i64, r_milli: i64, g_milli: i64, b_milli: i64, intensity_milli: i64) -> nil:
    ubo := e7_load_u64(scene + 152)
    if ubo == 0:
        ret
    e7_store_f32(ubo + 208, e7_f32_div(e7_f32_from_i64(x_milli), 1000.0))
    e7_store_f32(ubo + 212, e7_f32_div(e7_f32_from_i64(y_milli), 1000.0))
    e7_store_f32(ubo + 216, e7_f32_div(e7_f32_from_i64(z_milli), 1000.0))
    e7_store_f32(ubo + 220, 1.0)
    e7_store_f32(ubo + 224, e7_f32_div(e7_f32_from_i64(r_milli), 1000.0))
    e7_store_f32(ubo + 228, e7_f32_div(e7_f32_from_i64(g_milli), 1000.0))
    e7_store_f32(ubo + 232, e7_f32_div(e7_f32_from_i64(b_milli), 1000.0))
    e7_store_f32(ubo + 236, e7_f32_div(e7_f32_from_i64(intensity_milli), 1000.0))
    e7_store_f32(ubo + 240, 0.35)
    e7_store_f32(ubo + 244, 0.35)
    e7_store_f32(ubo + 248, 0.40)
    e7_store_f32(ubo + 252, 1.0)
    e7_store_f32(ubo + 256, 1.0)
    e7_store_f32(ubo + 260, 1.0)
    e7_store_f32(ubo + 264, 1.0)
    e7_store_f32(ubo + 268, 1.0)

# Engine cube model: RY(angle) * RX(0.35), written to the model slot.
scene_set_cube_angle <- (scene: u64, angle_milli_radians: i64) -> nil:
    ubo := e7_load_u64(scene + 152)
    if ubo == 0:
        ret
    angle := e7_f32_div(e7_f32_from_i64(angle_milli_radians), 1000.0)
    cy := e7_f32_cos(angle)
    sy := e7_f32_sin(angle)
    tilt := 0.35
    cx := e7_f32_cos(tilt)
    sx := e7_f32_sin(tilt)
    e7_store_f32(ubo, cy)
    e7_store_f32(ubo + 4, 0.0)
    e7_store_f32(ubo + 8, e7_f32_neg(sy))
    e7_store_f32(ubo + 12, 0.0)
    e7_store_f32(ubo + 16, e7_f32_mul(sx, sy))
    e7_store_f32(ubo + 20, cx)
    e7_store_f32(ubo + 24, e7_f32_mul(sx, cy))
    e7_store_f32(ubo + 28, 0.0)
    e7_store_f32(ubo + 32, e7_f32_mul(cx, sy))
    e7_store_f32(ubo + 36, e7_f32_neg(sx))
    e7_store_f32(ubo + 40, e7_f32_mul(cx, cy))
    e7_store_f32(ubo + 44, 0.0)
    e7_store_f32(ubo + 48, 0.0)
    e7_store_f32(ubo + 52, 0.0)
    e7_store_f32(ubo + 56, 0.0)
    e7_store_f32(ubo + 60, 1.0)
