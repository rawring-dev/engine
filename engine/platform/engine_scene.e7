# Engine scene layer implemented in e7 on top of `platform::scene`.
#
# These `e7_engine_scene_*` functions are ordinary e7 platform functions (the
# compiler has no engine-scene intrinsics); engine code calls them through the
# `Gpu` wrapper in `gfx::gpu`.

e7_engine_scene_create <- (window: u64, vertex_shader: str,
fragment_shader: str) -> u64:
    width_out <- ptr::alloc(4) as u64
    height_out <- ptr::alloc(4) as u64
    window_size(window, width_out, height_out)
    width <- ptr::load_u32(width_out)
    height <- ptr::load_u32(height_out)
    ptr::free(width_out)
    ptr::free(height_out)
    if width == 0 or height == 0:
        ret 0
    ret scene_create(window, width as i64, height as i64)

e7_engine_scene_destroy <- (scene: u64) -> nil:
    if scene == 0:
        ret
    scene_destroy(scene)

e7_engine_scene_resize <- (scene: u64, width: i64, height: i64) -> nil:
    if scene == 0:
        ret
    scene_resize(scene, width, height)
    ret

e7_engine_scene_set_camera <- (scene: u64, eye_x: i64, eye_y: i64, eye_z: i64,
yaw: i64, pitch: i64) -> nil:
    if scene == 0:
        ret
    scene_set_camera(scene, eye_x, eye_y, eye_z, yaw, pitch)

e7_engine_scene_set_cube_angle <- (scene: u64, angle: i64) -> nil:
    if scene == 0:
        ret
    scene_set_cube_angle(scene, angle)

e7_engine_scene_set_projection <- (scene: u64, fov_y: f32, near: f32,
far: f32) -> nil:
    if scene != 0:
        scene_set_projection(scene, fov_y, near, far)

e7_engine_scene_set_light <- (scene: u64, x: i64, y: i64, z: i64, r: i64,
g: i64, b: i64, intensity: i64) -> nil:
    if scene == 0:
        ret
    scene_set_light(scene, x, y, z, r, g, b, intensity)

e7_engine_scene_begin_frame <- (scene: u64) -> nil:
    if scene == 0:
        ret
    scene_begin_frame(scene)

e7_engine_scene_draw_box <- (scene: u64, x: i64, y: i64, z: i64, sx: i64,
sy: i64, sz: i64, r: i64, g: i64, b: i64, angle: i64) -> nil:
    if scene == 0:
        ret
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, angle)

e7_engine_scene_draw_shape <- (scene: u64, shape: i32, x: i64, y: i64, z: i64,
sx: i64, sy: i64, sz: i64, r: i64, g: i64, b: i64, angle: i64) -> nil:
    if scene == 0:
        ret
    # Kind 0 is the shared cube; kinds 1..3 select the procedural sphere,
    # capsule and plane meshes generated by scene.e7.
    scene_draw_shape_rot(scene, shape, x, y, z, sx, sy, sz, 0, angle, 0, r, g,
        b, 0 as u64)

e7_engine_scene_draw_shape_rot <- (
    scene: u64,
    shape: i32,
    x: i64,
    y: i64,
    z: i64,
    sx: i64,
    sy: i64,
    sz: i64,
    rx: i64,
    ry: i64,
    rz: i64,
    r: i64,
    g: i64,
    b: i64,
    texture: u64,
) -> nil:
    if scene == 0:
        ret
    scene_draw_shape_rot(scene, shape, x, y, z, sx, sy, sz, rx, ry, rz, r, g, b,
        texture)

# Quaternion procedural draw: rotation is a unit quaternion (x, y, z, w), so the
# renderer builds the model matrix directly from physics orientation.
e7_engine_scene_draw_shape_quat <- (
    scene: u64,
    shape: i32,
    x: i64,
    y: i64,
    z: i64,
    sx: i64,
    sy: i64,
    sz: i64,
    qx: f32,
    qy: f32,
    qz: f32,
    qw: f32,
    r: i64,
    g: i64,
    b: i64,
    texture: u64,
) -> nil:
    if scene == 0:
        ret
    scene_draw_shape_quat(scene, shape, x, y, z, sx, sy, sz, qx, qy, qz, qw, r,
        g, b, texture)

e7_engine_scene_draw_custom <- (scene: u64, mesh: u64, x: i64, y: i64, z: i64,
sx: i64, sy: i64, sz: i64, r: i64, g: i64, b: i64, angle: i64) -> nil:
    if scene == 0:
        ret
    scene_draw_custom(scene, mesh, x, y, z, sx, sy, sz, 0, angle, 0, r, g, b,
        0 as u64)

e7_engine_scene_draw_custom_rot <- (
    scene: u64,
    mesh: u64,
    x: i64,
    y: i64,
    z: i64,
    sx: i64,
    sy: i64,
    sz: i64,
    rx: i64,
    ry: i64,
    rz: i64,
    r: i64,
    g: i64,
    b: i64,
    texture: u64,
) -> nil:
    if scene == 0:
        ret
    scene_draw_custom(scene, mesh, x, y, z, sx, sy, sz, rx, ry, rz, r, g, b,
        texture)

# Quaternion custom-mesh draw (same quaternion-only model-matrix path).
e7_engine_scene_draw_custom_quat <- (
    scene: u64,
    mesh: u64,
    x: i64,
    y: i64,
    z: i64,
    sx: i64,
    sy: i64,
    sz: i64,
    qx: f32,
    qy: f32,
    qz: f32,
    qw: f32,
    r: i64,
    g: i64,
    b: i64,
    texture: u64,
) -> nil:
    if scene == 0:
        ret
    scene_draw_custom_quat(scene, mesh, x, y, z, sx, sy, sz, qx, qy, qz, qw, r,
        g, b, texture)

e7_engine_scene_draw_ui_quad <- (scene: u64, texture: u64, x: i64, y: i64,
w: i64, h: i64, r: i64, g: i64, b: i64, a: i64) -> nil:
    if scene == 0:
        ret
    scene_ui_quad(scene, texture, x, y, w, h, r, g, b, a)

e7_engine_scene_texture_create <- (scene: u64, image: u64) -> u64:
    if scene == 0:
        ret 0
    ret scene_texture_create(scene, image) as u64

e7_engine_scene_texture_destroy <- (scene: u64, texture: u64) -> nil:
    if scene == 0:
        ret
    scene_texture_destroy(scene, texture)

e7_engine_scene_mesh_upload <- (scene: u64, vertices: [f32], indices: [i32],
layout: i32) -> u64:
    if scene == 0:
        ret 0
    ret scene_mesh_upload(scene, vertices, indices, layout) as u64

e7_engine_scene_mesh_upload_skinned <- (scene: u64, vertices: [f32], indices: [i32], joints: [i64], weights: [f32]) -> u64:
    if scene == 0:
        ret 0
    ret scene_mesh_upload_skinned(scene, vertices, indices, joints, weights) as u64

e7_engine_scene_end_frame <- (scene: u64) -> nil:
    if scene == 0:
        ret
    pixels_out <- ptr::alloc(8) as u64
    size_out <- ptr::alloc(8) as u64
    # Hidden windows still present to release acquired swapchain images.
    # Without this, headless runs stop when the swapchain image pool fills.
    drew <- scene_draw_present(scene, pixels_out, size_out)
    if drew != 0:
        pixels <- ptr::load_u64(pixels_out)
        width <- scene_width(scene)
        height <- scene_height(scene)
        host::capture(pixels as u64, width, height)
        ptr::free(pixels)
    ptr::free(pixels_out)
    ptr::free(size_out)
    host::note_frame()

e7_engine_scene_draw_matrix <- (scene: u64, mesh: u64, shape: i32, matrix: [f32; 16], tint: [f32; 3], texture: u64) -> nil:
    scene_draw_matrix(scene,mesh,shape,matrix,tint,texture)

e7_engine_scene_mesh_destroy <- (scene: u64, mesh: u64) -> nil:
    scene_mesh_destroy(scene,mesh)

e7_engine_scene_texture_destroy_safely <- (scene: u64, texture: u64) -> nil:
    if scene != 0 and texture != 0:
        vulkan_device_wait_idle(ptr::load_u64(scene + 32))
        scene_texture_destroy(scene,texture)

e7_engine_scene_mesh_set_joint <- (scene: u64, mesh: u64, joint: i64, matrix: [f32;16]) -> nil:
    scene_mesh_set_joint(scene, mesh, joint, matrix)
