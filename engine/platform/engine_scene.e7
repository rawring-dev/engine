# Engine scene layer implemented in e7 on top of `platform::scene`.
#
# Temporary `e7_engine_scene_*` prefix: the runtime engine still publishes the original
# `e7_engine_scene_*` JIT symbols.  These functions will take those names once
# the runtime manifest is removed.

e7_engine_scene_create <- (window: u64, vertex_shader: str, fragment_shader: str) -> u64:
    width_out := e7_alloc_bytes(4)
    height_out := e7_alloc_bytes(4)
    window_size(window, width_out, height_out)
    width := e7_load_u32(width_out)
    height := e7_load_u32(height_out)
    e7_free_ptr(width_out)
    e7_free_ptr(height_out)
    if width == 0 or height == 0:
        ret 0
    ret scene_create(window, width as i64, height as i64)

e7_engine_scene_destroy <- (scene: u64) -> nil:
    if scene == 0:
        ret
    scene_destroy(scene)

e7_engine_scene_resize <- (scene: u64, width: i64, height: i64) -> nil:
    if scene == 0:
        ret
    ret

e7_engine_scene_set_camera <- (scene: u64, eye_x: i64, eye_y: i64, eye_z: i64, yaw: i64, pitch: i64) -> nil:
    if scene == 0:
        ret
    scene_set_camera(scene, eye_x, eye_y, eye_z, yaw, pitch)

e7_engine_scene_set_cube_angle <- (scene: u64, angle: i64) -> nil:
    if scene == 0:
        ret
    scene_set_cube_angle(scene, angle)

e7_engine_scene_set_light <- (scene: u64, x: i64, y: i64, z: i64, r: i64, g: i64, b: i64, intensity: i64) -> nil:
    if scene == 0:
        ret
    scene_set_light(scene, x, y, z, r, g, b, intensity)

e7_engine_scene_begin_frame <- (scene: u64) -> nil:
    if scene == 0:
        ret
    scene_begin_frame(scene)

e7_engine_scene_draw_box <- (scene: u64, x: i64, y: i64, z: i64, sx: i64, sy: i64, sz: i64, r: i64, g: i64, b: i64, angle: i64) -> nil:
    if scene == 0:
        ret
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, angle)

e7_engine_scene_draw_shape <- (scene: u64, shape: i32, x: i64, y: i64, z: i64, sx: i64, sy: i64, sz: i64, r: i64, g: i64, b: i64, angle: i64) -> nil:
    if scene == 0:
        ret
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, angle)

e7_engine_scene_draw_shape_rot <- (
    scene: u64,
    shape: i32,
    x: i64,
    y: i64,
    z: i64,
    sx: i64,
    sy: i64,
    sz: i64,
    rx: i64,
    ry: i64,
    rz: i64,
    r: i64,
    g: i64,
    b: i64,
    texture: u64,
) -> nil:
    if scene == 0:
        ret
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, ry)

e7_engine_scene_draw_custom <- (scene: u64, mesh: u64, x: i64, y: i64, z: i64, sx: i64, sy: i64, sz: i64, r: i64, g: i64, b: i64, angle: i64) -> nil:
    if scene == 0:
        ret
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, angle)

e7_engine_scene_draw_custom_rot <- (
    scene: u64,
    mesh: u64,
    x: i64,
    y: i64,
    z: i64,
    sx: i64,
    sy: i64,
    sz: i64,
    rx: i64,
    ry: i64,
    rz: i64,
    r: i64,
    g: i64,
    b: i64,
    texture: u64,
) -> nil:
    if scene == 0:
        ret
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, ry)

e7_engine_scene_draw_ui_quad <- (scene: u64, texture: u64, x: i64, y: i64, w: i64, h: i64, r: i64, g: i64, b: i64, a: i64) -> nil:
    if scene == 0:
        ret
    ret

e7_engine_scene_texture_create <- (scene: u64, image: u64) -> u64:
    ret 0

e7_engine_scene_texture_destroy <- (scene: u64, texture: u64) -> nil:
    if scene == 0:
        ret
    ret

e7_engine_scene_mesh_upload <- (scene: u64, vertices: [f32], indices: [i32], layout: i32) -> u64:
    ret 0

e7_engine_scene_end_frame <- (scene: u64) -> nil:
    if scene == 0:
        ret
    pixels_out := e7_alloc_bytes(8)
    size_out := e7_alloc_bytes(8)
    drew := scene_draw(scene, pixels_out, size_out)
    if drew != 0:
        pixels := e7_load_u64(pixels_out)
        width := scene_width(scene)
        height := scene_height(scene)
        e7_host_capture(pixels as u64, width, height)
        e7_free_ptr(pixels)
    e7_free_ptr(pixels_out)
    e7_free_ptr(size_out)
    e7_host_note_frame()

