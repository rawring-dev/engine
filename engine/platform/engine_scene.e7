# Engine scene layer implemented in e7 on top of `platform::scene`.
#
# Temporary `es_*` prefix: the runtime engine still publishes the original
# `e7_engine_scene_*` JIT symbols.  These functions will take those names once
# the runtime manifest is removed.

es_create <- (window: u64, vertex_shader: u64, fragment_shader: u64) -> u64:
    ret scene_create(window, 960, 540)

es_destroy <- (scene: u64) -> nil:
    scene_destroy(scene)

es_resize <- (scene: u64, width: i64, height: i64) -> nil:
    ret

es_set_camera <- (scene: u64, eye_x: i64, eye_y: i64, eye_z: i64, yaw: i64, pitch: i64) -> nil:
    scene_set_camera(scene, eye_x, eye_y, eye_z, yaw, pitch)

es_set_cube_angle <- (scene: u64, angle: i64) -> nil:
    scene_set_cube_angle(scene, angle)

es_set_light <- (scene: u64, x: i64, y: i64, z: i64, r: i64, g: i64, b: i64, intensity: i64) -> nil:
    scene_set_light(scene, x, y, z, r, g, b, intensity)

es_begin_frame <- (scene: u64) -> nil:
    scene_begin_frame(scene)

es_draw_box <- (scene: u64, x: i64, y: i64, z: i64, sx: i64, sy: i64, sz: i64, r: i64, g: i64, b: i64, angle: i64) -> nil:
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, angle)

es_draw_shape <- (scene: u64, shape: i64, x: i64, y: i64, z: i64, sx: i64, sy: i64, sz: i64, r: i64, g: i64, b: i64, angle: i64) -> nil:
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, angle)

es_draw_shape_rot <- (
    scene: u64,
    shape: i64,
    x: i64,
    y: i64,
    z: i64,
    sx: i64,
    sy: i64,
    sz: i64,
    rx: i64,
    ry: i64,
    rz: i64,
    r: i64,
    g: i64,
    b: i64,
    texture: u64,
) -> nil:
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, ry)

es_draw_custom <- (scene: u64, mesh: u64, x: i64, y: i64, z: i64, sx: i64, sy: i64, sz: i64, r: i64, g: i64, b: i64, angle: i64) -> nil:
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, angle)

es_draw_custom_rot <- (
    scene: u64,
    mesh: u64,
    x: i64,
    y: i64,
    z: i64,
    sx: i64,
    sy: i64,
    sz: i64,
    rx: i64,
    ry: i64,
    rz: i64,
    r: i64,
    g: i64,
    b: i64,
    texture: u64,
) -> nil:
    scene_draw_box(scene, x, y, z, sx, sy, sz, r, g, b, ry)

es_draw_ui_quad <- (scene: u64, texture: u64, x: i64, y: i64, w: i64, h: i64, r: i64, g: i64, b: i64, a: i64) -> nil:
    ret

es_texture_create <- (scene: u64, image: u64) -> u64:
    ret 0

es_texture_destroy <- (scene: u64, texture: u64) -> nil:
    ret

es_mesh_upload <- (scene: u64, vertices: [f32], indices: [i32], layout: i32) -> u64:
    ret 0

es_end_frame <- (scene: u64) -> nil:
    pixels_out := e7_alloc_bytes(8)
    size_out := e7_alloc_bytes(8)
    drew := scene_draw(scene, pixels_out, size_out)
    if drew != 0:
        pixels := e7_load_u64(pixels_out)
        width := scene_width(scene)
        height := scene_height(scene)
        e7_host_capture(pixels as u64, width, height)
        e7_free_ptr(pixels)
    e7_free_ptr(pixels_out)
    e7_free_ptr(size_out)
    e7_host_note_frame()
