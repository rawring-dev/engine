# Asset library: images (PNG/JPEG through the low-level runtime loader) and
# parsed OBJ meshes.  The runtime only decodes files; all loading policy and
# resource ownership lives here.

@resource
pub Image <- struct
    handle: u64
    width: i32
    height: i32
    # Tightly packed top-down RGBA8 bytes (width * height * 4).
    pixels: str

@resource
pub Assets <- struct
    cube_image: Image
    cube_mesh: obj::ObjMesh

# Load an image into an e7 `Image`.  Missing/undecodable files produce a
# zeroed Image (handle 0) instead of failing the plugin.
pub load_image <- (path: str) -> Image:
    handle := e7_image_load(path)
    if handle == 0:
        ret Image {
            handle: 0,
            width: 0,
            height: 0,
            pixels: "",
        }
    ret Image {
        handle: handle,
        width: e7_image_width(handle) as i32,
        height: e7_image_height(handle) as i32,
        pixels: e7_image_pixels(handle),
    }

pub free_image <- (image: Image) -> nil:
    e7_image_free(image.handle)
    ret

# Load the engine's sample assets.  The renderer keeps its built-in cube; this
# proves the image/OBJ pipeline end-to-end and gives later rendering work a
# native mesh resource to consume.
pub AssetsPlugin <- plugin
    assets_plugin_init <- sys (commands: &mut Commands):
        commands.insert_resource(Assets {
            cube_image: load_image("engine/assets/testdata/cube.png"),
            cube_mesh: obj::load_obj("engine/assets/cube.obj"),
        })
