# ECS components and the auto-collected Components table.

@Components
pub Camera <- struct
    position: [f32; 3]
    yaw: f32
    pitch: f32
    fov_y: f32
    near: f32
    far: f32

@Components
pub CameraController <- struct
    move_speed: f32
    look_speed: f32

# Authored/static transform.  `rotation` is an intrinsic-XYZ Euler angle used
# for authoring static bodies and by non-physics callers; the physics step does
# not write it for dynamic bodies.
@Components
pub Transform <- struct
    translation: [f32; 3]
    rotation: [f32; 3]
    scale: [f32; 3]

# Render-facing orientation as a unit quaternion (x, y, z, w).  This is the
# single source of truth for dynamic body rotation: the physics step publishes
# PhysicsWorld.quaternions here every step and the renderer builds the model
# matrix directly from it (no quaternion -> Euler -> matrix round trip).  Static
# bodies are initialised once from their authored Transform.rotation.
@Components
pub BodyOrientation <- struct
    x: f32
    y: f32
    z: f32
    w: f32

@Components
pub MeshRenderer <- struct
    mesh: u64
    pipeline: u64
    colour: [f32; 4]

@Components
pub PointLight <- struct
    position: [f32; 3]
    colour: [f32; 3]
    intensity: f32

# Marks an entity as visible to the scene renderer.  `kind` selects the
# procedural mesh: 0 box, 1 sphere, 2 capsule, 3 plane.  `colour` is the
# per-object RGB tint (0..1) multiplied into the mesh's vertex colour.
@Components
pub Renderable <- struct
    kind: i32
    colour: [f32; 3]

# Cube proxy with a per-cube spin phase so stacked proxies do not rotate in
# lockstep (they would otherwise read as a single tall box).
@Components
pub CubeMesh <- struct
    spin_phase: f32

pub Components <- table
    entity_id: usize,
    ... # automatically collects all types with @Components


pub Commands <- struct
    handle: u64



@Components
pub RigidBody <- struct
    velocity: [f32; 3]
    # Euler angular velocity in radians/second; orientation mirrors
    # Transform.rotation for bodies that are not rotation-locked.
    angular_velocity: [f32; 3]
    orientation: [f32; 3]
    inv_mass: f32
    gravity_scale: f32
    rotation_locked: bool
    is_static: bool

@Components
pub BoxCollider <- struct
    half_extents: [f32; 3]

@Components
pub SphereCollider <- struct
    radius: f32

@Components
pub BodyId <- struct
    id: i64

# Broadphase bounds: half extents of each body's world-space AABB.
@Components
pub BodyBounds <- struct
    half_extents: [f32; 3]

@Components
pub CapsuleCollider <- struct
    radius: f32
    half_height: f32

# Infinite plane `dot(normal, p) = offset`. The demo uses normal (0,1,0), offset
# 0.
@Components
pub PlaneCollider <- struct
    normal: [f32; 3]
    offset: f32

@Components
pub Player <- struct
    body_id: i64

@Components
pub Pickup <- struct
    body_id: i64

# `by` is the holder body id (0 = not held).  This is a renderer/tooling marker
# synced from BodyFlags.held_by.  Physics pickup timing uses BodyFlags directly;
# when the runtime removal/despawn ABI is available, adding/removing Held can
# replace this append-only marker with no physics change.
@Components
pub Held <- struct
    by: i64

# Compact physics shape/interaction metadata, present on every physics body.
# Collider components remain the public shape API; this component lets a single
# ECS query drive broadphase, narrowphase, pickup, and camera follow.
@Components
pub BodyFlags <- struct
    # 0 = box, 1 = sphere, 2 = capsule, 3 = plane
    shape: i64
    radius: f32
    half_height: f32
    is_player: bool
    is_pickup: bool
    # Player body id for Player rows, pickup body id for Pickup rows.
    target_id: i64
    held_by: i64

# Stable scene identity and a parent identity, independent of ECS row ids.
# Transform remains local. An empty parent denotes a root.
@Components
pub Hierarchy <- struct
    id: str
    parent: str

# Imported affine transform (including glTF matrix nodes). User Transform
# values are composed after this matrix, allowing local authoring offsets.
@Components
pub LocalMatrix <- struct
    matrix: [f32; 16]

# Persistent geometry reference; GPU handles are transient and never saved.
@Components
pub GltfMesh <- struct
    path: str
    mesh: i64
    primitive: i64

@Components
pub GeometryBounds <- struct
    minimum: [f32; 3]
    maximum: [f32; 3]

# Source image reference; editor/runtime resolves it to a transient GPU texture.
@Components
pub GltfTexture <- struct
    path: str
    image: i64

# Retained authoring data for an imported node absent from the latest export.
@Components
pub GltfMissing <- struct
    missing: bool

# Flat keyframe channels share `times`; an empty channel leaves that property
# unchanged. Quaternions are xyzw. Values are local to the parent hierarchy.
@Components
pub TransformAnimation <- struct
    times: [f32]
    translations: [f32]
    rotations: [f32]
    scales: [f32]
    time: f32
    speed: f32
    looping: bool
    playing: bool

# Bind-pose vertices and four influences per vertex for an imported skin.
@Components
pub GltfSkin <- struct
    joints: [str]
    inverse_bind: [f32]
    vertices: [f32]
    joint_indices: [i64]
    weights: [f32]
