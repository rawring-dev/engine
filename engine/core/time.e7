use core::events::*;

@resource
pub Time <- struct
    delta: f32
    elapsed: f32
    # Integer clocks for the millisecond intrinsic ABI.
    now_ms: i64
    start_ms: i64


pub TimePlugin <- plugin
    time_plugin_init <- sys (commands: &mut Commands):
        commands.insert_resource(Time { delta: 0.0, elapsed: 0.0, now_ms: 0, start_ms: 0 })

impl Time:
    pub now_ms <- (time: &Time) -> i64:
        ret host::time_now_ms()

    pub start <- (time: &mut Time) -> nil:
        time.start_ms = host::time_now_ms()
        time.now_ms = time.start_ms
        ret


@trigger(PreUpdate)
pub tick_time <- sys (time: res &mut Time):
    now := time.now_ms()
    time.now_ms = now
    time.elapsed = (now - time.start_ms) as f32 / 1000.0
    time.delta = 0.016

