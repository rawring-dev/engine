use core::events::*;
use platform::engine_window::*;

@resource
pub Window <- struct
    handle: u64
    width: i32
    height: i32
    quit_requested: bool


# Inherent Window methods.  Raw engine intrinsics stay inside these wrappers;
# call sites use `window.pump()` / `window.should_close()` etc.
impl Window:
    pub create <- (window: &mut Window, title: str) -> nil:
        window.handle = e7_engine_window_create(title, window.width as i64, window.height as i64)
        window.quit_requested = false
        ret

    pub pump <- (window: &mut Window) -> nil:
        window.quit_requested = e7_engine_window_pump(window.handle) != 0
        out_width := e7_alloc_bytes(4)
        out_height := e7_alloc_bytes(4)
        resized := e7_engine_window_take_resize(window.handle, out_width, out_height)
        if resized != 0:
            new_width := e7_load_u32(out_width)
            new_height := e7_load_u32(out_height)
            if new_width > 0 and new_height > 0:
                window.width = new_width as i32
                window.height = new_height as i32
        e7_free_ptr(out_width)
        e7_free_ptr(out_height)
        ret

    # Window close OR the host frame limiter (`--frames`) requests shutdown.
    pub should_close <- (window: &Window) -> bool:
        ret e7_engine_window_should_close(window.handle) != 0 or e7_host_should_close() != 0

    pub destroy <- (window: &mut Window) -> nil:
        e7_engine_window_destroy(window.handle)
        ret


pub WindowPlugin <- plugin
    window_plugin_init <- sys (commands: &mut Commands):
        commands.insert_resource(Window {
            handle: 0,
            width: 960,
            height: 540,
            quit_requested: false,
        })

@trigger(FrameInit)
pub poll_window <- sys (window: res &mut Window):
    window.pump()

