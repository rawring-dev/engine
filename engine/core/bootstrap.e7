use core::ecs::*;
use core::events::*;
use gfx::gpu::*;
use core::time::*;
use core::window::*;

@trigger(Init)
pub init_window <- sys (
    window: res &mut Window,
    gpu: res &mut Gpu,
    time: res &mut Time,

    commands: &mut Commands,
):
    window.width = 960
    window.height = 540
    window.create("engine7")

    # Shader loading is e7 policy: read the SPIR-V assets and hand them to the
    # low-level Vulkan scene constructor through the Gpu wrappers.
    vert_spirv <- gpu.read_shader("engine/shaders/cube.vert.spv")
    frag_spirv <- gpu.read_shader("engine/shaders/cube.frag.spv")
    gpu.create_scene(window, vert_spirv, frag_spirv)
    time.start()


@trigger(DeInit)
pub shutdown <- sys (window: res &mut Window, gpu: res &mut Gpu):
    gpu.destroy_scene()
    window.destroy()
