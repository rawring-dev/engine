# Camera plugin marker.
#
# Look input and player-follow translation are applied inside
# `physics.e7::physics_step` (same deterministic Update system as the body
# step), so the camera cannot race or lag the physics core by a full frame.
# Rendering reads the resulting Camera component in the Render phase.

use core::ecs::*;
use core::events::*;
use core::input::*;

pub CameraPlugin <- plugin
