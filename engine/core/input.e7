use core::events::*;

@resource
pub Input <- struct
    move_forward: bool
    move_backward: bool
    move_left: bool
    move_right: bool
    move_up: bool
    move_down: bool
    sprint: bool
    look_left: bool
    look_right: bool
    look_up: bool
    look_down: bool
    look_dx: f32
    look_dy: f32
    # Space (edge-triggered jump) and E (edge-triggered pickup).
    jump_pressed: bool
    jump_down: bool
    jump_was_down: bool
    interact: bool
    interact_pressed: bool
    interact_was_down: bool


# Raw key/mouse queries as Input methods.  Input policy (actions, edge
# detection, clamps) stays in `gather_input`.
impl Input:
    pub key_down <- (input: &Input, code: i64) -> bool:
        ret e7_engine_key_down(code) != 0

    pub mouse_dx <- (input: &Input) -> f32:
        ret e7_f32_from_i64(e7_engine_mouse_dx())

    pub mouse_dy <- (input: &Input) -> f32:
        ret e7_f32_from_i64(e7_engine_mouse_dy())

    pub mouse_x <- (input: &Input) -> i64:
        ret e7_engine_mouse_x()

    pub mouse_y <- (input: &Input) -> i64:
        ret e7_engine_mouse_y()

    pub cursor_x <- (input: &Input) -> f32:
        ret e7_f32_from_i64(e7_engine_mouse_x())

    pub cursor_y <- (input: &Input) -> f32:
        ret e7_f32_from_i64(e7_engine_mouse_y())

    pub mouse_down <- (input: &Input, button: i64) -> bool:
        ret e7_engine_mouse_down(button) != 0

    pub text_input <- (input: &Input) -> str:
        ret e7_engine_text_input()

    pub capture_mouse <- (input: &Input) -> nil:
        e7_engine_capture_mouse(1)
        ret

    pub mouse_captured <- (input: &Input) -> bool:
        ret e7_engine_mouse_captured() != 0


pub InputPlugin <- plugin
    input_plugin_init <- sys (commands: &mut Commands):
        commands.insert_resource(Input {
            move_forward: false,
            move_backward: false,
            move_left: false,
            move_right: false,
            move_up: false,
            move_down: false,
            sprint: false,
            look_left: false,
            look_right: false,
            look_up: false,
            look_down: false,
            look_dx: 0.0,
            look_dy: 0.0,
            jump_pressed: false,
            jump_down: false,
            jump_was_down: false,
            interact: false,
            interact_pressed: false,
            interact_was_down: false,
        })

@trigger(FrameInit)
pub gather_input <- sys (input: res &mut Input):
    # Logical key codes: 0 W, 1 S, 2 A, 3 D, 4 E (up/interact), 5 Q (down),
    # 6 Shift, 7-10 arrow look, 11 Space (jump).  Jump/interact are
    # edge-triggered so holding a key does not repeat the action every frame.
    input.move_forward = input.key_down(0)
    input.move_backward = input.key_down(1)
    input.move_left = input.key_down(2)
    input.move_right = input.key_down(3)
    input.move_up = input.key_down(4)
    input.move_down = input.key_down(5)
    input.sprint = input.key_down(6)
    input.look_left = input.key_down(7)
    input.look_right = input.key_down(8)
    input.look_up = input.key_down(9)
    input.look_down = input.key_down(10)

    input.look_dx = e7_f32_clamp(input.mouse_dx(), -600.0, 600.0)
    input.look_dy = e7_f32_clamp(input.mouse_dy(), -600.0, 600.0)

    jump_down := input.key_down(11)
    interact_down := input.move_up
    input.jump_pressed = jump_down and not input.jump_was_down
    input.jump_down = jump_down
    input.jump_was_down = jump_down
    input.interact = interact_down
    input.interact_pressed = interact_down and not input.interact_was_down
    input.interact_was_down = interact_down


@trigger(PostUpdate)
pub reset_input <- sys (input: res &mut Input):
    input.move_forward = false
    input.move_backward = false
    input.move_left = false
    input.move_right = false
    input.move_up = false
    input.move_down = false
    input.sprint = false
    input.look_left = false
    input.look_right = false
    input.look_up = false
    input.look_down = false
    input.look_dx = 0.0
    input.look_dy = 0.0
    input.jump_pressed = false
    input.jump_down = false
    input.interact_pressed = false

