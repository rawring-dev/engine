# Project gameplay entry module. Add modules here to include new scripts in
# editor builds; :w inside embedded Neovim applies changes to the live scene.
use core::events::*;
use core::ecs::*;
use core::time::*;

pub Gameplay <- plugin

# Example: this runs only during Play (or one paused Step). Changing the pulse
# speed and saving demonstrates code reload without resetting object positions.
@plugin(Gameplay)
@trigger(Update)
pub pulse_light <- sys (lights: select &mut PointLight from Components, time: res &Time):
    for light in lights:
        light.intensity = 2.8 + f32::sin(time.elapsed * 1.5) * 0.25
