# engine7 entry point. All engine behavior lives in the imported libraries:
# events, ecs, gfx, time, window, input, camera, scene, bootstrap and ui.
mod events
mod ecs
mod gfx
mod time
mod window
mod input
mod camera
mod scene
mod bootstrap
mod physics_broadphase
mod physics_narrowphase
mod physics
mod assets
mod ui
mod obj

use events::*;
use ecs::*;
use gfx::*;
use time::*;
use window::*;
use input::*;
use camera::*;
use scene::*;
use bootstrap::*;
use physics_broadphase::*;
use physics_narrowphase::*;
use physics::*;
use assets::*;
use obj::*;
use ui::*;

# Demo-specific configuration serialized through the engine's JSON derive.
@resource
@derive(Serialize, Deserialize)
pub DemoSettings <- struct
    window_width: i32
    window_height: i32
    move_speed: f32
    look_speed: f32
    title: str

# UI helper constructors keep every widget row on the same five-component
# projection while letting each row override only the fields it uses.
default_label <- () -> UILabel:
    ret UILabel { text: "", size: 14, colour: [0.92, 0.94, 0.98, 1.0] }

default_button <- () -> UIButton:
    ret UIButton { label: "", action: 0 }

default_field <- () -> UITextField:
    ret UITextField {
        text: "",
        max_len: 0,
        focused: false,
        revision: 0,
        rendered_revision: 0,
        texture: 0,
        texture_w: 0,
        texture_h: 0,
    }

# Demo-specific content: the scene entity rows, cube collider, and light.
pub DemoPlugin <- plugin
    demo_plugin_init <- sys (commands: &mut Commands):
        settings := DemoSettings {
            window_width: 960,
            window_height: 540,
            move_speed: 4.0,
            look_speed: 0.0025,
            title: "engine7",
        }
        # Exercise derive/JSON in the demo: round-trip the configuration and
        # keep the decoded resource.
        settings_json := json_encode(settings)
        decoded := json_decode::<DemoSettings>(settings_json)
        commands.insert_resource(decoded)

        camera := Camera {
            position: [0.0, 1.8, 5.5]
            yaw: 0.0
            pitch: -0.14
            fov_y: 1.0471975512
            near: 0.1
            far: 100.0
        }
        controller := CameraController {
            move_speed: 4.0,
            look_speed: 0.0025,
        }
        camera_track := Transform {
            translation: [0.0, 1.5, 6.0],
            rotation: [0.0, 0.0, 0.0],
            scale: [1.0, 1.0, 1.0],
        }
        commands.add_row(Components, { camera, controller, camera_track })

        # Flat static ground plane at y=0.
        plane_transform := Transform {
            translation: [0.0, 0.0, 0.0],
            rotation: [0.0, 0.0, 0.0],
            scale: [1.0, 1.0, 1.0],
        }
        plane_id := BodyId { id: 1 }
        plane_bounds := BodyBounds { half_extents: [50.0, 0.1, 50.0] }
        plane_body := RigidBody {
            velocity: [0.0, 0.0, 0.0],
            angular_velocity: [0.0, 0.0, 0.0],
            orientation: [0.0, 0.0, 0.0],
            inv_mass: 0.0,
            gravity_scale: 0.0,
            rotation_locked: true,
            is_static: true,
        }
        plane_collider := PlaneCollider { normal: [0.0, 1.0, 0.0], offset: 0.0 }
        plane_flags := BodyFlags {
            shape: 3,
            radius: 0.0,
            half_height: 0.0,
            is_player: false,
            is_pickup: false,
            target_id: 1,
            held_by: 0,
        }
        plane_renderable := Renderable { kind: 3, colour: [0.42, 0.48, 0.42] }
        plane_material := Material { texture: 0, tint: [0.42, 0.48, 0.42] }
        commands.add_row(Components, {
            plane_transform,
            plane_id,
            plane_bounds,
            plane_body,
            plane_collider,
            plane_flags,
            plane_renderable,
            plane_material,
        })

        # Pickable dynamic ball (unlocked rotation; collisions impart spin).
        ball_transform := Transform {
            translation: [-1.2, 2.0, 3.0],
            rotation: [0.0, 0.0, 0.0],
            scale: [1.0, 1.0, 1.0],
        }
        ball_id := BodyId { id: 3 }
        ball_bounds := BodyBounds { half_extents: [0.5, 0.5, 0.5] }
        ball_body := RigidBody {
            velocity: [0.0, 0.0, 0.0],
            # Start at rest rotationally; friction/contacts add spin later.
            angular_velocity: [0.0, 0.0, 0.0],
            orientation: [0.0, 0.0, 0.0],
            inv_mass: 1.0,
            gravity_scale: 1.0,
            rotation_locked: false,
            is_static: false,
        }
        ball_collider := SphereCollider { radius: 0.5 }
        ball_flags := BodyFlags {
            shape: 1,
            radius: 0.5,
            half_height: 0.0,
            is_player: false,
            is_pickup: true,
            target_id: 3,
            held_by: 0,
        }
        ball_pickup := Pickup { body_id: 3 }
        ball_renderable := Renderable { kind: 1, colour: [1.0, 0.55, 0.22] }
        ball_material := Material { texture: 0, tint: [1.0, 0.55, 0.22] }
        commands.add_row(Components, {
            ball_transform,
            ball_id,
            ball_bounds,
            ball_body,
            ball_collider,
            ball_flags,
            ball_pickup,
            ball_renderable,
            ball_material,
        })

        # Three dynamic cubes stacked vertically (unlocked rotation).
        cube_x := -2.0
        cube_y := 0.5
        stack_index := 0
        while stack_index < 3:
            cube_transform := Transform {
                translation: [cube_x, cube_y, 0.0],
                rotation: [0.0, 0.0, 0.0],
                scale: [1.0, 1.0, 1.0],
            }
            cube_body_id := 4 + stack_index
            cube_id := BodyId { id: cube_body_id }
            cube_bounds := BodyBounds { half_extents: [0.5, 0.5, 0.5] }
            cube_body := RigidBody {
                velocity: [0.0, 0.0, 0.0],
                angular_velocity: [0.0, 0.0, 0.0],
                orientation: [0.0, 0.0, 0.0],
                inv_mass: 1.0,
                gravity_scale: 1.0,
                rotation_locked: false,
                is_static: false,
            }
            cube_collider := BoxCollider { half_extents: [0.5, 0.5, 0.5] }
            cube_flags := BodyFlags {
                shape: 0,
                radius: 0.0,
                half_height: 0.0,
                is_player: false,
                is_pickup: true,
                target_id: 4 + stack_index,
                held_by: 0,
            }
            cube_tint := e7_f32_from_i64(stack_index)
            cube_colour := [0.95 - cube_tint * 0.2, 0.85 + cube_tint * 0.05, 0.65 + cube_tint * 0.2]
            cube_renderable := Renderable { kind: 0, colour: cube_colour }
            cube_material := Material { texture: 0, tint: cube_colour }
            cube_pickup := Pickup { body_id: 4 + stack_index }
            commands.add_row(Components, {
                cube_transform,
                cube_id,
                cube_bounds,
                cube_body,
                cube_collider,
                cube_flags,
                cube_renderable,
                cube_pickup,
                cube_material,
            })
            cube_y = cube_y + 1.0
            stack_index = stack_index + 1

        # Rotation-locked capsule player, processed last so its capsule
        # narrowphase sees every other body in the broadphase grid.
        player_transform := Transform {
            translation: [-2.0, 1.2, 4.0],
            rotation: [0.0, 0.0, 0.0],
            scale: [1.0, 1.0, 1.0],
        }
        player_id := BodyId { id: 2 }
        player_bounds := BodyBounds { half_extents: [0.4, 1.0, 0.4] }
        player_body := RigidBody {
            velocity: [0.0, 0.0, 0.0],
            angular_velocity: [0.0, 0.0, 0.0],
            orientation: [0.0, 0.0, 0.0],
            inv_mass: 1.0,
            gravity_scale: 1.0,
            rotation_locked: true,
            is_static: false,
        }
        player_capsule := CapsuleCollider { radius: 0.4, half_height: 0.6 }
        player_flags := BodyFlags {
            shape: 2,
            radius: 0.4,
            half_height: 0.6,
            is_player: true,
            is_pickup: false,
            target_id: 2,
            held_by: 0,
        }
        player := Player { body_id: 2 }
        # First-person: the player capsule is physics-only (the eye is inside).
        commands.add_row(Components, {
            player_transform,
            player_id,
            player_bounds,
            player_body,
            player_capsule,
            player_flags,
            player,
        })

        light := PointLight {
            position: [2.0, 3.0, 4.0],
            colour: [1.0, 0.9, 0.8],
            intensity: 2.8,
        }
        commands.add_row(Components, { light })

        # Custom OBJ mesh entity: engine/assets/cube.obj uploaded to the GPU by
        # AssetsPlugin's FrameInit system and drawn with the sample texture.
        obj_transform := Transform {
            translation: [-0.8, 0.6, 1.0],
            rotation: [0.0, 0.4, 0.0],
            scale: [0.8, 0.8, 0.8],
        }
        obj_renderer := MeshRenderer {
            mesh: 0,
            pipeline: 0,
            colour: [1.0, 1.0, 1.0, 1.0],
        }
        obj_material := Material { texture: 0, tint: [0.85, 0.9, 1.0] }
        commands.add_row(Components, { obj_transform, obj_renderer, obj_material })


        # ---------------------------------------------------------------- UI
        # Overlay panel (first widget row draws the background).
        commands.add_row(Components, {
            UIRect { x: 30.0, y: 20.0, w: 340.0, h: 270.0 },
            UIPanel { colour: [0.055, 0.07, 0.105, 0.86] },
            default_label(),
            default_button(),
            default_field(),
        })
        # Title.
        commands.add_row(Components, {
            UIRect { x: 48.0, y: 34.0, w: 300.0, h: 30.0 },
            UIPanel { colour: [0.0, 0.0, 0.0, 0.0] },
            UILabel { text: "engine7 UI", size: 20, colour: [1.0, 0.95, 0.82, 1.0] },
            default_button(),
            default_field(),
        })
        # Button: reset the cube stack via the UIButtonPressed trigger.
        commands.add_row(Components, {
            UIRect { x: 52.0, y: 80.0, w: 280.0, h: 36.0 },
            UIPanel { colour: [0.16, 0.22, 0.32, 0.96] },
            default_label(),
            UIButton { label: "Reset Stack", action: 1 },
            default_field(),
        })
        # Button: toggle the demo light.
        commands.add_row(Components, {
            UIRect { x: 52.0, y: 124.0, w: 280.0, h: 36.0 },
            UIPanel { colour: [0.16, 0.22, 0.32, 0.96] },
            default_label(),
            UIButton { label: "Toggle Light", action: 2 },
            default_field(),
        })
        # Field label.
        commands.add_row(Components, {
            UIRect { x: 52.0, y: 178.0, w: 280.0, h: 20.0 },
            UIPanel { colour: [0.0, 0.0, 0.0, 0.0] },
            UILabel { text: "Name", size: 14, colour: [0.75, 0.8, 0.9, 1.0] },
            default_button(),
            default_field(),
        })
        # Text field: click, type, Backspace, Enter.
        commands.add_row(Components, {
            UIRect { x: 52.0, y: 200.0, w: 280.0, h: 34.0 },
            UIPanel { colour: [0.09, 0.12, 0.17, 0.96] },
            default_label(),
            default_button(),
            UITextField {
                text: "",
                max_len: 24,
                focused: false,
                revision: 0,
                rendered_revision: -1,
                texture: 0,
                texture_w: 0,
                texture_h: 0,
            },
        })

@trigger(UIButtonPressed)
pub demo_ui_actions <- sys (
    ui: res &UIState,
    world: res &mut PhysicsWorld,
    bodies: select &mut Transform, &mut RigidBody, &BodyId from Components,
    lights: select &mut PointLight from Components,
):
    if ui.action == 1:
        # Reset the three demo cubes upright on the plane and wake them.
        for (transform, body, id) in bodies:
            if id.id < 4 or id.id > 6:
                cont
            index := id.id - 4
            transform.translation[0] = -2.0
            transform.translation[1] = 0.5 + e7_f32_from_i64(index)
            transform.translation[2] = 0.0
            transform.rotation[0] = 0.0
            transform.rotation[1] = 0.0
            transform.rotation[2] = 0.0
            body.velocity[0] = 0.0
            body.velocity[1] = 0.0
            body.velocity[2] = 0.0
            body.angular_velocity[0] = 0.0
            body.angular_velocity[1] = 0.0
            body.angular_velocity[2] = 0.0
            body.orientation[0] = 0.0
            body.orientation[1] = 0.0
            body.orientation[2] = 0.0
            world.quaternions[id.id] = [0.0, 0.0, 0.0, 1.0]
            world.sleep_state[id.id] = [0.0, 0.0]
    elif ui.action == 2:
        for light in lights:
            if light.intensity > 1.0:
                light.intensity = 0.35
            else:
                light.intensity = 2.8

pub main <- async () -> i32:
    commands := await query &mut Commands

    commands.add_plugin(window::WindowPlugin)
    commands.add_plugin(input::InputPlugin)
    commands.add_plugin(time::TimePlugin)
    commands.add_plugin(gfx::GfxPlugin)
    commands.add_plugin(camera::CameraPlugin)
    commands.add_plugin(physics_broadphase::BroadphasePlugin)
    commands.add_plugin(physics_narrowphase::NarrowphasePlugin)
    commands.add_plugin(physics::PhysicsPlugin)
    commands.add_plugin(assets::AssetsPlugin)
    commands.add_plugin(DemoPlugin)
    commands.add_plugin(ui::Ui)
    disown commands

    window := await query &Window

    await Init()

    while not window.quit_requested:
        await FrameInit()
        await PreUpdate()
        ui_state := await query &mut UIState
        if ui_state.clicked_action != 0:
            ui_state.action = ui_state.clicked_action
            ui_state.clicked_action = 0
            await UIButtonPressed()
        await Update()
        await PostUpdate()
        await Render()

    await DeInit()

    ret 0
