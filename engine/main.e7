# engine7 entry point. All engine behavior lives in the imported libraries:
# events, ecs, gfx, time, window, input, camera, scene, bootstrap and ui.
mod events
mod ecs
mod gfx
mod time
mod window
mod input
mod camera
mod scene
mod bootstrap
mod ui

use events::*;
use ecs::*;
use gfx::*;
use time::*;
use window::*;
use input::*;
use camera::*;
use scene::*;
use bootstrap::*;

pub main <- async () -> i32:
    commands := await query &mut Commands

    commands.add_plugin(ui::Ui)

    commands.insert_resource(Window {
        handle: 0,
        width: 960,
        height: 540,
        quit_requested: false,
    })
    commands.insert_resource(Input {
        move_forward: false,
        move_backward: false,
        move_left: false,
        move_right: false,
        move_up: false,
        move_down: false,
        sprint: false,
        look_left: false,
        look_right: false,
        look_up: false,
        look_down: false,
        look_dx: 0.0,
        look_dy: 0.0,
    })
    commands.insert_resource(Time { delta: 0.0, elapsed: 0.0, now_ms: 0, start_ms: 0 })
    commands.insert_resource(Gpu {
        scene: 0,
        surface: 0,
        renderer: 0,
        swapchain_format: 0,
        width: 960,
        height: 540,
        cube_pipeline: 0,
        cube_vertex_shader: 0,
        cube_fragment_shader: 0,
    })

    disown commands

    window := await query &Window

    await Init()

    while not window.quit_requested:
        await FrameInit()
        await PreUpdate()
        await Update()
        await PostUpdate()
        await Render()

    await DeInit()

    ret 0
