# engine7 sample game/engine scaffold.
#
# The runtime exposes SDL3 and Vulkan through a small native ABI. Everything
# above that ABI lives here: resources, components, systems, the frame loop,
# and the GPU wrappers. The engine uses one ECS world; each frame runs the
# FrameInit, PreUpdate, Update, PostUpdate, and Render trigger phases.
#
# Controls: WASD move on the horizontal plane, Q/E down/up, Shift sprint,
# mouse look; Escape or the window close button exits. `run-engine --frames N`
# exits deterministically after N frames (headless by default).

# ---------------------------------------------------------------------------
# Resources: long-lived singletons owned by the world
# ---------------------------------------------------------------------------

mod ui

@resource
Window <- struct
    handle: u64
    width: i32
    height: i32
    quit_requested: bool

@resource
Input <- struct
    move_forward: bool
    move_backward: bool
    move_left: bool
    move_right: bool
    move_up: bool
    move_down: bool
    sprint: bool
    look_left: bool
    look_right: bool
    look_up: bool
    look_down: bool
    look_dx: f32
    look_dy: f32

@resource
Time <- struct
    delta: f32
    elapsed: f32
    # Integer clocks for the millisecond intrinsic ABI.
    now_ms: i64
    start_ms: i64

@resource
Gpu <- struct
    # Engine window/scene handles (see e7_engine_* intrinsics).
    scene: u64
    # Native handles returned by the runtime's Vulkan ABI.
    surface: u64
    renderer: u64
    swapchain_format: i32
    width: i32
    height: i32

    # Shader/pipeline deployment state. A pipeline is created from a pair of
    # SPIR-V modules produced from Slang sources at build time.
    cube_pipeline: u64
    cube_vertex_shader: u64
    cube_fragment_shader: u64

# Runtime command buffer used to mutate the world outside systems (resource
# insertion, table row insertion, plugin registration).
Commands <- struct
    # Opaque runtime handle filled by `await query &mut Commands`.
    handle: u64

# ---------------------------------------------------------------------------
# Component traits and components
# ---------------------------------------------------------------------------

# Component types are plain structs tagged with @Components. Entity identity is
# carried in the `entity_id` column; the Components table below is the ECS
# storage/query source used by `select ... from Components`.

@Components
Camera <- struct
    # World-space eye position in metres.
    position: [f32; 3]
    # Radians around +Y (0 looks down -Z).
    yaw: f32
    # Radians; positive looks up.
    pitch: f32
    fov_y: f32
    near: f32
    far: f32

@Components
CameraController <- struct
    move_speed: f32
    look_speed: f32

@Components
Transform <- struct
    translation: [f32; 3]
    rotation: [f32; 3]
    scale: [f32; 3]

@Components
MeshRenderer <- struct
    mesh: u64
    pipeline: u64
    colour: [f32; 4]

@Components
PointLight <- struct
    position: [f32; 3]
    colour: [f32; 3]
    intensity: f32

@Components
CubeMesh <- struct
    # TODO: make this actually a thing

# The ECS component table. Each row is an entity; component columns are
# optional per entity (empty slots mean “component absent”). Systems query it
# with `select &mut Component from Components`.
Components <- table
    entity_id: usize,
    ... # automatically collects all types with @Components

# ---------------------------------------------------------------------------
# GPU wrappers: resources over the runtime's SDL/Vulkan ABI
# ---------------------------------------------------------------------------

ShaderModule <- struct
    handle: u64
    stage: ShaderStage

ShaderStage <- enum
    Vertex
    Fragment

RasterPipeline <- struct
    handle: u64
    vertex: ShaderModule
    fragment: ShaderModule
    topology: Topology

Topology <- enum
    TriangleList

Mesh <- struct
    handle: u64
    vertex_count: u64
    index_count: u64

ComputePipeline <- struct
    handle: u64
    shader: ShaderModule
    workgroup_size: [u32; 3]

# A deploy is the e7-side description of a shader pair. `gpu_deploy_shader`
# reads SPIR-V produced from `shaders/*.slang` and builds a raster pipeline.
ShaderDeploy <- struct
    name: str
    vertex_spirv: [u8]
    fragment_spirv: [u8]

PipelineOptions <- struct
    depth_test: bool
    depth_write: bool
    cull_mode: CullMode
    topology: Topology

CullMode <- enum
    None
    Front
    Back

# Overloaded deployment entry points. The runtime ABI exposes the Vulkan calls;
# these declarations are the e7-facing resource wrappers. The body is filled
# once the compiler can lower `res &mut` sys parameter bodies.
#
# All of the gpu_* functions should be methods of the Gpu type
gpu_deploy_raster_pipeline <- async (
    gpu: &mut Gpu,
    deploy: ShaderDeploy,
    options: PipelineOptions,
) -> u64:
    ret 0

gpu_deploy_compute_pipeline <- async (
    gpu: &mut Gpu,
    shader: ShaderModule,
    workgroup_size: [u32; 3],
) -> u64:
    ret 0

gpu_create_mesh <- async (
    gpu: &mut Gpu,
    vertices: [f32],
    indices: [u32],
) -> u64:
    ret 0

gpu_set_uniform <- async (
    gpu: &mut Gpu,
    name: str,
    value: [f32; 4],
) -> !nil:
    ret

gpu_begin_frame <- async (gpu: &mut Gpu) -> !nil:
    ret

gpu_end_frame <- async (gpu: &mut Gpu) -> !nil:
    ret

gpu_draw_mesh <- async (
    gpu: &mut Gpu,
    mesh: Mesh,
    transform: Transform,
    camera: &Camera,
    light: &PointLight,
) -> !nil:
    ret

Init <- trigger
DeInit <- trigger

# ---------------------------------------------------------------------------
# Frame triggers
# ---------------------------------------------------------------------------

FrameInit <- trigger
PreUpdate <- trigger
Update <- trigger
PostUpdate <- trigger
Render <- trigger

# ---------------------------------------------------------------------------
# Systems
# ---------------------------------------------------------------------------

@trigger(Init)
init_window <- sys (
    window: res &mut Window,
    gpu: res &mut Gpu,
    time: res &mut Time,

    # Commands is what lets you insert to tables, etc.
    commands: &mut Commands,
):
    # Compiler-known engine intrinsics: create a (hidden when --headless)
    # SDL/Vulkan window and a scene using the runtime's embedded SPIR-V.
    window.width = 960
    window.height = 540
    window.handle = e7_engine_window_create("engine7", window.width, window.height)
    window.quit_requested = false

    gpu.scene = e7_engine_scene_create(window.handle)
    gpu.width = window.width
    gpu.height = window.height
    time.start_ms = e7_engine_time_now_ms()

    camera_transform := Transform {
        translation: [0.0, 1.5, 6.0],
        rotation: [0.0, 0.0, 0.0],
        scale: [1.0, 1.0, 1.0],
    }
    camera := Camera {
        position: [0.0, 1.8, 5.5]
        yaw: 0.0
        pitch: -0.14
        fov_y: 1.0471975512
        near: 0.1
        far: 100.0
    }
    controller := CameraController {
        move_speed: 4.0,
        look_speed: 0.0025,
    }
    commands.add_row(Components, { camera_transform, camera, controller })

    cube_transform := Transform {
        translation: [0.0, 0.0, 0.0],
        rotation: [0.0, 0.0, 0.0],
        scale: [1.0, 1.0, 1.0],
    }
    cube_mesh := CubeMesh

    commands.add_row(Components, { cube_transform, cube_mesh })


    light := PointLight {
        position: [2.0, 3.0, 4.0],
        colour: [1.0, 0.9, 0.8],
        intensity: 12.0,
    }
    commands.add_row(Components, { light })

@trigger(FrameInit)
poll_window <- sys (window: res &mut Window):
    # Pump SDL events through the runtime. Window close sets quit_requested;
    # the main loop treats that as the frame-exit signal. The frame limiter
    # (`e7_engine_should_close`) is polled from Render after drawing.
    window.quit_requested = e7_engine_window_pump(window.handle) != 0

@trigger(FrameInit)
gather_input <- sys (input: res &mut Input):
    # The runtime exposes only raw key state and accumulated mouse motion; all
    # camera/input policy lives here. Logical key codes: 0 W, 1 S, 2 A, 3 D,
    # 4 E (up), 5 Q (down), 6 Shift, 7-10 arrow look.
    input.move_forward = e7_engine_key_down(0) != 0
    input.move_backward = e7_engine_key_down(1) != 0
    input.move_left = e7_engine_key_down(2) != 0
    input.move_right = e7_engine_key_down(3) != 0
    input.move_up = e7_engine_key_down(4) != 0
    input.move_down = e7_engine_key_down(5) != 0
    input.sprint = e7_engine_key_down(6) != 0
    input.look_left = e7_engine_key_down(7) != 0
    input.look_right = e7_engine_key_down(8) != 0
    input.look_up = e7_engine_key_down(9) != 0
    input.look_down = e7_engine_key_down(10) != 0
    # Guard against focus/VM mouse jumps; the delta itself is consumed here.
    input.look_dx = e7_f32_clamp(e7_f32_from_i64(e7_engine_mouse_dx()), -600.0, 600.0)
    input.look_dy = e7_f32_clamp(e7_f32_from_i64(e7_engine_mouse_dy()), -600.0, 600.0)

@trigger(Update)
move_camera <- sys (
    input: &Input,
    time: &Time,
    controllers: select &mut Camera, &mut CameraController from Components,
):
    # First-person camera policy (the runtime only supplies raw input):
    # mouse/arrow look, pitch clamp, then WASD/QE movement on a fixed 16ms step.
    delta := 0.016
    pitch_limit := 1.5533430343
    for (camera, controller) in controllers:
        camera.yaw = camera.yaw + input.look_dx * controller.look_speed
        camera.pitch = camera.pitch - input.look_dy * controller.look_speed
        keyboard_look := 1.6 * delta
        if input.look_left:
            camera.yaw = camera.yaw - keyboard_look
        if input.look_right:
            camera.yaw = camera.yaw + keyboard_look
        if input.look_up:
            camera.pitch = camera.pitch + keyboard_look
        if input.look_down:
            camera.pitch = camera.pitch - keyboard_look
        camera.pitch = e7_f32_clamp(camera.pitch, -pitch_limit, pitch_limit)

        # Camera-relative basis: yaw 0 looks down -Z, +yaw turns toward +X.
        sin_yaw := e7_f32_sin(camera.yaw)
        cos_yaw := e7_f32_cos(camera.yaw)
        forward_x := sin_yaw
        forward_z := 0.0 - cos_yaw
        right_x := cos_yaw
        right_z := sin_yaw

        dir_x := 0.0
        dir_y := 0.0
        dir_z := 0.0
        if input.move_forward:
            dir_x = dir_x + forward_x
            dir_z = dir_z + forward_z
        if input.move_backward:
            dir_x = dir_x - forward_x
            dir_z = dir_z - forward_z
        if input.move_right:
            dir_x = dir_x + right_x
            dir_z = dir_z + right_z
        if input.move_left:
            dir_x = dir_x - right_x
            dir_z = dir_z - right_z
        if input.move_up:
            dir_y = dir_y + 1.0
        if input.move_down:
            dir_y = dir_y - 1.0

        speed := controller.move_speed * delta
        if input.sprint:
            speed = speed * 2.5
        length := e7_f32_sqrt(dir_x * dir_x + dir_y * dir_y + dir_z * dir_z)
        if length > 0.000001:
            scale := speed / length
            camera.position[0] = camera.position[0] + dir_x * scale
            camera.position[1] = camera.position[1] + dir_y * scale
            camera.position[2] = camera.position[2] + dir_z * scale

@trigger(Update)
spin_cube <- sys (
    transforms: select &mut Transform from Components where has CubeMesh,
    time: &Time,
):
    # `where has CubeMesh` is applied by the runtime query. Rotation updates
    # need f32 arithmetic on `transform.rotation` (TODO).
    for transform in transforms:
        transform.rotation

@trigger(Update)
update_light <- sys (lights: select &mut PointLight from Components, time: &Time):
    # Iterating PointLight rows is wired; animated light placement needs f32
    # arithmetic (TODO).
    for light in lights:
        light.position

@trigger(PostUpdate)
reset_input <- sys (input: res &mut Input):
    input.move_forward = false
    input.move_backward = false
    input.move_left = false
    input.move_right = false
    input.move_up = false
    input.move_down = false
    input.sprint = false
    input.look_left = false
    input.look_right = false
    input.look_up = false
    input.look_down = false
    input.look_dx = 0.0
    input.look_dy = 0.0

@trigger(Render)
render_scene <- sys (
    gpu: res &mut Gpu,
    window: res &mut Window,
    time: &Time,
    cubes: select &CubeMesh, &Transform from Components,
    lights: select &PointLight from Components,
    cameras: select &Camera from Components,
):
    # Push the e7-owned camera into the renderer (milli-unit/milli-degree ABI),
    # then draw the spinning cube and point light.
    for camera in cameras:
        yaw_degrees := camera.yaw * 57.2957795
        pitch_degrees := camera.pitch * 57.2957795
        e7_engine_scene_set_camera(
            gpu.scene,
            e7_f32_to_milli(camera.position[0]),
            e7_f32_to_milli(camera.position[1]),
            e7_f32_to_milli(camera.position[2]),
            e7_f32_to_milli(yaw_degrees),
            e7_f32_to_milli(pitch_degrees),
        )

    # Units: scene helper delta in ms; cube angle in milli-radians.
    now := e7_engine_time_now_ms()
    elapsed_ms := now - time.start_ms
    e7_engine_scene_draw(gpu.scene, 16, elapsed_ms, 2600, 3000, 2600)

    # Query iteration is available here too; the native renderer currently owns
    # the GPU scene, so cube/light rows are read but not consumed yet.
    for (cube, cube_transform) in cubes:
        cube
        cube_transform
    for light_row in lights:
        light_row.position

    # Poll the frame limiter only after drawing so the captured/last frame is
    # the one the user sees. A window close request also exits.
    window.quit_requested = e7_engine_window_should_close(window.handle) != 0 or e7_engine_should_close() != 0

@trigger(DeInit)
shutdown <- sys (window: res &mut Window, gpu: res &mut Gpu):
    e7_engine_scene_destroy(gpu.scene)
    e7_engine_window_destroy(window.handle)

# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

main <- async () -> i32:
    commands := await query &mut Commands

    commands.add_plugin(ui::Ui)

    commands.insert_resource(Window {
        handle: 0,
        width: 960,
        height: 540,
        quit_requested: false,
    })
    commands.insert_resource(Input {
        move_forward: false,
        move_backward: false,
        move_left: false,
        move_right: false,
        move_up: false,
        move_down: false,
        sprint: false,
        look_left: false,
        look_right: false,
        look_up: false,
        look_down: false,
        look_dx: 0.0,
        look_dy: 0.0,
    })
    commands.insert_resource(Time { delta: 0.0, elapsed: 0.0, now_ms: 0, start_ms: 0 })
    commands.insert_resource(Gpu {
        scene: 0,
        surface: 0,
        renderer: 0,
        swapchain_format: 0,
        width: 960,
        height: 540,
        cube_pipeline: 0,
        cube_vertex_shader: 0,
        cube_fragment_shader: 0,
    })

    disown commands

    window := await query &Window

    await Init()

    while not window.quit_requested:
        await FrameInit()
        await PreUpdate()
        await Update()
        await PostUpdate()
        await Render()

    await DeInit()

    ret 0
