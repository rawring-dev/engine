# GPU resources, materials, and shader/pipeline descriptions.

use core::window::*;

# Per-object material: a GPU texture id (0 = built-in white texture) and an
# RGB tint.  The scene renderer samples `texture` with the mesh UVs and
# multiplies its own vertex colour and `tint`.
@Components
pub Material <- struct
    texture: u64
    tint: [f32; 3]

@resource
pub Gpu <- struct
    scene: u64
    surface: u64
    renderer: u64
    swapchain_format: i32
    width: i32
    height: i32

    cube_pipeline: u64
    cube_vertex_shader: u64
    cube_fragment_shader: u64


# Inherent Gpu methods: the raw e7_engine_scene_* / e7_engine_read_shader
# intrinsics are confined here; game code calls methods such as
# `gpu.set_camera(...)`, `gpu.begin_frame()`, `gpu.draw_renderable(...)`.
impl Gpu:
    pub read_shader <- (gpu: &Gpu, path: str) -> str:
        ret e7_engine_read_shader(path)

    pub create_scene <- (gpu: &mut Gpu, window: &Window, vert: str, frag: str) -> nil:
        gpu.scene = e7_engine_scene_create(window.handle, vert, frag)
        gpu.width = window.width
        gpu.height = window.height
        ret

    pub destroy_scene <- (gpu: &mut Gpu) -> nil:
        e7_engine_scene_destroy(gpu.scene)
        gpu.scene = 0
        ret

    # Integer-scaled ABI: camera yaw/pitch in milli-degrees, eye milli-units.
    pub set_camera <- (
        gpu: &Gpu,
        eye_x: i64,
        eye_y: i64,
        eye_z: i64,
        yaw: i64,
        pitch: i64,
    ) -> nil:
        e7_engine_scene_set_camera(gpu.scene, eye_x, eye_y, eye_z, yaw, pitch)
        ret

    pub set_light <- (
        gpu: &Gpu,
        x: i64,
        y: i64,
        z: i64,
        r: i64,
        g: i64,
        b: i64,
        intensity: i64,
    ) -> nil:
        e7_engine_scene_set_light(gpu.scene, x, y, z, r, g, b, intensity)
        ret

    pub begin_frame <- (gpu: &Gpu) -> nil:
        e7_engine_scene_begin_frame(gpu.scene)
        ret

    pub end_frame <- (gpu: &Gpu) -> nil:
        e7_engine_scene_end_frame(gpu.scene)
        ret

    # Procedural renderable: kind (0 box, 1 sphere, 2 capsule, 3 plane),
    # position/scale milli-units, XYZ Euler rotation milli-radians, RGB tint
    # milli, texture id.
    pub draw_renderable <- (
        gpu: &Gpu,
        kind: i32,
        px: i64,
        py: i64,
        pz: i64,
        sx: i64,
        sy: i64,
        sz: i64,
        rx: i64,
        ry: i64,
        rz: i64,
        tr: i64,
        tg: i64,
        tb: i64,
        texture: u64,
    ) -> nil:
        e7_engine_scene_draw_shape_rot(
            gpu.scene, kind, px, py, pz, sx, sy, sz, rx, ry, rz, tr, tg, tb, texture,
        )
        ret

    # Uploaded custom mesh draw (same transform/material layout as above).
    pub draw_custom <- (
        gpu: &Gpu,
        mesh: u64,
        px: i64,
        py: i64,
        pz: i64,
        sx: i64,
        sy: i64,
        sz: i64,
        rx: i64,
        ry: i64,
        rz: i64,
        tr: i64,
        tg: i64,
        tb: i64,
        texture: u64,
    ) -> nil:
        e7_engine_scene_draw_custom_rot(
            gpu.scene, mesh, px, py, pz, sx, sy, sz, rx, ry, rz, tr, tg, tb, texture,
        )
        ret

    pub upload_texture <- (gpu: &mut Gpu, image_handle: u64) -> u64:
        ret e7_engine_scene_texture_create(gpu.scene, image_handle)

    pub destroy_texture <- (gpu: &Gpu, texture: u64) -> nil:
        e7_engine_scene_texture_destroy(gpu.scene, texture)
        ret

    pub upload_mesh <- (
        gpu: &mut Gpu,
        vertices: [f32],
        indices: [i32],
        layout: i32,
    ) -> u64:
        ret e7_engine_scene_mesh_upload(gpu.scene, vertices, indices, layout)

    # Screen-space UI quad: pixel coordinates from the top-left, RGBA 0..255.
    # Call after world draws (inside begin_frame/end_frame); texture 0 is a
    # solid tinted rectangle, text images work through their texture id.
    pub draw_ui_quad <- (
        gpu: &Gpu,
        texture: u64,
        x: i64,
        y: i64,
        w: i64,
        h: i64,
        r: i64,
        g: i64,
        b: i64,
        a: i64,
    ) -> nil:
        e7_engine_scene_draw_ui_quad(gpu.scene, texture, x, y, w, h, r, g, b, a)
        ret


# Asset text reader wrapper (OBJ/shader text).  Raw intrinsic stays here.
pub read_asset <- (path: str) -> str:
    ret e7_engine_read_shader(path)


pub GfxPlugin <- plugin
    gfx_plugin_init <- sys (commands: &mut Commands):
        commands.insert_resource(Gpu {
            scene: 0,
            surface: 0,
            renderer: 0,
            swapchain_format: 0,
            width: 960,
            height: 540,
            cube_pipeline: 0,
            cube_vertex_shader: 0,
            cube_fragment_shader: 0,
        })

pub ShaderModule <- struct
    handle: u64
    stage: ShaderStage

pub ShaderStage <- enum
    Vertex
    Fragment

pub RasterPipeline <- struct
    handle: u64
    vertex: ShaderModule
    fragment: ShaderModule
    topology: Topology

pub Topology <- enum
    TriangleList

pub Mesh <- struct
    handle: u64
    vertex_count: u64
    index_count: u64

pub ComputePipeline <- struct
    handle: u64
    shader: ShaderModule
    workgroup_size: [u32; 3]

pub ShaderDeploy <- struct
    name: str
    vertex_spirv: [u8]
    fragment_spirv: [u8]

pub PipelineOptions <- struct
    depth_test: bool
    depth_write: bool
    cull_mode: CullMode
    topology: Topology

pub CullMode <- enum
    None
    Front
    Back

# Overloaded deployment entry points. The runtime ABI exposes the Vulkan calls;
# these declarations are the e7-facing resource wrappers. The body is filled
# once the compiler can lower `res &mut` sys parameter bodies.
pub gpu_deploy_raster_pipeline <- async (
    gpu: &mut Gpu,
    deploy: ShaderDeploy,
    options: PipelineOptions,
) -> u64:
    ret 0

pub gpu_deploy_compute_pipeline <- async (
    gpu: &mut Gpu,
    shader: ShaderModule,
    workgroup_size: [u32; 3],
) -> u64:
    ret 0

pub gpu_create_mesh <- async (
    gpu: &mut Gpu,
    vertices: [f32],
    indices: [u32],
) -> u64:
    ret 0

pub gpu_set_uniform <- async (
    gpu: &mut Gpu,
    name: str,
    value: [f32; 4],
) -> !nil:
    ret

pub gpu_begin_frame <- async (gpu: &mut Gpu) -> !nil:
    ret

pub gpu_end_frame <- async (gpu: &mut Gpu) -> !nil:
    ret

pub gpu_draw_mesh <- async (
    gpu: &mut Gpu,
    mesh: Mesh,
    transform: Transform,
    camera: &Camera,
    light: &PointLight,
) -> !nil:
    ret

