use ecs::*;
use events::*;
use gfx::*;
use time::*;

@trigger(Update)
pub update_light <- sys (lights: select &mut PointLight from Components, time: res &Time):
    angle := time.elapsed * 0.7 + 0.8
    for light in lights:
        light.position[0] = 2.8 * e7_f32_cos(angle)
        light.position[1] = 3.0
        light.position[2] = 2.8 * e7_f32_sin(angle)


@trigger(Render)
pub render_scene <- sys (
    gpu: res &mut Gpu,
    window: res &mut Window,
    renderables: select &Transform, &Renderable, &BodyBounds, &Material from Components,
    meshes: select &Transform, &MeshRenderer, &Material from Components,
    lights: select &PointLight from Components,
    cameras: select &Camera from Components,
):
    # First-person: the ECS camera is the eye.  Every renderable shares it.
    for camera in cameras:
        yaw_degrees := camera.yaw * 57.2957795
        pitch_degrees := camera.pitch * 57.2957795
        e7_engine_scene_set_camera(
            gpu.scene,
            e7_f32_to_milli(camera.position[0]),
            e7_f32_to_milli(camera.position[1]),
            e7_f32_to_milli(camera.position[2]),
            e7_f32_to_milli(yaw_degrees),
            e7_f32_to_milli(pitch_degrees),
        )

    for light_row in lights:
        e7_engine_scene_set_light(
            gpu.scene,
            e7_f32_to_milli(light_row.position[0]),
            e7_f32_to_milli(light_row.position[1]),
            e7_f32_to_milli(light_row.position[2]),
            e7_f32_to_milli(light_row.colour[0]),
            e7_f32_to_milli(light_row.colour[1]),
            e7_f32_to_milli(light_row.colour[2]),
            e7_f32_to_milli(light_row.intensity),
        )

    # Frame submission is e7 policy: configure camera/light, begin the frame,
    # draw one procedural shape per renderable, then end/present it.
    e7_engine_scene_begin_frame(gpu.scene)
    for (transform, renderable, bounds, material) in renderables:
        # Physics bodies keep their visual size in BodyBounds; the procedural
        # meshes are unit-sized, so the scale is half-extent based.
        sx := bounds.half_extents[0]
        sy := bounds.half_extents[1]
        sz := bounds.half_extents[2]
        if renderable.kind == 1:
            # Sphere: radius is the largest half-extent on every axis.
            radius := sx
            if sy > radius:
                radius = sy
            if sz > radius:
                radius = sz
            sx = radius
            sy = radius
            sz = radius
        if renderable.kind == 2:
            # Capsule geometry: scale x/z is the radius, scale y is the
            # cylinder half-height (see runtime renderer.capsule_vertices).
            radius := sx
            if sz > radius:
                radius = sz
            cylinder_half := sy - radius
            if cylinder_half < 0.0:
                cylinder_half = 0.0
            sx = radius
            sy = cylinder_half
            sz = radius
        # Full XYZ Euler orientation from the physics Transform (roll/pitch/yaw
        # in radians), matching the physics quaternion convention.
        e7_engine_scene_draw_shape_rot(
            gpu.scene,
            renderable.kind,
            e7_f32_to_milli(transform.translation[0]),
            e7_f32_to_milli(transform.translation[1]),
            e7_f32_to_milli(transform.translation[2]),
            e7_f32_to_milli(sx),
            e7_f32_to_milli(sy),
            e7_f32_to_milli(sz),
            e7_f32_to_milli(transform.rotation[0]),
            e7_f32_to_milli(transform.rotation[1]),
            e7_f32_to_milli(transform.rotation[2]),
            e7_f32_to_milli(material.tint[0]),
            e7_f32_to_milli(material.tint[1]),
            e7_f32_to_milli(material.tint[2]),
            material.texture,
        )
    # Custom OBJ meshes uploaded by AssetsPlugin.  `mesh` is assigned at
    # FrameInit; rows with mesh 0 are skipped until the upload completes.
    for (mesh_transform, mesh_renderer, mesh_material) in meshes:
        if mesh_renderer.mesh == 0:
            cont
        e7_engine_scene_draw_custom_rot(
            gpu.scene,
            mesh_renderer.mesh,
            e7_f32_to_milli(mesh_transform.translation[0]),
            e7_f32_to_milli(mesh_transform.translation[1]),
            e7_f32_to_milli(mesh_transform.translation[2]),
            e7_f32_to_milli(mesh_transform.scale[0]),
            e7_f32_to_milli(mesh_transform.scale[1]),
            e7_f32_to_milli(mesh_transform.scale[2]),
            e7_f32_to_milli(mesh_transform.rotation[0]),
            e7_f32_to_milli(mesh_transform.rotation[1]),
            e7_f32_to_milli(mesh_transform.rotation[2]),
            e7_f32_to_milli(mesh_material.tint[0]),
            e7_f32_to_milli(mesh_material.tint[1]),
            e7_f32_to_milli(mesh_material.tint[2]),
            mesh_material.texture,
        )
    e7_engine_scene_end_frame(gpu.scene)

    window.quit_requested = e7_engine_window_should_close(window.handle) != 0 or e7_engine_should_close() != 0
