use events::*;

@resource
pub Time <- struct
    delta: f32
    elapsed: f32
    # Integer clocks for the millisecond intrinsic ABI.
    now_ms: i64
    start_ms: i64


pub TimePlugin <- plugin
    time_plugin_init <- sys (commands: &mut Commands):
        commands.insert_resource(Time { delta: 0.0, elapsed: 0.0, now_ms: 0, start_ms: 0 })

@trigger(PreUpdate)
pub tick_time <- sys (time: res &mut Time):
    now := e7_engine_time_now_ms()
    time.now_ms = now
    time.elapsed = e7_f32_from_i64(now - time.start_ms) / 1000.0
    time.delta = 0.016

