mod broadphase
mod narrowphase

# Physics library: vector/ray primitives, plugin resources, and the single
# fixed-step Update system that composes broadphase and narrowphase modules.
#
# Modules:
#   - physics_broadphase.e7: SpatialMap, cell keys, region/ray candidate queries
#   - physics_narrowphase.e7: AABB/sphere/capsule/plane tests + raycasts
#   - physics.e7 (this file): public Vec3/Ray/Aabb API, ECS resources, systems
#
# All gameplay physics happens in one Update system so the order is
# deterministic even though trigger phases run systems concurrently:
#   gravity + quaternion integration + oriented ground manifolds for all bodies
#   -> complete broadphase snapshot (conservative rotated AABBs)
#   -> clipped box faces / oriented capsule / sphere contact constraints
#   -> accumulated velocity impulses + split positional iterations for all bodies
#   -> nearest-pickup acquire/release/hold
#   -> camera look + player-follow -> (PostUpdate: Held marker sync, debug ray).
# The step is fixed at 16 ms.  Quaternion authoritative orientation lives in
# PhysicsWorld.quaternions (map body id -> [x,y,z,w]); the step publishes it to
# the BodyOrientation component for rendering and never decomposes it back to
# Euler angles.  Transform.rotation is authored data for static bodies and
# non-physics callers; dynamic bodies leave it untouched.  Pickup and camera
# follow observe the same step's transforms instead of lagging a phase behind.

use core::ecs::*;
use core::events::*;
use core::time::*;

pub Vec3 <- struct
    x: f32
    y: f32
    z: f32

pub Ray <- struct
    origin: Vec3
    direction: Vec3

pub Aabb <- struct
    min: Vec3
    max: Vec3

pub RayHit <- struct
    hit: bool
    distance: f32
    point: Vec3

@resource
pub PhysicsWorld <- struct
    gravity_y: f32
    max_step: f32
    grounded: bool
    # Prevents held-Space from auto-hopping on every landing.
    jump_latched: bool
    # Player world position and latest camera look (used by movement, pickup,
    # and camera follow; the camera pass updates these at the end of the step).
    player_x: f32
    player_y: f32
    player_z: f32
    camera_yaw: f32
    camera_pitch: f32
    move_speed: f32
    # Quaternion per body id (x, y, z, w).  The sole orientation state for the
    # simulation: initialised once from the authored Euler Transform.rotation
    # (static bodies keep that value) and integrated with normalisation for
    # dynamic bodies.  Collision, the body AABB and the rendered model matrix
    # all consume this quaternion directly.  Diagonal inverse inertia is derived
    # per shape from BodyBounds/mass when impulses are applied.
    quaternions: map[i64, [f32]]
    # Ground plane used by narrowphase (demo plane is y-up at 0).
    plane_normal: [f32; 3]
    plane_offset: f32
    # Coulomb friction coefficients (dynamic / static).  High by default so
    # boxes stop sliding and stack instead of gliding.
    friction: f32
    friction_static: f32
    # Reserved for compatibility with existing scene resource initializers.
    # The contact solver now commits complete body states without deferred impulses.
    pending_impulses: map[i64, [f32]]
    # Per-body sleep state: [timer_seconds, sleeping_flag].  A supported body
    # with low linear/angular speed freezes after 0.35 s and wakes on contact or
    # player interaction.
    sleep_state: map[i64, [f32]]

@resource
pub RaycastState <- struct
    hit: bool
    distance: f32
    point_x: f32
    point_y: f32
    point_z: f32

@resource
pub PickupState <- struct
    # Body id held by the player, or 0 for none.
    held_id: i64

pub PhysicsPlugin <- plugin
    physics_plugin_init <- sys (commands: &mut Commands):
        commands.insert_resource(PhysicsWorld {
            gravity_y: -30.0, # demo gravity: 30 m/s² downward
            max_step: 0.05,
            grounded: false,
            jump_latched: false,
            player_x: 0.0,
            player_y: 0.0,
            player_z: 0.0,
            camera_yaw: 0.0,
            camera_pitch: 0.0,
            move_speed: 4.0,
            quaternions: map[i64, [f32]] {},
            plane_normal: [0.0, 1.0, 0.0],
            plane_offset: 0.0,
            friction: 0.9,
            friction_static: 1.15,
            pending_impulses: map[i64, [f32]] {},
            sleep_state: map[i64, [f32]] {},
        })
        commands.insert_resource(RaycastState {
            hit: false,
            distance: 0.0,
            point_x: 0.0,
            point_y: 0.0,
            point_z: 0.0,
        })
        commands.insert_resource(PickupState { held_id: 0 })

pub box_collider <- (center: Vec3, half: Vec3) -> Aabb:
    ret Aabb {
        min: Vec3 {
            x: center.x - half.x,
            y: center.y - half.y,
            z: center.z - half.z,
        },
        max: Vec3 {
            x: center.x + half.x,
            y: center.y + half.y,
            z: center.z + half.z,
        },
    }

pub ray_aabb <- (ray: Ray, box: Aabb) -> RayHit:
    # Slab test without division-by-zero hazards.
    inv_x := 1.0 / ray.direction.x
    inv_y := 1.0 / ray.direction.y
    inv_z := 1.0 / ray.direction.z
    t1 := (box.min.x - ray.origin.x) * inv_x
    t2 := (box.max.x - ray.origin.x) * inv_x
    t3 := (box.min.y - ray.origin.y) * inv_y
    t4 := (box.max.y - ray.origin.y) * inv_y
    t5 := (box.min.z - ray.origin.z) * inv_z
    t6 := (box.max.z - ray.origin.z) * inv_z
    xmin := t1
    if t2 < xmin:
        xmin = t2
    xmax := t1
    if t2 > xmax:
        xmax = t2
    ymin := t3
    if t4 < ymin:
        ymin = t4
    ymax := t3
    if t4 > ymax:
        ymax = t4
    zmin := t5
    if t6 < zmin:
        zmin = t6
    zmax := t5
    if t6 > zmax:
        zmax = t6
    tmin := xmin
    if ymin > tmin:
        tmin = ymin
    if zmin > tmin:
        tmin = zmin
    tmax := xmax
    if ymax < tmax:
        tmax = ymax
    if zmax < tmax:
        tmax = zmax
    hit := tmax >= tmin and tmax >= 0.0
    t := tmin
    if t < 0.0:
        t = tmax
    ret RayHit {
        hit: hit,
        distance: t,
        point: Vec3 {
            x: ray.origin.x + ray.direction.x * t,
            y: ray.origin.y + ray.direction.y * t,
            z: ray.origin.z + ray.direction.z * t,
        },
    }

pub ray_sphere <- (ray: Ray, center: Vec3, radius: f32) -> RayHit:
    ox := ray.origin.x - center.x
    oy := ray.origin.y - center.y
    oz := ray.origin.z - center.z
    b := ox * ray.direction.x + oy * ray.direction.y + oz * ray.direction.z
    c := ox * ox + oy * oy + oz * oz - radius * radius
    disc := b * b - c
    if disc < 0.0:
        ret RayHit { hit: false, distance: 0.0, point: ray.origin }
    root := f32::sqrt(disc)
    t := 0.0 - b - root
    if t < 0.0:
        t = 0.0 - b + root
    ret RayHit {
        hit: t >= 0.0,
        distance: t,
        point: Vec3 {
            x: ray.origin.x + ray.direction.x * t,
            y: ray.origin.y + ray.direction.y * t,
            z: ray.origin.z + ray.direction.z * t,
        },
    }

# ---------------------------------------------------------------------------
# Broadphase lookup helpers used by the collision pass
# ---------------------------------------------------------------------------

find_bound_index_local <- (ids: [i64], id: i64) -> i64:
    index := 0
    count := ids.len() as i64
    while index < count:
        if ids[index as usize] == id:
            ret index
        index = index + 1
    ret -1

# ---------------------------------------------------------------------------
# Sleep support helpers
# ---------------------------------------------------------------------------

# Distance from a body centre to the support direction along -normal, i.e. the
# shape's half-extent projected onto `normal`.  Boxes use the rotated extents,
# capsules use radius + half_height * |axis.n|, spheres use the radius.
shape_extent_along <- (
    shape: i64,
    half: Vec3,
    radius: f32,
    half_height: f32,
    orientation: Quat,
    normal: Vec3,
) -> f32:
    length := f32::sqrt(normal.x * normal.x + normal.y * normal.y + normal.z * normal.z)
    if length < 0.000001:
        ret 0.0
    nx := normal.x / length
    ny := normal.y / length
    nz := normal.z / length
    if shape == 0:
        ax := quat_rotate(Quat { x: orientation.x, y: orientation.y, z: orientation.z, w: orientation.w }, Vec3 { x: 1.0, y: 0.0, z: 0.0 })
        ay := quat_rotate(Quat { x: orientation.x, y: orientation.y, z: orientation.z, w: orientation.w }, Vec3 { x: 0.0, y: 1.0, z: 0.0 })
        az := quat_rotate(Quat { x: orientation.x, y: orientation.y, z: orientation.z, w: orientation.w }, Vec3 { x: 0.0, y: 0.0, z: 1.0 })
        ex := f32::abs(nx * ax.x + ny * ax.y + nz * ax.z) * half.x
        ey := f32::abs(nx * ay.x + ny * ay.y + nz * ay.z) * half.y
        ez := f32::abs(nx * az.x + ny * az.y + nz * az.z) * half.z
        ret ex + ey + ez
    if shape == 2:
        axis := quat_rotate(
            Quat { x: orientation.x, y: orientation.y, z: orientation.z, w: orientation.w },
            Vec3 { x: 0.0, y: 1.0, z: 0.0 },
        )
        ret radius + half_height * f32::abs(nx * axis.x + ny * axis.y + nz * axis.z)
    ret radius

# Contact manifold for two bodies, used by the main collision pass and by the
# sleep-support check (which reads the stored per-body state).  The returned
# normal points from body B toward body A.  Aggregate arguments are rebuilt as
# literals at each call because e7 aggregates move when passed by value.
pair_manifold <- (
    a_shape: i64,
    a_center: Vec3,
    a_half: Vec3,
    a_radius: f32,
    a_half_height: f32,
    a_q: Quat,
    b_shape: i64,
    b_center: Vec3,
    b_half: Vec3,
    b_radius: f32,
    b_half_height: f32,
    b_q: Quat,
) -> Manifold:
    contact := Manifold {
        hit: false,
        normal: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        penetration: 0.0,
        contact: Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
    }
    if a_shape == 2:
        if b_shape == 1:
            contact = sphere_capsule_manifold(
                Vec3 { x: b_center.x, y: b_center.y, z: b_center.z },
                b_radius,
                Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
                a_radius,
                a_half_height,
                Quat { x: a_q.x, y: a_q.y, z: a_q.z, w: a_q.w },
            )
            contact = Manifold {
                hit: contact.hit,
                normal: Vec3 { x: 0.0 - contact.normal.x, y: 0.0 - contact.normal.y, z: 0.0 - contact.normal.z },
                penetration: contact.penetration,
                contact: Vec3 { x: contact.contact.x, y: contact.contact.y, z: contact.contact.z },
            }
        elif b_shape == 0:
            contact = capsule_obb_manifold(
                Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
                a_radius,
                a_half_height,
                Quat { x: a_q.x, y: a_q.y, z: a_q.z, w: a_q.w },
                Obb {
                    center: Vec3 { x: b_center.x, y: b_center.y, z: b_center.z },
                    half_extents: Vec3 { x: b_half.x, y: b_half.y, z: b_half.z },
                    orientation: Quat { x: b_q.x, y: b_q.y, z: b_q.z, w: b_q.w },
                },
            )
        else:
            contact = capsule_capsule_manifold(
                Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
                a_radius,
                a_half_height,
                Quat { x: a_q.x, y: a_q.y, z: a_q.z, w: a_q.w },
                Vec3 { x: b_center.x, y: b_center.y, z: b_center.z },
                b_radius,
                b_half_height,
                Quat { x: b_q.x, y: b_q.y, z: b_q.z, w: b_q.w },
            )
    elif a_shape == 1:
        if b_shape == 2:
            contact = sphere_capsule_manifold(
                Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
                a_radius,
                Vec3 { x: b_center.x, y: b_center.y, z: b_center.z },
                b_radius,
                b_half_height,
                Quat { x: b_q.x, y: b_q.y, z: b_q.z, w: b_q.w },
            )
        elif b_shape == 0:
            contact = sphere_obb_manifold(
                Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
                a_radius,
                Obb {
                    center: Vec3 { x: b_center.x, y: b_center.y, z: b_center.z },
                    half_extents: Vec3 { x: b_half.x, y: b_half.y, z: b_half.z },
                    orientation: Quat { x: b_q.x, y: b_q.y, z: b_q.z, w: b_q.w },
                },
            )
        else:
            contact = sphere_sphere_manifold(
                Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
                a_radius,
                Vec3 { x: b_center.x, y: b_center.y, z: b_center.z },
                b_radius,
            )
    elif a_shape == 0:
        if b_shape == 0:
            contact = obb_obb_manifold(
                Obb {
                    center: Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
                    half_extents: Vec3 { x: a_half.x, y: a_half.y, z: a_half.z },
                    orientation: Quat { x: a_q.x, y: a_q.y, z: a_q.z, w: a_q.w },
                },
                Obb {
                    center: Vec3 { x: b_center.x, y: b_center.y, z: b_center.z },
                    half_extents: Vec3 { x: b_half.x, y: b_half.y, z: b_half.z },
                    orientation: Quat { x: b_q.x, y: b_q.y, z: b_q.z, w: b_q.w },
                },
            )
        elif b_shape == 1:
            push := sphere_obb_manifold(
                Vec3 { x: b_center.x, y: b_center.y, z: b_center.z },
                b_radius,
                Obb {
                    center: Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
                    half_extents: Vec3 { x: a_half.x, y: a_half.y, z: a_half.z },
                    orientation: Quat { x: a_q.x, y: a_q.y, z: a_q.z, w: a_q.w },
                },
            )
            contact = Manifold {
                hit: push.hit,
                normal: Vec3 { x: 0.0 - push.normal.x, y: 0.0 - push.normal.y, z: 0.0 - push.normal.z },
                penetration: push.penetration,
                contact: Vec3 { x: push.contact.x, y: push.contact.y, z: push.contact.z },
            }
        else:
            push := capsule_obb_manifold(
                Vec3 { x: b_center.x, y: b_center.y, z: b_center.z },
                b_radius,
                b_half_height,
                Quat { x: b_q.x, y: b_q.y, z: b_q.z, w: b_q.w },
                Obb {
                    center: Vec3 { x: a_center.x, y: a_center.y, z: a_center.z },
                    half_extents: Vec3 { x: a_half.x, y: a_half.y, z: a_half.z },
                    orientation: Quat { x: a_q.x, y: a_q.y, z: a_q.z, w: a_q.w },
                },
            )
            contact = Manifold {
                hit: push.hit,
                normal: Vec3 { x: 0.0 - push.normal.x, y: 0.0 - push.normal.y, z: 0.0 - push.normal.z },
                penetration: push.penetration,
                contact: Vec3 { x: push.contact.x, y: push.contact.y, z: push.contact.z },
            }
    ret contact

# ---------------------------------------------------------------------------
# Render orientation initialisation
# ---------------------------------------------------------------------------

# Seed the render-facing BodyOrientation quaternion from the authored Euler
# Transform.rotation exactly once.  Dynamic bodies are overwritten from the
# physics quaternion every step; static bodies keep this converted value, so
# Euler angles never reach the renderer as rotation state.
@trigger(Init)
pub physics_orientation_init <- sys (orientations: select &mut BodyOrientation, &Transform from Components):
    for (orientation, transform) in orientations:
        q := quat_from_euler(transform.rotation[0], transform.rotation[1], transform.rotation[2])
        orientation.x = q.x
        orientation.y = q.y
        orientation.z = q.z
        orientation.w = q.w


# Publish the authoritative physics quaternion to the render-facing component.
# This runs after the fixed step so rendering never sees an Euler intermediate;
# the quaternion map is the only rotation state that flows into the renderer.
@trigger(PostUpdate)
pub physics_publish_orientation <- sys (
    world: res &PhysicsWorld,
    orientations: select &mut BodyOrientation, &BodyId from Components,
):
    for (orientation, body_id) in orientations:
        qv := world.quaternions[body_id.id]
        if qv.len() >= 4:
            orientation.x = qv[0]
            orientation.y = qv[1]
            orientation.z = qv[2]
            orientation.w = qv[3]

# ---------------------------------------------------------------------------
# The fixed-step system
# ---------------------------------------------------------------------------

# Build immutable contact records; the solver owns their accumulated impulses.
append_velocity_contact <- (contacts: [f32], a: i64, b: i64, normal: Vec3, point: Vec3, center_a: Vec3, center_b: Vec3) -> [f32]:
    result := contacts
    record := [a as f32, b as f32, normal.x, normal.y, normal.z,
        point.x - center_a.x, point.y - center_a.y, point.z - center_a.z,
        point.x - center_b.x, point.y - center_b.y, point.z - center_b.z,
        0.0, 0.0, 0.0]
    for value in record:
        result = vec::push(result, value)
    ret result


@trigger(Update)
pub physics_step <- sys (
    input: res &Input,
    world: res &mut PhysicsWorld,
    spatial: res &mut SpatialMap,
    bodies: select &mut Transform, &mut RigidBody, &BodyBounds, &BodyFlags from Components,
    collision_bodies: select &mut Transform, &mut RigidBody, &BodyBounds, &BodyFlags from Components,
    spatial_bodies: select &Transform, &RigidBody, &BodyBounds, &BodyFlags from Components,
    interaction_bodies: select &mut Transform, &mut RigidBody, &mut BodyFlags from Components,
    hold_bodies: select &mut Transform, &mut RigidBody, &mut BodyFlags from Components,
    cameras: select &mut Camera, &CameraController from Components,
    pickup_state: res &mut PickupState,
):
    dt := 0.016
    captured := input.mouse_captured()
    cell_size := spatial.cell_size
    plane_x := world.plane_normal[0]
    plane_y := world.plane_normal[1]
    plane_z := world.plane_normal[2]
    ground := world.plane_offset
    plane_length := f32::sqrt(plane_x * plane_x + plane_y * plane_y + plane_z * plane_z)
    if plane_length > 0.000001:
        plane_x = plane_x / plane_length
        plane_y = plane_y / plane_length
        plane_z = plane_z / plane_length
        ground = ground / plane_length
    world.grounded = false
    world.pending_impulses = map[i64, [f32]] {}

    ids: [i64] := []
    stored_bounds: [f32] := []
    stored_shapes: [i64] := []
    stored_radius: [f32] := []
    stored_half_height: [f32] := []
    stored_half: [f32] := []
    stored_quats: [f32] := []
    stored_vel: [f32] := []
    stored_ang: [f32] := []
    stored_inv_mass: [f32] := []
    stored_locked: [i64] := []
    stored_sleeping: [i64] := []
    body_count := 0

    for (transform, body, body_bounds, flags) in bodies:
        id := flags.target_id
        qv := world.quaternions[id]
        q := quat_from_vec(qv)
        if qv.len() == 0:
            q = quat_from_euler(transform.rotation[0], transform.rotation[1], transform.rotation[2])
            world.quaternions[id] = [q.x, q.y, q.z, q.w]
        on_ground := false
        sleep_entry := world.sleep_state[id]
        sleep_timer := 0.0
        sleeping := false
        if sleep_entry.len() >= 2:
            sleep_timer = sleep_entry[0]
            if sleep_entry[1] > 0.5:
                sleeping = true
        supported := false

        if not body.is_static and flags.held_by == 0 and not sleeping:
            if body.rotation_locked:
                body.angular_velocity[0] = 0.0
                body.angular_velocity[1] = 0.0
                body.angular_velocity[2] = 0.0
                q = quat_from_euler(transform.rotation[0], transform.rotation[1], transform.rotation[2])
                world.quaternions[id] = [q.x, q.y, q.z, q.w]
            else:
                q = quat_integrate(
                    Quat { x: q.x, y: q.y, z: q.z, w: q.w },
                    Vec3 { x: body.angular_velocity[0], y: body.angular_velocity[1], z: body.angular_velocity[2] },
                    dt,
                )
                # The quaternion is the only orientation state written here;
                # rendering reads it through BodyOrientation, published by
                # physics_publish_orientation once the step is complete.
                world.quaternions[id] = [q.x, q.y, q.z, q.w]
                body.angular_velocity[0] = body.angular_velocity[0] * 0.995
                body.angular_velocity[1] = body.angular_velocity[1] * 0.995
                body.angular_velocity[2] = body.angular_velocity[2] * 0.995

            body.velocity[1] = body.velocity[1] + world.gravity_y * body.gravity_scale * dt
            transform.translation[0] = transform.translation[0] + body.velocity[0] * dt
            transform.translation[1] = transform.translation[1] + body.velocity[1] * dt
            transform.translation[2] = transform.translation[2] + body.velocity[2] * dt

            half := Vec3 { x: body_bounds.half_extents[0], y: body_bounds.half_extents[1], z: body_bounds.half_extents[2] }
            center := Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] }
            normal := Vec3 { x: plane_x, y: plane_y, z: plane_z }
            if flags.shape == 0:
                # Box-plane: corner contacts, deepest first (up to four).
                points := box_plane_contacts(
                    Vec3 { x: center.x, y: center.y, z: center.z },
                    Vec3 { x: half.x, y: half.y, z: half.z },
                    Quat { x: q.x, y: q.y, z: q.z, w: q.w },
                    Vec3 { x: normal.x, y: normal.y, z: normal.z },
                    ground,
                    4,
                )
                contact_count := points.len() / 3
                if contact_count > 0:
                    max_depth := 0.0
                    index := 0
                    while index < contact_count * 3:
                        depth := 0.0 - (normal.x * points[index as usize] + normal.y * points[(index + 1) as usize] + normal.z * points[(index + 2) as usize] - ground)
                        if depth > max_depth:
                            max_depth = depth
                        index = index + 3
                    transform.translation[0] = transform.translation[0] + normal.x * max_depth * 0.9
                    transform.translation[1] = transform.translation[1] + normal.y * max_depth * 0.9
                    transform.translation[2] = transform.translation[2] + normal.z * max_depth * 0.9
                    on_ground = true
                    supported = true
            elif flags.shape == 2:
                ground_manifold := capsule_plane_manifold(
                    Vec3 { x: center.x, y: center.y, z: center.z },
                    flags.radius,
                    flags.half_height,
                    Quat { x: q.x, y: q.y, z: q.z, w: q.w },
                    Vec3 { x: normal.x, y: normal.y, z: normal.z },
                    ground,
                )
                if ground_manifold.hit:
                    transform.translation[0] = transform.translation[0] + normal.x * ground_manifold.penetration * 0.9
                    transform.translation[1] = transform.translation[1] + normal.y * ground_manifold.penetration * 0.9
                    transform.translation[2] = transform.translation[2] + normal.z * ground_manifold.penetration * 0.9
                    on_ground = true
                    supported = true
            else:
                ground_push := sphere_plane_penetration(
                    Vec3 { x: center.x, y: center.y, z: center.z },
                    flags.radius,
                    Vec3 { x: normal.x, y: normal.y, z: normal.z },
                    ground,
                )
                if ground_push.x != 0.0 or ground_push.y != 0.0 or ground_push.z != 0.0:
                    push_distance := f32::sqrt(ground_push.x * ground_push.x + ground_push.y * ground_push.y + ground_push.z * ground_push.z)
                    transform.translation[0] = transform.translation[0] + normal.x * push_distance * 0.9
                    transform.translation[1] = transform.translation[1] + normal.y * push_distance * 0.9
                    transform.translation[2] = transform.translation[2] + normal.z * push_distance * 0.9
                    on_ground = true
                    supported = true
            if on_ground:
                if flags.is_player:
                    world.grounded = true

            if flags.is_player:
                yaw := world.camera_yaw
                sin_yaw := f32::sin(yaw)
                cos_yaw := f32::cos(yaw)
                forward_x := sin_yaw
                forward_z := 0.0 - cos_yaw
                right_x := cos_yaw
                right_z := sin_yaw
                wish_x := 0.0
                wish_z := 0.0
                if captured and input.move_forward:
                    wish_x = wish_x + forward_x
                    wish_z = wish_z + forward_z
                if captured and input.move_backward:
                    wish_x = wish_x - forward_x
                    wish_z = wish_z - forward_z
                if captured and input.move_right:
                    wish_x = wish_x + right_x
                    wish_z = wish_z + right_z
                if captured and input.move_left:
                    wish_x = wish_x - right_x
                    wish_z = wish_z - right_z
                length := f32::sqrt(wish_x * wish_x + wish_z * wish_z)
                speed := world.move_speed
                if captured and input.sprint:
                    speed = speed * 2.5
                if length > 0.000001:
                    scale := speed / length
                    body.velocity[0] = wish_x * scale
                    body.velocity[2] = wish_z * scale
                else:
                    body.velocity[0] = 0.0
                    body.velocity[2] = 0.0
                if not input.jump_down:
                    world.jump_latched = false

        # Snapshot all integrated bodies before solving body-body contacts.
        final_aabb := shape_aabb(
            flags.shape,
            Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] },
            Vec3 { x: body_bounds.half_extents[0], y: body_bounds.half_extents[1], z: body_bounds.half_extents[2] },
            flags.radius,
            flags.half_height,
            Quat { x: q.x, y: q.y, z: q.z, w: q.w },
        )
        ids = vec::push(ids, id)
        stored_bounds = vec::push(stored_bounds, final_aabb.min.x)
        stored_bounds = vec::push(stored_bounds, final_aabb.min.y)
        stored_bounds = vec::push(stored_bounds, final_aabb.min.z)
        stored_bounds = vec::push(stored_bounds, final_aabb.max.x)
        stored_bounds = vec::push(stored_bounds, final_aabb.max.y)
        stored_bounds = vec::push(stored_bounds, final_aabb.max.z)
        stored_shapes = vec::push(stored_shapes, flags.shape)
        stored_radius = vec::push(stored_radius, flags.radius)
        stored_half_height = vec::push(stored_half_height, flags.half_height)
        stored_half = vec::push(stored_half, body_bounds.half_extents[0])
        stored_half = vec::push(stored_half, body_bounds.half_extents[1])
        stored_half = vec::push(stored_half, body_bounds.half_extents[2])
        stored_quats = vec::push(stored_quats, q.x)
        stored_quats = vec::push(stored_quats, q.y)
        stored_quats = vec::push(stored_quats, q.z)
        stored_quats = vec::push(stored_quats, q.w)
        stored_vel = vec::push(stored_vel, body.velocity[0])
        stored_vel = vec::push(stored_vel, body.velocity[1])
        stored_vel = vec::push(stored_vel, body.velocity[2])
        stored_ang = vec::push(stored_ang, body.angular_velocity[0])
        stored_ang = vec::push(stored_ang, body.angular_velocity[1])
        stored_ang = vec::push(stored_ang, body.angular_velocity[2])
        effective_mass := body.inv_mass
        if body.is_static or flags.held_by != 0:
            effective_mass = 0.0
        stored_inv_mass = vec::push(stored_inv_mass, effective_mass)
        locked_value := 0
        if body.rotation_locked:
            locked_value = 1
        stored_locked = vec::push(stored_locked, locked_value)
        sleeping_value := 0
        if sleeping:
            sleeping_value = 1
        stored_sleeping = vec::push(stored_sleeping, sleeping_value)
        body_count = body_count + 1
        if flags.is_player:
            world.player_x = transform.translation[0]
            world.player_y = transform.translation[1]
            world.player_z = transform.translation[2]

    # Solve the whole contact network together, so gravity loads propagate
    # through a stack into the floor instead of bouncing between pair visits.
    solver_state: [f32] := []
    solver_inertias: [f32] := []
    velocity_contacts: [f32] := []
    position_contacts: [f32] := []
    solver_positions: [f32] := []
    support_flags: [i64] := []
    support_points := map[i64, [f32]] {}
    ai := 0
    while ai < body_count:
        vb := ai * 3
        qb := ai * 4
        bb := ai * 6
        ax := (stored_bounds[bb as usize] + stored_bounds[(bb + 3) as usize]) * 0.5
        ay := (stored_bounds[(bb + 1) as usize] + stored_bounds[(bb + 4) as usize]) * 0.5
        az := (stored_bounds[(bb + 2) as usize] + stored_bounds[(bb + 5) as usize]) * 0.5
        solver_positions = vec::push(solver_positions, ax)
        solver_positions = vec::push(solver_positions, ay)
        solver_positions = vec::push(solver_positions, az)
        support_flags = vec::push(support_flags, 0)
        aq := Quat { x: stored_quats[qb as usize], y: stored_quats[(qb + 1) as usize], z: stored_quats[(qb + 2) as usize], w: stored_quats[(qb + 3) as usize] }
        inertia := inverse_inertia_world(
            stored_shapes[ai as usize],
            Vec3 { x: stored_half[vb as usize], y: stored_half[(vb + 1) as usize], z: stored_half[(vb + 2) as usize] },
            stored_radius[ai as usize], stored_half_height[ai as usize], stored_inv_mass[ai as usize],
            Quat { x: aq.x, y: aq.y, z: aq.z, w: aq.w },
        )
        if stored_locked[ai as usize] != 0:
            inertia = Mat3 { m00: 0.0, m01: 0.0, m02: 0.0, m10: 0.0, m11: 0.0, m12: 0.0, m20: 0.0, m21: 0.0, m22: 0.0 }
        values: [f32] := [inertia.m00, inertia.m01, inertia.m02, inertia.m10, inertia.m11, inertia.m12, inertia.m20, inertia.m21, inertia.m22]
        for value in values:
            solver_inertias = vec::push(solver_inertias, value)
        values = [stored_vel[vb as usize], stored_vel[(vb + 1) as usize], stored_vel[(vb + 2) as usize], stored_ang[vb as usize], stored_ang[(vb + 1) as usize], stored_ang[(vb + 2) as usize]]
        for value in values:
            solver_state = vec::push(solver_state, value)
        if stored_inv_mass[ai as usize] > 0.0:
            extent := shape_extent_along(stored_shapes[ai as usize],
                Vec3 { x: stored_half[vb as usize], y: stored_half[(vb + 1) as usize], z: stored_half[(vb + 2) as usize] },
                stored_radius[ai as usize], stored_half_height[ai as usize],
                Quat { x: aq.x, y: aq.y, z: aq.z, w: aq.w }, Vec3 { x: plane_x, y: plane_y, z: plane_z },
            )
            record := [ai as f32, -1.0, plane_x, plane_y, plane_z, ground + extent]
            for value in record:
                position_contacts = vec::push(position_contacts, value)
            if ax * plane_x + ay * plane_y + az * plane_z - extent <= ground + 0.006:
                support_flags[ai as usize] = 1
            points: [f32] := []
            if stored_shapes[ai as usize] == 0:
                points = box_plane_contacts(
                    Vec3 { x: ax, y: ay, z: az },
                    Vec3 { x: stored_half[vb as usize], y: stored_half[(vb + 1) as usize], z: stored_half[(vb + 2) as usize] },
                    Quat { x: aq.x, y: aq.y, z: aq.z, w: aq.w },
                    Vec3 { x: plane_x, y: plane_y, z: plane_z }, ground + 0.006, 4,
                )
            else:
                extent := shape_extent_along(stored_shapes[ai as usize],
                    Vec3 { x: stored_half[vb as usize], y: stored_half[(vb + 1) as usize], z: stored_half[(vb + 2) as usize] },
                    stored_radius[ai as usize], stored_half_height[ai as usize],
                    Quat { x: aq.x, y: aq.y, z: aq.z, w: aq.w }, Vec3 { x: plane_x, y: plane_y, z: plane_z },
                )
                if ax * plane_x + ay * plane_y + az * plane_z - extent <= ground + 0.006:
                    points = [ax - plane_x * extent, ay - plane_y * extent, az - plane_z * extent]
            point := 0
            while point < points.len() as i64:
                patch := support_points[ai]
                patch = vec::push(patch, points[point as usize])
                patch = vec::push(patch, points[(point + 2) as usize])
                support_points[ai] = patch
                velocity_contacts = append_velocity_contact(velocity_contacts, ai, -1,
                    Vec3 { x: plane_x, y: plane_y, z: plane_z },
                    Vec3 { x: points[point as usize], y: points[(point + 1) as usize], z: points[(point + 2) as usize] },
                    Vec3 { x: ax, y: ay, z: az }, Vec3 { x: 0.0, y: 0.0, z: 0.0 },
                )
                point = point + 3
        bi := 0
        while bi < ai:
            ob := bi * 6
            ov := bi * 3
            oq := bi * 4
            if stored_shapes[ai as usize] == 3 or stored_shapes[bi as usize] == 3 or stored_inv_mass[ai as usize] + stored_inv_mass[bi as usize] <= 0.0:
                bi = bi + 1
                cont
            if stored_bounds[bb as usize] > stored_bounds[(ob + 3) as usize] or stored_bounds[(bb + 3) as usize] < stored_bounds[ob as usize] or stored_bounds[(bb + 1) as usize] > stored_bounds[(ob + 4) as usize] or stored_bounds[(bb + 4) as usize] < stored_bounds[(ob + 1) as usize] or stored_bounds[(bb + 2) as usize] > stored_bounds[(ob + 5) as usize] or stored_bounds[(bb + 5) as usize] < stored_bounds[(ob + 2) as usize]:
                bi = bi + 1
                cont
            bx := (stored_bounds[ob as usize] + stored_bounds[(ob + 3) as usize]) * 0.5
            by := (stored_bounds[(ob + 1) as usize] + stored_bounds[(ob + 4) as usize]) * 0.5
            bz := (stored_bounds[(ob + 2) as usize] + stored_bounds[(ob + 5) as usize]) * 0.5
            bq := Quat { x: stored_quats[oq as usize], y: stored_quats[(oq + 1) as usize], z: stored_quats[(oq + 2) as usize], w: stored_quats[(oq + 3) as usize] }
            manifold := pair_manifold(stored_shapes[ai as usize], Vec3 { x: ax, y: ay, z: az },
                Vec3 { x: stored_half[vb as usize], y: stored_half[(vb + 1) as usize], z: stored_half[(vb + 2) as usize] },
                stored_radius[ai as usize], stored_half_height[ai as usize], Quat { x: aq.x, y: aq.y, z: aq.z, w: aq.w },
                stored_shapes[bi as usize], Vec3 { x: bx, y: by, z: bz },
                Vec3 { x: stored_half[ov as usize], y: stored_half[(ov + 1) as usize], z: stored_half[(ov + 2) as usize] },
                stored_radius[bi as usize], stored_half_height[bi as usize], Quat { x: bq.x, y: bq.y, z: bq.z, w: bq.w },
            )
            if manifold.hit:
                if manifold.normal.y > 0.5:
                    support_flags[ai as usize] = 1
                if manifold.normal.y < -0.5:
                    support_flags[bi as usize] = 1
                separation := (ax - bx) * manifold.normal.x + (ay - by) * manifold.normal.y + (az - bz) * manifold.normal.z
                record := [ai as f32, bi as f32, manifold.normal.x, manifold.normal.y, manifold.normal.z, separation + manifold.penetration]
                for value in record:
                    position_contacts = vec::push(position_contacts, value)
                points: [f32] := []
                if stored_shapes[ai as usize] == 0 and stored_shapes[bi as usize] == 0:
                    points = obb_obb_contacts(
                        Obb { center: Vec3 { x: ax, y: ay, z: az }, half_extents: Vec3 { x: stored_half[vb as usize], y: stored_half[(vb + 1) as usize], z: stored_half[(vb + 2) as usize] }, orientation: Quat { x: aq.x, y: aq.y, z: aq.z, w: aq.w } },
                        Obb { center: Vec3 { x: bx, y: by, z: bz }, half_extents: Vec3 { x: stored_half[ov as usize], y: stored_half[(ov + 1) as usize], z: stored_half[(ov + 2) as usize] }, orientation: Quat { x: bq.x, y: bq.y, z: bq.z, w: bq.w } },
                    )
                if points.len() == 0:
                    points = [manifold.contact.x, manifold.contact.y, manifold.contact.z]
                point := 0
                while point < points.len() as i64:
                    if manifold.normal.y > 0.5:
                        patch := support_points[ai]
                        patch = vec::push(patch, points[point as usize])
                        patch = vec::push(patch, points[(point + 2) as usize])
                        support_points[ai] = patch
                    if manifold.normal.y < -0.5:
                        patch := support_points[bi]
                        patch = vec::push(patch, points[point as usize])
                        patch = vec::push(patch, points[(point + 2) as usize])
                        support_points[bi] = patch
                    velocity_contacts = append_velocity_contact(velocity_contacts, ai, bi,
                        Vec3 { x: manifold.normal.x, y: manifold.normal.y, z: manifold.normal.z },
                        Vec3 { x: points[point as usize], y: points[(point + 1) as usize], z: points[(point + 2) as usize] },
                        Vec3 { x: ax, y: ay, z: az }, Vec3 { x: bx, y: by, z: bz },
                    )
                    point = point + 3
            bi = bi + 1
        ai = ai + 1
    solved_velocities := solve_contact_velocities(solver_state, stored_inv_mass, solver_inertias, velocity_contacts, world.friction, world.friction_static, 128)
    solved_positions := solve_contact_positions(solver_positions, stored_inv_mass, position_contacts, 24)

    # Commit the solved body states. Each ECS pass owns a separate query cursor.
    for (transform, body, body_bounds, flags) in collision_bodies:
        id := flags.target_id
        current_index := find_bound_index_local(ids, id)
        if body.is_static or flags.held_by != 0:
            cont
        velocity_base := current_index * 6
        body.velocity[0] = solved_velocities[velocity_base as usize]
        body.velocity[1] = solved_velocities[(velocity_base + 1) as usize]
        body.velocity[2] = solved_velocities[(velocity_base + 2) as usize]
        body.angular_velocity[0] = solved_velocities[(velocity_base + 3) as usize]
        body.angular_velocity[1] = solved_velocities[(velocity_base + 4) as usize]
        body.angular_velocity[2] = solved_velocities[(velocity_base + 5) as usize]
        q := quat_from_vec(world.quaternions[id])
        sleep_entry := world.sleep_state[id]
        sleep_timer := 0.0
        sleeping := false
        if sleep_entry.len() >= 2:
            sleep_timer = sleep_entry[0]
            sleeping = sleep_entry[1] > 0.5
        wake_linear := f32::abs(body.velocity[0]) + f32::abs(body.velocity[1]) + f32::abs(body.velocity[2])
        wake_angular := f32::abs(body.angular_velocity[0]) + f32::abs(body.angular_velocity[1]) + f32::abs(body.angular_velocity[2])
        if sleeping and (wake_linear > 0.03 or wake_angular > 0.08):
            sleeping = false
            sleep_timer = 0.0
            world.sleep_state[id] = [0.0, 0.0]
            stored_sleeping[current_index as usize] = 0
        base := current_index * 3
        transform.translation[0] = solved_positions[base as usize]
        transform.translation[1] = solved_positions[(base + 1) as usize]
        transform.translation[2] = solved_positions[(base + 2) as usize]
        supported := support_flags[current_index as usize] != 0
        stable_support := supported and support_polygon_contains(
            support_points[current_index], transform.translation[0], transform.translation[2], flags.shape == 0,
        )
        if sleeping and not stable_support:
            sleeping = false
            sleep_timer = 0.0
            world.sleep_state[id] = [0.0, 0.0]
            stored_sleeping[current_index as usize] = 0
        if sleeping:
            body.velocity[0] = 0.0
            body.velocity[1] = 0.0
            body.velocity[2] = 0.0
            body.angular_velocity[0] = 0.0
            body.angular_velocity[1] = 0.0
            body.angular_velocity[2] = 0.0
        half_x := body_bounds.half_extents[0]
        half_y := body_bounds.half_extents[1]
        half_z := body_bounds.half_extents[2]

        if flags.is_player:
            world.grounded = supported and body.velocity[1] <= 0.0
            if captured and input.jump_down and world.grounded and not world.jump_latched:
                body.velocity[1] = 5.2
                world.jump_latched = true
                world.grounded = false
            world.player_x = transform.translation[0]
            world.player_y = transform.translation[1]
            world.player_z = transform.translation[2]

        if not body.is_static and not sleeping and not flags.is_player:
            linear_speed := f32::abs(body.velocity[0]) + f32::abs(body.velocity[1]) + f32::abs(body.velocity[2])
            angular_speed := f32::abs(body.angular_velocity[0]) + f32::abs(body.angular_velocity[1]) + f32::abs(body.angular_velocity[2])
            if stable_support and linear_speed < 0.03 and angular_speed < 0.08:
                sleep_timer = sleep_timer + dt
                if sleep_timer >= 0.35:
                    sleeping = true
                    sleep_timer = 0.0
                    body.velocity[0] = 0.0
                    body.velocity[1] = 0.0
                    body.velocity[2] = 0.0
                    body.angular_velocity[0] = 0.0
                    body.angular_velocity[1] = 0.0
                    body.angular_velocity[2] = 0.0
            else:
                sleep_timer = 0.0
            sleep_flag := 0.0
            if sleeping:
                sleep_flag = 1.0
            world.sleep_state[id] = [sleep_timer, sleep_flag]
        elif sleeping:
            world.sleep_state[id] = [0.0, 1.0]

        final_aabb := shape_aabb(
            flags.shape,
            Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] },
            Vec3 { x: half_x, y: half_y, z: half_z },
            flags.radius, flags.half_height,
            Quat { x: q.x, y: q.y, z: q.z, w: q.w },
        )
        base = current_index * 6
        stored_bounds[(base + 0) as usize] = final_aabb.min.x
        stored_bounds[(base + 1) as usize] = final_aabb.min.y
        stored_bounds[(base + 2) as usize] = final_aabb.min.z
        stored_bounds[(base + 3) as usize] = final_aabb.max.x
        stored_bounds[(base + 4) as usize] = final_aabb.max.y
        stored_bounds[(base + 5) as usize] = final_aabb.max.z

    # ------------------------------------- wake sleeping bodies without support
    # Sleeping bodies skip integration and contacts with other sleeping bodies, so a
    # body whose support was removed (despawned supporting box, support moved
    # away by a pickup, body pushed off an edge) would stay frozen in mid-air.
    # Re-check every sleeping body against this step's final body state and
    # clear its sleep timer when nothing supports it.  Only sleeping bodies are
    # tested, so stable stacks keep sleeping; cheap vertical early-outs keep the
    # narrowphase tests limited to plausible supporting pairs.
    support_nx := plane_x
    support_ny := plane_y
    support_nz := plane_z
    sleep_index := 0
    while sleep_index < body_count:
        sleeper_sleeping := stored_sleeping[sleep_index as usize] != 0
        sleeper_shape := stored_shapes[sleep_index as usize]
        if sleeper_sleeping and sleeper_shape != 3:
            sleeper_id := ids[sleep_index as usize]
            sleeper_bounds_base := sleep_index * 6
            sleeper_min_x := stored_bounds[(sleeper_bounds_base + 0) as usize]
            sleeper_min_y := stored_bounds[(sleeper_bounds_base + 1) as usize]
            sleeper_min_z := stored_bounds[(sleeper_bounds_base + 2) as usize]
            sleeper_max_x := stored_bounds[(sleeper_bounds_base + 3) as usize]
            sleeper_max_y := stored_bounds[(sleeper_bounds_base + 4) as usize]
            sleeper_max_z := stored_bounds[(sleeper_bounds_base + 5) as usize]
            sleeper_x := (sleeper_min_x + sleeper_max_x) * 0.5
            sleeper_y := (sleeper_min_y + sleeper_max_y) * 0.5
            sleeper_z := (sleeper_min_z + sleeper_max_z) * 0.5
            sleeper_half_base := sleep_index * 3
            sleeper_half_x := stored_half[(sleeper_half_base + 0) as usize]
            sleeper_half_y := stored_half[(sleeper_half_base + 1) as usize]
            sleeper_half_z := stored_half[(sleeper_half_base + 2) as usize]
            sleeper_quat_base := sleep_index * 4
            sleeper_qx := stored_quats[(sleeper_quat_base + 0) as usize]
            sleeper_qy := stored_quats[(sleeper_quat_base + 1) as usize]
            sleeper_qz := stored_quats[(sleeper_quat_base + 2) as usize]
            sleeper_qw := stored_quats[(sleeper_quat_base + 3) as usize]
            sleeper_radius := stored_radius[sleep_index as usize]
            sleeper_half_height := stored_half_height[sleep_index as usize]
            sleeper_extent := shape_extent_along(
                sleeper_shape,
                Vec3 { x: sleeper_half_x, y: sleeper_half_y, z: sleeper_half_z },
                sleeper_radius,
                sleeper_half_height,
                Quat { x: sleeper_qx, y: sleeper_qy, z: sleeper_qz, w: sleeper_qw },
                Vec3 { x: support_nx, y: support_ny, z: support_nz },
            )
            sleeper_along := support_nx * sleeper_x + support_ny * sleeper_y + support_nz * sleeper_z
            sleeper_bottom := sleeper_along - sleeper_extent
            supported_now := sleeper_bottom <= ground + 0.03
            if not supported_now:
                other := 0
                while other < body_count:
                    if other != sleep_index:
                        other_shape := stored_shapes[other as usize]
                        # Shape 3 is the collision plane entity; the infinite
                        # ground plane is handled above instead.
                        if other_shape != 3:
                            other_bounds_base := other * 6
                            other_min_x := stored_bounds[(other_bounds_base + 0) as usize]
                            other_min_y := stored_bounds[(other_bounds_base + 1) as usize]
                            other_min_z := stored_bounds[(other_bounds_base + 2) as usize]
                            other_max_x := stored_bounds[(other_bounds_base + 3) as usize]
                            other_max_y := stored_bounds[(other_bounds_base + 4) as usize]
                            other_max_z := stored_bounds[(other_bounds_base + 5) as usize]
                            other_x := (other_min_x + other_max_x) * 0.5
                            other_y := (other_min_y + other_max_y) * 0.5
                            other_z := (other_min_z + other_max_z) * 0.5
                            other_half_base := other * 3
                            other_half_x := stored_half[(other_half_base + 0) as usize]
                            other_half_y := stored_half[(other_half_base + 1) as usize]
                            other_half_z := stored_half[(other_half_base + 2) as usize]
                            other_quat_base := other * 4
                            other_qx := stored_quats[(other_quat_base + 0) as usize]
                            other_qy := stored_quats[(other_quat_base + 1) as usize]
                            other_qz := stored_quats[(other_quat_base + 2) as usize]
                            other_qw := stored_quats[(other_quat_base + 3) as usize]
                            other_radius := stored_radius[other as usize]
                            other_half_height := stored_half_height[other as usize]
                            other_along := support_nx * other_x + support_ny * other_y + support_nz * other_z
                            if other_along < sleeper_along:
                                other_extent := shape_extent_along(
                                    other_shape,
                                    Vec3 { x: other_half_x, y: other_half_y, z: other_half_z },
                                    other_radius,
                                    other_half_height,
                                    Quat { x: other_qx, y: other_qy, z: other_qz, w: other_qw },
                                    Vec3 { x: support_nx, y: support_ny, z: support_nz },
                                )
                                other_top := other_along + other_extent
                                # Only a body whose top is near the sleeper's
                                # bottom can support it; the narrowphase test
                                # below confirms actual contact.
                                if f32::abs(other_top - sleeper_bottom) <= 1.0:
                                    contact := pair_manifold(
                                        sleeper_shape,
                                        Vec3 { x: sleeper_x, y: sleeper_y, z: sleeper_z },
                                        Vec3 { x: sleeper_half_x, y: sleeper_half_y, z: sleeper_half_z },
                                        sleeper_radius,
                                        sleeper_half_height,
                                        Quat { x: sleeper_qx, y: sleeper_qy, z: sleeper_qz, w: sleeper_qw },
                                        other_shape,
                                        Vec3 { x: other_x, y: other_y, z: other_z },
                                        Vec3 { x: other_half_x, y: other_half_y, z: other_half_z },
                                        other_radius,
                                        other_half_height,
                                        Quat { x: other_qx, y: other_qy, z: other_qz, w: other_qw },
                                    )
                                    if contact.hit and contact.penetration > 0.0:
                                        normal_along := contact.normal.x * support_nx + contact.normal.y * support_ny + contact.normal.z * support_nz
                                        if normal_along > 0.5:
                                            supported_now = true
                    other = other + 1
            if not supported_now:
                world.sleep_state[sleeper_id] = [0.0, 0.0]
        sleep_index = sleep_index + 1

    # ------------------------------------------------------- nearest pickup
    released := false
    released_id := 0
    if captured and input.interact_pressed:
        if pickup_state.held_id != 0:
            released_id = pickup_state.held_id
            pickup_state.held_id = 0
            released = true
        else:
            best_id := 0
            best_distance := 1000000.0
            for (transform, body, flags) in interaction_bodies:
                if not flags.is_pickup:
                    cont
                dx := transform.translation[0] - world.player_x
                dy := transform.translation[1] - world.player_y
                dz := transform.translation[2] - world.player_z
                distance := dx * dx + dy * dy + dz * dz
                if distance > 6.76:
                    cont
                tie := f32::abs(distance - best_distance) <= 0.000001
                if best_id == 0 or distance < best_distance - 0.000001 or (tie and flags.target_id < best_id):
                    best_id = flags.target_id
                    best_distance = distance
            pickup_state.held_id = best_id

    hold_yaw := world.camera_yaw
    forward_x := f32::sin(hold_yaw)
    forward_z := 0.0 - f32::cos(hold_yaw)
    for (transform, body, flags) in hold_bodies:
        if not flags.is_pickup:
            cont
        if flags.target_id == pickup_state.held_id:
            flags.held_by = 1
            world.sleep_state[flags.target_id] = [0.0, 0.0]
            transform.translation[0] = world.player_x + forward_x * 1.8
            transform.translation[1] = world.player_y + 1.4
            transform.translation[2] = world.player_z + forward_z * 1.8
            body.velocity[0] = 0.0
            body.velocity[1] = 0.0
            body.velocity[2] = 0.0
            body.angular_velocity[0] = 0.0
            body.angular_velocity[1] = 0.0
            body.angular_velocity[2] = 0.0
        else:
            flags.held_by = 0
        if released and flags.target_id == released_id and not body.rotation_locked:
            body.angular_velocity[1] = f32::clamp(body.angular_velocity[1] + 1.6, -10.0, 10.0)

    # Publish spatial queries from committed transforms, including held bodies.
    cells := map[i64, [i64]] {}
    stored_bounds = []
    for (transform, body, body_bounds, flags) in spatial_bodies:
        q := quat_from_vec(world.quaternions[flags.target_id])
        bounds := shape_aabb(
            flags.shape,
            Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] },
            Vec3 { x: body_bounds.half_extents[0], y: body_bounds.half_extents[1], z: body_bounds.half_extents[2] },
            flags.radius, flags.half_height,
            Quat { x: q.x, y: q.y, z: q.z, w: q.w },
        )
        stored_bounds = vec::push(stored_bounds, bounds.min.x)
        stored_bounds = vec::push(stored_bounds, bounds.min.y)
        stored_bounds = vec::push(stored_bounds, bounds.min.z)
        stored_bounds = vec::push(stored_bounds, bounds.max.x)
        stored_bounds = vec::push(stored_bounds, bounds.max.y)
        stored_bounds = vec::push(stored_bounds, bounds.max.z)
        broadphase_insert(&mut cells, cell_size, flags.target_id,
            Vec3 { x: bounds.min.x, y: bounds.min.y, z: bounds.min.z },
            Vec3 { x: bounds.max.x, y: bounds.max.y, z: bounds.max.z },
        )
        if flags.is_player:
            world.player_x = transform.translation[0]
            world.player_y = transform.translation[1]
            world.player_z = transform.translation[2]
    spatial.cells = cells
    spatial.ids = ids
    spatial.bounds = stored_bounds
    spatial.count = body_count

    # ------------------------------------------- camera look + follow (same step)
    for (camera, controller) in cameras:
        # Look input only owns the camera while the pointer is captured.  When
        # the cursor is free (Esc/UI), the mouse must not rotate the view.
        if captured:
            camera.yaw = camera.yaw + input.look_dx * controller.look_speed
            camera.pitch = camera.pitch - input.look_dy * controller.look_speed
            keyboard_look := 1.6 * dt
            if input.look_left:
                camera.yaw = camera.yaw - keyboard_look
            if input.look_right:
                camera.yaw = camera.yaw + keyboard_look
            if input.look_up:
                camera.pitch = camera.pitch + keyboard_look
            if input.look_down:
                camera.pitch = camera.pitch - keyboard_look
        camera.pitch = f32::clamp(camera.pitch, -1.5533430343, 1.5533430343)
        camera.position[0] = world.player_x
        camera.position[1] = world.player_y + 1.55
        camera.position[2] = world.player_z
        world.camera_yaw = camera.yaw
        world.camera_pitch = camera.pitch
        world.move_speed = controller.move_speed

@trigger(PostUpdate)
pub physics_held_marker <- sys (
    state: res &PickupState,
    commands: &mut Commands,
    rows: select &Pickup, &BodyFlags from Components,
):
    for (pickup, flags) in rows:
        entity := rows.entity()
        if flags.target_id == state.held_id:
            commands.add_component::<Held>(entity, Held { by: 1 })
        else:
            commands.remove_component::<Held>(entity)

# Camera-space debug raycast against box colliders (cosmetic/resource only).
@trigger(PostUpdate)
pub physics_raycast <- sys (
    state: res &mut RaycastState,
    cameras: select &Camera from Components,
    colliders: select &Transform, &BoxCollider from Components,
):
    for camera in cameras:
        sin_yaw := f32::sin(camera.yaw)
        cos_yaw := f32::cos(camera.yaw)
        cos_pitch := f32::cos(camera.pitch)
        direction := Vec3 {
            x: sin_yaw * cos_pitch,
            y: f32::sin(camera.pitch),
            z: 0.0 - cos_yaw * cos_pitch,
        }
        origin := Vec3 {
            x: camera.position[0],
            y: camera.position[1],
            z: camera.position[2],
        }
        state.hit = false
        state.distance = 1000000.0
        for (transform, collider) in colliders:
            center := Vec3 {
                x: transform.translation[0],
                y: transform.translation[1],
                z: transform.translation[2],
            }
            half := Vec3 {
                x: collider.half_extents[0],
                y: collider.half_extents[1],
                z: collider.half_extents[2],
            }
            hit := ray_aabb(
                Ray {
                    origin: Vec3 { x: origin.x, y: origin.y, z: origin.z },
                    direction: Vec3 { x: direction.x, y: direction.y, z: direction.z },
                },
                box_collider(center, half),
            )
            if hit.hit and hit.distance < state.distance:
                state.hit = true
                state.distance = hit.distance
                state.point_x = hit.point.x
                state.point_y = hit.point.y
                state.point_z = hit.point.z
