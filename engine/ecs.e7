# ECS components and the auto-collected Components table.

@Components
pub Camera <- struct
    position: [f32; 3]
    yaw: f32
    pitch: f32
    fov_y: f32
    near: f32
    far: f32

@Components
pub CameraController <- struct
    move_speed: f32
    look_speed: f32

@Components
pub Transform <- struct
    translation: [f32; 3]
    rotation: [f32; 3]
    scale: [f32; 3]

@Components
pub MeshRenderer <- struct
    mesh: u64
    pipeline: u64
    colour: [f32; 4]

@Components
pub PointLight <- struct
    position: [f32; 3]
    colour: [f32; 3]
    intensity: f32

# Marks an entity as visible to the scene renderer.  `kind` is a visual hint:
# 0 box, 1 sphere, 2 capsule, 3 plane.  The renderer currently proxies every
# kind as a box (sphere uses its largest half-extent uniformly); the hint is
# kept so materials/meshes can be selected here later without changing rows.
@Components
pub Renderable <- struct
    kind: i32

# Cube proxy with a per-cube spin phase so stacked proxies do not rotate in
# lockstep (they would otherwise read as a single tall box).
@Components
pub CubeMesh <- struct
    spin_phase: f32

pub Components <- table
    entity_id: usize,
    ... # automatically collects all types with @Components


pub Commands <- struct
    handle: u64



@Components
pub RigidBody <- struct
    velocity: [f32; 3]
    inv_mass: f32
    gravity_scale: f32
    rotation_locked: bool
    is_static: bool

@Components
pub BoxCollider <- struct
    half_extents: [f32; 3]

@Components
pub SphereCollider <- struct
    radius: f32

@Components
pub BodyId <- struct
    id: i64

# Broadphase bounds: half extents of each body's world-space AABB.
@Components
pub BodyBounds <- struct
    half_extents: [f32; 3]

@Components
pub CapsuleCollider <- struct
    radius: f32
    half_height: f32

# Infinite plane `dot(normal, p) = offset`.  The demo uses normal (0,1,0), offset 0.
@Components
pub PlaneCollider <- struct
    normal: [f32; 3]
    offset: f32

@Components
pub Player <- struct
    body_id: i64

@Components
pub Pickup <- struct
    body_id: i64

# `by` is the holder body id (0 = not held).  Components cannot be removed at
# runtime, so a held object keeps this marker and toggles `by`.
@Components
pub Held <- struct
    by: i64
