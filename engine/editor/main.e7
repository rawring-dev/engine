# e7 project editor: scene document editing UI, selection, save/load, and
# hot-reload requests.  The editor is an ordinary e7 project compiled and run
# by the `editor-run` host (runtime/src/editor_run.zig), which also provides
# the in-process recompile/swap loop for code reloads.
#
# Layout: the scene uses the engine's normal components and renderer
# (`Renderable` + `BodyBounds` + `BodyOrientation` + `Material` + `Transform`,
# one `Camera`, one `PointLight`).  The editor document (`EngineScene`) is the
# authoritative scene state; `EditorRefresh` rebuilds ECS rows from it.
#
# Editing actions come through the retained UI widgets: buttons write
# `UIState.clicked_action`, the main loop forwards it to `UIButtonPressed`,
# and `handle_editor_action` mutates the document.  Labels are refreshed from
# editor state each Update; dynamic label textures are invalidated and
# regenerated by the UI system on the next frame.

use core::ecs::*;
use core::events::*;
use core::window::*;
use core::time::*;
use gfx::gpu::*;
use ui::*;
use scene::document::*;

# Trigger fired by the main loop after edits; systems rebuild ECS rows.
pub EditorRefresh <- trigger

@Components
pub EditorObject <- struct
    name: str

# Role marker for dynamic labels: 0 title, 1 selection, 2 transform, 3 status.
@Components
pub EditorLabel <- struct
    role: i64

@resource
pub EditorState <- struct
    document: SceneDocument
    scene_path: str
    selected: i64
    dirty: bool
    status: str
    colour_step: i64

pub editor_state <- (document: SceneDocument, path: str) -> EditorState:
    ret EditorState {
        document: document,
        scene_path: path,
        selected: 0,
        dirty: false,
        status: "ready",
        colour_step: 0,
    }

# --------------------------------------------------------------- formatting --

digit_text <- (digit: i64) -> str:
    if digit == 1:
        ret "1"
    if digit == 2:
        ret "2"
    if digit == 3:
        ret "3"
    if digit == 4:
        ret "4"
    if digit == 5:
        ret "5"
    if digit == 6:
        ret "6"
    if digit == 7:
        ret "7"
    if digit == 8:
        ret "8"
    if digit == 9:
        ret "9"
    ret "0"

pub fmt_i64 <- (value: i64) -> str:
    if value == 0:
        ret "0"
    magnitude := value
    negative := false
    if magnitude < 0:
        negative = true
        magnitude = 0 - magnitude
    out := ""
    while magnitude > 0:
        out = digit_text(magnitude % 10) + out
        magnitude = magnitude / 10
    if negative:
        ret "-" + out
    ret out

# Fixed-point display for scene units: 1500 milli-units -> "1.500".
pub fmt_milli <- (value: f32) -> str:
    milli := f32::to_milli(value)
    negative := false
    magnitude := milli
    if magnitude < 0:
        negative = true
        magnitude = 0 - magnitude
    whole := magnitude / 1000
    fraction := magnitude % 1000
    fraction_text := fmt_i64(fraction)
    while (fraction_text.len() as i64) < 3:
        fraction_text = "0" + fraction_text
    sign := ""
    if negative:
        sign = "-"
    ret sign + fmt_i64(whole) + "." + fraction_text

# --------------------------------------------------------------- selection ---

select_first <- (state: &mut EditorState) -> nil:
    state.selected = 0
    clamp_selection(state)

select_next <- (state: &mut EditorState) -> nil:
    state.selected = state.selected + 1
    clamp_selection(state)

select_previous <- (state: &mut EditorState) -> nil:
    state.selected = state.selected - 1
    clamp_selection(state)

clamp_selection <- (state: &mut EditorState) -> nil:
    count := state.document.objects.len() as i64
    if count == 0:
        state.selected = 0
        ret
    if state.selected < 0:
        state.selected = count - 1
    if state.selected >= count:
        state.selected = 0
    ret

selected_object_index <- (state: &EditorState) -> i64:
    count := state.document.objects.len() as i64
    if count == 0:
        ret 0 - 1
    index := state.selected
    if index < 0 or index >= count:
        ret 0 - 1
    ret index

colour_palette <- (step: i64) -> Colour:
    slot := step % 6
    if slot < 0:
        slot = slot + 6
    if slot == 0:
        ret Colour { r: 1.0, g: 0.55, b: 0.22, a: 1.0 }
    if slot == 1:
        ret Colour { r: 0.25, g: 0.6, b: 0.95, a: 1.0 }
    if slot == 2:
        ret Colour { r: 0.35, g: 0.85, b: 0.45, a: 1.0 }
    if slot == 3:
        ret Colour { r: 0.95, g: 0.35, b: 0.55, a: 1.0 }
    if slot == 4:
        ret Colour { r: 0.85, g: 0.75, b: 0.25, a: 1.0 }
    ret Colour { r: 0.75, g: 0.75, b: 0.8, a: 1.0 }

# ------------------------------------------------------------- row helpers ---

empty_label <- () -> UILabel = UILabel { text: "", size: 16, colour: [0.92, 0.94, 0.98, 1.0] }
empty_button <- () -> UIButton = UIButton { label: "", action: 0 }
empty_field <- () -> UITextField:
    ret UITextField {
        text: "",
        max_len: 0,
        focused: false,
        revision: 0,
        rendered_revision: 0,
        texture: 0,
        texture_w: 0,
        texture_h: 0,
    }

transparent_panel <- () -> UIPanel = UIPanel { colour: [0.0, 0.0, 0.0, 0.0] }
panel <- (r: f32, g: f32, b: f32, a: f32) -> UIPanel = UIPanel { colour: [r, g, b, a] }

# One editor UI row: every row carries all five UI components so the retained
# UI projection stays a single list (see engine/ui/main.e7).
add_label_row <- (
    commands: &mut Commands,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    text: str,
    size: i64,
    role: i64,
) -> nil:
    rect := UIRect { x: x, y: y, w: w, h: h }
    panel := transparent_panel()
    label := UILabel { text: text, size: size, colour: [0.92, 0.94, 0.98, 1.0] }
    button := empty_button()
    field := empty_field()
    marker := EditorLabel { role: role }
    commands.add_row(Components, { rect, panel, label, button, field, marker })
    ret

add_button_row <- (
    commands: &mut Commands,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    text: str,
    action: i64,
) -> nil:
    rect := UIRect { x: x, y: y, w: w, h: h }
    panel := panel(0.16, 0.2, 0.28, 0.95)
    label := empty_label()
    button := UIButton { label: text, action: action }
    field := empty_field()
    commands.add_row(Components, { rect, panel, label, button, field })
    ret

# --------------------------------------------------------------- plugin -----

pub Editor <- plugin
    editor_plugin_init <- sys (commands: &mut Commands):
        scene_path := "engine/editor/scenes/sample.scene.json"
        document := load_scene(scene_path)
        commands.insert_resource(editor_state(document, scene_path))

        # Full-height side panel.
        panel_rect := UIRect { x: 596.0, y: 0.0, w: 364.0, h: 540.0 }
        panel_bg := panel(0.055, 0.07, 0.105, 0.94)
        panel_label := empty_label()
        panel_button := empty_button()
        panel_field := empty_field()
        commands.add_row(Components, { panel_rect, panel_bg, panel_label, panel_button, panel_field })

        add_label_row(commands, 612.0, 12.0, 332.0, 30.0, "editor7 scene editor", 20, 0)
        add_label_row(commands, 612.0, 48.0, 332.0, 26.0, "", 16, 1)
        add_label_row(commands, 612.0, 76.0, 332.0, 46.0, "", 16, 2)
        add_label_row(commands, 612.0, 492.0, 332.0, 40.0, "", 14, 3)

        # Selection.
        add_button_row(commands, 612.0, 130.0, 158.0, 28.0, "Prev object", 2)
        add_button_row(commands, 784.0, 130.0, 158.0, 28.0, "Next object", 1)

        # Translation nudges (0.25 world units; displayed as milli-units).
        add_button_row(commands, 612.0, 170.0, 100.0, 28.0, "X -", 3)
        add_button_row(commands, 722.0, 170.0, 100.0, 28.0, "X +", 4)
        add_button_row(commands, 832.0, 170.0, 110.0, 28.0, "Colour", 9)
        add_button_row(commands, 612.0, 206.0, 100.0, 28.0, "Y -", 5)
        add_button_row(commands, 722.0, 206.0, 100.0, 28.0, "Y +", 6)
        add_button_row(commands, 612.0, 242.0, 100.0, 28.0, "Z -", 7)
        add_button_row(commands, 722.0, 242.0, 100.0, 28.0, "Z +", 8)

        # File actions.
        add_button_row(commands, 612.0, 292.0, 158.0, 28.0, "Save scene", 10)
        add_button_row(commands, 784.0, 292.0, 158.0, 28.0, "Reload code", 11)

        add_label_row(commands, 612.0, 332.0, 332.0, 24.0, "Save writes the scene JSON;", 14, 4)
        add_label_row(commands, 612.0, 356.0, 332.0, 24.0, "Reload saves and recompiles.", 14, 4)
        ret

# Rebuild ECS scene rows from the editor document.  Queued despawns apply
# before the queued adds; `disown commands` flushes the command buffer.
@trigger(EditorRefresh)
pub rebuild_scene <- sys (
    commands: &mut Commands,
    state: res &mut EditorState,
    camera_rows: select &mut Camera from Components,
    light_rows: select &mut PointLight from Components,
    object_rows: select &mut Renderable from Components,
):
    for row in camera_rows:
        commands.despawn(camera_rows.entity())
    for row in light_rows:
        commands.despawn(light_rows.entity())
    for row in object_rows:
        commands.despawn(object_rows.entity())

    document := state.document
    camera := Camera {
        position: [document.camera.position.x, document.camera.position.y, document.camera.position.z],
        yaw: document.camera.yaw,
        pitch: document.camera.pitch,
        fov_y: document.camera.fov_y,
        near: document.camera.near,
        far: document.camera.far,
    }
    commands.add_row(Components, { camera })

    light := PointLight {
        position: [document.light.position.x, document.light.position.y, document.light.position.z],
        colour: [document.light.colour.x, document.light.colour.y, document.light.colour.z],
        intensity: document.light.intensity,
    }
    commands.add_row(Components, { light })

    for object in document.objects:
        transform := Transform {
            translation: [object.translation.x, object.translation.y, object.translation.z],
            rotation: [object.rotation.x, object.rotation.y, object.rotation.z],
            scale: [1.0, 1.0, 1.0],
        }
        bounds := BodyBounds {
            half_extents: [object.half_extents.x, object.half_extents.y, object.half_extents.z],
        }
        material := Material { texture: 0, tint: [object.colour.r, object.colour.g, object.colour.b] }
        renderable := Renderable { kind: shape_kind_code(object.kind), colour: [object.colour.r, object.colour.g, object.colour.b] }
        quaternion := euler_to_quaternion(object.rotation)
        orientation := BodyOrientation { x: quaternion.x, y: quaternion.y, z: quaternion.z, w: quaternion.w }
        marker := EditorObject { name: object.name }
        commands.add_row(Components, { transform, bounds, material, renderable, orientation, marker })
    disown commands

# --------------------------------------------------------------- actions -----

@trigger(UIButtonPressed)
pub handle_editor_action <- sys (state: res &mut EditorState, ui: res &UIState):
    action := ui.action
    if action == 0:
        ret

    if action == 1:
        select_next(state)
        state.status = "selected next object"
        ret
    if action == 2:
        select_previous(state)
        state.status = "selected previous object"
        ret
    if action == 10:
        status := save_scene(state.scene_path, &state.document)
        if status == 0:
            state.status = "saved " + state.scene_path
        else:
            state.status = "save failed: " + state.scene_path
        ret
    if action == 11:
        status := save_scene(state.scene_path, &state.document)
        if status == 0:
            state.status = "reloading code..."
        else:
            state.status = "save failed; reloading code..."
        host::request_reload()
        ret
    if action == 9:
        index := selected_object_index(state)
        if index < 0:
            state.status = "no object selected"
            ret
        object := state.document.objects[index as usize]
        state.colour_step = state.colour_step + 1
        object.colour = colour_palette(state.colour_step)
        state.dirty = true
        state.status = "cycled colour"
        ret

    index := selected_object_index(state)
    if index < 0:
        state.status = "no object selected"
        ret
    object := state.document.objects[index as usize]
    step := 0.25
    if action == 3:
        object.translation.x = object.translation.x - step
        state.status = "moved X -"
    elif action == 4:
        object.translation.x = object.translation.x + step
        state.status = "moved X +"
    elif action == 5:
        object.translation.y = object.translation.y - step
        state.status = "moved Y -"
    elif action == 6:
        object.translation.y = object.translation.y + step
        state.status = "moved Y +"
    elif action == 7:
        object.translation.z = object.translation.z - step
        state.status = "moved Z -"
    elif action == 8:
        object.translation.z = object.translation.z + step
        state.status = "moved Z +"
    else:
        ret
    state.dirty = true
    ret

# --------------------------------------------------------- label refresh -----

label_title <- (state: &EditorState) -> str = "editor7 - " + state.document.name

label_selection <- (state: &EditorState) -> str:
    count := state.document.objects.len() as i64
    if count == 0:
        ret "no objects in scene"
    index := selected_object_index(state)
    if index < 0:
        ret "no object selected"
    object := state.document.objects[index as usize]
    ret "[" + fmt_i64(index) + "/" + fmt_i64(count) + "] " + object.name + " (" + shape_kind_name(object.kind) + ")"

label_transform <- (state: &EditorState) -> str:
    index := selected_object_index(state)
    if index < 0:
        ret "translation: -"
    object := state.document.objects[index as usize]
    ret "pos " + fmt_milli(object.translation.x) + ", " + fmt_milli(object.translation.y) + ", " + fmt_milli(object.translation.z)

label_status <- (state: &EditorState) -> str = state.status

label_text_for_role <- (state: &EditorState, role: i64) -> str:
    if role == 0:
        ret label_title(state)
    if role == 1:
        ret label_selection(state)
    if role == 2:
        ret label_transform(state)
    if role == 3:
        ret label_status(state)
    ret ""

# Destroy a stale cached label texture so the UI system regenerates it from
# the changed text next frame (labels are cached once by entity id).
invalidate_label <- (gpu: &mut Gpu, ui: &mut UIState, entity: i64) -> nil:
    entry := ui.textures[entity]
    if entry.len() > 0 and entry[0] != 0:
        gpu.destroy_texture(entry[0] as u64)
    empty: [i64] := []
    ui.textures[entity] = empty
    ret

@trigger(Update)
pub refresh_labels <- sys (
    state: res &EditorState,
    gpu: res &mut Gpu,
    ui: res &mut UIState,
    labels: select &mut UILabel, &EditorLabel from Components,
):
    for (label, marker) in labels:
        desired := label_text_for_role(state, marker.role)
        if label.text != desired:
            invalidate_label(gpu, ui, labels.entity())
            label.text = desired
    ret

