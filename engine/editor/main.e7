# Native scene authoring workspace. All document operations are implemented in
# model.e7 and shared by the UI, shortcuts, and dependency-free regression tests.
mod inspector
use inspector::*;
mod model
use model::*;
use core::ecs::*;
use core::events::*;
use core::window::*;
use core::input::*;
use gfx::gpu::*;
use ui::*;
use scene::document::*;

pub EditorRefresh <- trigger
pub EditorInput <- trigger

@Components
pub EditorObject <- struct
    name: str

@Components
pub EditorLabel <- struct
    role: i64
    synced: i64

@Components
pub EditorField <- struct
    role: i64
    synced: i64

@Components
pub EditorHierarchy <- struct
    slot: i64

# Anchors: 0 fixed, 1 right, 2 stretch width, 3 stretch height,
# 4 right + stretch height, 5 bottom + stretch width, 6 viewport.
@Components
pub EditorWidget <- struct
    anchor: i64
    x: f32
    y: f32
    w: f32
    h: f32

widget <- (commands: &mut Commands, x: f32, y: f32, w: f32, h: f32, text: str, role: i64, action: i64, field_role: i64, anchor: i64) -> nil:
    rect := UIRect { x: x, y: y, w: w, h: h }
    colour := [0.0, 0.0, 0.0, 0.0]
    if action != 0 or field_role >= 0:
        colour = [0.105, 0.14, 0.19, 0.98]
    panel := UIPanel { colour: colour }
    label_text := text
    button_text := ""
    if action != 0:
        button_text = text
        label_text = ""
    label := UILabel { text: label_text, size: 14, colour: [0.85, 0.9, 0.96, 1.0] }
    button := UIButton { label: button_text, action: action }
    max_len := 0
    if field_role >= 0:
        max_len = 128
    field := UITextField { text: "", max_len: max_len, focused: false, select_all: false, revision: 0, rendered_revision: 0, texture: 0, texture_w: 0, texture_h: 0 }
    marker := EditorLabel { role: role, synced: 0 }
    field_marker := EditorField { role: field_role, synced: 0 }
    slot := -1
    if action >= 100 and action < 108:
        slot = action - 100
    hierarchy := EditorHierarchy { slot: slot }
    layout := EditorWidget { anchor: anchor, x: x, y: y, w: w, h: h }
    commands.add_row(Components, { rect, panel, label, button, field, marker, field_marker, hierarchy, layout })

background <- (commands: &mut Commands, x: f32, y: f32, w: f32, h: f32, anchor: i64) -> nil:
    rect := UIRect { x: x, y: y, w: w, h: h }
    panel := UIPanel { colour: [0.035, 0.05, 0.075, 0.97] }
    label := UILabel { text: "", size: 14, colour: [0.9, 0.94, 0.98, 1.0] }
    button := UIButton { label: "", action: 0 }
    field := UITextField { text: "", max_len: 0, focused: false, select_all: false, revision: 0, rendered_revision: 0, texture: 0, texture_w: 0, texture_h: 0 }
    layout := EditorWidget { anchor: anchor, x: x, y: y, w: w, h: h }
    commands.add_row(Components, { rect, panel, label, button, field, layout })

pub Editor <- plugin
    editor_plugin_init <- sys (commands: &mut Commands):
        path := "engine/editor/scenes/sample.scene.json"
        commands.insert_resource(editor_resume(load_scene(path), path))
        # This transparent world widget prevents the game UI from capturing
        # the mouse on selection clicks; the editor owns right-button capture.
        widget(commands, 174.0, 40.0, 466.0, 468.0, "", -1, 0, -1, 6)
        background(commands, 0.0, 0.0, 960.0, 40.0, 2)
        background(commands, 0.0, 40.0, 174.0, 468.0, 3)
        background(commands, 640.0, 40.0, 320.0, 468.0, 4)
        background(commands, 0.0, 508.0, 960.0, 32.0, 5)
        widget(commands, 4.0, 4.0, 130.0, 30.0, "", 0, 0, -1, 0)
        widget(commands, 146.0, 5.0, 58.0, 28.0, "New", -1, 20, -1, 0)
        widget(commands, 210.0, 5.0, 58.0, 28.0, "Open", -1, 21, -1, 0)
        widget(commands, 274.0, 5.0, 58.0, 28.0, "Save", -1, 10, -1, 0)
        widget(commands, 346.0, 5.0, 58.0, 28.0, "Undo", -1, 14, -1, 0)
        widget(commands, 410.0, 5.0, 58.0, 28.0, "Redo", -1, 15, -1, 0)
        widget(commands, 480.0, 5.0, 70.0, 28.0, "Focus", -1, 24, -1, 0)
        widget(commands, 560.0, 5.0, 120.0, 28.0, "Save view", -1, 25, -1, 1)
        widget(commands, 786.0, 5.0, 164.0, 28.0, "Reload code", -1, 11, -1, 1)
        widget(commands, 184.0, 46.0, 442.0, 28.0, "", -1, 0, 0, 2)
        widget(commands, 4.0, 47.0, 160.0, 24.0, "CREATE", -1, 0, -1, 0)
        widget(commands, 10.0, 78.0, 74.0, 28.0, "Box", -1, 16, -1, 0)
        widget(commands, 90.0, 78.0, 74.0, 28.0, "Sphere", -1, 17, -1, 0)
        widget(commands, 10.0, 112.0, 74.0, 28.0, "Capsule", -1, 18, -1, 0)
        widget(commands, 90.0, 112.0, 74.0, 28.0, "Plane", -1, 19, -1, 0)
        widget(commands, 4.0, 146.0, 160.0, 24.0, "SCENE OBJECTS", -1, 0, -1, 0)
        slot := 0
        while slot < 8:
            widget(commands, 10.0, 176.0 + (slot as f32) * 26.0, 154.0, 24.0, "", -1, 100 + slot, -1, 0)
            slot = slot + 1
        widget(commands, 10.0, 390.0, 74.0, 28.0, "< Page", -1, 22, -1, 0)
        widget(commands, 90.0, 390.0, 74.0, 28.0, "Page >", -1, 23, -1, 0)
        widget(commands, 10.0, 430.0, 74.0, 28.0, "Copy", -1, 12, -1, 0)
        widget(commands, 90.0, 430.0, 74.0, 28.0, "Delete", -1, 13, -1, 0)
        widget(commands, 4.0, 468.0, 160.0, 24.0, "", 4, 0, -1, 0)
        widget(commands, 646.0, 47.0, 306.0, 24.0, "INSPECTOR", -1, 0, -1, 1)
        widget(commands, 646.0, 73.0, 306.0, 24.0, "", 1, 0, -1, 1)
        widget(commands, 654.0, 100.0, 92.0, 26.0, "Object", -1, 40, -1, 1)
        widget(commands, 754.0, 100.0, 92.0, 26.0, "Camera", -1, 41, -1, 1)
        widget(commands, 854.0, 100.0, 92.0, 26.0, "Light", -1, 42, -1, 1)
        row := 0
        while row < 6:
            y := 130.0 + (row as f32) * 38.0
            widget(commands, 646.0, y, 306.0, 17.0, "", 10 + row, 0, -1, 1)
            widget(commands, 654.0, y + 17.0, 292.0, 21.0, "", -1, 0, 1 + row, 1)
            row = row + 1
        widget(commands, 654.0, 374.0, 74.0, 28.0, "<", -1, 43, -1, 1)
        widget(commands, 730.0, 374.0, 138.0, 28.0, "", 5, 0, -1, 1)
        widget(commands, 872.0, 374.0, 74.0, 28.0, ">", -1, 44, -1, 1)
        widget(commands, 654.0, 418.0, 142.0, 30.0, "Apply", -1, 30, -1, 1)
        widget(commands, 806.0, 418.0, 140.0, 30.0, "Reset fields", -1, 31, -1, 1)
        widget(commands, 646.0, 460.0, 300.0, 24.0, "RMB + WASD/QE to fly", -1, 0, -1, 1)
        widget(commands, 646.0, 484.0, 300.0, 24.0, "F focus | Ctrl+S save", -1, 0, -1, 1)
        widget(commands, 4.0, 510.0, 948.0, 26.0, "", 3, 0, -1, 5)

@trigger(FrameInit)
pub layout_widgets <- sys (window: res &Window, rows: select &mut UIRect, &EditorWidget from Components):
    dx := (window.width as f32) - 960.0
    dy := (window.height as f32) - 540.0
    for (rect, anchor) in rows:
        rect.x = anchor.x
        rect.y = anchor.y
        rect.w = anchor.w
        rect.h = anchor.h
        if anchor.anchor == 1 or anchor.anchor == 4:
            rect.x = rect.x + dx
        if anchor.anchor == 2 or anchor.anchor == 5 or anchor.anchor == 6:
            rect.w = rect.w + dx
        if anchor.anchor == 3 or anchor.anchor == 4 or anchor.anchor == 6:
            rect.h = rect.h + dy
        if anchor.anchor == 5:
            rect.y = rect.y + dy

@trigger(EditorRefresh)
pub rebuild_scene <- sys (
    commands: &mut Commands,
    state: res &EditorState,
    camera_rows: select &mut Camera from Components,
    light_rows: select &mut PointLight from Components,
    object_rows: select &mut Renderable from Components,
):
    for row in camera_rows:
        commands.despawn(camera_rows.entity())
    for row in light_rows:
        commands.despawn(light_rows.entity())
    for row in object_rows:
        commands.despawn(object_rows.entity())

    document := state.document
    view := state.view_camera
    camera := Camera {
        position: [view.position.x, view.position.y, view.position.z],
        yaw: view.yaw,
        pitch: view.pitch,
        fov_y: view.fov_y,
        near: view.near,
        far: view.far,
    }
    commands.add_row(Components, { camera })

    light := PointLight {
        position: [document.light.position.x, document.light.position.y, document.light.position.z],
        colour: [document.light.colour.x, document.light.colour.y, document.light.colour.z],
        intensity: document.light.intensity,
    }
    commands.add_row(Components, { light })

    for object in document.objects:
        transform := Transform {
            translation: [object.translation.x, object.translation.y, object.translation.z],
            rotation: [object.rotation.x, object.rotation.y, object.rotation.z],
            scale: [1.0, 1.0, 1.0],
        }
        bounds := BodyBounds {
            half_extents: [object.half_extents.x, object.half_extents.y, object.half_extents.z],
        }
        material := Material { texture: 0, tint: [object.colour.r, object.colour.g, object.colour.b] }
        renderable := Renderable { kind: shape_kind_code(object.kind), colour: [object.colour.r, object.colour.g, object.colour.b] }
        quaternion := euler_to_quaternion(object.rotation)
        orientation := BodyOrientation { x: quaternion.x, y: quaternion.y, z: quaternion.z, w: quaternion.w }
        marker := EditorObject { name: object.name }
        commands.add_row(Components, { transform, bounds, material, renderable, orientation, marker })
    disown commands


@trigger(UIButtonPressed)
pub handle_editor_action <- sys (state: res &mut EditorState, ui: res &UIState, rows: select &UITextField, &EditorField from Components):
    fields: [str] := ["", "", "", "", "", "", ""]
    for (field, marker) in rows:
        if marker.role >= 0:
            fields[marker.role as usize] = field.text
    editor_dispatch(state, ui.action, fields)

invalidate_label <- (gpu: &mut Gpu, ui: &mut UIState, entity: i64) -> nil:
    entry := ui.textures[entity]
    if entry.len() > 0 and entry[0] != 0:
        gpu.destroy_texture(entry[0] as u64)
    ui.textures[entity] = []

@trigger(Update)
pub refresh_editor_widgets <- sys (
    state: res &EditorState, gpu: res &mut Gpu, ui: res &mut UIState,
    labels: select &mut UILabel, &mut EditorLabel from Components,
    fields: select &mut UITextField, &mut EditorField, &mut UIPanel, &mut UIButton from Components,
    hierarchy: select &mut UIButton, &mut UIPanel, &EditorHierarchy from Components,
):
    for (label, marker) in labels:
        if marker.role < 0:
            cont
        if marker.role >= 5 and marker.synced == state.revision:
            cont
        marker.synced = state.revision
        desired := ""
        if marker.role == 0:
            desired = "editor7"
            if state.dirty:
                desired = "editor7 *"
        elif marker.role == 1:
            index := selected_object_index(state)
            if index < 0:
                desired = "No selection"
            else:
                desired = shape_kind_name(state.document.objects[index as usize].kind) + " properties"
            if state.inspector_target == 1:
                desired = "Scene camera (radians)"
            elif state.inspector_target == 2:
                desired = "Scene light"
        elif marker.role == 3:
            desired = state.status
        elif marker.role == 4:
            desired = fmt_i64(state.document.objects.len() as i64) + " objects"
        elif marker.role == 5:
            pages := (state.inspector_fields.len() as i64 + 5) / 6
            desired = "No fields"
            if pages > 0:
                desired = fmt_i64(state.inspector_page + 1) + " / " + fmt_i64(pages)
        elif marker.role >= 10 and marker.role < 16:
            index := state.inspector_page * 6 + marker.role - 10
            if index < state.inspector_fields.len() as i64:
                field := state.inspector_fields[index as usize]
                desired = field.path + " : " + inspect_type_hint(field.schema)
        if desired != label.text:
            invalidate_label(gpu, ui, labels.entity())
            label.text = desired
    for (field, marker, panel, button) in fields:
        if marker.role < 0:
            cont
        revision := state.revision
        if marker.role == 0:
            revision = state.path_revision
        if marker.synced == revision:
            cont
        index := state.inspector_page * 6 + marker.role - 1
        field.max_len = 2048
        panel.colour = [0.105, 0.14, 0.19, 0.98]
        if marker.role > 0 and index >= state.inspector_fields.len() as i64:
            field.max_len = 0
            panel.colour = [0.0, 0.0, 0.0, 0.0]
        desired_button := ""
        button.action = 0
        if marker.role > 0 and index < state.inspector_fields.len() as i64:
            choices := state.inspector_fields[index as usize].choices
            if choices.len() > 0:
                field.max_len = 0
                button.action = 60 + marker.role - 1
                desired_button = state.inspector_draft[index as usize] + " >"
        if field.max_len == 0:
            field.focused = false
            if ui.focused_entity == fields.entity():
                ui.focused_entity = 0
        if button.label != desired_button:
            invalidate_label(gpu, ui, fields.entity())
            button.label = desired_button
        if not field.focused:
            field.text = editor_field_text(state, marker.role)
            field.revision = field.revision + 1
            marker.synced = revision
    for (button, panel, marker) in hierarchy:
        if marker.slot < 0:
            cont
        index := state.hierarchy_page * 8 + marker.slot
        desired := ""
        button.action = 0
        panel.colour = [0.055, 0.075, 0.105, 1.0]
        if index < state.document.objects.len() as i64:
            name := state.document.objects[index as usize].name
            if name.len() > 15:
                name = name.slice(0, 15)
            desired = "  " + name
            if index == state.selected:
                desired = "> " + name
                panel.colour = [0.12, 0.3, 0.42, 1.0]
            button.action = 100 + marker.slot
        if button.label != desired:
            invalidate_label(gpu, ui, hierarchy.entity())
            button.label = desired

@trigger(EditorInput)
pub editor_input <- sys (
    state: res &mut EditorState, input: res &Input, ui: res &UIState, window: res &Window,
    fields: select &UITextField, &EditorField from Components,
    cameras: select &mut Camera from Components,
):
    action := 0
    if ui.focused_entity == 0 and not state.camera_active:
        if input.key_down(14):
            if input.key_down(1):
                action = 10
            elif input.key_down(15):
                action = 14
            elif input.key_down(16):
                action = 15
            elif input.key_down(3):
                action = 12
            elif input.key_down(17):
                action = 20
            elif input.key_down(20):
                action = 21
        elif input.key_down(18):
            action = 13
        elif input.key_down(19):
            action = 24
    if action != 0 and action != state.last_shortcut:
        values: [str] := ["", "", "", "", "", "", ""]
        for (field, marker) in fields:
            if marker.role >= 0:
                values[marker.role as usize] = field.text
        editor_dispatch(state, action, values)
    state.last_shortcut = action
    inside := input.cursor_x() >= 174.0 and input.cursor_x() < (window.width as f32) - 320.0 and input.cursor_y() >= 78.0 and input.cursor_y() < (window.height as f32) - 32.0
    down := input.mouse_down(0)
    if down and not state.pointer_down and inside and not state.camera_active:
        picked := editor_pick(state, input.cursor_x(), input.cursor_y(), window.width as f32, window.height as f32)
        if picked >= 0:
            editor_select(state, picked)
    state.pointer_down = down
    right := input.mouse_down(1)
    starting_camera := right and inside and not state.camera_active
    if starting_camera:
        state.camera_active = true
        input.capture_mouse()
    if not right and state.camera_active:
        state.camera_active = false
        input.release_mouse()
    if state.camera_active:
        camera := state.view_camera
        if not starting_camera:
            camera.yaw = camera.yaw + input.look_dx * 0.003
            camera.pitch = f32::clamp(camera.pitch - input.look_dy * 0.003, -1.5, 1.5)
        speed := 0.064
        if input.sprint:
            speed = 0.2
        forward := 0.0
        sideways := 0.0
        vertical := 0.0
        if input.move_forward:
            forward = forward + speed
        if input.move_backward:
            forward = forward - speed
        if input.move_right:
            sideways = sideways + speed
        if input.move_left:
            sideways = sideways - speed
        if input.move_up:
            vertical = vertical + speed
        if input.move_down:
            vertical = vertical - speed
        sy := f32::sin(camera.yaw)
        cy := f32::cos(camera.yaw)
        cp := f32::cos(camera.pitch)
        camera.position.x = camera.position.x + forward * sy * cp + sideways * cy
        camera.position.y = camera.position.y + vertical + forward * f32::sin(camera.pitch)
        camera.position.z = camera.position.z - forward * cy * cp + sideways * sy
    for camera in cameras:
        camera.position = [state.view_camera.position.x, state.view_camera.position.y, state.view_camera.position.z]
        camera.yaw = state.view_camera.yaw
        camera.pitch = state.view_camera.pitch
