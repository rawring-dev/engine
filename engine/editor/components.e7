# Type-erased authoring uses the compiler's complete @Components catalogue.
# Stable qualified names are persisted; numeric ECS ids are resolved per build.
@derive(Serialize, Deserialize)
pub ComponentType <- struct
    name: str
    id: i64
    slots: i64
    schema: str

pub component_short_name <- (name: str) -> str:
    parts := str::split(name, ":")
    ret parts[(parts.len() as i64 - 1) as usize]

pub component_type_index <- (types: &[ComponentType], name: str) -> i64:
    index := 0
    while index < types.len() as i64:
        if types[index as usize].name == name:
            ret index
        index = index + 1
    ret -1

pub component_named <- (types: &[ComponentType], short_name: str) -> str:
    index := 0
    while index < types.len() as i64:
        name := types[index as usize].name
        if component_short_name(name) == short_name:
            ret name
        index = index + 1
    ret ""

pub component_default <- (schema: str) -> str:
    tag := inspect_char(schema, 0)
    if tag == "s":
        ret "\"\""
    if tag == "b":
        ret "false"
    if tag == "i" or tag == "f":
        ret "0"
    if tag == "?":
        ret "null"
    if tag == "[":
        ret "[]"
    if tag == "<":
        ret "{}"
    if tag == "A" or tag == "M":
        colon := 1
        while inspect_char(schema, colon) != ":" and colon < schema.len() as i64:
            colon = colon + 1
        count := i64::parse(schema.slice(1, colon as usize))
        element := schema.slice((colon + 1) as usize, schema.len() as usize)
        if tag == "M":
            element = "A" + element
        out := "["
        index := 0
        while index < count:
            if index > 0:
                out = out + ","
            out = out + component_default(element)
            index = index + 1
        ret out + "]"
    if tag == "{":
        out := "{"
        at := 1
        while at < schema.len() as i64 and inspect_char(schema, at) != "}":
            equal := at
            while inspect_char(schema, equal) != "=" and equal < schema.len() as i64:
                equal = equal + 1
            end := inspect_schema_end(schema, equal + 1)
            if at > 1:
                out = out + ","
            out = out + json::encode(schema.slice(at as usize, equal as usize)) + ":" + component_default(schema.slice((equal + 1) as usize, end as usize))
            at = end
            if inspect_char(schema, at) == ";":
                at = at + 1
        ret out + "}"
    if tag == "E":
        equal := 2
        while inspect_char(schema, equal) != "=" and equal < schema.len() as i64:
            equal = equal + 1
        name := schema.slice(2, equal as usize)
        if inspect_char(schema, equal + 1) == "u":
            ret json::encode(name)
        values: [str] := []
        at := equal + 2
        while inspect_char(schema, at) != ")" and at < schema.len() as i64:
            end := inspect_schema_end(schema, at)
            values = vec::push(values, component_default(schema.slice(at as usize, end as usize)))
            at = end
            if inspect_char(schema, at) == ",":
                at = at + 1
        payload := "["
        index := 0
        while index < values.len() as i64:
            if index > 0:
                payload = payload + ","
            payload = payload + values[index as usize]
            index = index + 1
        payload = payload + "]"
        if values.len() == 1:
            payload = values[0]
        ret "{" + json::encode(name) + ":" + payload + "}"
    ret "null"

# Defaults that have a meaningful identity rather than zero (scale, mass,
# gravity, radii, camera lens). Other/custom types use their schema recursively.
pub component_initial <- (component: ComponentType) -> str:
    name := component_short_name(component.name)
    if component.name != name and component.name != "core::ecs::" + name and component.name != "gfx::gpu::Material":
        ret component_default(component.schema)
    if name == "Transform":
        ret "{\"translation\":[0,0,0],\"rotation\":[0,0,0],\"scale\":[1,1,1]}"
    if name == "BodyOrientation":
        ret "{\"x\":0,\"y\":0,\"z\":0,\"w\":1}"
    if name == "RigidBody":
        ret "{\"velocity\":[0,0,0],\"angular_velocity\":[0,0,0],\"orientation\":[0,0,0],\"inv_mass\":1,\"gravity_scale\":1,\"rotation_locked\":false,\"is_static\":false}"
    if name == "BodyBounds" or name == "BoxCollider":
        ret "{\"half_extents\":[0.5,0.5,0.5]}"
    if name == "SphereCollider":
        ret "{\"radius\":0.5}"
    if name == "CapsuleCollider":
        ret "{\"radius\":0.5,\"half_height\":0.5}"
    if name == "PlaneCollider":
        ret "{\"normal\":[0,1,0],\"offset\":0}"
    if name == "Material":
        ret "{\"texture\":0,\"tint\":[1,1,1]}"
    if name == "Renderable":
        ret "{\"kind\":0,\"colour\":[1,1,1]}"
    if name == "Camera":
        ret "{\"position\":[0,1.8,6],\"yaw\":0,\"pitch\":-0.15,\"fov_y\":1.0471975512,\"near\":0.1,\"far\":100}"
    if name == "PointLight":
        ret "{\"position\":[3,4,2],\"colour\":[1,1,1],\"intensity\":2.8}"
    ret component_default(component.schema)

pub component_canonical <- (schema: str, source: str) -> str:
    value := json::decode_value(schema, source)
    if value == 0:
        ret ""
    ret json::encode_value(schema, value)
