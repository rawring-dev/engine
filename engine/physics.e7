# Physics library: vector/ray primitives, plugin resources, and the single
# fixed-step Update system that composes broadphase and narrowphase modules.
#
# Modules:
#   - physics_broadphase.e7: SpatialMap, cell keys, region/ray candidate queries
#   - physics_narrowphase.e7: AABB/sphere/capsule/plane tests + raycasts
#   - physics.e7 (this file): public Vec3/Ray/Aabb API, ECS resources, systems
#
# All gameplay physics happens in one Update system so the order is
# deterministic even though trigger phases run systems concurrently:
#   broadphase rebuild + gravity/integrate + true-shape ground contact
#   -> body-body narrowphase (AABB/capsule/sphere/plane, each pair once)
#   -> player movement/jump -> pickup acquire/release/hold
#   -> camera look + player-follow -> (PostUpdate: Held marker sync, debug ray).
# The step is fixed at 16 ms.  Pickup and camera follow therefore observe the
# same step's transforms instead of lagging a phase behind.

use ecs::*;
use events::*;
use time::*;

pub Vec3 <- struct
    x: f32
    y: f32
    z: f32

pub Ray <- struct
    origin: Vec3
    direction: Vec3

pub Aabb <- struct
    min: Vec3
    max: Vec3

pub RayHit <- struct
    hit: bool
    distance: f32
    point: Vec3

@resource
pub PhysicsWorld <- struct
    gravity_y: f32
    max_step: f32
    grounded: bool
    # Prevents held-Space from auto-hopping on every landing.
    jump_latched: bool
    # Player world position and latest camera look (used by movement, pickup,
    # and camera follow; the camera pass updates these at the end of the step).
    player_x: f32
    player_y: f32
    player_z: f32
    camera_yaw: f32
    camera_pitch: f32
    move_speed: f32

@resource
pub RaycastState <- struct
    hit: bool
    distance: f32
    point_x: f32
    point_y: f32
    point_z: f32

@resource
pub PickupState <- struct
    # Body id held by the player, or 0 for none.
    held_id: i64

pub PhysicsPlugin <- plugin
    physics_plugin_init <- sys (commands: &mut Commands):
        commands.insert_resource(PhysicsWorld {
            gravity_y: -9.81,
            max_step: 0.05,
            grounded: false,
            jump_latched: false,
            player_x: 0.0,
            player_y: 0.0,
            player_z: 0.0,
            camera_yaw: 0.0,
            camera_pitch: 0.0,
            move_speed: 4.0,
        })
        commands.insert_resource(RaycastState {
            hit: false,
            distance: 0.0,
            point_x: 0.0,
            point_y: 0.0,
            point_z: 0.0,
        })
        commands.insert_resource(PickupState { held_id: 0 })

pub box_collider <- (center: Vec3, half: Vec3) -> Aabb:
    ret Aabb {
        min: Vec3 {
            x: center.x - half.x,
            y: center.y - half.y,
            z: center.z - half.z,
        },
        max: Vec3 {
            x: center.x + half.x,
            y: center.y + half.y,
            z: center.z + half.z,
        },
    }

pub ray_aabb <- (ray: Ray, box: Aabb) -> RayHit:
    # Slab test without division-by-zero hazards.
    inv_x := 1.0 / ray.direction.x
    inv_y := 1.0 / ray.direction.y
    inv_z := 1.0 / ray.direction.z
    t1 := (box.min.x - ray.origin.x) * inv_x
    t2 := (box.max.x - ray.origin.x) * inv_x
    t3 := (box.min.y - ray.origin.y) * inv_y
    t4 := (box.max.y - ray.origin.y) * inv_y
    t5 := (box.min.z - ray.origin.z) * inv_z
    t6 := (box.max.z - ray.origin.z) * inv_z
    xmin := t1
    if t2 < xmin:
        xmin = t2
    xmax := t1
    if t2 > xmax:
        xmax = t2
    ymin := t3
    if t4 < ymin:
        ymin = t4
    ymax := t3
    if t4 > ymax:
        ymax = t4
    zmin := t5
    if t6 < zmin:
        zmin = t6
    zmax := t5
    if t6 > zmax:
        zmax = t6
    tmin := xmin
    if ymin > tmin:
        tmin = ymin
    if zmin > tmin:
        tmin = zmin
    tmax := xmax
    if ymax < tmax:
        tmax = ymax
    if zmax < tmax:
        tmax = zmax
    hit := tmax >= tmin and tmax >= 0.0
    t := tmin
    if t < 0.0:
        t = tmax
    ret RayHit {
        hit: hit,
        distance: t,
        point: Vec3 {
            x: ray.origin.x + ray.direction.x * t,
            y: ray.origin.y + ray.direction.y * t,
            z: ray.origin.z + ray.direction.z * t,
        },
    }

pub ray_sphere <- (ray: Ray, center: Vec3, radius: f32) -> RayHit:
    ox := ray.origin.x - center.x
    oy := ray.origin.y - center.y
    oz := ray.origin.z - center.z
    b := ox * ray.direction.x + oy * ray.direction.y + oz * ray.direction.z
    c := ox * ox + oy * oy + oz * oz - radius * radius
    disc := b * b - c
    if disc < 0.0:
        ret RayHit { hit: false, distance: 0.0, point: ray.origin }
    root := e7_f32_sqrt(disc)
    t := 0.0 - b - root
    if t < 0.0:
        t = 0.0 - b + root
    ret RayHit {
        hit: t >= 0.0,
        distance: t,
        point: Vec3 {
            x: ray.origin.x + ray.direction.x * t,
            y: ray.origin.y + ray.direction.y * t,
            z: ray.origin.z + ray.direction.z * t,
        },
    }

# ---------------------------------------------------------------------------
# Broadphase lookup helpers used by the collision pass
# ---------------------------------------------------------------------------

find_bound_index_local <- (ids: [i64], id: i64) -> i64:
    index := 0
    count := ids.len() as i64
    while index < count:
        if ids[index as usize] == id:
            ret index
        index = index + 1
    ret -1

# ---------------------------------------------------------------------------
# The fixed-step system
# ---------------------------------------------------------------------------

@trigger(Update)
pub physics_step <- sys (
    input: res &Input,
    world: res &mut PhysicsWorld,
    spatial: res &mut SpatialMap,
    bodies: select &mut Transform, &mut RigidBody, &BodyBounds, &BodyFlags from Components,
    interaction_bodies: select &mut Transform, &mut RigidBody, &mut BodyFlags from Components,
    planes: select &PlaneCollider from Components,
    cameras: select &mut Camera, &CameraController from Components,
    pickup_state: res &mut PickupState,
):
    dt := 0.016
    cell_size := spatial.cell_size

    # Plane used for ground contact (demo has a single y-up plane).
    plane_x := 0.0
    plane_y := 1.0
    plane_z := 0.0
    ground := 0.0
    for plane in planes:
        plane_x = plane.normal[0]
        plane_y = plane.normal[1]
        plane_z = plane.normal[2]
        ground = plane.offset

    world.grounded = false

    # ---------------------------------------------------------------- bodies
    cells := map[i64, [i64]] {}
    ids: [i64] := []
    stored_bounds: [f32] := []
    stored_shapes: [i64] := []
    stored_radius: [f32] := []
    stored_half_height: [f32] := []
    body_count := 0

    for (transform, body, body_bounds, flags) in bodies:
        on_ground := false

        if not body.is_static:
            # Angular integration: orientation mirrors Transform.rotation for
            # unlocked bodies; locked bodies keep both at rest.
            if body.rotation_locked:
                body.angular_velocity[0] = 0.0
                body.angular_velocity[1] = 0.0
                body.angular_velocity[2] = 0.0
                body.orientation[0] = transform.rotation[0]
                body.orientation[1] = transform.rotation[1]
                body.orientation[2] = transform.rotation[2]
            else:
                transform.rotation[0] = transform.rotation[0] + body.angular_velocity[0] * dt
                transform.rotation[1] = transform.rotation[1] + body.angular_velocity[1] * dt
                transform.rotation[2] = transform.rotation[2] + body.angular_velocity[2] * dt
                body.orientation[0] = transform.rotation[0]
                body.orientation[1] = transform.rotation[1]
                body.orientation[2] = transform.rotation[2]
                body.angular_velocity[0] = body.angular_velocity[0] * 0.99
                body.angular_velocity[1] = body.angular_velocity[1] * 0.99
                body.angular_velocity[2] = body.angular_velocity[2] * 0.99

            body.velocity[1] = body.velocity[1] + world.gravity_y * body.gravity_scale * dt
            transform.translation[0] = transform.translation[0] + body.velocity[0] * dt
            transform.translation[1] = transform.translation[1] + body.velocity[1] * dt
            transform.translation[2] = transform.translation[2] + body.velocity[2] * dt

            # Ground contact uses the true collider shape.
            ground_push := Vec3 { x: 0.0, y: 0.0, z: 0.0 }
            if flags.shape == 2:
                ground_push = capsule_plane_penetration(
                    Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] },
                    flags.radius,
                    flags.half_height,
                    Vec3 { x: plane_x, y: plane_y, z: plane_z },
                    ground,
                )
            elif flags.shape == 1:
                ground_push = sphere_plane_penetration(
                    Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] },
                    flags.radius,
                    Vec3 { x: plane_x, y: plane_y, z: plane_z },
                    ground,
                )
            elif flags.shape == 0:
                ground_push = box_plane_penetration(
                    Aabb {
                        min: Vec3 {
                            x: transform.translation[0] - body_bounds.half_extents[0],
                            y: transform.translation[1] - body_bounds.half_extents[1],
                            z: transform.translation[2] - body_bounds.half_extents[2],
                        },
                        max: Vec3 {
                            x: transform.translation[0] + body_bounds.half_extents[0],
                            y: transform.translation[1] + body_bounds.half_extents[1],
                            z: transform.translation[2] + body_bounds.half_extents[2],
                        },
                    },
                    Vec3 { x: plane_x, y: plane_y, z: plane_z },
                    ground,
                )

            if ground_push.x != 0.0 or ground_push.y != 0.0 or ground_push.z != 0.0:
                transform.translation[0] = transform.translation[0] + ground_push.x
                transform.translation[1] = transform.translation[1] + ground_push.y
                transform.translation[2] = transform.translation[2] + ground_push.z
                normal_speed := body.velocity[0] * plane_x + body.velocity[1] * plane_y + body.velocity[2] * plane_z
                if normal_speed < 0.0:
                    body.velocity[0] = body.velocity[0] - plane_x * normal_speed
                    body.velocity[1] = body.velocity[1] - plane_y * normal_speed
                    body.velocity[2] = body.velocity[2] - plane_z * normal_speed
                on_ground = true
                if not body.rotation_locked:
                    body.velocity[0] = body.velocity[0] * 0.98
                    body.velocity[2] = body.velocity[2] * 0.98
                    # Rolling contact: horizontal motion imparts yaw spin so
                    # the box/sphere proxies visibly rotate, then it damps.
                    body.angular_velocity[1] = e7_f32_clamp(
                        body.angular_velocity[1] + (body.velocity[0] - body.velocity[2]) * 1.2,
                        -8.0,
                        8.0,
                    )
                    body.angular_velocity[0] = body.angular_velocity[0] * 0.94
                    body.angular_velocity[1] = body.angular_velocity[1] * 0.94
                    body.angular_velocity[2] = body.angular_velocity[2] * 0.94

            if on_ground:
                world.grounded = true

            # Player movement is applied as velocity; collisions resolve the
            # capsule before the next translation step.
            if flags.is_player:
                yaw := world.camera_yaw
                sin_yaw := e7_f32_sin(yaw)
                cos_yaw := e7_f32_cos(yaw)
                forward_x := sin_yaw
                forward_z := 0.0 - cos_yaw
                right_x := cos_yaw
                right_z := sin_yaw
                wish_x := 0.0
                wish_z := 0.0
                if input.move_forward:
                    wish_x = wish_x + forward_x
                    wish_z = wish_z + forward_z
                if input.move_backward:
                    wish_x = wish_x - forward_x
                    wish_z = wish_z - forward_z
                if input.move_right:
                    wish_x = wish_x + right_x
                    wish_z = wish_z + right_z
                if input.move_left:
                    wish_x = wish_x - right_x
                    wish_z = wish_z - right_z
                length := e7_f32_sqrt(wish_x * wish_x + wish_z * wish_z)
                speed := world.move_speed
                if input.sprint:
                    speed = speed * 2.5
                if length > 0.000001:
                    scale := speed / length
                    body.velocity[0] = wish_x * scale
                    body.velocity[2] = wish_z * scale
                else:
                    body.velocity[0] = 0.0
                    body.velocity[2] = 0.0

                capsule_bottom := ground + flags.radius + flags.half_height
                player_on_ground := transform.translation[1] <= capsule_bottom + 0.02
                if not input.jump_down:
                    world.jump_latched = false
                if input.jump_down and player_on_ground and not world.jump_latched:
                    body.velocity[1] = 5.2
                    world.jump_latched = true
                    world.grounded = false
                world.player_x = transform.translation[0]
                world.player_y = transform.translation[1]
                world.player_z = transform.translation[2]

        # Store the broadphase entry *before* collisions so later bodies see
        # this body; earlier bodies are already inserted.
        min_x := transform.translation[0] - body_bounds.half_extents[0]
        min_y := transform.translation[1] - body_bounds.half_extents[1]
        min_z := transform.translation[2] - body_bounds.half_extents[2]
        max_x := transform.translation[0] + body_bounds.half_extents[0]
        max_y := transform.translation[1] + body_bounds.half_extents[1]
        max_z := transform.translation[2] + body_bounds.half_extents[2]

        # Body-body narrowphase against bodies already in the grid (each pair
        # is handled once, when the later body is processed).
        candidates := query_cells(
            &cells,
            cell_size,
            Vec3 { x: min_x, y: min_y, z: min_z },
            Vec3 { x: max_x, y: max_y, z: max_z },
        )
        candidate_count := candidates.len() as i64
        candidate := 0
        while candidate < candidate_count:
            other_id := candidates[candidate as usize]
            candidate = candidate + 1
            other_index := find_bound_index_local(ids, other_id)
            if other_index < 0:
                cont
            other_shape := stored_shapes[other_index as usize]
            if other_shape == 3:
                # Static plane contact is handled by the ground pass.
                cont
            other_base := other_index * 6
            other_min_x := stored_bounds[(other_base + 0) as usize]
            other_min_y := stored_bounds[(other_base + 1) as usize]
            other_min_z := stored_bounds[(other_base + 2) as usize]
            other_max_x := stored_bounds[(other_base + 3) as usize]
            other_max_y := stored_bounds[(other_base + 4) as usize]
            other_max_z := stored_bounds[(other_base + 5) as usize]
            other_center_x := (other_min_x + other_max_x) * 0.5
            other_center_y := (other_min_y + other_max_y) * 0.5
            other_center_z := (other_min_z + other_max_z) * 0.5

            push := Vec3 { x: 0.0, y: 0.0, z: 0.0 }
            if flags.shape == 2:
                if other_shape == 1:
                    sphere_push := sphere_capsule_penetration(
                        Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] },
                        flags.radius,
                        flags.half_height,
                        Vec3 { x: other_center_x, y: other_center_y, z: other_center_z },
                        stored_radius[other_index as usize],
                    )
                    push = Vec3 { x: 0.0 - sphere_push.x, y: 0.0 - sphere_push.y, z: 0.0 - sphere_push.z }
                elif other_shape == 0:
                    push = capsule_aabb_penetration(
                        Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] },
                        flags.radius,
                        flags.half_height,
                        Aabb {
                            min: Vec3 { x: other_min_x, y: other_min_y, z: other_min_z },
                            max: Vec3 { x: other_max_x, y: other_max_y, z: other_max_z },
                        },
                    )
            elif flags.shape == 1:
                if other_shape == 2:
                    push = sphere_capsule_penetration(
                        Vec3 { x: other_center_x, y: other_center_y, z: other_center_z },
                        stored_radius[other_index as usize],
                        stored_half_height[other_index as usize],
                        Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] },
                        flags.radius,
                    )
                elif other_shape == 0:
                    push = sphere_aabb_penetration(
                        Vec3 { x: transform.translation[0], y: transform.translation[1], z: transform.translation[2] },
                        flags.radius,
                        Aabb {
                            min: Vec3 { x: other_min_x, y: other_min_y, z: other_min_z },
                            max: Vec3 { x: other_max_x, y: other_max_y, z: other_max_z },
                        },
                    )
            elif flags.shape == 0:
                if other_shape == 1:
                    sphere_push := sphere_aabb_penetration(
                        Vec3 { x: other_center_x, y: other_center_y, z: other_center_z },
                        stored_radius[other_index as usize],
                        Aabb {
                            min: Vec3 { x: min_x, y: min_y, z: min_z },
                            max: Vec3 { x: max_x, y: max_y, z: max_z },
                        },
                    )
                    push = Vec3 { x: 0.0 - sphere_push.x, y: 0.0 - sphere_push.y, z: 0.0 - sphere_push.z }
                elif other_shape == 2:
                    capsule_push := capsule_aabb_penetration(
                        Vec3 { x: other_center_x, y: other_center_y, z: other_center_z },
                        stored_radius[other_index as usize],
                        stored_half_height[other_index as usize],
                        Aabb {
                            min: Vec3 { x: min_x, y: min_y, z: min_z },
                            max: Vec3 { x: max_x, y: max_y, z: max_z },
                        },
                    )
                    push = Vec3 { x: 0.0 - capsule_push.x, y: 0.0 - capsule_push.y, z: 0.0 - capsule_push.z }

            if push.x == 0.0 and push.y == 0.0 and push.z == 0.0:
                # AABB fallback for box/box, sphere/sphere, capsule/capsule.
                push = aabb_penetration(
                    Aabb {
                        min: Vec3 { x: min_x, y: min_y, z: min_z },
                        max: Vec3 { x: max_x, y: max_y, z: max_z },
                    },
                    Aabb {
                        min: Vec3 { x: other_min_x, y: other_min_y, z: other_min_z },
                        max: Vec3 { x: other_max_x, y: other_max_y, z: other_max_z },
                    },
                )

            if push.x != 0.0 or push.y != 0.0 or push.z != 0.0:
                transform.translation[0] = transform.translation[0] + push.x
                transform.translation[1] = transform.translation[1] + push.y
                transform.translation[2] = transform.translation[2] + push.z
                if push.x != 0.0:
                    body.velocity[0] = 0.0
                if push.y != 0.0:
                    body.velocity[1] = 0.0
                if push.z != 0.0:
                    body.velocity[2] = 0.0
                if not body.rotation_locked:
                    body.angular_velocity[0] = e7_f32_clamp(
                        body.angular_velocity[0] + push.z * 0.8,
                        -8.0,
                        8.0,
                    )
                    body.angular_velocity[1] = e7_f32_clamp(
                        body.angular_velocity[1] + (push.x - push.z) * 1.6,
                        -8.0,
                        8.0,
                    )
                    body.angular_velocity[2] = e7_f32_clamp(
                        body.angular_velocity[2] - push.x * 0.8,
                        -8.0,
                        8.0,
                    )

        # Recompute bounds after collision resolution and insert into the grid.
        final_min_x := transform.translation[0] - body_bounds.half_extents[0]
        final_min_y := transform.translation[1] - body_bounds.half_extents[1]
        final_min_z := transform.translation[2] - body_bounds.half_extents[2]
        final_max_x := transform.translation[0] + body_bounds.half_extents[0]
        final_max_y := transform.translation[1] + body_bounds.half_extents[1]
        final_max_z := transform.translation[2] + body_bounds.half_extents[2]
        ids = e7_vec_push(ids, flags.target_id)
        body_count = body_count + 1
        stored_bounds = e7_vec_push(stored_bounds, final_min_x)
        stored_bounds = e7_vec_push(stored_bounds, final_min_y)
        stored_bounds = e7_vec_push(stored_bounds, final_min_z)
        stored_bounds = e7_vec_push(stored_bounds, final_max_x)
        stored_bounds = e7_vec_push(stored_bounds, final_max_y)
        stored_bounds = e7_vec_push(stored_bounds, final_max_z)
        stored_shapes = e7_vec_push(stored_shapes, flags.shape)
        stored_radius = e7_vec_push(stored_radius, flags.radius)
        stored_half_height = e7_vec_push(stored_half_height, flags.half_height)
        broadphase_insert(
            &mut cells,
            cell_size,
            flags.target_id,
            Vec3 { x: final_min_x, y: final_min_y, z: final_min_z },
            Vec3 { x: final_max_x, y: final_max_y, z: final_max_z },
        )
        if flags.is_player:
            world.player_x = transform.translation[0]
            world.player_y = transform.translation[1]
            world.player_z = transform.translation[2]

    spatial.cells = cells
    spatial.ids = ids
    spatial.bounds = stored_bounds
    spatial.count = body_count

    # ---------------------------------------------------------- interactions
    released := false
    released_id := 0
    if input.interact_pressed:
        if pickup_state.held_id != 0:
            released_id = pickup_state.held_id
            pickup_state.held_id = 0
            released = true
    # Player yaw for held-body placement (camera pass refreshes it after this).
    hold_yaw := world.camera_yaw
    forward_x := e7_f32_sin(hold_yaw)
    forward_z := 0.0 - e7_f32_cos(hold_yaw)
    acquired := released
    for (transform, body, flags) in interaction_bodies:
        if not flags.is_pickup:
            cont
        if input.interact_pressed and pickup_state.held_id == 0 and not acquired:
            dx := transform.translation[0] - world.player_x
            dy := transform.translation[1] - world.player_y
            dz := transform.translation[2] - world.player_z
            distance_sq := dx * dx + dy * dy + dz * dz
            if distance_sq <= 6.76:
                pickup_state.held_id = flags.target_id
                acquired = true
        if flags.target_id == pickup_state.held_id:
            flags.held_by = 1
            transform.translation[0] = world.player_x + forward_x * 1.8
            transform.translation[1] = world.player_y + 1.4
            transform.translation[2] = world.player_z + forward_z * 1.8
            body.velocity[0] = 0.0
            body.velocity[1] = 0.0
            body.velocity[2] = 0.0
            body.angular_velocity[0] = 0.0
            body.angular_velocity[1] = 0.0
            body.angular_velocity[2] = 0.0
        else:
            flags.held_by = 0
        if released and flags.target_id == released_id:
            # Release impulse: a small deterministic spin from letting go.
            if not body.rotation_locked:
                body.angular_velocity[1] = e7_f32_clamp(body.angular_velocity[1] + 1.6, -8.0, 8.0)

    # ------------------------------------------- camera look + follow (same step)
    for (camera, controller) in cameras:
        camera.yaw = camera.yaw + input.look_dx * controller.look_speed
        camera.pitch = camera.pitch - input.look_dy * controller.look_speed
        keyboard_look := 1.6 * dt
        if input.look_left:
            camera.yaw = camera.yaw - keyboard_look
        if input.look_right:
            camera.yaw = camera.yaw + keyboard_look
        if input.look_up:
            camera.pitch = camera.pitch + keyboard_look
        if input.look_down:
            camera.pitch = camera.pitch - keyboard_look
        camera.pitch = e7_f32_clamp(camera.pitch, -1.5533430343, 1.5533430343)
        camera.position[0] = world.player_x
        camera.position[1] = world.player_y + 1.55
        camera.position[2] = world.player_z
        world.camera_yaw = camera.yaw
        world.camera_pitch = camera.pitch
        world.move_speed = controller.move_speed

# Cosmetic marker sync: ECS cannot remove components, so Held.by is kept in
# sync with the core pickup state for renderers/tools.  Pickup timing itself is
# in physics_step above; this system is not on the gameplay path.
@trigger(PostUpdate)
pub physics_held_marker <- sys (
    state: res &PickupState,
    held_components: select &mut Held, &Pickup from Components,
):
    for (held, pickup) in held_components:
        if pickup.body_id == state.held_id:
            held.by = 1
        else:
            held.by = 0

# Camera-space debug raycast against box colliders (cosmetic/resource only).
@trigger(PostUpdate)
pub physics_raycast <- sys (
    state: res &mut RaycastState,
    cameras: select &Camera from Components,
    colliders: select &Transform, &BoxCollider from Components,
):
    for camera in cameras:
        sin_yaw := e7_f32_sin(camera.yaw)
        cos_yaw := e7_f32_cos(camera.yaw)
        cos_pitch := e7_f32_cos(camera.pitch)
        direction := Vec3 {
            x: sin_yaw * cos_pitch,
            y: e7_f32_sin(camera.pitch),
            z: 0.0 - cos_yaw * cos_pitch,
        }
        origin := Vec3 {
            x: camera.position[0],
            y: camera.position[1],
            z: camera.position[2],
        }
        state.hit = false
        state.distance = 1000000.0
        for (transform, collider) in colliders:
            center := Vec3 {
                x: transform.translation[0],
                y: transform.translation[1],
                z: transform.translation[2],
            }
            half := Vec3 {
                x: collider.half_extents[0],
                y: collider.half_extents[1],
                z: collider.half_extents[2],
            }
            hit := ray_aabb(
                Ray {
                    origin: Vec3 { x: origin.x, y: origin.y, z: origin.z },
                    direction: Vec3 { x: direction.x, y: direction.y, z: direction.z },
                },
                box_collider(center, half),
            )
            if hit.hit and hit.distance < state.distance:
                state.hit = true
                state.distance = hit.distance
                state.point_x = hit.point.x
                state.point_y = hit.point.y
                state.point_z = hit.point.z
