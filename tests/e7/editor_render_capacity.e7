# Verify recording/storage boundaries without creating a window or GPU device.
# e7-test-source: ../../engine/platform/sdl.e7
# e7-test-source: ../../engine/platform/vulkan.e7
# e7-test-source: ../../engine/platform/scene.e7

test_editor_records_objects_and_ui_without_overwriting_resource_tables <- () -> i64:
    scene := ptr::alloc(2048) as u64
    extra := ptr::alloc(66944) as u64
    uniform := ptr::alloc(256 * 320) as u64
    vertices := ptr::alloc(256 * 6 * 32) as u64
    ptr::store_u64(scene + 1280, extra)
    ptr::store_u64(scene + 152, uniform)
    ptr::store_u64(scene + 1224, vertices)
    ptr::store_u64(scene + 1192, 1)
    ptr::store_u32(scene + 88, 960)
    ptr::store_u32(scene + 92, 540)
    ptr::store_u64(extra + 40960, 12345)
    index := 0
    while index < 257:
        scene_draw_box(scene, 0, 0, 0, 1000, 1000, 1000, 1000, 1000, 1000, 0)
        index = index + 1
    assert_eq_i64(ptr::load_u32(scene + 1300), 256)
    index = 0
    while index < 257:
        scene_ui_quad(scene, 0 as u64, 0, 0, 20, 20, 255, 255, 255, 255)
        index = index + 1
    assert_eq_i64(ptr::load_u32(scene + 1300), 512)
    assert_eq_i64(ptr::load_u32(scene + 1232), 256)
    assert_eq_i64(ptr::load_u64(extra + 40960), 12345)
    ptr::store_u32(scene + 1288, 256)
    ptr::store_u64(extra + 40960 + 255 * 96 + 32, 9876)
    assert_eq_i64(texture_set(scene, 256), 9876)
    ptr::store_u64(extra + 66560, 2468)
    index = 0
    while index < 257:
        push_texture_free(scene, index)
        index = index + 1
    assert_eq_i64(ptr::load_u32(scene + 1292), 256)
    assert_eq_i64(ptr::load_u32(extra + 65536 + 255 * 4), 255)
    assert_eq_i64(ptr::load_u64(extra + 66560), 2468)
    ptr::free(vertices)
    ptr::free(uniform)
    ptr::free(extra)
    ptr::free(scene)
    ret 0

test_authored_camera_projection_changes_the_render_uniform <- () -> i64:
    scene := ptr::alloc(2048) as u64
    uniform := ptr::alloc(320) as u64
    ptr::store_u64(scene + 152, uniform)
    ptr::store_u32(scene + 88, 128)
    ptr::store_u32(scene + 92, 64)
    scene_set_projection(scene, 1.5707963267948966, 0.5, 10.0)
    assert_f32_near(ptr::load_f32(uniform + 128), 0.5, 0.000001)
    assert_f32_near(ptr::load_f32(uniform + 148), -1.0, 0.000001)
    assert_f32_near(ptr::load_f32(uniform + 168), -1.0526315789, 0.000001)
    assert_f32_near(ptr::load_f32(uniform + 184), -0.5263157895, 0.000001)
    scene_set_projection(scene, 0.0, 0.5, 10.0)
    assert_f32_near(ptr::load_f32(uniform + 128), 0.5, 0.000001)
    ptr::free(uniform)
    ptr::free(scene)
    ret 0
