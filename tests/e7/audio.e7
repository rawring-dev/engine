# Engine/platform audio tests: dynamic SDL3 audio FFI, WAV loading and
# playback.  The platform layer binds SDL3 at runtime, so these tests use the
# deterministic SDL "dummy" audio driver and never produce audible output.
#
# e7-test-source: ../../engine/platform/audio.e7

# The suite may run from the workspace root or from a package directory, so
# try the checked-in fixture with the same prefixes the Zig tests use.
load_test_tone <- () -> AudioClip:
    first <- audio_load_wav("engine/assets/testdata/tone.wav")
    if first.valid():
        ret first
    second <- audio_load_wav("../engine/assets/testdata/tone.wav")
    if second.valid():
        ret second
    ret audio_load_wav("../../engine/assets/testdata/tone.wav")

# 1 when the active SDL audio driver is the deterministic dummy driver.
is_dummy_driver <- () -> i64:
    name <- audio_current_driver()
    if str::len(name) != 5:
        ret 0
    data <- str::data(name) as u64
    if ptr::load_u8(data) != 100:
        ret 0
    if ptr::load_u8(data + 1) != 117:
        ret 0
    if ptr::load_u8(data + 2) != 109:
        ret 0
    if ptr::load_u8(data + 3) != 109:
        ret 0
    if ptr::load_u8(data + 4) != 121:
        ret 0
    ret 1

test_audio_loads_wav_spec <- () -> i64:
    clip <- load_test_tone()
    assert_eq_bool(clip.valid(), true)
    # The fixture is a 100 ms 440 Hz mono 16-bit WAV: 4410 frames, 8820 bytes.
    assert_eq_i64(clip.length, 8820)
    assert_eq_i64(clip.channels as i64, 1)
    assert_eq_i64(clip.freq as i64, 44100)
    assert_eq_i64(clip.bytes_per_frame(), 2)
    assert_eq_i64(clip.frame_count(), 4410)
    assert_eq_i64(clip.duration_ms(), 100)
    clip.free()
    ret 0

test_audio_rejects_missing_and_invalid_files <- () -> i64:
    missing <- audio_load_wav("engine/assets/testdata/missing-tone.wav")
    assert_eq_bool(missing.valid(), false)
    assert_eq_i64(missing.length, 0)
    missing.free()
    # A real file that is not a WAV must also decode to an empty clip.
    invalid <- audio_load_wav("engine/assets/testdata/cube.png")
    assert_eq_bool(invalid.valid(), false)
    assert_eq_i64(invalid.length, 0)
    invalid.free()
    ret 0

test_audio_playback_dummy_driver <- () -> i64:
    clip <- load_test_tone()
    if not clip.valid():
        # Fixture not reachable from this working directory: the load test
        # reports that failure; skip playback here.
        ret 0
    if audio_init("dummy") == 0:
        # No audio subsystem in this environment: the platform layer must
        # degrade gracefully instead of failing the engine.
        ret 0
    assert_eq_i64(is_dummy_driver(), 1)
    system := AudioSystem { ready: true, volume: 1.0, stream: 0 }
    assert_eq_i64(system.play(&clip), 1)
    system.set_volume(0.25)
    system.stop()
    assert_eq_i64(system.playing(), 0)
    system.shutdown()
    clip.free()
    ret 0

test_audio_plugin_state_degrades_without_device <- () -> i64:
    # A system created with ready=false must no-op on every operation, which is
    # the state the engine plugin inserts when SDL audio initialization fails.
    clip <- load_test_tone()
    system := AudioSystem { ready: false, volume: 1.0, stream: 0 }
    assert_eq_i64(system.play(&clip), 0)
    system.stop()
    assert_eq_i64(system.playing(), 0)
    system.set_volume(0.5)
    system.shutdown()
    clip.free()
    ret 0
